# name: ${FILE_PATH}
# description: ${DESCRIPTION}
# group: [sf3]

argument sf 1

argument dm 5

argument data_dir data/persistent/benchmark/tpch/sf=1

name Iceberg Q${QUERY_NUMBER_PADDED}
group tpch
subgroup sf${sf}

require avro

require parquet

require iceberg

require httpfs

require tpch

cache tpch_sf${sf}_dm${dm}.db

load
CALL dbgen(sf=${sf});
CREATE SECRET (
    TYPE S3,
    KEY_ID 'admin',
    SECRET 'password',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL 0
);
ATTACH '' AS my_datalake (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    ENDPOINT 'http://127.0.0.1:8181'
);
create schema if not exists my_datalake.tpch_sf1_dm5;
DROP TABLE IF EXISTS my_datalake."tpch_sf1_dm5".customer;
DROP TABLE IF EXISTS my_datalake."tpch_sf1_dm5".lineitem;
DROP TABLE IF EXISTS my_datalake."tpch_sf1_dm5".nation;
DROP TABLE IF EXISTS my_datalake."tpch_sf1_dm5".orders;
DROP TABLE IF EXISTS my_datalake."tpch_sf1_dm5".part;
DROP TABLE IF EXISTS my_datalake."tpch_sf1_dm5".partsupp;
DROP TABLE IF EXISTS my_datalake."tpch_sf1_dm5".region;
DROP TABLE IF EXISTS my_datalake."tpch_sf1_dm5".supplier;
DROP SCHEMA IF EXISTS my_datalake."tpch_sf1_dm5";
CREATE SCHEMA IF NOT EXISTS my_datalake."tpch_sf1_dm5";
CREATE TABLE my_datalake."tpch_sf1_dm5".customer as select * from customer;
CREATE TABLE my_datalake."tpch_sf1_dm5".lineitem as select * from lineitem;
CREATE TABLE my_datalake."tpch_sf1_dm5".nation as select * from nation;
CREATE TABLE my_datalake."tpch_sf1_dm5".orders as select * from orders;
CREATE TABLE my_datalake."tpch_sf1_dm5".part as select * from part;
CREATE TABLE my_datalake."tpch_sf1_dm5".partsupp as select * from partsupp;
CREATE TABLE my_datalake."tpch_sf1_dm5".region as select * from region;
CREATE TABLE my_datalake."tpch_sf1_dm5".supplier as select * from supplier;
INSERT INTO my_datalake.tpch_sf1_dm5.orders SELECT * EXCLUDE sf FROM read_parquet('${data_dir}/orders_u1.parquet');
INSERT INTO my_datalake.tpch_sf1_dm5.lineitem SELECT * EXCLUDE sf FROM read_parquet('${data_dir}/lineitem_u1.parquet');
DELETE FROM my_datalake.tpch_sf1_dm5.orders   WHERE o_orderkey IN (SELECT o_orderkey FROM read_parquet('${data_dir}/delete_set_1.parquet'));
DELETE FROM my_datalake.tpch_sf1_dm5.lineitem WHERE l_orderkey IN (SELECT o_orderkey FROM read_parquet('${data_dir}/delete_set_1.parquet'));
INSERT INTO my_datalake.tpch_sf1_dm5.orders SELECT * EXCLUDE sf FROM read_parquet('${data_dir}/orders_u2.parquet');
INSERT INTO my_datalake.tpch_sf1_dm5.lineitem SELECT * EXCLUDE sf FROM read_parquet('${data_dir}/lineitem_u2.parquet');
DELETE FROM my_datalake.tpch_sf1_dm5.orders   WHERE o_orderkey IN (SELECT o_orderkey FROM read_parquet('${data_dir}/delete_set_2.parquet'));
DELETE FROM my_datalake.tpch_sf1_dm5.lineitem WHERE l_orderkey IN (SELECT o_orderkey FROM read_parquet('${data_dir}/delete_set_2.parquet'));
INSERT INTO my_datalake.tpch_sf1_dm5.orders SELECT * EXCLUDE sf FROM read_parquet('${data_dir}/orders_u3.parquet');
INSERT INTO my_datalake.tpch_sf1_dm5.lineitem SELECT * EXCLUDE sf FROM read_parquet('${data_dir}/lineitem_u3.parquet');
DELETE FROM my_datalake.tpch_sf1_dm5.orders   WHERE o_orderkey IN (SELECT o_orderkey FROM read_parquet('${data_dir}/delete_set_3.parquet'));
DELETE FROM my_datalake.tpch_sf1_dm5.lineitem WHERE l_orderkey IN (SELECT o_orderkey FROM read_parquet('${data_dir}/delete_set_3.parquet'));
INSERT INTO my_datalake.tpch_sf1_dm5.orders SELECT * EXCLUDE sf FROM read_parquet('${data_dir}/orders_u4.parquet');
INSERT INTO my_datalake.tpch_sf1_dm5.lineitem SELECT * EXCLUDE sf FROM read_parquet('${data_dir}/lineitem_u4.parquet');
DELETE FROM my_datalake.tpch_sf1_dm5.orders   WHERE o_orderkey IN (SELECT o_orderkey FROM read_parquet('${data_dir}/delete_set_4.parquet'));
DELETE FROM my_datalake.tpch_sf1_dm5.lineitem WHERE l_orderkey IN (SELECT o_orderkey FROM read_parquet('${data_dir}/delete_set_4.parquet'));
INSERT INTO my_datalake.tpch_sf1_dm5.orders SELECT * EXCLUDE sf FROM read_parquet('${data_dir}/orders_u5.parquet');
INSERT INTO my_datalake.tpch_sf1_dm5.lineitem SELECT * EXCLUDE sf FROM read_parquet('${data_dir}/lineitem_u5.parquet');
DELETE FROM my_datalake.tpch_sf1_dm5.orders   WHERE o_orderkey IN (SELECT o_orderkey FROM read_parquet('${data_dir}/delete_set_5.parquet'));
DELETE FROM my_datalake.tpch_sf1_dm5.lineitem WHERE l_orderkey IN (SELECT o_orderkey FROM read_parquet('${data_dir}/delete_set_5.parquet'));

reload
CREATE SECRET (
    TYPE S3,
    KEY_ID 'admin',
    SECRET 'password',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL 0
);
ATTACH '' AS my_datalake (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    ENDPOINT 'http://127.0.0.1:8181',
    DEFAULT_SCHEMA 'tpch_sf1_dm5'
);


run
SET debug_fs_delay_mean_ms=3;
SET enable_external_file_cache=false;
USE my_datalake.tpch_sf1_dm5;
pragma tpch(${QUERY_NUMBER_PADDED});

