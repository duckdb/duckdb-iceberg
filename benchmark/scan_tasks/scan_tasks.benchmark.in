# name: ${FILE_PATH}
# description: Execute pre-materialized Iceberg tasks with ${THREADS} threads
# group: [scan_tasks]

name Iceberg scan tasks - ${CASE} - ${THREADS} threads
group scan_tasks
subgroup ${CASE}

require avro

require parquet

require iceberg

require json

# Generate deterministic local data outside the timed region. Repeated paths
# deliberately isolate task scheduling and reader setup from filesystem scale.
load
SET threads=1;
SET enable_external_file_cache=false;
COPY (SELECT i::BIGINT AS id, (3*i+7)::BIGINT AS payload FROM range(${ROWS}) t(i))
TO '${BENCHMARK_DIR}/scan_tasks_${CASE}_${THREADS}_data.parquet'
(FORMAT PARQUET, ROW_GROUP_SIZE 8192, FIELD_IDS {id:1, payload:2});
COPY (SELECT i::BIGINT AS id, (3*i+7)::BIGINT AS payload FROM range(32) t(i))
TO '${BENCHMARK_DIR}/scan_tasks_${CASE}_${THREADS}_tiny.parquet'
(FORMAT PARQUET, FIELD_IDS {id:1, payload:2});
CREATE TEMP TABLE tasks AS
SELECT CASE WHEN i < ${DATA_TASKS} THEN '${BENCHMARK_DIR}/scan_tasks_${CASE}_${THREADS}_data.parquet'
            ELSE '${BENCHMARK_DIR}/scan_tasks_${CASE}_${THREADS}_tiny.parquet' END::VARCHAR AS file_path,
       'PARQUET'::VARCHAR AS file_format,
       CASE WHEN i < ${DATA_TASKS} THEN data_size ELSE tiny_size END::BIGINT AS file_size_in_bytes,
       CASE WHEN i < ${DATA_TASKS} THEN ${ROWS} ELSE 32 END::BIGINT AS record_count,
       NULL::BIGINT AS sequence_number, NULL::BIGINT AS first_row_id,
       0::INTEGER AS partition_spec_id, {'3':i::BIGINT} AS partition_constants,
       []::STRUCT(file_path VARCHAR, file_format VARCHAR, content INTEGER, file_size_in_bytes BIGINT,
                  record_count BIGINT, equality_ids INTEGER[], referenced_data_file VARCHAR,
                  content_offset BIGINT, content_size_in_bytes BIGINT)[] AS delete_files,
       NULL::BIGINT AS snapshot_id, 0::INTEGER AS schema_id,
       '{"format-version":2,"table-uuid":"00000000-0000-0000-0000-000000000001","location":"${BENCHMARK_DIR}","last-updated-ms":0,"last-column-id":3,"last-sequence-number":0,"current-schema-id":0,"schemas":[{"schema-id":0,"type":"struct","fields":[{"id":1,"name":"id","required":false,"type":"long"},{"id":2,"name":"payload","required":false,"type":"long"},{"id":3,"name":"task_id","required":false,"type":"long"}]}],"partition-specs":[{"spec-id":0,"fields":[{"name":"task_id","transform":"identity","source-id":3,"field-id":1000}]}],"default-spec-id":0,"sort-orders":[{"order-id":0,"fields":[]}],"default-sort-order-id":0}'::JSON::VARIANT AS metadata,
       NULL::STRUCT(id BIGINT, payload BIGINT, task_id BIGINT) AS schema
FROM range(${TASKS}) t(i)
CROSS JOIN (SELECT size AS data_size FROM read_blob('${BENCHMARK_DIR}/scan_tasks_${CASE}_${THREADS}_data.parquet')) d
CROSS JOIN (SELECT size AS tiny_size FROM read_blob('${BENCHMARK_DIR}/scan_tasks_${CASE}_${THREADS}_tiny.parquet')) s;
SET VARIABLE task_list = (SELECT list(t) FROM tasks t);
SET threads=${THREADS};

run
SELECT count(*), sum(id), sum(payload), sum(task_id)
FROM iceberg_scan_tasks(getvariable('task_list'));

result IIII
${COUNT}	${SUM_ID}	${SUM_PAYLOAD}	${SUM_TASK_ID}
