# name: benchmark/file_pruning_benchmarks/metadata_only_delete_whole_partition.benchmark
# description: DELETE matching every row of one day-partition
# group: [file_pruning_benchmarks]

name Metadata-only DELETE of a whole partition
group file_pruning_benchmarks
subgroup metadata_only_delete

require avro

require parquet

require iceberg

require httpfs

# A day(event_date)-partitioned, format-version 2 table of 8 partitions holding 500k rows each. The
# timed DELETE matches exactly one partition on the partition source column, so every row of that
# partition's data files is deleted. A metadata-only DELETE can drop those files without reading
# them; the row-level implementation scans them and writes positional deletes instead.
#
# require_reinit rebuilds the table before each timed run, so the DELETE is measured against a fresh
# table every time. Initialize() runs outside the profiler, so the rebuild itself is not timed.
require_reinit

load
SET enable_external_file_cache=false;
CREATE SECRET (
    TYPE S3,
    KEY_ID 'admin',
    SECRET 'password',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL 0
);
ATTACH '' AS my_datalake (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    ENDPOINT 'http://127.0.0.1:8181',
);
CREATE SCHEMA if not exists my_datalake.default;
DROP TABLE IF EXISTS my_datalake.default.metadata_only_delete_whole_partition;
CREATE TABLE my_datalake.default.metadata_only_delete_whole_partition (
    id BIGINT,
    event VARCHAR,
    event_date DATE
) PARTITIONED BY (day(event_date)) WITH ('format-version' = '2');
INSERT INTO my_datalake.default.metadata_only_delete_whole_partition
SELECT
    range % 500000,
    'e' || range::VARCHAR,
    DATE '2024-01-01' + (range // 500000)::INTEGER
FROM range(4000000);

run
DELETE FROM my_datalake.default.metadata_only_delete_whole_partition
WHERE event_date = DATE '2024-01-01';

# Verify the affected count and surviving rows outside the timed DELETE. Both implementations
# must return the same rows, regardless of whether they drop data files or write delete files.
result_query III
SELECT (SELECT * FROM __answer), count(*),
       count(*) FILTER (WHERE event_date = DATE '2024-01-01')
FROM my_datalake.default.metadata_only_delete_whole_partition;
----
500000	3500000	0
