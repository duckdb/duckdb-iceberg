# name: benchmark/file_pruning_benchmarks/row_level_delete_uncovered_predicate.benchmark
# description: DELETE on a non-partition column, where coverage can never be proven and the row-level path always runs
# group: [file_pruning_benchmarks]

name Row-level DELETE on an uncovered predicate
group file_pruning_benchmarks
subgroup metadata_only_delete

require avro

require parquet

require iceberg

require httpfs

# The control for the metadata-only benchmarks uses the same 128-partition, format-version 2 table,
# but filters on id, which no partition field covers. Each data file loses only one of its 1000 rows,
# so both implementations need row-level deletes. This measures any overhead on the fallback path;
# the optimization's per-spec gate can reject this predicate before attempting per-file coverage.
require_reinit

load
SET enable_external_file_cache=false;
CREATE SECRET (
    TYPE S3,
    KEY_ID 'admin',
    SECRET 'password',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL 0
);
ATTACH '' AS my_datalake (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    ENDPOINT 'http://127.0.0.1:8181',
);
CREATE SCHEMA if not exists my_datalake.default;
DROP TABLE IF EXISTS my_datalake.default.row_level_delete_uncovered_predicate;
CREATE TABLE my_datalake.default.row_level_delete_uncovered_predicate (
    id BIGINT,
    event VARCHAR,
    event_date DATE
) PARTITIONED BY (day(event_date)) WITH ('format-version' = '2');
INSERT INTO my_datalake.default.row_level_delete_uncovered_predicate
SELECT
    range % 1000,
    'e' || range::VARCHAR,
    DATE '2024-01-01' + (range // 1000)::INTEGER
FROM range(128000);

run
DELETE FROM my_datalake.default.row_level_delete_uncovered_predicate
WHERE id = 0;

result_query III
SELECT (SELECT * FROM __answer), count(*), count(*) FILTER (WHERE id = 0)
FROM my_datalake.default.row_level_delete_uncovered_predicate;
----
128	127872	0
