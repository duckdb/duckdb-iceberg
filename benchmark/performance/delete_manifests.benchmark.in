# name: ${FILE_PATH}
# description: Read eight delete manifests of 40,000 entries each with ${THREADS} threads
# group: [performance]

name Delete manifests - ${THREADS} threads
group performance
subgroup delete_manifests

require avro

require parquet

require iceberg

require json

# The scans of the eight data files need the same eight delete manifests: the partition summaries of the manifests
# span the partition of the data files, so each manifest has to be read. Their entries are for the partitions on
# either side, so no delete file is read and the time goes into the manifests. The table is written by hand: the
# entries need no delete files behind them. Local files and disabled external caching isolate CPU costs; OS pages
# stay warm.
#
# require_reinit rebuilds the database before each timed run, so every run is the first scan of the table. A later
# scan takes the parsed delete manifests from the manifest cache and does not read them.
require_reinit

load
SET threads=1;
SET enable_external_file_cache=false;
COPY (SELECT k, (i + k * 262144)::BIGINT id, (3 * i + 7)::BIGINT payload, 'b' AS p FROM range(8) f(k), range(262144) t(i))
TO '${BENCHMARK_DIR}/delete_manifests_${THREADS}_data'
(FORMAT PARQUET, PARTITION_BY (k), FIELD_IDS {id:1, payload:2, p:3}, OVERWRITE);
SET VARIABLE manifest_field_ids = {status: 0, snapshot_id: 1, sequence_number: 3, file_sequence_number: 4,
	data_file: {__duckdb_field_id: 2, content: 134, file_path: 100, file_format: 101,
		partition: {__duckdb_field_id: 102, p: 1000}, record_count: 103, file_size_in_bytes: 104}};
COPY (
	SELECT 1::INTEGER AS status, 2::BIGINT AS snapshot_id, 1::BIGINT AS sequence_number, 1::BIGINT AS file_sequence_number,
		{content: 0::INTEGER, file_path: filename, file_format: 'PARQUET', partition: {p: 'b'},
		 record_count: 262144::BIGINT, file_size_in_bytes: size::BIGINT} AS data_file
	FROM read_blob('${BENCHMARK_DIR}/delete_manifests_${THREADS}_data/*/*.parquet') ORDER BY filename
) TO '${BENCHMARK_DIR}/delete_manifests_${THREADS}_data.avro' (FORMAT AVRO, FIELD_IDS getvariable('manifest_field_ids'),
	METADATA {'schema-id': '0', 'partition-spec-id': '0', 'format-version': '2', 'content': 'data'});
CREATE TEMP TABLE delete_entries AS
SELECT (i % 8)::INTEGER AS manifest, 1::INTEGER AS status, 2::BIGINT AS snapshot_id, 2::BIGINT AS sequence_number,
	2::BIGINT AS file_sequence_number,
	{content: 1::INTEGER,
	 file_path: '${BENCHMARK_DIR}/delete_manifests_${THREADS}_other_partition/delete_' || i || '.parquet',
	 file_format: 'PARQUET', partition: {p: CASE WHEN (i // 8) % 2 = 0 THEN 'a' ELSE 'c' END},
	 record_count: 10::BIGINT, file_size_in_bytes: 1000::BIGINT} AS data_file
FROM range(320000) t(i);
SET VARIABLE delete_manifest_metadata =
	{'schema-id': '0', 'partition-spec-id': '0', 'format-version': '2', 'content': 'deletes'};
COPY (SELECT * EXCLUDE (manifest) FROM delete_entries WHERE manifest = 0)
TO '${BENCHMARK_DIR}/delete_manifests_${THREADS}_deletes_0.avro'
(FORMAT AVRO, FIELD_IDS getvariable('manifest_field_ids'), METADATA getvariable('delete_manifest_metadata'));
COPY (SELECT * EXCLUDE (manifest) FROM delete_entries WHERE manifest = 1)
TO '${BENCHMARK_DIR}/delete_manifests_${THREADS}_deletes_1.avro'
(FORMAT AVRO, FIELD_IDS getvariable('manifest_field_ids'), METADATA getvariable('delete_manifest_metadata'));
COPY (SELECT * EXCLUDE (manifest) FROM delete_entries WHERE manifest = 2)
TO '${BENCHMARK_DIR}/delete_manifests_${THREADS}_deletes_2.avro'
(FORMAT AVRO, FIELD_IDS getvariable('manifest_field_ids'), METADATA getvariable('delete_manifest_metadata'));
COPY (SELECT * EXCLUDE (manifest) FROM delete_entries WHERE manifest = 3)
TO '${BENCHMARK_DIR}/delete_manifests_${THREADS}_deletes_3.avro'
(FORMAT AVRO, FIELD_IDS getvariable('manifest_field_ids'), METADATA getvariable('delete_manifest_metadata'));
COPY (SELECT * EXCLUDE (manifest) FROM delete_entries WHERE manifest = 4)
TO '${BENCHMARK_DIR}/delete_manifests_${THREADS}_deletes_4.avro'
(FORMAT AVRO, FIELD_IDS getvariable('manifest_field_ids'), METADATA getvariable('delete_manifest_metadata'));
COPY (SELECT * EXCLUDE (manifest) FROM delete_entries WHERE manifest = 5)
TO '${BENCHMARK_DIR}/delete_manifests_${THREADS}_deletes_5.avro'
(FORMAT AVRO, FIELD_IDS getvariable('manifest_field_ids'), METADATA getvariable('delete_manifest_metadata'));
COPY (SELECT * EXCLUDE (manifest) FROM delete_entries WHERE manifest = 6)
TO '${BENCHMARK_DIR}/delete_manifests_${THREADS}_deletes_6.avro'
(FORMAT AVRO, FIELD_IDS getvariable('manifest_field_ids'), METADATA getvariable('delete_manifest_metadata'));
COPY (SELECT * EXCLUDE (manifest) FROM delete_entries WHERE manifest = 7)
TO '${BENCHMARK_DIR}/delete_manifests_${THREADS}_deletes_7.avro'
(FORMAT AVRO, FIELD_IDS getvariable('manifest_field_ids'), METADATA getvariable('delete_manifest_metadata'));
COPY (
	SELECT filename AS manifest_path, size::BIGINT AS manifest_length, 0::INTEGER AS partition_spec_id,
		(CASE WHEN contains(filename, '_deletes_') THEN 1 ELSE 0 END)::INTEGER AS content,
		(CASE WHEN contains(filename, '_deletes_') THEN 2 ELSE 1 END)::BIGINT AS sequence_number,
		0::BIGINT AS min_sequence_number, 2::BIGINT AS added_snapshot_id,
		(CASE WHEN contains(filename, '_deletes_') THEN 40000 ELSE 8 END)::INTEGER AS added_files_count,
		0::INTEGER AS existing_files_count, 0::INTEGER AS deleted_files_count,
		(CASE WHEN contains(filename, '_deletes_') THEN 400000 ELSE 2097152 END)::BIGINT AS added_rows_count,
		0::BIGINT AS existing_rows_count, 0::BIGINT AS deleted_rows_count,
		[{contains_null: false, contains_nan: false,
		  lower_bound: (CASE WHEN contains(filename, '_deletes_') THEN 'a' ELSE 'b' END)::BLOB,
		  upper_bound: (CASE WHEN contains(filename, '_deletes_') THEN 'c' ELSE 'b' END)::BLOB}] AS partitions
	FROM read_blob(['${BENCHMARK_DIR}/delete_manifests_${THREADS}_data.avro',
	                '${BENCHMARK_DIR}/delete_manifests_${THREADS}_deletes_*.avro']) ORDER BY filename
) TO '${BENCHMARK_DIR}/delete_manifests_${THREADS}_list.avro' (
	FORMAT AVRO,
	FIELD_IDS {manifest_path: 500, manifest_length: 501, partition_spec_id: 502, content: 517, sequence_number: 515,
		min_sequence_number: 516, added_snapshot_id: 503, added_files_count: 504, existing_files_count: 505,
		deleted_files_count: 506, added_rows_count: 512, existing_rows_count: 513, deleted_rows_count: 514,
		partitions: {__duckdb_field_id: 507, list: {__duckdb_field_id: 508, contains_null: 509,
			contains_nan: {__duckdb_field_id: 518, __duckdb_nullable: true}, lower_bound: 510, upper_bound: 511}}}
);
COPY (
	SELECT 2 AS "format-version", '00000000-0000-0000-0000-000000000006' AS "table-uuid",
		'${BENCHMARK_DIR}/delete_manifests_${THREADS}' AS location,
		2 AS "last-sequence-number", 0 AS "last-updated-ms", 3 AS "last-column-id", 0 AS "current-schema-id",
		[{'type': 'struct', 'schema-id': 0, 'fields': [
			{'id': 1, 'name': 'id', 'required': false, 'type': 'long'},
			{'id': 2, 'name': 'payload', 'required': false, 'type': 'long'},
			{'id': 3, 'name': 'p', 'required': false, 'type': 'string'}]}] AS schemas,
		0 AS "default-spec-id",
		[{'spec-id': 0, 'fields': [{'name': 'p', 'transform': 'identity', 'source-id': 3, 'field-id': 1000}]}] AS "partition-specs",
		1000 AS "last-partition-id", 0 AS "default-sort-order-id",
		[{'order-id': 0, 'fields': []::INTEGER[]}] AS "sort-orders",
		2 AS "current-snapshot-id",
		[{'snapshot-id': 2, 'sequence-number': 2, 'timestamp-ms': 0, 'schema-id': 0,
		  'manifest-list': '${BENCHMARK_DIR}/delete_manifests_${THREADS}_list.avro',
		  'summary': {'operation': 'overwrite'}}] AS snapshots
) TO '${BENCHMARK_DIR}/delete_manifests_${THREADS}_v1.metadata.json' (FORMAT JSON);
SET threads=${THREADS};

run
SELECT count(*), sum(id) FROM iceberg_scan('${BENCHMARK_DIR}/delete_manifests_${THREADS}_v1.metadata.json');

result II
2097152	2199022206976
