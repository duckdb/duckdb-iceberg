{
	"description": "Use apache/iceberg-rest-fixture as Iceberg Rest Catalog.",
	"on_init": "CREATE SECRET (TYPE S3,KEY_ID 'admin',SECRET 'password',ENDPOINT '127.0.0.1:9000',URL_STYLE 'path',USE_SSL 0); ATTACH '' AS my_datalake (TYPE ICEBERG,CLIENT_ID 'admin',CLIENT_SECRET 'password',URI 'http://127.0.0.1:8181'); Create schema if not exists my_datalake.default;",
	"skip_error_messages": [],
	"statically_loaded_extensions": [
		"core_functions",
		"parquet",
		"avro",
		"iceberg",
		"httpfs",
		"icu"
	],
	"test_env": [
		{
			"env_name": "CATALOG_TEST_CONFIG_SETUP",
			"env_value": "fixture"
		},
		{
			"env_name": "FORMAT_V3_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "UNKNOWN_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "VARIANT_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "GEOMETRY_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "TIMESTAMP_NS_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "COLUMN_DEFAULT_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "TIMESTAMP_NS_DEFAULT_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "TIMESTAMPTZ_NS_DEFAULT_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "TIMETRAVEL_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "SNAPSHOT_HISTORY_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "METADATA_LOG_SUPPORT",
			"env_value": "true"
		},
