  "on_init": "CREATE SECRET IF NOT EXISTS s3tables_secret (TYPE S3, PROVIDER credential_chain); ATTACH IF NOT EXISTS '{S3TABLES_TABLE_BUCKET_ARN}' AS my_datalake (TYPE ICEBERG, ENDPOINT_TYPE S3_TABLES); Create schema if not exists my_datalake.default; set iceberg_default_format_version=3",
