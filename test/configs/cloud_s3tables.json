{
  "description": "Use an AWS S3 Tables table bucket as Iceberg Rest Catalog.",
  "comment": "S3TABLES_TABLE_BUCKET_ARN is a placeholder: the Test S3 Tables Catalog workflow fills it in with the ARN of the throwaway table bucket it created for the run. To use this config locally, point it at a table bucket of your own and make sure AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_DEFAULT_REGION are exported for the credential chain to pick up.",
  "on_init": "CREATE SECRET IF NOT EXISTS s3tables_secret (TYPE S3, PROVIDER credential_chain); ATTACH IF NOT EXISTS '{S3TABLES_TABLE_BUCKET_ARN}' AS my_datalake (TYPE ICEBERG, ENDPOINT_TYPE S3_TABLES); Create schema if not exists my_datalake.default; set iceberg_default_format_version=3",
  "skip_error_messages": [],
  "statically_loaded_extensions": [
    "core_functions",
    "parquet",
    "avro",
    "iceberg",
    "httpfs",
    "aws"
  ],
  "test_env": [
    {
      "env_name": "CATALOG_TEST_CONFIG_SETUP",
      "env_value": "s3tables"
    },
    {
      "env_name": "S3TABLES_TABLE_BUCKET_ARN",
      "env_value": ""
    },
    {
      "env_name": "FORMAT_V3_SUPPORT",
      "env_value": "true"
    },
    {
      "env_name": "UNKNOWN_SUPPORT",
      "env_value": "true"
    },
    {
      "env_name": "TIMETRAVEL_SUPPORT",
      "env_value": "true"
    },
    {
      "env_name": "SNAPSHOT_HISTORY_SUPPORT",
      "env_value": "true"
    },
    {
      "env_name": "METADATA_LOG_SUPPORT",
      "env_value": "true"
    },
    {
      "env_name": "METADATA_FILE_READ_SUPPORT",
      "env_value": "true"
    },
    {
      "env_name": "MULTI_TABLE_COMMIT_SUPPORT",
      "env_value": "true"
    },
    {
      "env_name": "SCAN_PLANNING_MODE",
      "env_value": "client"
    },
    {
      "env_name": "ATOMIC_COMMIT_CONFLICT_SUPPORT",
      "env_value": "true"
    }
  ],
