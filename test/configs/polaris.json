{
	"description": "Use Polaris as Iceberg Rest Catalog.",
	"on_init": "create secret polaris_secret (TYPE ICEBERG, CLIENT_ID 'root',CLIENT_SECRET 's3cr3t',URI 'http://0.0.0.0:8181/api/catalog'); attach 'quickstart_catalog' as my_datalake (type ICEBERG,URI 'http://0.0.0.0:8181/api/catalog', default_region 'us-west-2'); Create schema if not exists my_datalake.default;",
	"skip_error_messages": [],
	"statically_loaded_extensions": [
		"core_functions",
		"parquet",
		"avro",
		"iceberg",
		"httpfs"
	],
	"test_env": [
		{
			"env_name": "CATALOG_TEST_CONFIG_SETUP",
			"env_value": "polaris"
		},
		{
			"env_name": "FORMAT_V3_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "UNKNOWN_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "VARIANT_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "GEOMETRY_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "TIMESTAMP_NS_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "COLUMN_DEFAULT_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "TIMESTAMPTZ_NS_DEFAULT_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "TIMESTAMP_NS_DEFAULT_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "TIMETRAVEL_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "SNAPSHOT_HISTORY_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "METADATA_LOG_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "METADATA_FILE_READ_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "STAGED_CREATE_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "MULTI_TABLE_COMMIT_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "NAMESPACE_PROPERTIES_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "CASE_SENSITIVE_TABLE_NAMES_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "SCAN_PLANNING_MODE",
			"env_value": "client"
		}
	],
	"skip_tests": [
		{
			"reason": "Not yet supported with Polaris",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/delete/test_no_head_request_for_deletes.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/delete/time_travel_after_uncommitted_delete.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/transactions/test_transactional_updates_error_omits_stacktrace.test"
			]
		},
		{
			"reason": "For some reason the tables cannot be generated in polaris yet",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/test_requests_to_partitioned_table.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/read_mor_delete_partition_evolution.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/irc_catalog_read_deletes.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/test_read_upper_and_lower_bounds.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/iceberg_catalog_eager_refresh.test"
			]
		},
		{
			"reason": "Catalog fails with table collisions",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/alter/rename_table/rename_table_test.test"
			]
		},
		{
			"reason": "Need to reparse paths",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/delete/delete_table.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/test_write_upper_and_lower_bounds_single_values.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/test_write_upper_and_lower_bounds_all_null.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/test_write_upper_and_lower_bounds.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/test_write_decimal_bounds_hugeint.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/test_write_decimal_bounds.test"
			]
		},
		{
			"reason": "Polaris can't handle removals and updates of schema properties in the same request",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/schema_properties/schema_properties_update_transaction.test"
			]
		},
		{
			"reason": "Inserting into Nessie triggers Relassert error that does not reproduce locally",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/file_properties/test_parquet_options_physical_properties.test"
			]
		}
	]
}