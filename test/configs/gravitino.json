{
	"description": "Use Apache Gravitino as Iceberg Rest Catalog.",
	"on_init": "CREATE SECRET gravitino_storage (TYPE S3, KEY_ID 'admin', SECRET 'password', ENDPOINT '127.0.0.1:9000', URL_STYLE 'path', USE_SSL 0); ATTACH '' AS my_datalake (TYPE ICEBERG, URI 'http://127.0.0.1:9001/iceberg', AUTHORIZATION_TYPE 'none', ACCESS_DELEGATION_MODE 'vended_credentials'); CREATE SCHEMA IF NOT EXISTS my_datalake.default;",
	"skip_error_messages": [],
	"statically_loaded_extensions": [
		"core_functions",
		"parquet",
		"avro",
		"iceberg",
		"httpfs",
		"icu"
	],
	"test_env": [
		{
			"env_name": "CATALOG_TEST_CONFIG_SETUP",
			"env_value": "gravitino"
		},
		{
			"env_name": "FORMAT_V3_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "UNKNOWN_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "VARIANT_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "GEOMETRY_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "TIMESTAMP_NS_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "COLUMN_DEFAULT_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "TIMESTAMP_NS_DEFAULT_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "TIMESTAMPTZ_NS_DEFAULT_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "TIMETRAVEL_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "SNAPSHOT_HISTORY_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "METADATA_LOG_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "STAGED_CREATE_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "FILE_CLEANUP_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "NAMESPACE_PROPERTIES_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "CASE_SENSITIVE_TABLE_NAMES_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "SCAN_PLANNING_MODE",
			"env_value": "client"
		}
	],
	"skip_tests": [
		{
			"reason": "Test is hardcoded for 'fixture' intermediates",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/irc_catalog_read_deletes.test"
			]
		},
		{
			"reason": "Gravitino schemas don't carry a 'namespace_id'",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/schema_properties/schema_properties_update.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/schema_properties/schema_properties_update_transaction.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/schema_properties/schema_properties_update_concurrent_transactions.test"
			]
		}
	]
}