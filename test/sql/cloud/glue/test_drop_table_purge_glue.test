# name: test/sql/cloud/glue/test_drop_table_purge_glue.test
# description: DROP TABLE on a Glue table deletes its files with PURGE_MODE 'client'
# group: [glue]

# The Glue Iceberg REST endpoint only unregisters a Glue table: it rejects purgeRequested=true and never deletes
# customer files, so only a client-side purge can delete them. The metadata files it writes carry an empty
# metadata-log, which the purge (like Iceberg's CatalogUtil.dropTableData) relies on to find the previous metadata
# files, so those stay behind on Glue.

require-env ICEBERG_AWS_REMOTE_AVAILABLE

require-env AWS_ACCESS_KEY_ID

require-env AWS_SECRET_ACCESS_KEY

include test/sql/init_requires

require aws

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
CREATE SECRET (
  TYPE S3,
  PROVIDER credential_chain,
  REGION 'us-east-1'
);

# Inspect the purgeRequested query parameter in logged DELETE requests.
statement ok
SET redact_http_logs = false;

# ACCESS_DELEGATION_MODE 'none' with the header spelled out: without the header Glue still tries to vend Lake Formation
# credentials for the table location and fails LoadTable when the location is not registered with Lake Formation.
statement ok
ATTACH '840140254803' AS glue_client (
    TYPE ICEBERG,
    ENDPOINT_TYPE 'GLUE',
    ACCESS_DELEGATION_MODE 'none',
    EXTRA_HTTP_HEADERS MAP {'X-Iceberg-Access-Delegation': 'none'},
    PURGE_MODE 'client'
);

# Leftovers of an earlier failed run are purged as well.
statement ok
DROP TABLE IF EXISTS glue_client.simple_glue_database.duckdb_purge_client;

statement ok
DROP TABLE IF EXISTS glue_client.simple_glue_database.duckdb_purge_server;

#===--------------------------------------------------------------------===#
# PURGE_MODE 'client': Glue unregisters the table, DuckDB deletes its files
#===--------------------------------------------------------------------===#

statement ok
CREATE TABLE glue_client.simple_glue_database.duckdb_purge_client (a INTEGER, b VARCHAR)
WITH (
    'location' = 's3://duckdblabs-glue-iceberg-database-on-s3-bucket/duckdb-iceberg-purge-test/duckdb_purge_client/',
    'write.delete.mode' = 'merge-on-read'
);

# Three snapshots: two appends and a delete that adds a delete file
statement ok
INSERT INTO glue_client.simple_glue_database.duckdb_purge_client SELECT range, 'first' FROM range(10);

statement ok
INSERT INTO glue_client.simple_glue_database.duckdb_purge_client SELECT range, 'second' FROM range(10, 20);

statement ok
DELETE FROM glue_client.simple_glue_database.duckdb_purge_client WHERE a < 5;

query I
SELECT count(*) FROM glue_client.simple_glue_database.duckdb_purge_client;
----
15

query I
SELECT count(*) FROM iceberg_snapshots('glue_client.simple_glue_database.duckdb_purge_client');
----
3

# Glue writes every metadata file with an empty metadata-log, although every commit left one behind
query I
SELECT metadata."metadata-log" FROM iceberg_load_table_response(glue_client.simple_glue_database.duckdb_purge_client);
----
[]

statement ok
SET VARIABLE purge_client_metadata = (
    SELECT metadata_location FROM iceberg_load_table_response(glue_client.simple_glue_database.duckdb_purge_client)
);

statement ok
SET VARIABLE purge_client_previous_metadata = (
    SELECT count(*) FROM glob('s3://duckdblabs-glue-iceberg-database-on-s3-bucket/duckdb-iceberg-purge-test/duckdb_purge_client/metadata/*.metadata.json')
    WHERE file <> getvariable('purge_client_metadata')
);

query I
SELECT count(*) >= 3 FROM glob('s3://duckdblabs-glue-iceberg-database-on-s3-bucket/duckdb-iceberg-purge-test/duckdb_purge_client/data/*.parquet');
----
true

query I
SELECT getvariable('purge_client_previous_metadata') >= 4;
----
true

query I
SELECT count(*) >= 6 FROM glob('s3://duckdblabs-glue-iceberg-database-on-s3-bucket/duckdb-iceberg-purge-test/duckdb_purge_client/metadata/*.avro');
----
true

statement ok
CALL enable_logging('HTTP');

statement ok
CALL truncate_duckdb_logs();

statement ok
DROP TABLE glue_client.simple_glue_database.duckdb_purge_client;

# Glue was not asked to purge
query I
SELECT regexp_matches(request.url, 'tables/duckdb_purge_client\?purgeRequested=false$') FROM duckdb_logs_parsed('HTTP') WHERE request.type = 'DELETE';
----
true

statement ok
CALL disable_logging();

query I
SELECT count(*) FROM (SHOW TABLES FROM glue_client.simple_glue_database) WHERE name = 'duckdb_purge_client';
----
0

# Everything the metadata referenced is gone: data and delete files, manifests, manifest lists, the current metadata
# file
query I
SELECT count(*) FROM glob('s3://duckdblabs-glue-iceberg-database-on-s3-bucket/duckdb-iceberg-purge-test/duckdb_purge_client/**/*.parquet');
----
0

query I
SELECT count(*) FROM glob('s3://duckdblabs-glue-iceberg-database-on-s3-bucket/duckdb-iceberg-purge-test/duckdb_purge_client/**/*.avro');
----
0

# glob() returns an exact S3 path without checking it exists, so match the file by its version prefix instead
query I
SELECT count(*) FROM glob(regexp_replace(getvariable('purge_client_metadata'), '-[^/]*$', '-*'));
----
0

# The previous metadata files are not: Glue's empty metadata-log leaves the purge no way to find them, so they
# stay behind as orphans (and accumulate under this prefix across runs). Reported to the Glue Iceberg REST endpoint.
query I
SELECT count(*) >= getvariable('purge_client_previous_metadata') FROM glob('s3://duckdblabs-glue-iceberg-database-on-s3-bucket/duckdb-iceberg-purge-test/duckdb_purge_client/metadata/*.metadata.json');
----
true

#===--------------------------------------------------------------------===#
# The ENDPOINT_TYPE 'GLUE' default is PURGE_MODE 'server', which Glue accepts for S3 Tables but rejects for Glue
# tables; the table and its files survive the refused drop
#===--------------------------------------------------------------------===#

statement ok
ATTACH '840140254803' AS glue_server (
    TYPE ICEBERG,
    ENDPOINT_TYPE 'GLUE',
    ACCESS_DELEGATION_MODE 'none',
    EXTRA_HTTP_HEADERS MAP {'X-Iceberg-Access-Delegation': 'none'}
);

statement ok
CREATE TABLE glue_server.simple_glue_database.duckdb_purge_server (a INTEGER)
WITH ('location' = 's3://duckdblabs-glue-iceberg-database-on-s3-bucket/duckdb-iceberg-purge-test/duckdb_purge_server/');

statement ok
INSERT INTO glue_server.simple_glue_database.duckdb_purge_server SELECT range FROM range(10);

statement error
DROP TABLE glue_server.simple_glue_database.duckdb_purge_server;
----
<REGEX>:.*PurgeRequested cannot be true.*

query I
SELECT count(*) FROM glue_server.simple_glue_database.duckdb_purge_server;
----
10

query I
SELECT count(*) FROM glob('s3://duckdblabs-glue-iceberg-database-on-s3-bucket/duckdb-iceberg-purge-test/duckdb_purge_server/data/*.parquet');
----
1

# Clean up through the client-side purge
statement ok
DROP TABLE glue_client.simple_glue_database.duckdb_purge_server;

query I
SELECT count(*) FROM glob('s3://duckdblabs-glue-iceberg-database-on-s3-bucket/duckdb-iceberg-purge-test/duckdb_purge_server/**/*.parquet');
----
0

query I
SELECT count(*) FROM glob('s3://duckdblabs-glue-iceberg-database-on-s3-bucket/duckdb-iceberg-purge-test/duckdb_purge_server/**/*.avro');
----
0
