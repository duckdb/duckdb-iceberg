# name: test/sql/copy/copy_table_metadata.test
# description: COPY ... (FORMAT ICEBERG) sets sequence numbers, writes fully qualified paths and honors format-version
# group: [copy]

include test/sql/init_requires

require json

statement ok
COPY (SELECT range::INTEGER AS id, 'v' || range AS s FROM range(3)) TO '{TEST_DIR}/copy_meta' (FORMAT ICEBERG);

statement ok
set variable metadata_json = (
	select content::JSON from read_text('{TEST_DIR}/copy_meta/metadata/*.metadata.json')
);

# Every DuckDB-created table explicitly enables shredding, even without VARIANT columns.
query I
SELECT getvariable('metadata_json')->'properties'->>'write.parquet.shred-variants';
----
true

# v2 requires last-sequence-number, and the first snapshot of a table gets sequence number 1
query IIII
SELECT
	getvariable('metadata_json')->>'format-version',
	getvariable('metadata_json')->>'last-sequence-number',
	getvariable('metadata_json')->'snapshots'->0->>'sequence-number',
	json_array_length(getvariable('metadata_json')->'snapshots')
----
2	1	1	1

# The target is relative to the working directory: the location becomes an absolute file:// URI
statement ok
set variable location = getvariable('metadata_json')->>'location';

query I
SELECT getvariable('location') LIKE 'file:///%/copy_meta'
----
true

# ... and every path in the metadata is built from it
statement ok
set variable manifest_list = getvariable('metadata_json')->'snapshots'->0->>'manifest-list';

query I
SELECT starts_with(getvariable('manifest_list'), getvariable('location') || '/metadata/')
----
true

query IIIII
SELECT
	starts_with(manifest_path, getvariable('location') || '/metadata/'),
	content,
	sequence_number,
	min_sequence_number,
	added_snapshot_id = (getvariable('metadata_json')->'snapshots'->0->>'snapshot-id')::BIGINT
FROM read_avro(getvariable('manifest_list'))
----
true	0	1	1	true

statement ok
set variable manifest_file = (
	select manifest_path from read_avro(getvariable('manifest_list'))
);

# The descriptor must contain the final Avro length, including its container metadata.
query I
SELECT manifest_length = (
	SELECT octet_length(content) FROM read_blob(getvariable('manifest_file'))
)
FROM read_avro(getvariable('manifest_list'));
----
true

# data files inherit the sequence number of their manifest
query III
SELECT starts_with(data_file.file_path, getvariable('location') || '/data/'), sequence_number, file_sequence_number
FROM read_avro(getvariable('manifest_file'))
----
true	NULL	NULL

query II
SELECT id, s FROM iceberg_scan('{TEST_DIR}/copy_meta') ORDER BY id
----
0	v0
1	v1
2	v2

# the table can also be read through its location
query I
SELECT count(*) FROM iceberg_scan(getvariable('location'))
----
3

# A table without rows has no snapshot, so no sequence number has been assigned yet
statement ok
COPY (SELECT 1 AS x WHERE false) TO '{TEST_DIR}/copy_meta_empty' (FORMAT ICEBERG);

query II
SELECT content::JSON->>'last-sequence-number', json_array_length(content::JSON->'snapshots')
FROM read_text('{TEST_DIR}/copy_meta_empty/metadata/*.metadata.json')
----
0	0

# "format-version" selects the version of the new table, and is not stored as a table property
statement ok
COPY (SELECT range::INTEGER AS id FROM range(3)) TO '{TEST_DIR}/copy_meta_v3' (FORMAT ICEBERG, "format-version" 3);

statement ok
set variable v3_json = (
	select content::JSON from read_text('{TEST_DIR}/copy_meta_v3/metadata/*.metadata.json')
);

# v3 also requires next-row-id, and the snapshot records the row ids it assigned
query IIIIII
SELECT
	getvariable('v3_json')->>'format-version',
	getvariable('v3_json')->>'last-sequence-number',
	getvariable('v3_json')->>'next-row-id',
	getvariable('v3_json')->'snapshots'->0->>'first-row-id',
	getvariable('v3_json')->'snapshots'->0->>'added-rows',
	getvariable('v3_json')->'properties'->>'format-version'
----
3	1	3	0	3	NULL

query IIII
SELECT first_row_id, added_rows_count, sequence_number,
       added_snapshot_id = (getvariable('v3_json')->'snapshots'->0->>'snapshot-id')::BIGINT
FROM read_avro(getvariable('v3_json')->'snapshots'->0->>'manifest-list');
----
0	3	1	true

query I
SELECT id FROM iceberg_scan('{TEST_DIR}/copy_meta_v3') ORDER BY id
----
0
1
2

# Versions that COPY can't write are rejected instead of silently writing a v2 table
statement error
COPY (SELECT 1 AS id) TO '{TEST_DIR}/copy_meta_v1' (FORMAT ICEBERG, "format-version" 1);
----
Writing Iceberg tables with format-version 1 is not supported

statement error
COPY (SELECT 1 AS id) TO '{TEST_DIR}/copy_meta_v4' (FORMAT ICEBERG, "format-version" 4);
----
"format-version" must be 2 or 3, got 4

statement error
COPY (SELECT 1 AS id) TO '{TEST_DIR}/copy_meta_vx' (FORMAT ICEBERG, "format-version" 'two');
----
Can't cast COPY option "format-version"

# types added in v3 need a v3 table
statement error
COPY (SELECT '2024-01-01 00:00:00'::TIMESTAMP_NS AS ts) TO '{TEST_DIR}/copy_meta_ns_v2' (FORMAT ICEBERG);
----
<REGEX>:.*Column 'ts' of type TIMESTAMP_NS requires Iceberg format-version 3, the table uses 2.*

statement ok
COPY (SELECT '2024-01-01 00:00:00'::TIMESTAMP_NS AS ts) TO '{TEST_DIR}/copy_meta_ns_v3' (FORMAT ICEBERG, "format-version" 3);
