# name: test/sql/local/mapping_failure_variations.test
# group: [local]

require avro

require parquet

require iceberg

require httpfs

# struct_to_list

statement error
SELECT payload FROM iceberg_scan('{WORKING_DIRECTORY}/data/persistent/mapping_failures/struct_to_list', version='1')
----
Binder Error: Failed to map file-column of type 'STRUCT("value" VARCHAR)' to result-column of type 'VARCHAR[]'

statement error
SELECT * FROM iceberg_scan('{WORKING_DIRECTORY}/data/persistent/mapping_failures/struct_to_list', version='1')
----
Binder Error: Failed to map file-column of type 'STRUCT("value" VARCHAR)' to result-column of type 'VARCHAR[]'

statement error
SELECT id FROM iceberg_scan('{WORKING_DIRECTORY}/data/persistent/mapping_failures/struct_to_list', version='1') WHERE payload IS NOT NULL
----
Binder Error: Failed to map file-column of type 'STRUCT("value" VARCHAR)' to result-column of type 'VARCHAR[]'

query I
SELECT id FROM iceberg_scan('{WORKING_DIRECTORY}/data/persistent/mapping_failures/struct_to_list', version='1') ORDER BY id
----
1
2

