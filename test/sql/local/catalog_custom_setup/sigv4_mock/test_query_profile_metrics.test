# name: test/sql/local/catalog_custom_setup/sigv4_mock/test_query_profile_metrics.test
# description: The query profile counts the requests that are signed with SigV4
# group: [sigv4_mock]

# Requires: python3 scripts/sigv4_mock_server.py 19130
require-env SIGV4_MOCK_SERVER_AVAILABLE

include test/sql/init_requires

require aws

require json

set ignore_error_messages

statement ok
CREATE SECRET sigv4_profile_secret (
    TYPE S3,
    KEY_ID 'test_key_id',
    SECRET 'test_secret_key',
    REGION 'us-east-1'
);

statement ok
attach 'test_warehouse' as sigv4_profile_catalog (
    type ICEBERG,
    URI 'http://127.0.0.1:19130',
    AUTHORIZATION_TYPE 'sigv4',
    SIGV4_REGION 'us-east-1',
    SIGV4_SERVICE 'execute-api'
);

statement ok
PRAGMA enable_profiling = 'json';

statement ok
PRAGMA profiling_output = '{TEST_DIR}/sigv4_profile.json';

# Listing the schemas of the catalog asks the mock for its namespaces
query I
SELECT count(*) >= 0 FROM duckdb_schemas() WHERE database_name = 'sigv4_profile_catalog';
----
true

statement ok
PRAGMA disable_profiling;

query II
SELECT iceberg.rest_requests > 0, iceberg.rest_request_time > 0 FROM read_json('{TEST_DIR}/sigv4_profile.json');
----
true	true

statement ok
detach sigv4_profile_catalog;

statement ok
drop secret sigv4_profile_secret;
