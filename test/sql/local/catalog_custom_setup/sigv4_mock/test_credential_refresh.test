# name: test/sql/local/catalog_custom_setup/sigv4_mock/test_credential_refresh.test
# description: SigV4 catalog secret is refreshed when stale, and the refreshed credential is used for signing
# group: [sigv4_mock]

# Requires: python3 scripts/sigv4_mock_server.py 19130
require-env SIGV4_MOCK_SERVER_AVAILABLE

# Path of the AWS credentials file that AWS_CONFIG_FILE/AWS_SHARED_CREDENTIALS_FILE
# point at. The test rewrites this file to rotate the credential, which is what a
# refresh has to pick up. See .github/workflows/test-sigv4-mock-catalog.yml.
require-env AWS_CREDENTIALS_REFRESH_FILE

require avro

require parquet

require iceberg

require httpfs

require aws

require json

set ignore_error_messages

# The `config` chain reads the credentials file, so rotation needs no network and no
# STS mock. REFRESH 'auto' is what makes the aws extension store refresh_info, which
# is the input MaybeRefreshSecret replays to obtain a new credential. (In production
# the chain is web_identity, which sets refresh automatically; MaybeRefreshSecret is
# chain-agnostic, so the config chain exercises the same code path deterministically.)
statement ok
COPY (SELECT * FROM (VALUES ('[default]'), ('aws_access_key_id = REFRESHKEY1'), ('aws_secret_access_key = refreshsecret1')) t(line))
TO '{AWS_CREDENTIALS_REFRESH_FILE}' (FORMAT csv, HEADER false, QUOTE '');

statement ok
CREATE SECRET sigv4_refresh_secret (
    TYPE S3,
    PROVIDER credential_chain,
    CHAIN 'config',
    REFRESH 'auto',
    REGION 'us-east-1'
);

statement ok
ATTACH 'test_warehouse' AS refresh_catalog (
    TYPE ICEBERG,
    URI 'http://127.0.0.1:19130',
    AUTHORIZATION_TYPE 'sigv4',
    SIGV4_REGION 'us-east-1',
    SIGV4_SERVICE 'execute-api'
);

statement ok
SHOW ALL TABLES;

# The catalog signs with the credential the secret was created from.
query I
SELECT r->>'key_id' = 'REFRESHKEY1' FROM read_json('http://127.0.0.1:19130/last_signing_key') r;
----
true

# Rotate the credential on disk. Nothing has refreshed yet, so this must not change
# what the catalog signs with.
statement ok
COPY (SELECT * FROM (VALUES ('[default]'), ('aws_access_key_id = REFRESHKEY2'), ('aws_secret_access_key = refreshsecret2')) t(line))
TO '{AWS_CREDENTIALS_REFRESH_FILE}' (FORMAT csv, HEADER false, QUOTE '');

statement ok
SHOW ALL TABLES;

statement ok
SHOW ALL TABLES;

# Still the old key: the secret was created moments ago, so the refresh interval has
# not elapsed and MaybeRefreshSecret must leave it alone. This is what makes a
# redundant refresh (last_refresh_time left at the clock epoch) observable, and it
# is what keeps every catalog request from triggering a credential fetch.
query I
SELECT r->>'key_id' = 'REFRESHKEY1' FROM read_json('http://127.0.0.1:19130/last_signing_key') r;
----
true

# Now mark the credential stale, using the same hook OAuth2 uses. The next catalog
# request must refresh, replaying refresh_info -> re-reading the credentials file.
statement ok
SET iceberg_test_force_token_expiry=true;

statement ok
SHOW ALL TABLES;

# The refreshed credential is what actually signs the request. This is the assertion
# the whole test exists for: it fails both if the refresh never fires and if the
# refresh happens but the new secret is not picked up by the signer.
query I
SELECT r->>'key_id' = 'REFRESHKEY2' FROM read_json('http://127.0.0.1:19130/last_signing_key') r;
----
true

# Clear the hook, rotate once more, and confirm the interval gates again: the refresh
# reset the timer, so the third credential must NOT be picked up.
statement ok
SET iceberg_test_force_token_expiry=false;

statement ok
COPY (SELECT * FROM (VALUES ('[default]'), ('aws_access_key_id = REFRESHKEY3'), ('aws_secret_access_key = refreshsecret3')) t(line))
TO '{AWS_CREDENTIALS_REFRESH_FILE}' (FORMAT csv, HEADER false, QUOTE '');

statement ok
SHOW ALL TABLES;

statement ok
SHOW ALL TABLES;

query I
SELECT r->>'key_id' = 'REFRESHKEY2' FROM read_json('http://127.0.0.1:19130/last_signing_key') r;
----
true

statement ok
DETACH refresh_catalog;

statement ok
DROP SECRET sigv4_refresh_secret;
