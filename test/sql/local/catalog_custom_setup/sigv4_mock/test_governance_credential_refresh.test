# name: test/sql/local/catalog_custom_setup/sigv4_mock/test_governance_credential_refresh.test
# description: test that the registered table loader is given the catalog's refreshed credentials
# group: [sigv4_mock]

# Requires: python3 scripts/sigv4_mock_server.py 19130
require-env SIGV4_MOCK_SERVER_AVAILABLE

# See test_credential_refresh.test
require-env AWS_CREDENTIALS_REFRESH_FILE

include test/sql/init_requires

require aws

require iceberg_test_table_loader

statement ok
COPY (SELECT * FROM (VALUES ('[default]'), ('aws_access_key_id = REFRESHKEY1'), ('aws_secret_access_key = refreshsecret1')) t(line))
TO '{AWS_CREDENTIALS_REFRESH_FILE}' (FORMAT csv, HEADER false, QUOTE '');

statement ok
CREATE SECRET sigv4_refresh_secret (
    TYPE S3,
    PROVIDER credential_chain,
    CHAIN 'config',
    REFRESH 'auto',
    REGION 'us-east-1'
);

statement ok
ATTACH ':' AS gov (
    TYPE ICEBERG,
    ENDPOINT_TYPE 'GLUE',
    URI 'http://127.0.0.1:19130',
    SECRET 'sigv4_refresh_secret',
    GOVERNANCE true
);

statement ok
SET iceberg_test_table_loader_metadata_location = '{WORKING_DIRECTORY}/data/persistent/partition_integer/metadata/v1.metadata.json';

statement ok
COPY (SELECT * FROM (VALUES ('[default]'), ('aws_access_key_id = REFRESHKEY2'), ('aws_secret_access_key = refreshsecret2')) t(line))
TO '{AWS_CREDENTIALS_REFRESH_FILE}' (FORMAT csv, HEADER false, QUOTE '');

statement ok
SET iceberg_test_force_token_expiry=true;

# A lookup makes no REST call, so the loader request itself refreshes the stale credentials
query I
SELECT count(*) FROM gov.governed_db.refreshed_table;
----
0

query TT
SELECT key_id, session_token FROM iceberg_test_table_loader_requests();
----
REFRESHKEY2	(empty)
