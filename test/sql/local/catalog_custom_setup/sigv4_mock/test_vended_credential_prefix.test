# name: test/sql/local/catalog_custom_setup/sigv4_mock/test_vended_credential_prefix.test
# description: Preserve vended storage credential prefixes, including nested and aliased scopes
# group: [sigv4_mock]

# Requires: python3 scripts/sigv4_mock_server.py 19130
require-env SIGV4_MOCK_SERVER_AVAILABLE

include test/sql/init_requires

set ignore_error_messages

statement ok
SET redact_http_logs=true;

statement ok
CALL enable_logging(level='debug', storage='memory');

# The catalog credential must not hide a missing storage credential.
statement ok
CREATE SECRET scope_catalog_secret (
    TYPE S3,
    KEY_ID 'catalog_key',
    SECRET 'catalog_secret',
    REGION 'us-east-1',
    SCOPE 'http://127.0.0.1:19130'
);

statement ok
ATTACH 'scope_tests' AS scope_catalog (
    TYPE ICEBERG,
    URI 'http://127.0.0.1:19130/credential-scopes',
    AUTHORIZATION_TYPE 'sigv4',
    SECRET 'scope_catalog_secret',
    SIGV4_REGION 'us-east-1',
    SIGV4_SERVICE 'execute-api'
);

# Keep the transaction open so its vended secrets remain visible.
# Data can be a sibling of the table location, covered by the catalog's prefix.
statement ok
BEGIN;

query I
SELECT count(*) FROM scope_catalog.default.single_prefix;
----
0

query I
SELECT scope = ['s3://scope-bucket/table/'] FROM duckdb_secrets()
WHERE name = (SELECT name FROM which_secret('s3://scope-bucket/table/1/part.parquet', 's3'));
----
true

query I
SELECT count(*) FROM duckdb_logs l, duckdb_secrets() s
WHERE s.storage = 'transaction'
  AND starts_with(l.message, 'Iceberg table ')
  AND contains(l.message, s.name);
----
0

statement ok
COMMIT;

# A singleton credential can also be narrower than the table location.
statement ok
BEGIN;

statement ok
SELECT * FROM scope_catalog.default.single_nested;

query I
SELECT scope = ['s3://scope-bucket/table/metadata/'] FROM duckdb_secrets() WHERE storage = 'transaction';
----
true

query I
SELECT count(*) FROM which_secret('s3://scope-bucket/table/data/part.parquet', 's3');
----
0

statement ok
COMMIT;

# Nested credentials must not both become eligible for data files.
statement ok
BEGIN;

statement ok
SELECT * FROM scope_catalog.default.nested;

query I
SELECT scope = ['s3://scope-bucket/table/'] FROM duckdb_secrets()
WHERE name = (SELECT name FROM which_secret('s3://scope-bucket/table/data/part.parquet', 's3'));
----
true

query I
SELECT scope = ['s3://scope-bucket/table/metadata/'] FROM duckdb_secrets()
WHERE name = (SELECT name FROM which_secret('s3://scope-bucket/table/metadata/manifest.avro', 's3'));
----
true

statement ok
COMMIT;

# Scheme aliases preserve the bucket and path of the credential.
statement ok
BEGIN;

statement ok
SELECT * FROM scope_catalog.default.alias;

query I
SELECT scope = ['s3://scope-bucket/table/metadata/', 's3a://scope-bucket/table/metadata/'] FROM duckdb_secrets()
WHERE name = (SELECT name FROM which_secret('s3a://scope-bucket/table/metadata/manifest.avro', 's3'));
----
true

query I
SELECT count(*) FROM which_secret('s3a://scope-bucket/table/data/part.parquet', 's3');
----
0

query I
SELECT count(*) FROM which_secret('s3a://other-bucket/table/metadata/manifest.avro', 's3');
----
0

statement ok
COMMIT;

# A non-matching bucket is not a reason to widen a credential to the table.
statement ok
BEGIN;

statement ok
SELECT * FROM scope_catalog.default.different_bucket;

query I
SELECT scope = ['s3://other-bucket/table/'] FROM duckdb_secrets() WHERE storage = 'transaction';
----
true

query I
SELECT count(*) FROM which_secret('s3://scope-bucket/table/data/part.parquet', 's3');
----
0

statement ok
COMMIT;

# Retain the legacy R2 singleton "/" fallback.
statement ok
BEGIN;

statement ok
SELECT * FROM scope_catalog.default.slash;

query I
SELECT scope = ['s3://scope-bucket/table/'] FROM duckdb_secrets()
WHERE name = (SELECT name FROM which_secret('s3://scope-bucket/table/data/part.parquet', 's3'));
----
true

statement ok
COMMIT;

# Bare schemes remain the least specific credentials for that scheme.
statement ok
BEGIN;

statement ok
SELECT * FROM scope_catalog.default.bare_scheme;

query I
SELECT scope = ['s3://'] FROM duckdb_secrets() WHERE storage = 'transaction';
----
true

statement ok
COMMIT;

# Ignore credentials for other storage types.
statement ok
BEGIN;

statement ok
SELECT * FROM scope_catalog.default.mixed_types;

query I
SELECT scope = ['s3://scope-bucket/table/'] FROM duckdb_secrets() WHERE storage = 'transaction';
----
true

statement ok
COMMIT;

query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE log_level = 'INFO'
  AND message LIKE 'Iceberg table %legacy R2 compatibility';
----
true

# Redaction hides table/secret identities and storage paths, but keeps decision reasons.
query I
SELECT count(*) FROM duckdb_logs
WHERE starts_with(message, 'Iceberg table ')
  AND (contains(message, 'scope_catalog') OR contains(message, 'scope-bucket') OR contains(message, 'other-bucket'));
----
0

query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE log_level = 'DEBUG'
  AND starts_with(message, 'Iceberg table ')
  AND contains(message, 'adding scheme-alias scope');
----
true

# The explicit opt-out restores the context needed to diagnose scope mismatches.
statement ok
SET redact_http_logs=false;

# Reload the catalog so credential decisions run again instead of using cached empty tables.
statement ok
DETACH scope_catalog;

statement ok
ATTACH 'scope_tests' AS scope_catalog (
    TYPE ICEBERG,
    URI 'http://127.0.0.1:19130/credential-scopes',
    AUTHORIZATION_TYPE 'sigv4',
    SECRET 'scope_catalog_secret',
    SIGV4_REGION 'us-east-1',
    SIGV4_SERVICE 'execute-api'
);

statement ok
SELECT * FROM scope_catalog.default.alias;

query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE log_level = 'DEBUG'
  AND starts_with(message, 'Iceberg table ')
  AND contains(message, 'scope_catalog')
  AND contains(message, 'alias')
  AND contains(message, 's3a://scope-bucket/table/metadata/');
----
true

# Credential values are never included in these diagnostics, even without redaction.
query I
SELECT count(*) FROM duckdb_logs
WHERE starts_with(message, 'Iceberg table ')
  AND (contains(message, 'scope_key_') OR contains(message, 'scope_secret') OR contains(message, 'catalog_secret'));
----
0

statement ok
CALL disable_logging();

statement ok
DETACH scope_catalog;

statement ok
DROP SECRET scope_catalog_secret;
