# name: test/sql/local/catalog_custom_setup/polaris/table_resolution.test
# description: test the TABLE_RESOLUTION attach option against Polaris
# group: [polaris]

require-env POLARIS_SERVER_AVAILABLE

require avro

require parquet

require iceberg

require httpfs

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
set enable_logging=true

statement ok
set logging_level='debug';

statement ok
CREATE SECRET polaris_secret (
    TYPE ICEBERG,
    CLIENT_ID 'root',
    CLIENT_SECRET 's3cr3t',
    URI 'http://0.0.0.0:8181/api/catalog'
);

statement error
ATTACH 'quickstart_catalog' AS bad_resolution (
    TYPE ICEBERG,
    URI 'http://0.0.0.0:8181/api/catalog',
    DEFAULT_REGION 'us-west-2',
    TABLE_RESOLUTION 'sometimes'
);
----
<REGEX>:.*Unrecognized 'table_resolution' \(sometimes\), accepted options are: lazy, eager.*

# ---------------------------------------------------------------------------
# setup: this test creates the tables it needs, so it does not depend on
# generated data. They live in their own namespace and are named with a 'tr_'
# prefix, so every request assertion below can be scoped to them and stays
# independent of whatever else the catalog holds.
# ---------------------------------------------------------------------------

statement ok
ATTACH 'quickstart_catalog' AS my_datalake (
    TYPE ICEBERG,
    URI 'http://0.0.0.0:8181/api/catalog',
    DEFAULT_REGION 'us-west-2'
);

statement ok
DROP TABLE IF EXISTS my_datalake.table_resolution.tr_alpha;

statement ok
DROP TABLE IF EXISTS my_datalake.table_resolution.tr_beta;

statement ok
DROP TABLE IF EXISTS my_datalake.table_resolution.tr_gamma;

statement ok
DROP SCHEMA IF EXISTS my_datalake.table_resolution;

statement ok
CREATE SCHEMA my_datalake.table_resolution;

statement ok
CREATE TABLE my_datalake.table_resolution.tr_alpha (id BIGINT, name VARCHAR);

statement ok
CREATE TABLE my_datalake.table_resolution.tr_beta (a INTEGER, b DOUBLE, c BOOLEAN);

statement ok
CREATE TABLE my_datalake.table_resolution.tr_gamma (x VARCHAR);

statement ok
INSERT INTO my_datalake.table_resolution.tr_alpha SELECT range, 'v' || range::VARCHAR FROM range(10);

statement ok
DETACH my_datalake;

# ---------------------------------------------------------------------------
# lazy (the default): listing a schema never loads its tables
# ---------------------------------------------------------------------------

statement ok
ATTACH 'quickstart_catalog' AS my_datalake (
    TYPE ICEBERG,
    URI 'http://0.0.0.0:8181/api/catalog',
    DEFAULT_REGION 'us-west-2'
);

statement ok
CALL enable_logging('HTTP');

# drop the requests the setup above made, so the counts below only cover the listing
statement ok
CALL truncate_duckdb_logs();

# the tables are listed, but with no columns resolved they only carry the placeholder
query II
SELECT table_name, column_name FROM information_schema.columns
WHERE table_catalog = 'my_datalake' AND table_schema = 'table_resolution'
ORDER BY table_name;
----
tr_alpha	__
tr_beta	__
tr_gamma	__

# the namespaces were listed, but no table metadata was requested at all
query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%/tables/%';
----
0

query I
SELECT count(*) > 0 FROM duckdb_logs_parsed('HTTP')
WHERE request.url LIKE '%/namespaces/table_resolution/tables';
----
1

statement ok
DETACH my_datalake;

statement ok
CALL truncate_duckdb_logs();

# ---------------------------------------------------------------------------
# eager: listing a schema resolves the columns of every table it lists
# ---------------------------------------------------------------------------

statement ok
ATTACH 'quickstart_catalog' AS my_datalake (
    TYPE ICEBERG,
    URI 'http://0.0.0.0:8181/api/catalog',
    DEFAULT_REGION 'us-west-2',
    TABLE_RESOLUTION 'eager'
);

statement ok
CALL enable_logging('HTTP');

# the real columns are reported, not the '__' placeholder
query III
SELECT table_name, column_name, data_type FROM information_schema.columns
WHERE table_catalog = 'my_datalake' AND table_schema = 'table_resolution'
ORDER BY table_name, ordinal_position;
----
tr_alpha	id	BIGINT
tr_alpha	name	VARCHAR
tr_beta	a	INTEGER
tr_beta	b	DOUBLE
tr_beta	c	BOOLEAN
tr_gamma	x	VARCHAR

# each of the three tables was loaded exactly once
query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%/tables/tr_%';
----
3

statement ok
CALL truncate_duckdb_logs();

# a listing load is not cached as if it were a complete one: actually reading the table still
# issues a full LoadTable request, with credential vending and the complete snapshot log
query I
SELECT count(*) FROM my_datalake.table_resolution.tr_alpha;
----
10

query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP')
WHERE request.url LIKE '%/namespaces/table_resolution/tables/tr_alpha'
  AND contains(map_keys(request.headers), 'X-Iceberg-Access-Delegation');
----
1

# ---------------------------------------------------------------------------
# eager: a table is resolved once per transaction, however many listings run
# ---------------------------------------------------------------------------

# re-attach so that nothing has been resolved yet
statement ok
DETACH my_datalake;

statement ok
ATTACH 'quickstart_catalog' AS my_datalake (
    TYPE ICEBERG,
    URI 'http://0.0.0.0:8181/api/catalog',
    DEFAULT_REGION 'us-west-2',
    TABLE_RESOLUTION 'eager'
);

statement ok
CALL truncate_duckdb_logs();

statement ok
BEGIN;

statement ok
SELECT * FROM information_schema.columns WHERE table_catalog = 'my_datalake';

# SHOW ALL TABLES scans every schema twice more (duckdb_tables joined with duckdb_columns)
statement ok
SELECT count(*) FROM (SHOW ALL TABLES);

statement ok
COMMIT;

query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%/tables/tr_%';
----
3

# ---------------------------------------------------------------------------
# cleanup
# ---------------------------------------------------------------------------

statement ok
DROP TABLE my_datalake.table_resolution.tr_alpha;

statement ok
DROP TABLE my_datalake.table_resolution.tr_beta;

statement ok
DROP TABLE my_datalake.table_resolution.tr_gamma;

statement ok
DROP SCHEMA my_datalake.table_resolution;

statement ok
DETACH my_datalake;

statement ok
DROP SECRET polaris_secret;
