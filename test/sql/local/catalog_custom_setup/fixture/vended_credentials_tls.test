# name: test/sql/local/catalog_custom_setup/fixture/vended_credentials_tls.test
# description: vended S3 path-style access doesn't turn off TLS; the scheme of the vended endpoint decides it
# group: [fixture]

require-env FIXTURE_SERVER_AVAILABLE

require-env VENDED_CREDENTIAL_REFRESH_PROXY

include test/sql/init_requires

# Do not ignore 'HTTP' error messages.
set ignore_error_messages

statement ok
SET enable_logging=true

statement ok
SET logging_level='debug'

statement ok
CALL enable_logging('HTTP')

statement ok
CREATE SECRET vended_tls_http_proxy (
    TYPE HTTP,
    HTTP_PROXY '{VENDED_CREDENTIAL_REFRESH_PROXY}'
)

statement ok
ATTACH '' AS vended_tls (
    TYPE ICEBERG,
    URI 'http://127.0.0.1:8181',
    AUTHORIZATION_TYPE 'oauth2',
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    OAUTH2_SERVER_URI 'http://127.0.0.1:8181/v1/oauth/tokens'
)

statement ok
CREATE SCHEMA IF NOT EXISTS vended_tls.default

# The proxy vends a different S3 endpoint and path-style setting for each of these tables
statement ok
DROP TABLE IF EXISTS vended_tls.default.vended_tls_path_style_no_endpoint

statement ok
DROP TABLE IF EXISTS vended_tls.default.vended_tls_path_style_no_scheme

statement ok
DROP TABLE IF EXISTS vended_tls.default.vended_tls_path_style_https_endpoint

statement ok
DROP TABLE IF EXISTS vended_tls.default.vended_tls_path_style_http_endpoint

statement ok
DROP TABLE IF EXISTS vended_tls.default.vended_tls_http_endpoint

statement ok
CREATE TABLE vended_tls.default.vended_tls_path_style_no_endpoint (id INTEGER)

statement ok
CREATE TABLE vended_tls.default.vended_tls_path_style_no_scheme (id INTEGER)

statement ok
CREATE TABLE vended_tls.default.vended_tls_path_style_https_endpoint (id INTEGER)

statement ok
CREATE TABLE vended_tls.default.vended_tls_path_style_http_endpoint (id INTEGER)

statement ok
CREATE TABLE vended_tls.default.vended_tls_http_endpoint (id INTEGER)

# Attach again, so the tables are loaded through the proxy and get its S3 config
statement ok
DETACH vended_tls

statement ok
ATTACH '' AS vended_tls (
    TYPE ICEBERG,
    URI 'http://127.0.0.1:8181',
    AUTHORIZATION_TYPE 'oauth2',
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    OAUTH2_SERVER_URI 'http://127.0.0.1:8181/v1/oauth/tokens'
)

# The secrets created from the vended config. The tables are empty, so binding them makes no S3 request.
statement ok
BEGIN

statement ok
EXPLAIN SELECT * FROM vended_tls.default.vended_tls_path_style_no_endpoint

statement ok
EXPLAIN SELECT * FROM vended_tls.default.vended_tls_path_style_no_scheme

statement ok
EXPLAIN SELECT * FROM vended_tls.default.vended_tls_path_style_https_endpoint

statement ok
EXPLAIN SELECT * FROM vended_tls.default.vended_tls_path_style_http_endpoint

statement ok
EXPLAIN SELECT * FROM vended_tls.default.vended_tls_http_endpoint

# Path-style access only sets url_style. use_ssl follows the scheme of the vended endpoint: http:// turns TLS
# off and https:// turns it on. Without an endpoint, or without a scheme, use_ssl isn't set, so the s3_use_ssl
# setting applies (true by default).
query IIII
SELECT DISTINCT regexp_extract(scope[1], 'vended_tls_[a-z_]+') AS table_name,
       regexp_extract(secret_string, '(^|;)url_style=([^;]*)', 2) AS url_style,
       regexp_extract(secret_string, '(^|;)use_ssl=([^;]*)', 2) AS use_ssl,
       regexp_extract(secret_string, '(^|;)endpoint=([^;]*)', 2) AS endpoint
FROM duckdb_secrets()
WHERE scope[1] LIKE '%/vended_tls_%'
ORDER BY table_name
----
vended_tls_http_endpoint	(empty)	false	127.0.0.1:9000
vended_tls_path_style_http_endpoint	path	false	127.0.0.1:9000
vended_tls_path_style_https_endpoint	path	true	127.0.0.1:9443
vended_tls_path_style_no_endpoint	path	(empty)	(empty)
vended_tls_path_style_no_scheme	path	(empty)	127.0.0.1:9000

statement ok
COMMIT

# A path-style table with an http:// endpoint is still written and read over plain HTTP
statement ok
INSERT INTO vended_tls.default.vended_tls_path_style_http_endpoint VALUES (1), (2), (3)

statement ok
CALL truncate_duckdb_logs()

query I
SELECT count(*) FROM vended_tls.default.vended_tls_path_style_http_endpoint
----
3

query I
SELECT count(*) > 0
FROM duckdb_logs_parsed('HTTP')
WHERE starts_with(request.url, 'http://127.0.0.1:9000/warehouse/')
  AND request.headers['Authorization'] LIKE '%TLS_KEY%'
  AND response.status IN ('OK_200', 'PartialContent_206')
----
1
