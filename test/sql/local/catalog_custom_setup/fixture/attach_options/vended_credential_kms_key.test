# name: test/sql/local/catalog_custom_setup/fixture/attach_options/vended_credential_kms_key.test
# description: the vended credential secret keeps the KMS key of the user's S3 secret for the table location
# group: [attach_options]

require-env FIXTURE_SERVER_AVAILABLE

include test/sql/init_requires

require aws

statement ok
CREATE SECRET (
    TYPE S3,
    KEY_ID 'admin',
    SECRET 'password',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL 0,
    REGION 'us-east-1'
);

statement ok
ATTACH '' AS sigv4_lake (
    TYPE ICEBERG,
    URI 'http://127.0.0.1:8181',
    AUTHORIZATION_TYPE 'sigv4',
    SIGV4_SERVICE 'custom',
    SIGV4_REGION 'us-east-1'
);

statement ok
create schema if not exists sigv4_lake.default;

statement ok
drop table if exists sigv4_lake.default.test_vended_credential_kms_key;

statement ok
create table sigv4_lake.default.test_vended_credential_kms_key as select 1 as id;

# A secret for the warehouse with a KMS key. The vended secret is scoped to the table, so it is the one used for the
# table's files, and it has to carry the same KMS key.
statement ok
CREATE SECRET user_kms (
    TYPE S3,
    KEY_ID 'admin',
    SECRET 'password',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL 0,
    REGION 'us-east-1',
    KMS_KEY_ID 'arn:aws:kms:us-east-1:000000000000:key/duckdb-test-key',
    SCOPE 's3://warehouse/'
);

statement ok
begin;

query I
select count(*) from sigv4_lake.default.test_vended_credential_kms_key;
----
1

query I
select count(*) > 0
from duckdb_secrets()
where storage = 'transaction';
----
1

query I
select count(*)
from duckdb_secrets()
where storage = 'transaction'
  and secret_string not like '%kms_key_id=arn:aws:kms:us-east-1:000000000000:key/duckdb-test-key%';
----
0

statement ok
commit;

# The key goes out as the SSE-KMS headers of the request that writes a data file. The HTTP log redacts the key header
# by default. The fixture's object store has no KMS and fails the write; the request is logged all the same, and an
# HTTP error must not skip the test here.
set ignore_error_messages

statement ok
CALL enable_logging('HTTP');

statement ok
SET redact_http_logs = false;

statement maybe
insert into sigv4_lake.default.test_vended_credential_kms_key values (2);
----
test_vended_credential_kms_key/data/

query II
select distinct request.headers['x-amz-server-side-encryption'], request.headers['x-amz-server-side-encryption-aws-kms-key-id']
from duckdb_logs_parsed('HTTP')
where request.type = 'PUT' and request.url like '%/test_vended_credential_kms_key/data/%';
----
aws:kms	arn:aws:kms:us-east-1:000000000000:key/duckdb-test-key
