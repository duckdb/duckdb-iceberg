# name: test/sql/local/catalog_custom_setup/fixture/attach_options/vended_credential_kms_key.test
# description: the vended credential secret keeps the KMS key of the user's S3 secret for the table location
# group: [attach_options]

require-env FIXTURE_SERVER_AVAILABLE

include test/sql/init_requires

require aws

statement ok
CREATE SECRET (
    TYPE S3,
    KEY_ID 'admin',
    SECRET 'password',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL 0,
    REGION 'us-east-1'
);

statement ok
ATTACH '' AS sigv4_lake (
    TYPE ICEBERG,
    URI 'http://127.0.0.1:8181',
    AUTHORIZATION_TYPE 'sigv4',
    SIGV4_SERVICE 'custom',
    SIGV4_REGION 'us-east-1'
);

statement ok
create schema if not exists sigv4_lake.default;

statement ok
drop table if exists sigv4_lake.default.test_vended_credential_kms_key;

statement ok
create table sigv4_lake.default.test_vended_credential_kms_key as select 1 as id;

# A secret for the warehouse with a KMS key. The vended secret is scoped to the table, so it is the one used for the
# table's files, and it has to carry the same KMS key.
statement ok
CREATE SECRET user_kms (
    TYPE S3,
    KEY_ID 'admin',
    SECRET 'password',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL 0,
    REGION 'us-east-1',
    KMS_KEY_ID 'arn:aws:kms:us-east-1:000000000000:key/duckdb-test-key',
    SCOPE 's3://warehouse/'
);

statement ok
begin;

query I
select count(*) from sigv4_lake.default.test_vended_credential_kms_key;
----
1

query I
select count(*) > 0
from duckdb_secrets()
where storage = 'transaction';
----
1

query I
select count(*)
from duckdb_secrets()
where storage = 'transaction'
  and secret_string not like '%kms_key_id=arn:aws:kms:us-east-1:000000000000:key/duckdb-test-key%';
----
0

statement ok
commit;
