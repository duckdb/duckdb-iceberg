# name: test/sql/local/catalog_custom_setup/fixture/attach_options/table_resolution.test
# description: test lazy table metadata resolution
# group: [attach_options]

require-env FIXTURE_SERVER_AVAILABLE

require avro

require parquet

require iceberg

require httpfs

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
set enable_logging=true

statement ok
set logging_level='debug';

statement ok
CREATE SECRET (
    TYPE S3,
    KEY_ID 'admin',
    SECRET 'password',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL 0
);

# Create the tables needed by this test

statement ok
ATTACH '' AS my_datalake (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    URI 'http://127.0.0.1:8181'
);

statement ok
DROP TABLE IF EXISTS my_datalake.table_resolution.tr_alpha;

statement ok
DROP TABLE IF EXISTS my_datalake.table_resolution.tr_beta;

statement ok
DROP TABLE IF EXISTS my_datalake.table_resolution.tr_gamma;

statement ok
DROP SCHEMA IF EXISTS my_datalake.table_resolution;

statement ok
CREATE SCHEMA my_datalake.table_resolution;

statement ok
CREATE TABLE my_datalake.table_resolution.tr_alpha (id BIGINT, name VARCHAR);

statement ok
CREATE TABLE my_datalake.table_resolution.tr_beta (a INTEGER, b DOUBLE, c BOOLEAN);

statement ok
CREATE TABLE my_datalake.table_resolution.tr_gamma (x VARCHAR);

statement ok
INSERT INTO my_datalake.table_resolution.tr_alpha SELECT range, 'v' || range::VARCHAR FROM range(10);

statement ok
DETACH my_datalake;

# ---------------------------------------------------------------------------
# Column listings lazily resolve table metadata
# ---------------------------------------------------------------------------

statement ok
ATTACH '' AS my_datalake (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    URI 'http://127.0.0.1:8181'
);

statement ok
CALL enable_logging('HTTP');

# drop the requests the setup above made, so the counts below only cover the listing
statement ok
CALL truncate_duckdb_logs();

# Accessing columns resolves each listed table without an attach option
query II
SELECT table_name, column_name FROM information_schema.columns
WHERE table_catalog = 'my_datalake' AND table_schema = 'table_resolution'
ORDER BY table_name, ordinal_position;
----
tr_alpha	id
tr_alpha	name
tr_beta	a
tr_beta	b
tr_beta	c
tr_gamma	x

# Each test table was loaded once; unrelated catalog tables do not affect the count
query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%/namespaces/table_resolution/tables/tr_%';
----
3

query I
SELECT count(*) > 0 FROM duckdb_logs_parsed('HTTP')
WHERE request.url LIKE '%/namespaces/table_resolution/tables';
----
1

statement ok
DETACH my_datalake;

statement ok
CALL truncate_duckdb_logs();

# ---------------------------------------------------------------------------
# A fresh attachment reports real column names and types
# ---------------------------------------------------------------------------

statement ok
ATTACH '' AS my_datalake (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    URI 'http://127.0.0.1:8181'
);

statement ok
CALL enable_logging('HTTP');

# the real columns are reported, not the '__' placeholder
query III
SELECT table_name, column_name, data_type FROM information_schema.columns
WHERE table_catalog = 'my_datalake' AND table_schema = 'table_resolution'
ORDER BY table_name, ordinal_position;
----
tr_alpha	id	BIGINT
tr_alpha	name	VARCHAR
tr_beta	a	INTEGER
tr_beta	b	DOUBLE
tr_beta	c	BOOLEAN
tr_gamma	x	VARCHAR

# each of the three tables was loaded exactly once
query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%table_resolution/tables/tr_%';
----
3

statement ok
CALL truncate_duckdb_logs();

# A read in a new transaction refreshes the table metadata and requests vended credentials
query I
SELECT count(*) FROM my_datalake.table_resolution.tr_alpha;
----
10

query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP')
WHERE request.url LIKE '%/namespaces/table_resolution/tables/tr_alpha'
  AND contains(map_keys(request.headers), 'X-Iceberg-Access-Delegation');
----
1

# ---------------------------------------------------------------------------
# A table is resolved once per transaction, however many listings run
# ---------------------------------------------------------------------------

# re-attach so that nothing has been resolved yet
statement ok
DETACH my_datalake;

statement ok
ATTACH '' AS my_datalake (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    URI 'http://127.0.0.1:8181'
);

statement ok
CALL truncate_duckdb_logs();

statement ok
BEGIN;

statement ok
SELECT * FROM information_schema.columns WHERE table_catalog = 'my_datalake';

# The table/column OIDs must remain stable across scans for the SHOW ALL TABLES join.
query I
SELECT count(*) FROM (SHOW ALL TABLES)
WHERE database = 'my_datalake' AND schema = 'table_resolution';
----
3

statement ok
COMMIT;

query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%table_resolution/tables/tr_%';
----
3

# ---------------------------------------------------------------------------
# cleanup
# ---------------------------------------------------------------------------

statement ok
DROP TABLE my_datalake.table_resolution.tr_alpha;

statement ok
DROP TABLE my_datalake.table_resolution.tr_beta;

statement ok
DROP TABLE my_datalake.table_resolution.tr_gamma;

statement ok
DROP SCHEMA my_datalake.table_resolution;

statement ok
DETACH my_datalake;
