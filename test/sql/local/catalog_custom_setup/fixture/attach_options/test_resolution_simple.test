# name: test/sql/local/catalog_custom_setup/fixture/attach_options/test_resolution_simple.test
# description: test lazy table metadata resolution
# group: [attach_options]

require-env FIXTURE_SERVER_AVAILABLE

include test/sql/init_requires

set ignore_error_messages

statement ok
CREATE SECRET (
    TYPE S3,
    KEY_ID 'admin',
    SECRET 'password',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL 0
);


statement ok
ATTACH '' AS my_datalake (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    URI 'http://127.0.0.1:8181'
);

statement ok
from information_schema.columns;

statement ok
DETACH my_datalake;
