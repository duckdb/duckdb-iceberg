# name: test/sql/local/catalog_custom_setup/fixture/catalog_uri_options.test
# description: test canonical catalog URI options and the deprecated ENDPOINT alias
# group: [fixture]

require-env FIXTURE_SERVER_AVAILABLE

require avro

require parquet

require iceberg

require httpfs

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

# Test catalog secret and storage secret
statement ok
CALL enable_logging(level='debug', storage='memory')

statement ok
CREATE SECRET storage_secret(
	TYPE S3,
	KEY_ID 'admin',
	SECRET 'password',
	ENDPOINT '127.0.0.1:9000',
	URL_STYLE 'path',
	USE_SSL 0
);

statement ok
CREATE SECRET iceberg_secret (
	TYPE ICEBERG,
	CLIENT_ID 'admin',
	CLIENT_SECRET 'password',
	URI 'http://127.0.0.1:8181'
);

statement ok
ATTACH '' AS my_datalake (
	TYPE ICEBERG,
	SECRET iceberg_secret
);

statement error
use my_datalake
----
<REGEX>:.*No catalog.*

statement ok
DETACH my_datalake

statement ok
ATTACH '' AS my_datalake (
	TYPE ICEBERG,
	SECRET iceberg_secret,
	DEFAULT_SCHEMA 'default'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.catalog_uri_test;

statement ok
CREATE TABLE my_datalake.default.catalog_uri_test AS select 'hello world' a;

query I
select a from my_datalake.default.catalog_uri_test;
----
hello world

query I
SELECT message FROM duckdb_logs() where type = 'Iceberg' and message like '%uri% is inferred%' order by timestamp
----
'uri' is inferred from the ICEBERG secret 'iceberg_secret'
'uri' is inferred from the ICEBERG secret 'iceberg_secret'

statement ok
DETACH my_datalake

statement ok
DROP SECRET iceberg_secret

# ENDPOINT remains a deprecated alias for ICEBERG secrets, but new secrets store URI canonically.
statement ok
CALL truncate_duckdb_logs()

statement ok
CREATE SECRET legacy_iceberg_secret (
	TYPE ICEBERG,
	CLIENT_ID 'admin',
	CLIENT_SECRET 'password',
	ENDPOINT 'http://127.0.0.1:8181'
)

query I
SELECT count(*) FROM duckdb_logs()
WHERE message = 'The ICEBERG secret option ''endpoint'' is deprecated; use ''uri'' instead'
----
1

query I
SELECT count(*) FROM duckdb_secrets(redact=false)
WHERE name = 'legacy_iceberg_secret'
  AND secret_string LIKE '%;uri=http://127.0.0.1:8181%'
  AND secret_string NOT LIKE '%;endpoint=%'
----
1

statement ok
ATTACH '' AS my_datalake (
	TYPE ICEBERG,
	SECRET legacy_iceberg_secret,
	DEFAULT_SCHEMA 'default'
)

query I
SELECT a FROM my_datalake.default.catalog_uri_test
----
hello world

statement ok
DETACH my_datalake

statement ok
DROP SECRET legacy_iceberg_secret

# ENDPOINT also remains a deprecated ATTACH alias.
statement ok
CALL truncate_duckdb_logs()

statement ok
ATTACH '' AS my_datalake (
	TYPE ICEBERG,
	CLIENT_ID 'admin',
	CLIENT_SECRET 'password',
	ENDPOINT 'http://127.0.0.1:8181',
	DEFAULT_SCHEMA 'default'
)

query I
SELECT count(*) FROM duckdb_logs()
WHERE message = 'The Iceberg attach option ''endpoint'' is deprecated; use ''uri'' instead'
----
1

statement ok
DETACH my_datalake

statement error
ATTACH '' AS invalid_aliases (
	TYPE ICEBERG,
	URI 'http://127.0.0.1:8181',
	ENDPOINT 'http://127.0.0.1:8181',
	AUTHORIZATION_TYPE 'none'
)
----
Invalid Configuration Error: Both 'uri' and deprecated 'endpoint' were provided for Iceberg attach; use only 'uri'

# The alias collision is rejected during normalized ATTACH OR REPLACE comparison too.
statement error
ATTACH OR REPLACE '' AS my_datalake (
	TYPE ICEBERG,
	URI 'http://127.0.0.1:8181',
	ENDPOINT 'http://127.0.0.1:8181',
	AUTHORIZATION_TYPE 'none'
)
----
Invalid Configuration Error: Both 'uri' and deprecated 'endpoint' were provided for Iceberg attach; use only 'uri'

statement error
CREATE SECRET invalid_aliases (
	TYPE ICEBERG,
	URI 'http://127.0.0.1:8181',
	ENDPOINT 'http://127.0.0.1:8181',
	TOKEN 'unused'
)
----
Invalid Configuration Error: Both 'uri' and deprecated 'endpoint' were provided for an ICEBERG secret; use only 'uri'

statement error
ATTACH '' AS missing_uri (
	TYPE ICEBERG,
	AUTHORIZATION_TYPE 'none'
)
----
Invalid Configuration Error: Missing 'uri' option for Iceberg attach
