# name: test/sql/local/catalog_custom_setup/fixture/test_use_metadata_location.test
# description: USE_METADATA_LOCATION loads the authoritative metadata file at 'metadata-location'
# group: [fixture]

require-env FIXTURE_SERVER_AVAILABLE

require avro

require parquet

require iceberg

require httpfs

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
CREATE SECRET (
    TYPE S3,
    KEY_ID 'admin',
    SECRET 'password',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL 0
);

# Default attach: the embedded response metadata is trusted, no metadata file is read
statement ok
ATTACH '' AS default_datalake (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    URI 'http://127.0.0.1:8181'
);

statement ok
CALL enable_logging('HTTP');

statement ok
FROM default_datalake.default.table_unpartitioned;

query I
select count(*) from duckdb_logs_parsed('HTTP') where request.type = 'GET' and request.url like '%.metadata.json%';
----
0

statement ok
DETACH default_datalake;

# With USE_METADATA_LOCATION, the metadata file at 'metadata-location' is loaded instead
statement ok
ATTACH '' AS my_datalake (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    URI 'http://127.0.0.1:8181',
    USE_METADATA_LOCATION true
);

statement ok
CALL truncate_duckdb_logs();

statement ok
FROM my_datalake.default.table_unpartitioned;

# resolving the table read the metadata file
query I
select count(*) from duckdb_logs_parsed('HTTP') where request.type = 'GET' and request.url like '%.metadata.json%';
----
1

statement ok
CALL truncate_duckdb_logs();

statement ok
FROM my_datalake.default.table_unpartitioned;

# the metadata file is cached per catalog, re-scanning issues no new request
query I
select count(*) from duckdb_logs_parsed('HTTP') where request.type = 'GET' and request.url like '%.metadata.json%';
----
0
