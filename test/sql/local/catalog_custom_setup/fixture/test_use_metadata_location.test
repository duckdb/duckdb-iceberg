# name: test/sql/local/catalog_custom_setup/fixture/test_use_metadata_location.test
# description: USE_METADATA_LOCATION loads the authoritative metadata file at 'metadata-location'
# group: [fixture]

require-env FIXTURE_SERVER_AVAILABLE

require avro

require parquet

require iceberg

require httpfs

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
CREATE SECRET (
    TYPE S3,
    KEY_ID 'admin',
    SECRET 'password',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL 0
);

# Default attach: the embedded response metadata is trusted, no metadata file is read
statement ok
ATTACH '' AS default_datalake (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    URI 'http://127.0.0.1:8181'
);

statement ok
CALL enable_logging('HTTP');

statement ok
FROM default_datalake.default.table_unpartitioned;

query II
SELECT count(*) FILTER (request.type = 'GET'), count(*) FILTER (request.type = 'HEAD')
FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%.metadata.json%';
----
0	0

statement ok
DETACH default_datalake;

# With USE_METADATA_LOCATION, the metadata file at 'metadata-location' is loaded instead
statement ok
ATTACH '' AS my_datalake (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    URI 'http://127.0.0.1:8181',
    USE_METADATA_LOCATION true
);

statement ok
CALL truncate_duckdb_logs();

statement ok
FROM my_datalake.default.table_unpartitioned;

# Resolving the table reads the metadata with a single GET and no preliminary HEAD.
query II
SELECT count(*) FILTER (request.type = 'GET'), count(*) FILTER (request.type = 'HEAD')
FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%.metadata.json%';
----
1	0

statement ok
CALL truncate_duckdb_logs();

statement ok
FROM my_datalake.default.table_unpartitioned;

# The external file cache avoids metadata requests on re-scan.
query II
SELECT count(*) FILTER (request.type = 'GET'), count(*) FILTER (request.type = 'HEAD')
FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%.metadata.json%';
----
0	0

# Recreate the catalog so no catalog-local state can satisfy the metadata read.
statement ok
DETACH my_datalake;

statement ok
ATTACH '' AS my_datalake (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    URI 'http://127.0.0.1:8181',
    USE_METADATA_LOCATION true
);

statement ok
CALL truncate_duckdb_logs();

statement ok
FROM my_datalake.default.table_unpartitioned;

# The external file cache also avoids metadata requests for the new catalog.
query II
SELECT count(*) FILTER (request.type = 'GET'), count(*) FILTER (request.type = 'HEAD')
FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%.metadata.json%';
----
0	0

statement ok
DETACH my_datalake;
