# name: test/sql/local/catalog_custom_setup/fixture/test_create_schema_if_not_exists_concurrent.test
# description: Test CREATE SCHEMA IF NOT EXISTS succeeds when the schema is created concurrently
# group: [fixture]

require-env FIXTURE_SERVER_AVAILABLE

require avro

require parquet

require iceberg

require httpfs

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
CREATE SECRET (
    TYPE S3,
    KEY_ID 'admin',
    SECRET 'password',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL 0
);

statement ok
ATTACH '' AS my_datalake (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    ENDPOINT 'http://127.0.0.1:8181'
);

# a second attach of the same catalog acts as another DuckDB instance
statement ok
ATTACH '' AS other_datalake (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    ENDPOINT 'http://127.0.0.1:8181'
);

statement ok
DROP TABLE IF EXISTS my_datalake.concurrent_schema.my_table;

statement ok
DROP SCHEMA IF EXISTS my_datalake.concurrent_schema;

# con1 creates the schema with IF NOT EXISTS, con2 creates it first
statement ok con1
begin

statement ok con1
CREATE SCHEMA IF NOT EXISTS my_datalake.concurrent_schema;

statement ok con2
CREATE SCHEMA other_datalake.concurrent_schema;

# the server returns 409 AlreadyExists for con1's deferred create, which is fine for IF NOT EXISTS
statement ok con1
commit

statement ok
CREATE TABLE my_datalake.concurrent_schema.my_table (id INTEGER);

statement ok
DROP TABLE my_datalake.concurrent_schema.my_table;

statement ok
DROP SCHEMA my_datalake.concurrent_schema;

# without IF NOT EXISTS, the concurrently created schema is still an error
statement ok con1
begin

statement ok con1
CREATE SCHEMA my_datalake.concurrent_schema;

statement ok con2
CREATE SCHEMA other_datalake.concurrent_schema;

statement error con1
commit
----
Schema with name "concurrent_schema" already exists

statement ok
DROP SCHEMA my_datalake.concurrent_schema;

# a table created in the schema in the same transaction is committed
statement ok con1
begin

statement ok con1
CREATE SCHEMA IF NOT EXISTS my_datalake.concurrent_schema;

statement ok con1
CREATE TABLE my_datalake.concurrent_schema.my_table AS SELECT range id FROM range(3);

statement ok con2
CREATE SCHEMA other_datalake.concurrent_schema;

statement ok con1
commit

query I con2
SELECT * FROM other_datalake.concurrent_schema.my_table ORDER BY id;
----
0
1
2

statement ok con2
DROP TABLE other_datalake.concurrent_schema.my_table;

statement ok con2
DROP SCHEMA other_datalake.concurrent_schema;

# a plain create of a schema already being created in the same transaction is an error
statement ok con1
begin

statement ok con1
CREATE SCHEMA IF NOT EXISTS my_datalake.concurrent_schema;

statement ok con1
CREATE SCHEMA IF NOT EXISTS my_datalake.concurrent_schema;

statement error con1
CREATE SCHEMA my_datalake.concurrent_schema;
----
Schema with name "concurrent_schema" already exists

statement ok con1
rollback
