# name: test/sql/local/catalog_custom_setup/fixture/enable_logging_http/test_duckdb_catalog_functions_and_iceberg.test
# description: test integration with iceberg catalog read
# group: [enable_logging_http]

require-env FIXTURE_SERVER_AVAILABLE

include test/sql/init_requires

statement ok
CALL enable_logging('HTTP');

statement ok
set logging_level='debug';

statement ok
CREATE SECRET (
    TYPE S3,
    KEY_ID 'admin',
    SECRET 'password',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL 0
);


statement ok
ATTACH '' AS my_datalake (
    TYPE ICEBERG,
    CREATE_DEFAULT_SCHEMA true,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    URI 'http://127.0.0.1:8181'
);

# Exclude attach-time default-schema validation and optional creation.
statement ok
CALL truncate_duckdb_logs();

statement ok
use my_datalake.default;

# Using a non-default namespace does not issue an existence request.
query I
select count(*) from duckdb_logs_parsed('HTTP');
----
0

# Inspecting the logs does not issue catalog requests.
query I
select count(*) from duckdb_logs_parsed('HTTP');
----
0

statement ok
use memory;

# namespace 'memory' is looked up in the iceberg catalog
query I
select count(*) from duckdb_logs_parsed('HTTP');
----
0

query I
select count(*) from duckdb_logs_parsed('HTTP');
----
0