# name: test/sql/local/catalog_custom_setup/fixture/vended_credentials_refresh_endpoints.test
# description: credential refresh endpoint selection, response validation and error propagation
# group: [fixture]

require-env FIXTURE_SERVER_AVAILABLE

require-env VENDED_CREDENTIAL_REFRESH_PROXY

include test/sql/init_requires

set ignore_error_messages

statement ok
SET enable_external_file_cache=false

statement ok
CALL enable_logging('HTTP')

# Inspect synthetic credential and delegation headers to verify refresh requests.
statement ok
SET redact_http_logs=false

# Warm metadata in the same transaction before expiring the secret. Any
# subsequent LoadTable request must be the refresh, not a table lookup.
# Test credentials in config alone and config defaults overridden by a
# storage-credentials entry as well as self-contained storage-credentials.
foreach endpoint_mode,response_mode supported,single supported,multiple absent,single absent,multiple absent,config absent,merged omitted,single omitted,multiple omitted,config omitted,merged

statement ok
CREATE OR REPLACE SECRET endpoint_proxy (
    TYPE HTTP,
    HTTP_PROXY '{VENDED_CREDENTIAL_REFRESH_PROXY}',
    EXTRA_HTTP_HEADERS MAP {'x-credential-endpoint': '{endpoint_mode}', 'x-refresh-response': '{response_mode}'}
)

statement ok
ATTACH '' AS endpoint_refresh (
    TYPE ICEBERG,
    URI 'http://127.0.0.1:8181',
    AUTHORIZATION_TYPE 'oauth2',
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    OAUTH2_SERVER_URI 'http://127.0.0.1:8181/v1/oauth/tokens',
    ACCESS_DELEGATION_MODE 'none'
)

statement ok
CREATE SECRET endpoint_secret (
    TYPE S3,
    PROVIDER iceberg,
    KEY_ID 'OLD_INIT_KEY',
    SECRET 'OLD_INIT_KEY_SECRET',
    REGION 'us-east-1',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL false,
    HTTP_PROXY '{VENDED_CREDENTIAL_REFRESH_PROXY}',
    SCOPE 's3://warehouse/vended_credentials_refresh/init',
    REFRESH_INFO MAP {'catalog_name': 'endpoint_refresh', 'schema': 'default', 'table': 'vended_init_refresh'}
)

statement ok
BEGIN

query I
SELECT count(*) FROM endpoint_refresh.default.vended_init_refresh
----
0

statement ok
CALL truncate_duckdb_logs()

query IT
SELECT * FROM read_parquet('s3://warehouse/vended_credentials_refresh/init/data.parquet') ORDER BY ALL
----
1	foo
2	bar
3	baz

query I
SELECT count(*) = CASE WHEN '{endpoint_mode}' = 'supported' THEN 0 ELSE 1 END
FROM duckdb_logs_parsed('HTTP')
WHERE request.url = 'http://127.0.0.1:8181/v1/namespaces/default/tables/vended_init_refresh'
  AND request.type = 'GET'
  AND response.status = 'OK_200'
----
1

query I
SELECT count(*) = CASE WHEN '{endpoint_mode}' = 'supported' THEN 1 ELSE 0 END
FROM duckdb_logs_parsed('HTTP')
WHERE request.url LIKE '%/credentials'
----
1

query I
SELECT count(*) > 0
FROM duckdb_logs_parsed('HTTP')
WHERE request.url LIKE '%/vended_credentials_refresh/init/data.parquet'
  AND request.headers['Authorization'] LIKE '%NEW_INIT_KEY%'
  AND response.status IN ('OK_200', 'PartialContent_206')
----
1

query III
SELECT secret_string LIKE '%key_id=NEW_INIT_KEY%',
       secret_string LIKE '%secret=NEW_INIT_KEY_SECRET%',
       secret_string LIKE '%region=us-east-1%'
FROM duckdb_secrets(redact=false)
WHERE name = 'endpoint_secret'
----
1	1	1

statement ok
ROLLBACK

statement ok
DROP SECRET endpoint_secret

statement ok
DETACH endpoint_refresh

endloop

# Exercise automatic installation and the access-delegation header during a
# real table scan, through both legacy forms of the endpoint list.
foreach endpoint_mode absent omitted

statement ok
CREATE OR REPLACE SECRET endpoint_proxy (
    TYPE HTTP,
    HTTP_PROXY '{VENDED_CREDENTIAL_REFRESH_PROXY}',
    EXTRA_HTTP_HEADERS MAP {'x-credential-endpoint': '{endpoint_mode}'}
)

statement ok
ATTACH '' AS endpoint_refresh (
    TYPE ICEBERG,
    URI 'http://127.0.0.1:8181',
    AUTHORIZATION_TYPE 'oauth2',
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    OAUTH2_SERVER_URI 'http://127.0.0.1:8181/v1/oauth/tokens',
    ACCESS_DELEGATION_MODE 'vended_credentials'
)

statement ok
CALL truncate_duckdb_logs()

query III
SELECT count(*), sum(number), count(DISTINCT letter) FROM endpoint_refresh.default.vended_refresh_table
----
12	78	12

query I
SELECT count(*) >= 2
FROM duckdb_logs_parsed('HTTP')
WHERE request.url = 'http://127.0.0.1:8181/v1/namespaces/default/tables/vended_refresh_table'
  AND request.headers['X-Iceberg-Access-Delegation'] = 'vended-credentials'
  AND response.status = 'OK_200'
----
1

query I
SELECT count(*)
FROM duckdb_logs_parsed('HTTP')
WHERE request.url LIKE '%/credentials'
----
0

query I
SELECT count(*) > 0
FROM duckdb_logs_parsed('HTTP')
WHERE starts_with(request.url, 'http://127.0.0.1:9000/')
  AND request.url LIKE '%/data/%'
  AND request.headers['Authorization'] LIKE '%REFRESHED_TABLE_SCAN_KEY%'
  AND response.status IN ('OK_200', 'PartialContent_206')
----
1

statement ok
DETACH endpoint_refresh

endloop

# A failed refresh must preserve the catalog error and status, including a 404
# from an advertised /credentials endpoint. Never retry through the other API.
foreach endpoint_mode supported absent omitted

foreach error_code 403 404

statement ok
CREATE OR REPLACE SECRET endpoint_proxy (
    TYPE HTTP,
    HTTP_PROXY '{VENDED_CREDENTIAL_REFRESH_PROXY}',
    EXTRA_HTTP_HEADERS MAP {'x-credential-endpoint': '{endpoint_mode}', 'x-refresh-response': '{error_code}'}
)

statement ok
ATTACH '' AS endpoint_refresh (
    TYPE ICEBERG,
    URI 'http://127.0.0.1:8181',
    AUTHORIZATION_TYPE 'oauth2',
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    OAUTH2_SERVER_URI 'http://127.0.0.1:8181/v1/oauth/tokens',
    ACCESS_DELEGATION_MODE 'none'
)

statement ok
CREATE SECRET endpoint_secret (
    TYPE S3,
    PROVIDER iceberg,
    KEY_ID 'OLD_INIT_KEY',
    SECRET 'OLD_INIT_KEY_SECRET',
    REGION 'us-east-1',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL false,
    HTTP_PROXY '{VENDED_CREDENTIAL_REFRESH_PROXY}',
    SCOPE 's3://warehouse/vended_credentials_refresh/init',
    REFRESH_INFO MAP {'catalog_name': 'endpoint_refresh', 'schema': 'default', 'table': 'vended_init_refresh'}
)

statement ok
BEGIN

query I
SELECT count(*) FROM endpoint_refresh.default.vended_init_refresh
----
0

statement ok
CALL truncate_duckdb_logs()

onlyif error_code=403
statement error
SELECT * FROM read_parquet('s3://warehouse/vended_credentials_refresh/init/data.parquet')
----
<REGEX>:.*Could not refresh Iceberg vended credentials.*response code Forbidden_403 with message "refresh denied \(403\)".*

onlyif error_code=404
statement error
SELECT * FROM read_parquet('s3://warehouse/vended_credentials_refresh/init/data.parquet')
----
<REGEX>:.*Could not refresh Iceberg vended credentials.*response code NotFound_404 with message "refresh denied \(404\)".*

statement ok
ROLLBACK

query I
SELECT count(*) = CASE WHEN '{endpoint_mode}' = 'supported' THEN 0 ELSE 1 END
FROM duckdb_logs_parsed('HTTP')
WHERE request.url = 'http://127.0.0.1:8181/v1/namespaces/default/tables/vended_init_refresh'
  AND request.type = 'GET'
----
1

query I
SELECT count(*) = CASE WHEN '{endpoint_mode}' = 'supported' THEN 1 ELSE 0 END
FROM duckdb_logs_parsed('HTTP')
WHERE request.url LIKE '%/credentials'
----
1

statement ok
DROP SECRET endpoint_secret

statement ok
DETACH endpoint_refresh

endloop

endloop

# Missing and empty credentials cannot satisfy a refresh, even if the previous
# LoadTable response had credentials in config. Validate malformed credentials.
foreach endpoint_mode absent omitted

foreach response_mode empty omitted removed_config invalid

statement ok
CREATE OR REPLACE SECRET endpoint_proxy (
    TYPE HTTP,
    HTTP_PROXY '{VENDED_CREDENTIAL_REFRESH_PROXY}',
    EXTRA_HTTP_HEADERS MAP {'x-credential-endpoint': '{endpoint_mode}', 'x-refresh-response': '{response_mode}'}
)

statement ok
ATTACH '' AS endpoint_refresh (
    TYPE ICEBERG,
    URI 'http://127.0.0.1:8181',
    AUTHORIZATION_TYPE 'oauth2',
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    OAUTH2_SERVER_URI 'http://127.0.0.1:8181/v1/oauth/tokens',
    ACCESS_DELEGATION_MODE 'none'
)

statement ok
CREATE SECRET endpoint_secret (
    TYPE S3,
    PROVIDER iceberg,
    KEY_ID 'OLD_INIT_KEY',
    SECRET 'OLD_INIT_KEY_SECRET',
    REGION 'us-east-1',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL false,
    HTTP_PROXY '{VENDED_CREDENTIAL_REFRESH_PROXY}',
    SCOPE 's3://warehouse/vended_credentials_refresh/init',
    REFRESH_INFO MAP {'catalog_name': 'endpoint_refresh', 'schema': 'default', 'table': 'vended_init_refresh'}
)

statement ok
BEGIN

query I
SELECT count(*) FROM endpoint_refresh.default.vended_init_refresh
----
0

statement ok
CALL truncate_duckdb_logs()

skipif response_mode=invalid
statement error
SELECT * FROM read_parquet('s3://warehouse/vended_credentials_refresh/init/data.parquet')
----
no matching credential was re-vended

onlyif response_mode=invalid
statement error
SELECT * FROM read_parquet('s3://warehouse/vended_credentials_refresh/init/data.parquet')
----
storage_credentials_tmp' is not of type 'array'

statement ok
ROLLBACK

query I
SELECT count(*)
FROM duckdb_logs_parsed('HTTP')
WHERE request.url = 'http://127.0.0.1:8181/v1/namespaces/default/tables/vended_init_refresh'
  AND request.type = 'GET'
  AND response.status = 'OK_200'
----
1

query I
SELECT count(*)
FROM duckdb_logs_parsed('HTTP')
WHERE request.url LIKE '%/credentials'
----
0

statement ok
DROP SECRET endpoint_secret

statement ok
DETACH endpoint_refresh

endloop

endloop

statement ok
DROP SECRET endpoint_proxy
