# flag IS NOT NULL
query IIII
select * from iceberg_scan('{WORKING_DIRECTORY}/data/persistent/null_stats/default/test_nulls', version='00003-9d6a621e-8a72-4190-a880-f6ca02e32b86') where flag IS NOT NULL order by all
