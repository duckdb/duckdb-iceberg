# name: test/sql/local/missing_map_keys.test
# group: [local]

require avro

require parquet

require iceberg

require httpfs

# Unmappable key in a map.

statement error
SELECT payload FROM iceberg_scan('{WORKING_DIRECTORY}/data/persistent/missing_map_keys/map', version='1')
----
Invalid Input Error: Field ""key"" (field id 3) is missing from the file schema and has no default expression

statement error
SELECT * FROM iceberg_scan('{WORKING_DIRECTORY}/data/persistent/missing_map_keys/map', version='1')
----
Invalid Input Error: Field ""key"" (field id 3) is missing from the file schema and has no default expression

statement error
SELECT id FROM iceberg_scan('{WORKING_DIRECTORY}/data/persistent/missing_map_keys/map', version='1') WHERE payload IS NOT NULL
----
Invalid Input Error: Field ""key"" (field id 3) is missing from the file schema and has no default expression

query I
SELECT id FROM iceberg_scan('{WORKING_DIRECTORY}/data/persistent/missing_map_keys/map', version='1')
----
1

