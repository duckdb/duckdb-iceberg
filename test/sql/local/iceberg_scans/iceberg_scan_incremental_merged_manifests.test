# name: test/sql/local/iceberg_scans/iceberg_scan_incremental_merged_manifests.test
# description: incremental reads over appends that merge older manifests into their own
# group: [iceberg_scans]

require avro

require parquet

require iceberg

# Generated by scripts/persistent/incremental_merged_manifests.py: three appends of three rows each,
# where snapshot i appends ids [3 * i + 1, 3 * i + 3]. Every append after the first merges the previous
# manifest into the one it writes, so that manifest also holds the earlier files as EXISTING entries:
#   s1 6554556246591029721: added_rows=3, existing_rows=0
#   s2 2662590018741208069: added_rows=3, existing_rows=3
#   s3 419655816355277066:  added_rows=3, existing_rows=6
# A bare count(*) must not be answered from those manifest counts, it would include the EXISTING rows.

# A full scan still gets the exact count from the manifests
query I
SELECT count(*) FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/incremental_merged_manifests/default/merged/metadata/00003-1b4076cf-4f72-4d55-9af0-57792e89024e.metadata.json');
----
9

# s2's manifest counts 6 rows, only 3 of them were added by s2
query I
SELECT count(*) FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/incremental_merged_manifests/default/merged/metadata/00003-1b4076cf-4f72-4d55-9af0-57792e89024e.metadata.json', start_snapshot_id=6554556246591029721, end_snapshot_id=2662590018741208069);
----
3

query I
SELECT id FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/incremental_merged_manifests/default/merged/metadata/00003-1b4076cf-4f72-4d55-9af0-57792e89024e.metadata.json', start_snapshot_id=6554556246591029721, end_snapshot_id=2662590018741208069) ORDER BY id;
----
4
5
6

# s3's manifest counts 9 rows, only 3 of them were added by s3
query I
SELECT count(*) FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/incremental_merged_manifests/default/merged/metadata/00003-1b4076cf-4f72-4d55-9af0-57792e89024e.metadata.json', start_snapshot_id=2662590018741208069, end_snapshot_id=419655816355277066);
----
3

# Up to the current snapshot, spanning two merged manifests
query I
SELECT count(*) FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/incremental_merged_manifests/default/merged/metadata/00003-1b4076cf-4f72-4d55-9af0-57792e89024e.metadata.json', start_snapshot_id=6554556246591029721);
----
6

query II
SELECT min(id), max(id) FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/incremental_merged_manifests/default/merged/metadata/00003-1b4076cf-4f72-4d55-9af0-57792e89024e.metadata.json', start_snapshot_id=6554556246591029721);
----
4	9
