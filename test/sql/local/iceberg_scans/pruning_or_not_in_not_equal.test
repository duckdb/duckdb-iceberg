# name: test/sql/local/iceberg_scans/pruning_or_not_in_not_equal.test
# description: data files are skipped for OR, NOT IN and != filters
# group: [iceberg_scans]

include test/sql/init_requires

# One file per partition: partition_col 42 (user_id 12345, event_type 'click') and 1337 (67890, 'purchase')
statement ok
CREATE VIEW t AS SELECT * FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/partition_integer');

# OR: a file is skipped when no side can match

query I
SELECT count(*) FROM t WHERE partition_col = 1 OR partition_col > 2000;
----
0

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE partition_col = 1 OR partition_col > 2000;
----
analyzed_plan	<REGEX>:.*Total Files Read: 0.*

query I
SELECT user_id FROM t WHERE partition_col = 42 OR partition_col > 2000;
----
12345

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE partition_col = 42 OR partition_col > 2000;
----
analyzed_plan	<REGEX>:.*Total Files Read: 1.*

# != and NOT IN: a file is skipped when every row holds an excluded value

query I
SELECT user_id FROM t WHERE partition_col != 42;
----
67890

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE partition_col != 42;
----
analyzed_plan	<REGEX>:.*Total Files Read: 1.*

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE 42 != partition_col;
----
analyzed_plan	<REGEX>:.*Total Files Read: 1.*

query I
SELECT count(*) FROM t WHERE partition_col NOT IN (42, 1337);
----
0

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE partition_col NOT IN (42, 1337);
----
analyzed_plan	<REGEX>:.*Total Files Read: 0.*

query I
SELECT user_id FROM t WHERE partition_col NOT IN (42, 7);
----
67890

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE partition_col NOT IN (42, 7);
----
analyzed_plan	<REGEX>:.*Total Files Read: 1.*

# The same filters on columns that aren't partition columns use the file's bounds

query I
SELECT user_id FROM t WHERE event_type != 'click';
----
67890

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE event_type != 'click';
----
analyzed_plan	<REGEX>:.*Total Files Read: 1.*

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE user_id = 1 OR user_id > 99999;
----
analyzed_plan	<REGEX>:.*Total Files Read: 0.*

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE event_type NOT IN ('click', 'purchase');
----
analyzed_plan	<REGEX>:.*Total Files Read: 0.*

# A file that may hold NULLs is read: its bounds don't show that every row holds the value.
# Files: ids 1-3 all NULL, ids 4-6 ('foo', 'bar', 'baz'), ids 7-8 (NULL, 'blah')
statement ok
CREATE VIEW n AS SELECT * FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/is_null_is_not_null');

query I
SELECT id FROM n WHERE value != 'blah' ORDER BY id;
----
4
5
6

query II
EXPLAIN ANALYZE SELECT count(*) FROM n WHERE value != 'blah';
----
analyzed_plan	<REGEX>:.*Total Files Read: 2.*

# The all-NULL file is skipped for NOT IN as for !=
query I
SELECT id FROM n WHERE value NOT IN ('blah') ORDER BY id;
----
4
5
6

query II
EXPLAIN ANALYZE SELECT count(*) FROM n WHERE value NOT IN ('blah');
----
analyzed_plan	<REGEX>:.*Total Files Read: 2.*

query I
SELECT id FROM n WHERE value IS NULL OR value = 'zzz' ORDER BY id;
----
1
2
3
7

query II
EXPLAIN ANALYZE SELECT count(*) FROM n WHERE value IS NULL OR value = 'zzz';
----
analyzed_plan	<REGEX>:.*Total Files Read: 2.*

# Each surviving file matches a different arm. The file with ids 4-6
# matches none. The residual keeps only the endpoints of the other two files.
query I
SELECT list(id ORDER BY id) FROM n
WHERE (id >= 2 AND id < 3) OR id = 8 OR id < 0;
----
[2, 8]

query II
EXPLAIN ANALYZE SELECT id FROM n WHERE (id >= 2 AND id < 3) OR id = 8 OR id < 0;
----
analyzed_plan	<REGEX>:.*Total Files Read: 2.*

# A row-dependent list member and a transformed probe cannot be compared
# directly against the stored string bounds.
query I
SELECT list(id ORDER BY id) FROM n WHERE value NOT IN (upper(value), 'bar');
----
[4, 6, 8]

query I
SELECT list(id ORDER BY id) FROM n WHERE coalesce(value, 'missing') NOT IN ('foo', 'blah');
----
[1, 2, 3, 5, 6, 7]

# Different columns satisfy the two arms in different files.
query I
SELECT list(user_id ORDER BY user_id) FROM t WHERE partition_col != 42 OR event_type = 'click';
----
[12345, 67890]
