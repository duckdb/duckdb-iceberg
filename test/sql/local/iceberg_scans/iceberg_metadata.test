{'_day': 2026-01-02}

# Nested columns are named by their full path, like 'metadata.key' for a map key
query II
SELECT readable_metrics['metadata.key'], readable_metrics.timestamp.lower_bound
FROM ICEBERG_FILES('{WORKING_DIRECTORY}/data/persistent/map_stats/default.db/map_stats', version='00002-0e059d4b-e5e8-41af-a763-76cbf3a3d0bc', ALLOW_MOVED_PATHS=TRUE)
ORDER BY ALL;
----
{'column_size': 85, 'value_count': 1, 'null_value_count': 0, 'nan_value_count': NULL, 'lower_bound': NULL, 'upper_bound': NULL}	2026-01-01 00:00:00+00
{'column_size': 85, 'value_count': 1, 'null_value_count': 0, 'nan_value_count': NULL, 'lower_bound': NULL, 'upper_bound': NULL}	2026-01-02 00:00:00+00

# A v3 table with a deletion vector, the data file inherits its first row id from the manifest
query IIIIII
SELECT content, record_count, referenced_data_file IS NOT NULL, content_offset, content_size_in_bytes, first_row_id
FROM ICEBERG_FILES('{WORKING_DIRECTORY}/data/persistent/moved_deletion_vector_path', ALLOW_MOVED_PATHS=TRUE)
ORDER BY content;
----
0	100	false	NULL	NULL	0
1	1	true	4	42	NULL

