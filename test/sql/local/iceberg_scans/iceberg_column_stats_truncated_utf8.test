# name: test/sql/local/iceberg_scans/iceberg_column_stats_truncated_utf8.test
# description: iceberg_column_stats and filter pushdown must tolerate a varchar bound whose truncate(16) split a multi-byte UTF-8 character. The bound is omitted and logged instead of failing the whole scan.
# group: [iceberg_scans]

require avro

require parquet

require iceberg

statement ok
CALL enable_logging('Iceberg');

statement ok
CALL truncate_duckdb_logs();

# value's lower and upper bounds are a 16-byte truncate(16) that ends on the first byte of U+2019.
query III
SELECT column_name, lower_bound, upper_bound
FROM iceberg_column_stats('{WORKING_DIRECTORY}/data/persistent/utf8_trunc_bounds')
ORDER BY column_name;
----
id	1	3
value	NULL	NULL

query II
SELECT
	count(*) FILTER (message.contains($$Omitting invalid UTF-8 lower bound for column 'value'$$)),
	count(*) FILTER (message.contains($$Omitting invalid UTF-8 upper bound for column 'value'$$))
FROM duckdb_logs()
WHERE type = 'Iceberg';
----
1	1

# The data file itself is valid UTF-8. A filter on the truncated column must still scan it.
query II
SELECT id, value
FROM iceberg_scan('{WORKING_DIRECTORY}/data/persistent/utf8_trunc_bounds')
WHERE value = 'foo'
ORDER BY id;
----
1	foo
