# name: test/sql/local/iceberg_scans/iceberg_column_stats_truncated_utf8.test
# description: A varchar bound whose truncate(16) split a multi-byte character is repaired. The lower bound keeps the valid prefix. The upper bound increments the last code point, so a longer value with that prefix is still inside the bound.
# group: [iceberg_scans]

require avro

require parquet

require iceberg

# value's bounds are 16 bytes ending on the first byte of a 3-byte character (0xE2).
# The valid prefix is {"name":"John O. Rounding the last code point up yields {"name":"John P.
query III
SELECT column_name, lower_bound, upper_bound
FROM iceberg_column_stats('{WORKING_DIRECTORY}/data/persistent/utf8_trunc_bounds')
ORDER BY column_name;
----
id	1	3
value	{"name":"John O	{"name":"John P

# 'foo' is below the repaired lower bound, so the file is pruned.
query II
SELECT id, value
FROM iceberg_scan('{WORKING_DIRECTORY}/data/persistent/utf8_trunc_bounds')
WHERE value = 'foo'
ORDER BY id;
----
