# name: test/sql/local/iceberg_scans/equality_delete_invalid_bounds_cache.test
# description: Invalid equality-delete bounds are ignored and decoded only once per scan
# group: [iceberg_scans]

include test/sql/init_requires

require json

statement ok
set threads=1;

statement ok
set disabled_optimizers='column_lifetime,statistics_propagation,join_order';

statement ok
set enable_external_file_cache=false;

statement ok
call enable_logging('Iceberg');

foreach file a b

statement ok
copy (select id from (values (1), (2), (3)) t(id))
to '{TEST_DIR}/cached_bounds_{file}.parquet' (format parquet, field_ids {id: 1});

endloop

statement ok
copy (select 2::integer as id)
to '{TEST_DIR}/cached_bounds_delete.parquet' (format parquet, field_ids {id: 1});

statement ok
copy (
	select 1::integer as status, 1::bigint as snapshot_id,
		1::bigint as sequence_number, 1::bigint as file_sequence_number,
		{
			content: 0::integer, file_path: '{TEST_DIR}/cached_bounds_' || file || '.parquet',
			file_format: 'PARQUET', partition: {}, record_count: 3::bigint,
			file_size_in_bytes: 1000::bigint,
			lower_bounds: map {1: unhex('01000000')},
			upper_bounds: map {1: unhex('03000000')}
		} as data_file
	from (values ('a'), ('b')) t(file)
) to '{TEST_DIR}/cached_bounds_data.avro' (
	format avro,
	metadata {'schema-id': '0', 'partition-spec-id': '0', 'format-version': '2', 'content': 'data'},
	field_ids {
		status: 0, snapshot_id: 1, sequence_number: 3, file_sequence_number: 4,
		data_file: {__duckdb_field_id: 2, content: 134, file_path: 100, file_format: 101,
			partition: 102, record_count: 103, file_size_in_bytes: 104,
			lower_bounds: {__duckdb_field_id: 125, key: 126, value: 127},
			upper_bounds: {__duckdb_field_id: 128, key: 129, value: 130}}
	}
);

foreach invalid_bound lower upper

# The one-byte INTEGER bound is invalid. Its other bound would falsely suggest
# a disjoint range, so partial statistics must not discard the actual id=2 delete.
statement ok
copy (
	select 1::integer as status, 2::bigint as snapshot_id,
		2::bigint as sequence_number, 2::bigint as file_sequence_number,
		{
			content: 2::integer, file_path: '{TEST_DIR}/cached_bounds_delete.parquet',
			file_format: 'PARQUET', partition: {}, record_count: 1::bigint,
			file_size_in_bytes: 1000::bigint, equality_ids: [1],
			null_value_counts: map {1: 0::bigint},
			lower_bounds: map {1: case when '{invalid_bound}' = 'lower' then unhex('01') else unhex('32000000') end},
			upper_bounds: map {1: case when '{invalid_bound}' = 'upper' then unhex('01') else unhex('32000000') end}
		} as data_file
) to '{TEST_DIR}/cached_bounds_{invalid_bound}_delete.avro' (
	format avro,
	metadata {'schema-id': '0', 'partition-spec-id': '0', 'format-version': '2', 'content': 'deletes'},
	field_ids {
		status: 0, snapshot_id: 1, sequence_number: 3, file_sequence_number: 4,
		data_file: {__duckdb_field_id: 2, content: 134, file_path: 100, file_format: 101,
			partition: 102, record_count: 103, file_size_in_bytes: 104,
			equality_ids: {__duckdb_field_id: 135, list: 136},
			null_value_counts: {__duckdb_field_id: 110, key: 121, value: 122},
			lower_bounds: {__duckdb_field_id: 125, key: 126, value: 127},
			upper_bounds: {__duckdb_field_id: 128, key: 129, value: 130}}
	}
);

statement ok
copy (
	select case when content = 0 then '{TEST_DIR}/cached_bounds_data.avro'
	            else '{TEST_DIR}/cached_bounds_{invalid_bound}_delete.avro' end as manifest_path,
		1000::bigint as manifest_length, 0::integer as partition_spec_id, content::integer as content,
		seq::bigint as sequence_number, seq::bigint as min_sequence_number, seq::bigint as added_snapshot_id,
		files::integer as added_files_count, 0::integer as existing_files_count, 0::integer as deleted_files_count,
		rows::bigint as added_rows_count, 0::bigint as existing_rows_count, 0::bigint as deleted_rows_count
	from (values (0, 1, 2, 6), (1, 2, 1, 1)) t(content, seq, files, rows)
) to '{TEST_DIR}/cached_bounds_{invalid_bound}_list.avro' (
	format avro,
	field_ids {
		manifest_path: 500, manifest_length: 501, partition_spec_id: 502, content: 517,
		sequence_number: 515, min_sequence_number: 516, added_snapshot_id: 503,
		added_files_count: 504, existing_files_count: 505, deleted_files_count: 506,
		added_rows_count: 512, existing_rows_count: 513, deleted_rows_count: 514
	}
);

statement ok
copy (
	select to_json({
		'format-version': 2, 'table-uuid': 'aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee',
		'location': '{TEST_DIR}', 'last-sequence-number': 2, 'last-updated-ms': 1700000000000,
		'last-column-id': 1, 'current-schema-id': 0,
		'schemas': [{'type': 'struct', 'schema-id': 0,
			'fields': [{'id': 1, 'name': 'id', 'required': false, 'type': 'int'}]}],
		'default-spec-id': 0, 'partition-specs': [{'spec-id': 0, 'fields': []}],
		'last-partition-id': 999, 'default-sort-order-id': 0, 'sort-orders': [{'order-id': 0, 'fields': []}],
		'current-snapshot-id': 2,
		'snapshots': [{'snapshot-id': 2, 'sequence-number': 2, 'timestamp-ms': 1700000000000,
			'manifest-list': '{TEST_DIR}/cached_bounds_{invalid_bound}_list.avro', 'schema-id': 0,
			'summary': {'operation': 'delete'}}]
	}) as metadata
) to '{TEST_DIR}/cached_bounds_{invalid_bound}.metadata.json' (format csv, header false, quote '', escape '');

# Repeat in a fresh scan: absence of usable bounds is cached within a scan,
# while each new scan must prepare its own bounds.
loop scan 0 2

statement ok
call truncate_duckdb_logs();

query I
select id from iceberg_scan('{TEST_DIR}/cached_bounds_{invalid_bound}.metadata.json') order by id;
----
1
1
3
3

# Two data files share one delete entry. Its invalid bound is decoded once,
# including when initialization leaves no usable columns in the cache.
query II
select count(*) filter (message = 'Omitting invalid {invalid_bound} bound for column ''id'' of type INTEGER'),
       count(*) filter (message.starts_with('Iceberg Equality Delete Pruning'))
from duckdb_logs() where type = 'Iceberg';
----
1	0

endloop

endloop
