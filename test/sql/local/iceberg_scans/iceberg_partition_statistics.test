# name: test/sql/local/iceberg_scans/iceberg_partition_statistics.test
# description: iceberg_partition_statistics reads a table's partition statistics files
# group: [iceberg_scans]

require avro

require parquet

require iceberg

# Every partition statistics file of the table, one row per partition
query IIIIII
SELECT partition, statistics_snapshot_id, spec_id, data_record_count, data_file_count, total_record_count
FROM iceberg_partition_statistics('data/persistent/table_partition_statistics')
ORDER BY ALL;
----
{'region': apac}	1002	1	7	1	NULL
{'region': eu}	1001	1	10	1	12
{'region': latam}	1002	1	3	1	NULL
{'region': us}	1001	1	20	2	21

# Counts a file does not have are NULL
query IIIII
SELECT partition, statistics_snapshot_id, position_delete_record_count, position_delete_file_count, dv_count
FROM iceberg_partition_statistics('data/persistent/table_partition_statistics')
ORDER BY ALL;
----
{'region': apac}	1002	NULL	NULL	NULL
{'region': eu}	1001	2	1	0
{'region': latam}	1002	NULL	NULL	NULL
{'region': us}	1001	0	0	1

# The partition is the table's partition struct, not text
query I
SELECT typeof(partition) FROM iceberg_partition_statistics('data/persistent/table_partition_statistics') LIMIT 1;
----
STRUCT(region VARCHAR)

query I
SELECT partition.region
FROM iceberg_partition_statistics('data/persistent/table_partition_statistics', snapshot_from_id => 1001)
ORDER BY ALL;
----
eu
us

query II
SELECT partition.region, data_record_count
FROM iceberg_partition_statistics('data/persistent/table_partition_statistics/metadata/v1.metadata.json',
                                  snapshot_from_timestamp => TIMESTAMP '2023-11-14 22:13:20.500')
ORDER BY ALL;
----
eu	10
us	20

query IIIIIIIIIIIIIIII
SELECT *
FROM iceberg_partition_statistics('data/persistent/table_partition_statistics', snapshot_from_id => 1001)
ORDER BY ALL;
----
1001	data/persistent/table_partition_statistics/metadata/partition-stats-1001.parquet	1933	{'region': eu}	1	10	1	1000	2	1	0	0	12	2023-11-14 22:13:20	1001	0
1001	data/persistent/table_partition_statistics/metadata/partition-stats-1001.parquet	1933	{'region': us}	1	20	2	2200	0	0	0	0	21	2023-11-14 22:13:20	1001	1

# The file must have the size the table metadata registers
statement error
SELECT * FROM iceberg_partition_statistics('data/persistent/table_partition_statistics_bad_size');
----
Invalid Configuration Error: Partition statistics file

# A table without partition statistics files
query I
SELECT count(*) FROM iceberg_partition_statistics('data/persistent/table_statistics');
----
0
