statement ok
CREATE TABLE my_datalake.default.OrphanBuy AS SELECT 31::INTEGER AS id;

statement ok
CREATE TABLE my_datalake.default.orphanbuy AS SELECT 32::INTEGER AS id;

statement ok
BEGIN;

statement ok
SET VARIABLE upper_orphan = (
	SELECT json_extract_string(body::JSON, '$.metadata.location') || '/data/orphan.csv'
	FROM iceberg_test_catalog_request('GET', '/v1/namespaces/default/tables/OrphanBuy', NULL)
);

statement ok
SET VARIABLE lower_orphan = (
	SELECT json_extract_string(body::JSON, '$.metadata.location') || '/data/orphan.csv'
	FROM iceberg_test_catalog_request('GET', '/v1/namespaces/default/tables/orphanbuy', NULL)
);

statement ok
COPY (SELECT 31) TO (getvariable('upper_orphan')) (FORMAT CSV);

statement ok
COPY (SELECT 32) TO (getvariable('lower_orphan')) (FORMAT CSV);

statement ok
COMMIT;

statement ok
ATTACH '' AS orphan_read_only (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	AUTHORIZATION_TYPE 'none', ACCESS_DELEGATION_MODE 'none', READ_ONLY);

statement ok
SET home_directory = parse_dirpath(parse_dirpath(getvariable('upper_orphan')));

statement ok
CALL enable_logging(['HTTP'], storage='memory');

query TIII
SELECT error_code, has_orphan_path(orphan_file_locations, getvariable('upper_orphan')),
	has_orphan_path(orphan_file_locations, getvariable('lower_orphan')), deleted_file_count
FROM iceberg_remove_orphan_files('orphan_read_only.default.OrphanBuy',
	location => '~/data', older_than => TIMESTAMP '2999-01-01', dry_run => true);
----
SUCCESS	true	false	0

query II
SELECT count(*) FILTER (WHERE request.url LIKE '%/tables/OrphanBuy'), count(*) FILTER (WHERE request.url LIKE '%/v1/namespaces')
FROM duckdb_logs_parsed('HTTP');
----
1	0

statement ok
CALL disable_logging();

statement ok
RESET home_directory;

statement error
SELECT * FROM iceberg_remove_orphan_files('orphan_read_only.default.OrphanBuy', dry_run => false);
----
read-only mode

query II
SELECT (SELECT count(*) FROM glob(getvariable('upper_orphan'))), (SELECT count(*) FROM glob(getvariable('lower_orphan')));
----
1	1

statement ok
ATTACH '' AS orphan_lowercase (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	AUTHORIZATION_TYPE 'none', ACCESS_DELEGATION_MODE 'none', IDENTIFIER_CASE 'lowercase');

foreach schema_name default DEFAULT

query TII
SELECT error_code, has_orphan_path(orphan_file_locations, getvariable('lower_orphan')),
	has_orphan_path(orphan_file_locations, getvariable('upper_orphan'))
FROM iceberg_remove_orphan_files('orphan_lowercase.{schema_name}.OrphanBuy', dry_run => true, older_than => TIMESTAMP '2999-01-01');
----
SUCCESS	true	false

endloop

# Reuse the two tables to verify the bounds of cleanup on a shared write path.
foreach table_name OrphanBuy orphanbuy

statement ok
ALTER TABLE my_datalake.default.{table_name} SET ('write.data.path' = '{TEMP_DIR_ABSOLUTE}/orphan-shared');

statement ok
INSERT INTO my_datalake.default.{table_name} VALUES (42);

endloop

statement ok
BEGIN;

statement ok
SET VARIABLE other_table_file = (
	SELECT file_path
	FROM iceberg_metadata(my_datalake.default.orphanbuy)
	WHERE content = 'DATA' AND parse_filename(parse_dirpath(file_path)) = 'orphan-shared'
);

query TII
SELECT error_code, scanned_files > 0, has_orphan_path(orphan_file_locations, getvariable('other_table_file'))
FROM iceberg_remove_orphan_files('my_datalake.default.OrphanBuy',
	dry_run => true, older_than => TIMESTAMP '2999-01-01');
----
SUCCESS	true	false

statement ok
COMMIT;

query TI
SELECT error_code, scanned_files
FROM iceberg_remove_orphan_files('my_datalake.default.OrphanBuy',
	location => '{TEMP_DIR_ABSOLUTE}/orphan-shared', dry_run => true, older_than => TIMESTAMP '2999-01-01');
----
PREFIX_MISMATCH	0

statement ok
ALTER TABLE my_datalake.default.OrphanBuy SET ('gc.enabled' = 'not-a-boolean');

statement error
SELECT * FROM iceberg_remove_orphan_files('my_datalake.default.OrphanBuy', dry_run => true);
----
expected 'true' or 'false'

# COPY writes version-hint.text into the configured metadata directory.
statement ok
COPY (SELECT 42::INTEGER AS val) TO '{TEMP_DIR_ABSOLUTE}/orphan-custom'
	(FORMAT ICEBERG, "write.metadata.path" '{TEMP_DIR_ABSOLUTE}/orphan-custom/custom-meta');

statement ok
COPY (SELECT 1) TO '{TEMP_DIR_ABSOLUTE}/orphan-custom/custom-meta/current-version.txt' (FORMAT CSV);

statement ok
COPY (SELECT 1) TO '{TEMP_DIR_ABSOLUTE}/orphan-custom/unrelated.txt' (FORMAT CSV);

statement ok
BEGIN;

statement ok
SET VARIABLE custom_metadata_path = (SELECT file FROM glob('{TEMP_DIR_ABSOLUTE}/orphan-custom/custom-meta/*.metadata.json'));

statement ok
SET VARIABLE custom_metadata = (SELECT content::JSON FROM read_text(getvariable('custom_metadata_path')));

statement ok
FROM orphan_load_response(json_object('metadata-location', getvariable('custom_metadata_path'),
	'metadata', getvariable('custom_metadata')));

statement ok
COMMIT;

query TI
SELECT error_code, len(orphan_file_locations) = 1 AND parse_filename(orphan_file_locations[1]) = 'unrelated.txt'
FROM iceberg_remove_orphan_files('my_datalake.default.orphan_metadata',
	dry_run => true, older_than => TIMESTAMP '2999-01-01');
----
SUCCESS	true
