# name: test/sql/local/native_catalog/file_credentials_recording.test
# description: the credential recorder handles a trailing directory separator and reports portable paths
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require iceberg_test_credentials

statement ok
CREATE TABLE my_datalake.default.fc_recording AS SELECT 42 AS i;

statement ok
PRAGMA iceberg_test_credentials_record('{TEMP_DIR}/iceberg-native/');

query I
SELECT i FROM my_datalake.default.fc_recording;
----
42

# Recorded paths use forward slashes so assertions have the same meaning on Windows.
query III
SELECT count(*) FILTER (path LIKE '%/data/%.parquet') > 0, bool_and(contains(path, '/iceberg-native/') AND NOT contains(path, '\')), bool_or(has_credentials)
FROM iceberg_test_credentials_reads();
----
true	true	false

statement ok
PRAGMA iceberg_test_credentials_clear_reads;

query I
SELECT count(*) FROM iceberg_test_credentials_reads();
----
0
