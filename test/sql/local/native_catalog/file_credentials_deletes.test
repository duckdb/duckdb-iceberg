# name: test/sql/local/native_catalog/file_credentials_deletes.test
# description: a table the credentials callback gives credentials opens its positional delete files (format version 2) and deletion vectors (format version 3) with them
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require iceberg_test_credentials

statement ok
PRAGMA iceberg_test_credentials_record('{TEMP_DIR}/iceberg-native');

foreach version 2 3

statement ok
CREATE TABLE my_datalake.default.fc_deletes_v{version} (i INTEGER) WITH ('format-version' = '{version}', 'write.delete.mode' = 'merge-on-read');

statement ok
INSERT INTO my_datalake.default.fc_deletes_v{version} SELECT range FROM range(5);

statement ok
DELETE FROM my_datalake.default.fc_deletes_v{version} WHERE i = 1;

statement ok
PRAGMA iceberg_test_credentials('my_datalake', 'default', 'fc_deletes_v{version}', '{TEMP_DIR}/iceberg-native/');

endloop

statement ok
PRAGMA iceberg_test_credentials_clear_reads;

query I
SELECT sum(i) FROM my_datalake.default.fc_deletes_v2;
----
9

query III
SELECT count(*) FILTER (path LIKE '%-deletes.parquet') > 0, bool_and(has_credentials), bool_and(key_id = 'ICEBERG_TEST_CREDENTIALS') FROM iceberg_test_credentials_reads() WHERE contains(path, '/warehouse/');
----
true	true	true

statement ok
PRAGMA iceberg_test_credentials_clear_reads;

query I
SELECT sum(i) FROM my_datalake.default.fc_deletes_v3;
----
9

query III
SELECT count(*) FILTER (path LIKE '%-deletes.puffin') > 0, bool_and(has_credentials), bool_and(key_id = 'ICEBERG_TEST_CREDENTIALS') FROM iceberg_test_credentials_reads() WHERE contains(path, '/warehouse/');
----
true	true	true
