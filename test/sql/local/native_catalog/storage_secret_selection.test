# name: test/sql/local/native_catalog/storage_secret_selection.test
# description: Explicit storage secrets take precedence over automatic AWS credentials for SigV4 catalogs
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require aws

statement ok
LOAD aws;

statement ok
SET allow_persistent_secrets=false;

statement ok
CALL enable_logging('HTTP');

statement ok
SET redact_http_logs=false;

# Unnamed explicit secrets of either type must win over the automatic defaults.
foreach secret_type s3 aws

statement ok
CREATE SECRET (TYPE {secret_type}, KEY_ID 'explicit-default', SECRET 'test-secret', REGION 'us-east-1');

statement ok
CALL truncate_duckdb_logs();

statement ok
ATTACH '' AS signing_default (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	AUTHORIZATION_TYPE 'sigv4', SIGV4_REGION 'us-east-1', SIGV4_SERVICE 'custom');

query I
SELECT request.headers['Authorization'] LIKE '%Credential=explicit-default/%'
FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%/config';
----
true

statement ok
DETACH signing_default;

statement ok
DROP SECRET __default_{secret_type};

endloop

# Scope lookup must compare scores across types. Even a catch-all explicit
# secret outranks the automatic credentials, regardless of the type searched first.
foreach secret_type s3 aws

statement ok
CREATE SECRET explicit_storage (TYPE {secret_type}, KEY_ID 'explicit-scoped', SECRET 'test-secret',
	REGION 'us-east-1', SCOPE '');

statement ok
CALL truncate_duckdb_logs();

statement ok
ATTACH '' AS signing_scoped (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	AUTHORIZATION_TYPE 'sigv4', SIGV4_REGION 'us-east-1', SIGV4_SERVICE 'custom');

query I
SELECT request.headers['Authorization'] LIKE '%Credential=explicit-scoped/%'
FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%/config';
----
true

statement ok
DETACH signing_scoped;

statement ok
DROP SECRET explicit_storage;

endloop

# Check both explicit defaults before scope lookup: the AWS default wins even
# when an S3 secret has a more specific scope.
statement ok
CREATE SECRET scoped_s3 (TYPE S3, KEY_ID 'scoped-s3', SECRET 'test-secret', REGION 'us-east-1');

statement ok
CREATE SECRET (TYPE AWS, KEY_ID 'default-aws', SECRET 'test-secret', REGION 'us-east-1');

statement ok
CALL truncate_duckdb_logs();

statement ok
ATTACH '' AS signing_default_aws (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	AUTHORIZATION_TYPE 'sigv4', SIGV4_REGION 'us-east-1', SIGV4_SERVICE 'custom');

query I
SELECT request.headers['Authorization'] LIKE '%Credential=default-aws/%'
FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%/config';
----
true

statement ok
DETACH signing_default_aws;

# When both explicit defaults exist, the ordered type preference selects S3.
statement ok
CREATE SECRET (TYPE S3, KEY_ID 'default-s3', SECRET 'test-secret', REGION 'us-east-1');

statement ok
CALL truncate_duckdb_logs();

statement ok
ATTACH '' AS signing_both_defaults (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	AUTHORIZATION_TYPE 'sigv4', SIGV4_REGION 'us-east-1', SIGV4_SERVICE 'custom');

query I
SELECT request.headers['Authorization'] LIKE '%Credential=default-s3/%'
FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%/config';
----
true

statement ok
DETACH signing_both_defaults;

statement ok
DROP SECRET __default_s3;

# An explicit SECRET selector still takes precedence over every implicit choice.
statement ok
CALL truncate_duckdb_logs();

statement ok
ATTACH '' AS signing_named (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	AUTHORIZATION_TYPE 'sigv4', SECRET scoped_s3, SIGV4_REGION 'us-east-1', SIGV4_SERVICE 'custom');

query I
SELECT request.headers['Authorization'] LIKE '%Credential=scoped-s3/%'
FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%/config';
----
true

statement ok
DETACH signing_named;

statement ok
DROP SECRET __default_aws;

statement ok
DROP SECRET scoped_s3;
