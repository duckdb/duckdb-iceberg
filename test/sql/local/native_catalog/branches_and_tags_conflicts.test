# name: test/sql/local/native_catalog/branches_and_tags_conflicts.test
# description: A branch or tag change fails to commit when another writer changed the same ref first
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require json

statement ok
CREATE TABLE my_datalake.default.ref_conflicts (id INTEGER);

statement ok
INSERT INTO my_datalake.default.ref_conflicts VALUES (1);

statement ok
SET VARIABLE s1 = (
	SELECT json_extract(body, '$.metadata."current-snapshot-id"')::BIGINT
	FROM iceberg_test_catalog_request('GET', '/v1/namespaces/default/tables/ref_conflicts', NULL)
);

statement ok
INSERT INTO my_datalake.default.ref_conflicts VALUES (2);

statement ok
SET VARIABLE s2 = (
	SELECT json_extract(body, '$.metadata."current-snapshot-id"')::BIGINT
	FROM iceberg_test_catalog_request('GET', '/v1/namespaces/default/tables/ref_conflicts', NULL)
);

# Create fails if another writer created the same name first
statement ok
BEGIN;

statement ok
SELECT * FROM iceberg_create_branch('my_datalake.default.ref_conflicts', 'dev');

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/ref_conflicts',
	json_object('requirements', json_array(), 'updates', json_array(
		json_object('action', 'set-snapshot-ref', 'ref-name', 'dev', 'type', 'tag',
			'snapshot-id', getvariable('s1')))));
----
200

statement error
COMMIT;
----
Requirement failed: assert-ref-snapshot-id

query III
SELECT name, type, snapshot_id = getvariable('s1') FROM iceberg_refs('my_datalake.default.ref_conflicts') WHERE name = 'dev';
----
dev	TAG	true

# Drop fails if another writer moved the ref first
statement ok
BEGIN;

statement ok
SELECT * FROM iceberg_drop_tag('my_datalake.default.ref_conflicts', 'dev');

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/ref_conflicts',
	json_object('requirements', json_array(), 'updates', json_array(
		json_object('action', 'set-snapshot-ref', 'ref-name', 'dev', 'type', 'tag',
			'snapshot-id', getvariable('s2')))));
----
200

statement error
COMMIT;
----
Requirement failed: assert-ref-snapshot-id

query III
SELECT name, type, snapshot_id = getvariable('s2') FROM iceberg_refs('my_datalake.default.ref_conflicts') WHERE name = 'dev';
----
dev	TAG	true

# Drop fails if another writer dropped the ref first
statement ok
BEGIN;

statement ok
SELECT * FROM iceberg_drop_tag('my_datalake.default.ref_conflicts', 'dev');

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/ref_conflicts',
	json_object('requirements', json_array(), 'updates', json_array(
		json_object('action', 'remove-snapshot-ref', 'ref-name', 'dev'))));
----
200

statement error
COMMIT;
----
Requirement failed: assert-ref-snapshot-id

query II
SELECT name, type FROM iceberg_refs('my_datalake.default.ref_conflicts') ORDER BY name;
----
main	BRANCH

# Snapshot expiration can't share a transaction with ref changes
statement ok
BEGIN;

statement ok
SELECT * FROM iceberg_create_tag('my_datalake.default.ref_conflicts', 'v1');

statement error
SELECT * FROM iceberg_expire_snapshots('my_datalake.default.ref_conflicts', retain_last => 1);
----
Snapshot expiration cannot follow branch or tag changes in the same transaction

statement ok
ROLLBACK;

statement ok
BEGIN;

statement ok
SELECT * FROM iceberg_expire_snapshots('my_datalake.default.ref_conflicts', retain_last => 1,
	older_than => TIMESTAMP '2999-01-01');

statement error
SELECT * FROM iceberg_create_tag('my_datalake.default.ref_conflicts', 'v1');
----
Branch and tag changes cannot be combined with snapshot expiration in the same transaction

statement ok
ROLLBACK;
