# name: test/sql/local/native_catalog/file_credentials_transactions.test
# description: a transaction's own copy of a table it wrote, and a table it reconstructs from the metadata log because another connection committed to it after the transaction started, read with the credentials the callback gives the table
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require iceberg_test_credentials

statement ok
PRAGMA iceberg_test_credentials_record('{TEMP_DIR}/iceberg-native');

statement ok
CREATE TABLE my_datalake.default.fc_txn AS SELECT range AS i FROM range(3);

statement ok
PRAGMA iceberg_test_credentials('my_datalake', 'default', 'fc_txn', '{TEMP_DIR}/iceberg-native/');

#---------------------------------------------------------------------------
# a table the transaction wrote to: its scan reads the files of the transaction's copy with the credentials
#---------------------------------------------------------------------------
statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.fc_txn VALUES (10);

statement ok
PRAGMA iceberg_test_credentials_clear_reads;

query I
SELECT sum(i) FROM my_datalake.default.fc_txn;
----
13

query III
SELECT count(*) FILTER (path LIKE '%/data/%.parquet') > 0, bool_and(has_credentials), bool_and(key_id = 'ICEBERG_TEST_CREDENTIALS') FROM iceberg_test_credentials_reads() WHERE contains(path, '/warehouse/');
----
true	true	true

statement ok
COMMIT;

#---------------------------------------------------------------------------
# a transaction that started before another connection committed to the table reads the table's state at its start
# from the metadata log: the metadata file it reads from the log is opened with the credentials
#---------------------------------------------------------------------------
statement ok con1
BEGIN;

statement ok con1
SELECT 1;

statement ok con2
INSERT INTO my_datalake.default.fc_txn VALUES (100);

statement ok
PRAGMA iceberg_test_credentials_clear_reads;

query I con1
SELECT sum(i) FROM my_datalake.default.fc_txn;
----
13

statement ok con1
COMMIT;

query III
SELECT count(*) FILTER (path LIKE '%.metadata.json') > 0, bool_and(has_credentials), bool_and(key_id = 'ICEBERG_TEST_CREDENTIALS') FROM iceberg_test_credentials_reads() WHERE contains(path, '/warehouse/');
----
true	true	true
