# name: test/sql/local/native_catalog/file_credentials_scan.test
# description: a table the credentials callback gives credentials opens its manifest list, manifests and data files with them, also through iceberg_scan and iceberg_metadata; a table without, and a read of the same files by path, read by path
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require iceberg_test_credentials

statement ok
PRAGMA iceberg_test_credentials_record('{TEMP_DIR}/iceberg-native');

statement ok
CREATE TABLE my_datalake.default.fc_scan AS SELECT range AS i FROM range(3);

statement ok
CREATE TABLE my_datalake.default.fc_plain AS SELECT range AS i FROM range(3);

statement ok
PRAGMA iceberg_test_credentials('my_datalake', 'default', 'fc_scan', '{TEMP_DIR}/iceberg-native/');

#---------------------------------------------------------------------------
# with credentials: the manifest list, the manifests and the data files are each opened with them
#---------------------------------------------------------------------------
statement ok
PRAGMA iceberg_test_credentials_clear_reads;

query I
SELECT sum(i) FROM my_datalake.default.fc_scan;
----
3

query IIIII
SELECT count(*) FILTER (path LIKE '%/metadata/snap-%.avro') > 0, count(*) FILTER (path LIKE '%/metadata/%-m%.avro') > 0, count(*) FILTER (path LIKE '%/data/%.parquet') > 0, bool_and(has_credentials), bool_and(key_id = 'ICEBERG_TEST_CREDENTIALS') FROM iceberg_test_credentials_reads() WHERE contains(path, '/warehouse/');
----
true	true	true	true	true

#---------------------------------------------------------------------------
# without credentials: nothing carries them
#---------------------------------------------------------------------------
statement ok
PRAGMA iceberg_test_credentials_clear_reads;

query I
SELECT sum(i) FROM my_datalake.default.fc_plain;
----
3

query II
SELECT count(*) > 0, bool_or(has_credentials) FROM iceberg_test_credentials_reads() WHERE contains(path, '/warehouse/');
----
true	false

#---------------------------------------------------------------------------
# a read of the data files of the table with credentials by path carries none
#---------------------------------------------------------------------------
statement ok
SET VARIABLE fc_scan_files = (SELECT list(DISTINCT filename) FROM my_datalake.default.fc_scan);

statement ok
PRAGMA iceberg_test_credentials_clear_reads;

query I
SELECT sum(i) FROM read_parquet(getvariable('fc_scan_files'));
----
3

query II
SELECT count(*) > 0, bool_or(has_credentials) FROM iceberg_test_credentials_reads() WHERE contains(path, '/warehouse/');
----
true	false

#---------------------------------------------------------------------------
# credentials whose scope does not cover the table's files refuse to read them
#---------------------------------------------------------------------------
statement ok
PRAGMA iceberg_test_credentials('my_datalake', 'default', 'fc_plain', '{TEMP_DIR}/elsewhere/');

statement error
SELECT sum(i) FROM my_datalake.default.fc_plain;
----
cannot be used for

statement ok
PRAGMA iceberg_test_credentials('my_datalake', 'default', 'fc_plain', '');

#---------------------------------------------------------------------------
# iceberg_metadata and iceberg_scan of the table read it with the credentials
#---------------------------------------------------------------------------
statement ok
PRAGMA iceberg_test_credentials_clear_reads;

statement ok
SELECT * FROM iceberg_metadata(my_datalake.default.fc_scan);

query III
SELECT count(*) FILTER (path LIKE '%.avro') > 0, bool_and(has_credentials), bool_and(key_id = 'ICEBERG_TEST_CREDENTIALS') FROM iceberg_test_credentials_reads() WHERE contains(path, '/warehouse/');
----
true	true	true

statement ok
PRAGMA iceberg_test_credentials_clear_reads;

query I
SELECT sum(i) FROM iceberg_scan('my_datalake.default.fc_scan');
----
3

query III
SELECT count(*) FILTER (path LIKE '%/data/%.parquet') > 0, bool_and(has_credentials), bool_and(key_id = 'ICEBERG_TEST_CREDENTIALS') FROM iceberg_test_credentials_reads() WHERE contains(path, '/warehouse/');
----
true	true	true

#---------------------------------------------------------------------------
# iceberg_scan_plan refuses a table read with credentials: a scan task names its files by path
#---------------------------------------------------------------------------
statement error
SELECT * FROM iceberg_scan_plan('my_datalake.default.fc_scan');
----
whose files are read with file credentials

#---------------------------------------------------------------------------
# a CTE referenced twice: the scan is not copied through serialization, so every read carries the credentials
#---------------------------------------------------------------------------
statement ok
PRAGMA iceberg_test_credentials_clear_reads;

query II
WITH c AS NOT MATERIALIZED (SELECT i FROM my_datalake.default.fc_scan) SELECT (SELECT sum(i) FROM c), (SELECT count(*) FROM c);
----
3	3

query II
SELECT count(*) > 0, bool_and(key_id = 'ICEBERG_TEST_CREDENTIALS') FROM iceberg_test_credentials_reads() WHERE contains(path, '/warehouse/');
----
true	true

#---------------------------------------------------------------------------
# a prepared statement executed in later transactions binds the table again, with the credentials of each
#---------------------------------------------------------------------------
statement ok
PREPARE fc_prepared AS SELECT sum(i) FROM my_datalake.default.fc_scan;

statement ok
PRAGMA iceberg_test_credentials_clear_reads;

query I
EXECUTE fc_prepared;
----
3

query I
EXECUTE fc_prepared;
----
3

query II
SELECT count(*) FILTER (path LIKE '%/data/%.parquet') >= 2, bool_and(key_id = 'ICEBERG_TEST_CREDENTIALS') FROM iceberg_test_credentials_reads() WHERE contains(path, '/warehouse/');
----
true	true

#---------------------------------------------------------------------------
# with two callbacks registered, a read of the table fails rather than pick one of them
#---------------------------------------------------------------------------
statement ok
PRAGMA iceberg_test_credentials_register;

statement error
SELECT sum(i) FROM my_datalake.default.fc_scan;
----
More than one extension registered an IcebergFileCredentialsCallback
