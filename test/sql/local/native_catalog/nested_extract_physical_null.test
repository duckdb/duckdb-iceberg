# name: test/sql/local/native_catalog/nested_extract_physical_null.test
# description: Explicitly NULL Parquet fields use the Iceberg scan type for nested extracts and filters
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

statement ok
CREATE TABLE my_datalake.default.nested_physical_null (
	id INTEGER, s STRUCT(leaf INTEGER, n STRUCT(value INTEGER), kept INTEGER)
) WITH ('write.metadata.metrics.default' = 'none');

statement ok
INSERT INTO my_datalake.default.nested_physical_null VALUES
	(1, {'leaf': NULL, 'n': NULL, 'kept': 1}),
	(2, NULL),
	(3, {'leaf': NULL, 'n': NULL, 'kept': 3});

# Model an external writer that uses Parquet's NULL logical type for all-NULL fields.
# Preserve the field IDs and values, and keep metadata discovery and file access in one transaction.
statement ok
BEGIN;

statement ok
SET VARIABLE physical_null_file = (
	SELECT file_path FROM iceberg_metadata('my_datalake.default.nested_physical_null')
);

statement ok
SET VARIABLE physical_null_ids = (
	SELECT map(list(name), list(field_id)) FROM parquet_schema(getvariable('physical_null_file'))
	WHERE field_id IS NOT NULL
);

statement ok
COPY (
	SELECT id::INTEGER AS id,
	       CASE WHEN id = 2 THEN NULL ELSE {'leaf': NULL, 'n': NULL, 'kept': id::INTEGER} END AS s
	FROM range(1, 4) r(id)
) TO (getvariable('physical_null_file')) (
	FORMAT PARQUET,
	FIELD_IDS {
		id: getvariable('physical_null_ids')['id'],
		s: {
			__duckdb_field_id: getvariable('physical_null_ids')['s'],
			leaf: getvariable('physical_null_ids')['leaf'],
			n: getvariable('physical_null_ids')['n'],
			kept: getvariable('physical_null_ids')['kept']
		}
	}
);

query II
SELECT typeof(s.leaf) = '"NULL"', typeof(s.n) = '"NULL"'
FROM read_parquet(getvariable('physical_null_file')) LIMIT 1;
----
true	true

statement ok
COMMIT;

query ITITI
SELECT id, s.leaf::VARCHAR, s.leaf::BIGINT, s.n.value::VARCHAR, s.kept
FROM my_datalake.default.nested_physical_null ORDER BY id;
----
1	NULL	NULL	NULL	1
2	NULL	NULL	NULL	NULL
3	NULL	NULL	NULL	3

query I
SELECT id FROM my_datalake.default.nested_physical_null
WHERE s.leaf < 0 OR id = 3 ORDER BY id;
----
3

query I
SELECT count(*) FROM my_datalake.default.nested_physical_null WHERE s.n.value = 7;
----
0

query I
SELECT count(*) FROM my_datalake.default.nested_physical_null WHERE s.n.value::VARCHAR IS NULL;
----
3

query ITT
SELECT id, s.n, s.n::VARCHAR FROM my_datalake.default.nested_physical_null ORDER BY id;
----
1	NULL	NULL
2	NULL	NULL
3	NULL	NULL

statement ok
DROP TABLE my_datalake.default.nested_physical_null;
