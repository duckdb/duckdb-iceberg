# name: test/sql/local/native_catalog/required_list_elements.test
# description: Empty lists have no elements that can violate a nested NOT NULL constraint
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables',
	'{"name":"required_list_elements","schema":{"type":"struct","schema-id":0,"fields":[
		{"id":1,"name":"label","required":false,"type":{"type":"struct","fields":[
			{"id":2,"name":"controls","required":true,"type":{"type":"list","element-id":3,"element-required":true,"element":"string"}}
		]}},
		{"id":4,"name":"tags","required":true,"type":{"type":"list","element-id":5,"element-required":true,"element":"string"}}
	]}}');
----
200

statement ok
INSERT INTO my_datalake.default.required_list_elements VALUES
	(struct_pack(controls := []::VARCHAR[]), []::VARCHAR[]),
	(struct_pack(controls := ['x']), ['y']), (NULL, []::VARCHAR[]);

query II
SELECT label.controls, tags FROM my_datalake.default.required_list_elements ORDER BY len(label.controls) NULLS LAST;
----
[]	[]
[x]	[y]
NULL	[]

statement error
INSERT INTO my_datalake.default.required_list_elements VALUES
	(struct_pack(controls := ['valid']), ['ok']), (struct_pack(controls := [NULL]::VARCHAR[]), ['ok']);
----
NOT NULL constraint failed

statement error
INSERT INTO my_datalake.default.required_list_elements VALUES (struct_pack(controls := NULL::VARCHAR[]), ['ok']);
----
NOT NULL constraint failed

statement error
INSERT INTO my_datalake.default.required_list_elements VALUES (NULL, [NULL]::VARCHAR[]);
----
NOT NULL constraint failed

query I
SELECT count(*) FROM my_datalake.default.required_list_elements;
----
3

statement ok
DROP TABLE my_datalake.default.required_list_elements;
