# name: test/sql/local/native_catalog/copy_on_write_delete_row_lineage.test
# description: A server-planned delete preserves 64-bit row IDs and inherits sequence numbers from manifests
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require json

statement ok
CREATE TABLE my_datalake.default.cow_large_ids (k INTEGER)
WITH ('format-version' = '3', 'write.delete.mode' = 'copy-on-write');

# Start the first real allocation above the 32-bit range without writing billions of rows.
statement ok
SET VARIABLE empty_table = (
    SELECT json_merge_patch(body::JSON, '{"metadata":{"next-row-id":4294967296}}')
    FROM iceberg_test_catalog_request('GET', '/v1/namespaces/default/tables/cow_large_ids', NULL)
);

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response', json_object(
    'method', 'GET', 'path', '/v1/namespaces/default/tables/cow_large_ids', 'status', 200,
    'body', getvariable('empty_table')));
----
204

statement ok
INSERT INTO my_datalake.default.cow_large_ids VALUES (10), (20), (30);

query I
SELECT status FROM iceberg_test_catalog_request('DELETE', '/__test/response', NULL);
----
204

query III
SELECT k, _row_id, _last_updated_sequence_number FROM my_datalake.default.cow_large_ids ORDER BY k;
----
10	4294967296	1
20	4294967297	1
30	4294967298	1

statement ok
SET VARIABLE plan_config = (
    SELECT json_merge_patch(body::JSON, json_object('endpoints', list_append((body::JSON->'endpoints')::VARCHAR[],
        'POST /v1/{prefix}/namespaces/{namespace}/tables/{table}/plan')))
    FROM iceberg_test_catalog_request('GET', '/v1/config', NULL)
);

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response',
    json_object('method', 'GET', 'path', '/v1/config', 'status', 200, 'body', getvariable('plan_config')));
----
204

statement ok
ATTACH '' AS planned_catalog (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
    AUTHORIZATION_TYPE 'none', ACCESS_DELEGATION_MODE 'none');

# REST scan tasks supply the starting ID, but omit the data sequence number needed by the rewrite.
statement ok
SET VARIABLE planned_file = (
    SELECT json_object('spec-id', 0, 'partition', []::JSON[], 'content', 'data', 'file-path', file_path,
        'file-format', 'parquet', 'file-size-in-bytes', file_size_in_bytes, 'record-count', record_count,
        'first-row-id', first_row_id)
    FROM iceberg_scan_plan(my_datalake.default.cow_large_ids)
);

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response',
    json_object('method', 'POST', 'path', '/v1/namespaces/default/tables/cow_large_ids/plan', 'status', 200,
        'body', json_object('status', 'completed', 'file-scan-tasks', [json_object('data-file', getvariable('planned_file'))])));
----
204

statement ok
SET iceberg_use_server_side_scan_planning = true;

statement ok
CALL enable_logging(level = debug);

query I
DELETE FROM planned_catalog.default.cow_large_ids WHERE _row_id = 4294967297;
----
1

query II
SELECT count(*) FILTER (WHERE message.contains('/plan body=')) > 0,
       count(*) FILTER (WHERE message.contains('Scan planning failed'))
FROM duckdb_logs() WHERE type = 'Iceberg';
----
true	0

query III
SELECT k, _row_id, _last_updated_sequence_number FROM my_datalake.default.cow_large_ids ORDER BY k;
----
10	4294967296	1
30	4294967298	1

statement ok
CALL disable_logging();

statement ok
DETACH planned_catalog;

query I
SELECT status FROM iceberg_test_catalog_request('DELETE', '/__test/response', NULL);
----
204

statement ok
DROP TABLE my_datalake.default.cow_large_ids;
