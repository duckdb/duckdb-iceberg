# name: test/sql/local/native_catalog/invalid_scan_plan_metadata.test
# description: Reject corrupt server-planned file metadata before falling back to validated manifests
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require json

statement ok
CREATE TABLE my_datalake.default.invalid_scan_plan_metadata (id INTEGER);

statement ok
INSERT INTO my_datalake.default.invalid_scan_plan_metadata VALUES (1), (2);

statement ok
BEGIN;

statement ok
SET VARIABLE planned_file = (
	SELECT json_object('spec-id', 0, 'partition', []::JSON[], 'content', 'data',
		'file-path', file_path, 'file-format', 'parquet', 'file-size-in-bytes', 100, 'record-count', record_count)
	FROM iceberg_metadata(my_datalake.default.invalid_scan_plan_metadata)
	WHERE status = 'ADDED'
);

statement ok
COMMIT;

# Advertise the plan endpoint only on this attachment, then inject its responses.
statement ok
SET VARIABLE plan_config = (
	SELECT json_merge_patch(body::JSON, json_object('endpoints',
		list_append((body::JSON->'endpoints')::VARCHAR[],
			'POST /v1/{prefix}/namespaces/{namespace}/tables/{table}/plan')))
	FROM iceberg_test_catalog_request('GET', '/v1/config', NULL)
);

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response',
	json_object('method', 'GET', 'path', '/v1/config', 'status', 200, 'body', getvariable('plan_config')));
----
204

statement ok
ATTACH '' AS planned_catalog (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	AUTHORIZATION_TYPE 'none', ACCESS_DELEGATION_MODE 'none');

statement ok
SET iceberg_use_server_side_scan_planning = true;

statement ok
CALL enable_logging(level=debug);

statement ok
CREATE TABLE scan_plan_patches (patch JSON);

statement ok
INSERT INTO scan_plan_patches VALUES
	('{"record-count":-1}'),
	('{"file-size-in-bytes":-1}'),
	('{"file-path":""}'),
	('{"null-value-counts":{"keys":[1],"values":[-1]}}');

loop i 0 4

statement ok
SET VARIABLE planned_response = (
	SELECT json_object('status', 'completed', 'file-scan-tasks',
		[json_object('data-file', json_merge_patch(getvariable('planned_file'), patch))])
	FROM scan_plan_patches WHERE rowid = {i}
);

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response',
	json_object('method', 'POST', 'path', '/v1/namespaces/default/tables/invalid_scan_plan_metadata/plan',
		'status', 200, 'body', getvariable('planned_response')));
----
204

statement ok
CALL truncate_duckdb_logs();

# Server planning is optional: configuration errors are logged, and the query
# falls back to the table's real manifests without invalidating the database.
query I
SELECT list(id ORDER BY id) FROM planned_catalog.default.invalid_scan_plan_metadata;
----
[1, 2]

query I
SELECT count(*) > 0 FROM duckdb_logs()
WHERE message.contains('Scan planning failed')
	AND message.contains('Iceberg server-side scan-planning returned');
----
true

query I
SELECT count(*) FROM duckdb_logs()
WHERE message.contains('INTERNAL') OR message.contains('Internal Error');
----
0

query I
SELECT 42;
----
42

endloop

# A valid response is consumed successfully, proving the test reached server planning.
query I
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response',
	json_object('method', 'POST', 'path', '/v1/namespaces/default/tables/invalid_scan_plan_metadata/plan',
		'status', 200, 'body', json_object('status', 'completed', 'file-scan-tasks',
			[json_object('data-file', getvariable('planned_file'))])));
----
204

statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(id ORDER BY id) FROM planned_catalog.default.invalid_scan_plan_metadata;
----
[1, 2]

query I
SELECT count(*) > 0 FROM duckdb_logs()
WHERE type = 'Iceberg' AND message.contains('/plan body=');
----
true

query I
SELECT count(*) FROM duckdb_logs() WHERE message.contains('Scan planning failed');
----
0

statement ok
CALL disable_logging();

statement ok
DETACH planned_catalog;

query I
SELECT status FROM iceberg_test_catalog_request('DELETE', '/__test/response', NULL);
----
204

statement ok
DROP TABLE my_datalake.default.invalid_scan_plan_metadata;
