# name: test/sql/local/native_catalog/vended_credentials_external_access.test
# description: A table whose catalog vends storage credentials stays readable after enable_external_access is disabled
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require json

statement ok
SET allow_persistent_secrets=false;

statement ok
CREATE TABLE my_datalake.default.vended_external_access AS SELECT range AS i FROM range(3);

# The catalog vends credentials with every load of the table
statement ok
SET VARIABLE vended_response = (
	SELECT json_merge_patch(body::JSON, '{"config": {"s3.access-key-id": "VENDED_KEY", "s3.secret-access-key": "VENDED_SECRET", "s3.region": "us-east-1"}}'::JSON)
	FROM iceberg_test_catalog_request('GET', '/v1/namespaces/default/tables/vended_external_access', NULL)
);

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response',
	json_object('method', 'GET', 'path', '/v1/namespaces/default/tables/vended_external_access', 'status', 200,
		'body', getvariable('vended_response')));
----
204

statement ok
ATTACH '' AS vending (TYPE ICEBERG, URI 'http://iceberg-mock.invalid', AUTHORIZATION_TYPE 'none',
	ACCESS_DELEGATION_MODE 'vended_credentials');

query I
SELECT sum(i) FROM vending.default.vended_external_access;
----
3

# A host that locks the database down after its setup, leaving the catalog and the warehouse reachable
statement ok
SET allowed_directories=['http://iceberg-mock.invalid/', '{TEMP_DIR}/iceberg-native'];

statement ok
SET enable_external_access=false;

# The read stores the vended credentials as a secret of the transaction, which no statement asked for
statement ok
BEGIN;

query I
SELECT sum(i) FROM vending.default.vended_external_access;
----
3

query III
SELECT provider, storage, secret_string LIKE '%key_id=VENDED_KEY;%' FROM duckdb_secrets() WHERE type = 's3';
----
iceberg	transaction	true

statement ok
COMMIT;

query I
SELECT status FROM iceberg_test_catalog_request('DELETE', '/__test/response', NULL);
----
204
