# name: test/sql/local/native_catalog/rewrite_delete_ratio_file_scope.test
# description: Only file-scoped position deletes count towards delete_ratio_threshold, but every applicable delete file counts towards delete_file_threshold
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require json

# Model an external writer with two four-row data files and one position delete file without
# referenced_data_file. 'shared' deletes three rows from each file and has unequal file_path bounds, so it is
# not file-scoped. 'bounds' deletes three rows from the first file only, and its equal file_path bounds scope
# it to that file.
foreach kind shared bounds

statement ok
CREATE TABLE my_datalake.default.rewrite_delete_scope_{kind} (id INTEGER) WITH ('format-version' = 2);

statement ok
SET VARIABLE rewrite_id = (
	SELECT (metadata::JSON->'schemas'->0->'fields'->0->>'id')::INTEGER
	FROM iceberg_load_table_response(my_datalake.default.rewrite_delete_scope_{kind})
);

foreach file a b

statement ok
COPY (SELECT CASE WHEN '{file}' = 'a' THEN range + 1 ELSE range + 5 END::INTEGER AS id FROM range(4))
TO '{TEST_DIR}/scope_{kind}_{file}.parquet' (FORMAT PARQUET, FIELD_IDS {'id': getvariable('rewrite_id')});

endloop

statement ok
COPY (
	SELECT '{TEST_DIR}/scope_{kind}_' || file || '.parquet' AS file_path, pos::BIGINT AS pos
	FROM (VALUES ('a'), ('b')) t(file), range(3) r(pos)
	WHERE file = 'a' OR '{kind}' = 'shared'
	ORDER BY file_path, pos
) TO '{TEST_DIR}/scope_{kind}_delete.parquet'
(FORMAT PARQUET, FIELD_IDS {file_path: 2147483546, pos: 2147483545});

statement ok
COPY (
	SELECT 1::INTEGER AS status, 1::BIGINT AS snapshot_id,
		1::BIGINT AS sequence_number, 1::BIGINT AS file_sequence_number,
		{
			content: 0::INTEGER, file_path: '{TEST_DIR}/scope_{kind}_' || file || '.parquet',
			file_format: 'PARQUET', partition: {}, record_count: 4::BIGINT, file_size_in_bytes: 1000::BIGINT
		} AS data_file
	FROM (VALUES ('a'), ('b')) t(file)
) TO '{TEST_DIR}/scope_{kind}_data.avro' (
	FORMAT AVRO,
	METADATA {'schema-id': '0', 'partition-spec-id': '0', 'format-version': '2', 'content': 'data'},
	FIELD_IDS {
		status: 0, snapshot_id: 1, sequence_number: 3, file_sequence_number: 4,
		data_file: {__duckdb_field_id: 2, content: 134, file_path: 100, file_format: 101,
			partition: 102, record_count: 103, file_size_in_bytes: 104}
	}
);

statement ok
COPY (
	SELECT 1::INTEGER AS status, 2::BIGINT AS snapshot_id,
		2::BIGINT AS sequence_number, 2::BIGINT AS file_sequence_number,
		{
			content: 1::INTEGER, file_path: '{TEST_DIR}/scope_{kind}_delete.parquet',
			file_format: 'PARQUET', partition: {},
			record_count: CASE WHEN '{kind}' = 'shared' THEN 6 ELSE 3 END::BIGINT,
			file_size_in_bytes: 1000::BIGINT,
			lower_bounds: MAP {2147483546: encode('{TEST_DIR}/scope_{kind}_a.parquet')},
			upper_bounds: MAP {2147483546: encode('{TEST_DIR}/scope_{kind}_' ||
				CASE WHEN '{kind}' = 'shared' THEN 'b' ELSE 'a' END || '.parquet')}
		} AS data_file
) TO '{TEST_DIR}/scope_{kind}_deletes.avro' (
	FORMAT AVRO,
	METADATA {'schema-id': '0', 'partition-spec-id': '0', 'format-version': '2', 'content': 'deletes'},
	FIELD_IDS {
		status: 0, snapshot_id: 1, sequence_number: 3, file_sequence_number: 4,
		data_file: {__duckdb_field_id: 2, content: 134, file_path: 100, file_format: 101,
			partition: 102, record_count: 103, file_size_in_bytes: 104,
			lower_bounds: {__duckdb_field_id: 125, key: 126, value: 127},
			upper_bounds: {__duckdb_field_id: 128, key: 129, value: 130}}
	}
);

statement ok
COPY (
	SELECT '{TEST_DIR}/scope_{kind}_' || manifest || '.avro' AS manifest_path,
		1000::BIGINT AS manifest_length, 0::INTEGER AS partition_spec_id, content::INTEGER AS content,
		2::BIGINT AS sequence_number, 1::BIGINT AS min_sequence_number, 2::BIGINT AS added_snapshot_id,
		files::INTEGER AS added_files_count, 0::INTEGER AS existing_files_count, 0::INTEGER AS deleted_files_count,
		rows::BIGINT AS added_rows_count, 0::BIGINT AS existing_rows_count, 0::BIGINT AS deleted_rows_count
	FROM (VALUES ('data', 0, 2, 8), ('deletes', 1, 1, CASE WHEN '{kind}' = 'shared' THEN 6 ELSE 3 END))
		t(manifest, content, files, rows)
) TO '{TEST_DIR}/scope_{kind}_list.avro' (
	FORMAT AVRO,
	FIELD_IDS {
		manifest_path: 500, manifest_length: 501, partition_spec_id: 502,
		content: 517, sequence_number: 515, min_sequence_number: 516, added_snapshot_id: 503,
		added_files_count: 504, existing_files_count: 505, deleted_files_count: 506,
		added_rows_count: 512, existing_rows_count: 513, deleted_rows_count: 514
	}
);

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/rewrite_delete_scope_{kind}',
	json_object('requirements', json_array(), 'updates', json_array(
		json_object('action', 'add-snapshot', 'snapshot', json_object(
			'snapshot-id', 2, 'sequence-number', 2, 'schema-id', 0,
			'timestamp-ms', epoch_ms(current_timestamp), 'manifest-list', '{TEST_DIR}/scope_{kind}_list.avro',
			'summary', json_object('operation', 'overwrite'))),
		json_object('action', 'set-snapshot-ref', 'ref-name', 'main', 'type', 'branch', 'snapshot-id', 2))));
----
200

query I
SELECT list(id ORDER BY id) = CASE WHEN '{kind}' = 'shared' THEN [4, 8] ELSE [4, 5, 6, 7, 8] END
FROM my_datalake.default.rewrite_delete_scope_{kind};
----
true

endloop

# The shared delete removes 3 of 4 rows from each file, but it is not file-scoped,
# so neither file reaches the delete ratio. Two files are below min_input_files.
query IIIII
CALL iceberg_rewrite_data_files('my_datalake.default.rewrite_delete_scope_shared', delete_ratio_threshold := 0.1);
----
0	0	0	0	0

# Every applicable delete file counts towards delete_file_threshold. Both files are
# rewritten, so the shared delete is fully applied and removed.
query IIII
SELECT rewritten_data_files_count, added_data_files_count, failed_data_files_count, removed_delete_files_count
FROM iceberg_rewrite_data_files('my_datalake.default.rewrite_delete_scope_shared', delete_file_threshold := 1);
----
2	1	0	1

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.rewrite_delete_scope_shared;
----
[4, 8]

# Equal file_path bounds scope the delete to the first file: 3 of its 4 rows are deleted.
# With both files inside the size band, only that file is selected.
query III
SELECT rewritten_data_files_count, added_data_files_count, failed_data_files_count
FROM iceberg_rewrite_data_files('my_datalake.default.rewrite_delete_scope_bounds', min_file_size_bytes := 0,
	delete_ratio_threshold := 0.8);
----
0	0	0

# The delete is scoped to the rewritten file by its bounds alone, so it is fully applied and removed
query IIII
SELECT rewritten_data_files_count, added_data_files_count, failed_data_files_count, removed_delete_files_count
FROM iceberg_rewrite_data_files('my_datalake.default.rewrite_delete_scope_bounds', min_file_size_bytes := 0);
----
1	1	0	1

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.rewrite_delete_scope_bounds;
----
[4, 5, 6, 7, 8]

query I
SELECT count(*) FROM iceberg_metadata(my_datalake.default.rewrite_delete_scope_bounds)
WHERE content = 'POSITION_DELETES' AND status <> 'DELETED';
----
0

query I
SELECT count(*) FROM iceberg_metadata(my_datalake.default.rewrite_delete_scope_bounds)
WHERE content = 'DATA' AND status <> 'DELETED' AND file_path = '{TEST_DIR}/scope_bounds_b.parquet';
----
1

statement ok
DROP TABLE my_datalake.default.rewrite_delete_scope_shared;

statement ok
DROP TABLE my_datalake.default.rewrite_delete_scope_bounds;
