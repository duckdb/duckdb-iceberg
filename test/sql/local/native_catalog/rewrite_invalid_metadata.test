# name: test/sql/local/native_catalog/rewrite_invalid_metadata.test
# description: CoW and maintenance rewrites reject corrupt catalog metadata and preserve the database and files
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require json

statement ok
CREATE TABLE my_datalake.default.rewrite_invalid_metadata (
	id INTEGER, s STRUCT(a INTEGER, ignored INTEGER), items INTEGER[]
) WITH ('format-version' = 2, 'write.delete.mode' = 'copy-on-write');

statement ok
INSERT INTO my_datalake.default.rewrite_invalid_metadata VALUES
	(1, {'a': 1, 'ignored': 10}, [1]), (2, {'a': 2, 'ignored': 20}, [2]);

statement ok
INSERT INTO my_datalake.default.rewrite_invalid_metadata VALUES
	(3, {'a': 3, 'ignored': 30}, [3]), (4, {'a': 4, 'ignored': 40}, [4]);

statement ok
SET VARIABLE rewrite_response = (
	SELECT body::JSON FROM iceberg_test_catalog_request(
		'GET', '/v1/namespaces/default/tables/rewrite_invalid_metadata', NULL)
);

statement ok
SET VARIABLE rewrite_schema = getvariable('rewrite_response')->'metadata'->'schemas'->0;

statement ok
SET VARIABLE struct_id = (
	SELECT (value->>'id')::INTEGER FROM json_each(getvariable('rewrite_schema')->'fields')
	WHERE value->>'name' = 's'
);

statement ok
SET VARIABLE list_element_id = (
	SELECT (value->'type'->>'element-id')::INTEGER FROM json_each(getvariable('rewrite_schema')->'fields')
	WHERE value->>'name' = 'items'
);

# Omission of an unknown struct child forces the writer to cast its parent rather
# than passing it through. An invalid identity partition on that parent previously
# reached FindWrittenColumn's internal error.
statement ok
SET VARIABLE schema_with_unknown = json_merge_patch(getvariable('rewrite_schema'),
	json_object('fields', list_transform((getvariable('rewrite_schema')->'fields')::JSON[], lambda f:
		CASE WHEN f->>'name' = 's' THEN json_merge_patch(f,
			json_object('type', json_merge_patch(f->'type',
				json_object('fields', list_transform((f->'type'->'fields')::JSON[], lambda c:
					CASE WHEN c->>'name' = 'ignored' THEN json_merge_patch(c, '{"type":"unknown"}') ELSE c END)))))
		ELSE f END)));

statement ok
CREATE TABLE rewrite_metadata_patches (patch JSON);

statement ok
INSERT INTO rewrite_metadata_patches VALUES
	('{"default-spec-id":999}'),
	('{"default-sort-order-id":999}'),
	(json_object('schemas', [json_merge_patch(getvariable('rewrite_schema'), '{"schema-id":-1}')], 'current-schema-id', -1)),
	(json_object('schemas', [json_merge_patch(getvariable('rewrite_schema'), '{"fields":[]}')])),
	('{"properties":{"schema.name-mapping.default":"[{\"field-id\":1,\"names\":[{\"id\":1}]}]"}}'),
	('{"partition-specs":[{"spec-id":0,"fields":[{"source-id":999,"field-id":1000,"name":"p","transform":"identity"}]}]}'),
	(json_object('schemas', [getvariable('schema_with_unknown')],
		'partition-specs', [json_object('spec-id', 0, 'fields',
			[json_object('source-id', getvariable('struct_id'), 'field-id', 1000, 'name', 'p', 'transform', 'identity')])])),
	(json_object('partition-specs', [json_object('spec-id', 0, 'fields',
		[json_object('source-id', getvariable('list_element_id'), 'field-id', 1000, 'name', 'p', 'transform', 'identity')])])),
	(json_object('sort-orders', [json_object('order-id', 1, 'fields',
		[json_object('source-id', getvariable('struct_id'), 'transform', 'identity', 'direction', 'asc', 'null-order', 'nulls-first')])],
		'default-sort-order-id', 1)),
	('{"last-sequence-number":9223372036854775807}'),
	('{"partition-specs":[{"spec-id":0,"fields":[{"source-id":1,"field-id":1000,"name":"p","transform":"bucket[0]"}]}]}'),
	(json_object('snapshots', list_transform((getvariable('rewrite_response')->'metadata'->'snapshots')::JSON[],
		lambda s: json_merge_patch(s, '{"sequence-number":null}'))));

loop i 0 12

statement ok
SET VARIABLE corrupt_response = (
	SELECT json_merge_patch(getvariable('rewrite_response'),
		json_object('metadata', json_merge_patch(getvariable('rewrite_response')->'metadata', patch)))
	FROM rewrite_metadata_patches WHERE rowid = {i}
);

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response',
	json_object('method', 'GET', 'path', '/v1/namespaces/default/tables/rewrite_invalid_metadata',
		'status', 200, 'body', getvariable('corrupt_response')));
----
204

# A fresh attachment prevents a previously loaded table from masking a corrupt response.
statement ok
ATTACH '' AS corrupt_rewrite (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	AUTHORIZATION_TYPE 'none', ACCESS_DELEGATION_MODE 'none');

statement error
DELETE FROM corrupt_rewrite.default.rewrite_invalid_metadata WHERE id = 1;
----
Invalid Configuration Error:

query I
SELECT 42;
----
42

statement error
CALL iceberg_rewrite_data_files('corrupt_rewrite.default.rewrite_invalid_metadata', rewrite_all = true);
----
Invalid Configuration Error:

query I
SELECT 42;
----
42

statement ok
DETACH corrupt_rewrite;

query I
SELECT status FROM iceberg_test_catalog_request('DELETE', '/__test/response', NULL);
----
204

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.rewrite_invalid_metadata;
----
[1, 2, 3, 4]

# Failures during staging (sequence exhaustion) must clean up the shared sink's output.
statement ok
BEGIN;

statement ok
SET VARIABLE rewrite_glob = (
	SELECT parse_dirpath(file_path) || '/*.parquet'
	FROM iceberg_metadata(my_datalake.default.rewrite_invalid_metadata)
	WHERE status <> 'DELETED' LIMIT 1
);

query I
SELECT count(*) FROM glob(getvariable('rewrite_glob'));
----
2

statement ok
COMMIT;

endloop

# Both shared rewrite callers still succeed after all rejected responses.
query II
SELECT rewritten_data_files_count, added_data_files_count
FROM iceberg_rewrite_data_files('my_datalake.default.rewrite_invalid_metadata', rewrite_all = true);
----
2	1

statement ok
DELETE FROM my_datalake.default.rewrite_invalid_metadata WHERE id = 1;

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.rewrite_invalid_metadata;
----
[2, 3, 4]

statement ok
DROP TABLE my_datalake.default.rewrite_invalid_metadata;
