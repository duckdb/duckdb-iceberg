# name: test/sql/local/native_catalog/attach_config_sigv4.test
# description: Config negotiation and property aliases for SigV4 authorization
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require json

statement ok
CREATE SECRET config_s3 (TYPE S3, KEY_ID 'test-key', SECRET 'test-secret', REGION 'us-east-1');

statement ok
CREATE MACRO config_response(defaults, overrides, path := '/v1/config') AS TABLE
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response',
	json_object('method', 'GET', 'path', path, 'status', 200,
		'body', json_object('defaults', defaults::JSON, 'overrides', overrides::JSON,
			'endpoints', ['GET /v1/{prefix}/namespaces/{namespace}']))::VARCHAR);

statement ok
CALL enable_logging('HTTP');

statement ok
SET redact_http_logs = false;

# Client options override the Iceberg spellings in server defaults.
query I
SELECT * FROM config_response(
	'{"rest.signing-region":"eu-west-1","rest.signing-name":"server","default_schema":"default"}', '{}');
----
204

statement ok
CALL truncate_duckdb_logs();

statement ok
ATTACH '' AS signing_client (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	AUTHORIZATION_TYPE 'sigv4', SECRET config_s3, SIGV4_REGION 'us-east-1', SIGV4_SERVICE 'client');

query I
SELECT request.headers['Authorization'] LIKE '%/us-east-1/client/aws4_request%'
FROM duckdb_logs_parsed('HTTP') ORDER BY timestamp;
----
true
true

statement ok
DETACH signing_client;

# Overrides replace native signing options after the initial config request.
query I
SELECT * FROM config_response('{"default_schema":"default"}',
	'{"rest.signing-region":"eu-west-1","rest.signing-name":"server"}');
----
204

statement ok
CALL truncate_duckdb_logs();

statement ok
ATTACH '' AS signing_override (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	"rest.sigv4-enabled" true, SECRET config_s3, SIGV4_REGION 'us-east-1', SIGV4_SERVICE 'client');

query I
SELECT request.headers['Authorization'] LIKE '%/us-east-1/client/aws4_request%'
FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%/config';
----
true

query I
SELECT request.headers['Authorization'] LIKE '%/eu-west-1/server/aws4_request%'
FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%/namespaces/default';
----
true

statement ok
DETACH signing_override;

# Implicit AWS endpoint presets are below server defaults.
query I
SELECT * FROM config_response(
	'{"rest.signing-region":"eu-west-1","rest.signing-name":"server","default_schema":"default"}', '{}',
	path := '/v1/config?warehouse=arn%3Aaws%3As3tables%3Aus-east-1%3A123456789012%3Abucket%2Ftest');
----
204

statement ok
CALL truncate_duckdb_logs();

statement ok
ATTACH 'arn:aws:s3tables:us-east-1:123456789012:bucket/test' AS signing_preset (
	TYPE ICEBERG, URI 'http://iceberg-mock.invalid', ENDPOINT_TYPE 's3_tables', SECRET config_s3);

query I
SELECT request.headers['Authorization'] LIKE '%/us-east-1/s3tables/aws4_request%'
FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%/config?%';
----
true

query I
SELECT request.headers['Authorization'] LIKE '%/eu-west-1/server/aws4_request%'
FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%/namespaces/default';
----
true

statement ok
DETACH signing_preset;

# Explicit false prevents a server default from enabling SigV4.
query I
SELECT * FROM config_response('{"rest.sigv4-enabled":"true","default_schema":"default"}', '{}');
----
204

statement ok
CALL truncate_duckdb_logs();

statement ok
ATTACH '' AS signing_disabled (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	"rest.sigv4-enabled" false, TOKEN 'client-token');

query I
SELECT request.headers['Authorization'] FROM duckdb_logs_parsed('HTTP') ORDER BY timestamp;
----
Bearer client-token
Bearer client-token

statement ok
DETACH signing_disabled;

# A server-selected auth manager must not reinterpret the bootstrap S3 secret
# as an ICEBERG secret or combine its selector with the server's OAuth2 token.
query I
SELECT * FROM config_response('{"default_schema":"default"}',
	'{"rest.auth.type":"oauth2","token":"server-token"}');
----
204

statement ok
CALL truncate_duckdb_logs();

statement ok
ATTACH '' AS signing_to_oauth (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	AUTHORIZATION_TYPE 'sigv4', SECRET config_s3, SIGV4_REGION 'us-east-1', SIGV4_SERVICE 'client');

query I
SELECT request.headers['Authorization'] FROM duckdb_logs_parsed('HTTP')
WHERE request.url LIKE '%/namespaces/default';
----
Bearer server-token

statement ok
DETACH signing_to_oauth;

statement ok
DROP SECRET config_s3;

query I
SELECT status FROM iceberg_test_catalog_request('DELETE', '/__test/response', NULL);
----
204
