# name: test/sql/local/native_catalog/table_updates_in_ctas.test
# description: Eager CTAS and table functions share transaction state and commit or roll back together
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

statement ok
ATTACH OR REPLACE '' AS my_datalake (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	AUTHORIZATION_TYPE 'none', ACCESS_DELEGATION_MODE 'none', STAGE_CREATE_TABLES false);

statement ok
SET threads=4;

foreach table source_a source_b result rolled_back

statement ok
DROP TABLE IF EXISTS my_datalake.default.ctas_updates_{table};

endloop

foreach table source_a source_b

statement ok
CREATE TABLE my_datalake.default.ctas_updates_{table} (id INTEGER);

endloop

# CTAS initializes its table during execution while the input can update other tables.
loop i 0 5

statement ok
CREATE TABLE my_datalake.default.ctas_updates_result AS
SELECT count(*) AS calls, sum(Success)::BIGINT AS changed FROM (
	SELECT * FROM set_iceberg_table_properties(my_datalake.default.ctas_updates_source_a, {'p{i}': 'a'})
	UNION ALL
	SELECT * FROM set_iceberg_table_properties(my_datalake.default.ctas_updates_source_b, {'p{i}': 'b'})
);

query II
SELECT calls, changed FROM my_datalake.default.ctas_updates_result;
----
2	2

query TT
SELECT
	(SELECT value FROM iceberg_table_properties(my_datalake.default.ctas_updates_source_a) WHERE key = 'p{i}'),
	(SELECT value FROM iceberg_table_properties(my_datalake.default.ctas_updates_source_b) WHERE key = 'p{i}');
----
a	b

statement ok
DROP TABLE my_datalake.default.ctas_updates_result;

endloop

# Rewrite finalization also uses the shared update lock while CTAS and a property change
# register other tables in the same transaction.
statement ok
INSERT INTO my_datalake.default.ctas_updates_source_a VALUES (1);

statement ok
INSERT INTO my_datalake.default.ctas_updates_source_a VALUES (2);

statement ok
CREATE TABLE my_datalake.default.ctas_updates_result AS
SELECT sum(rewritten)::BIGINT AS rewritten, sum(added)::BIGINT AS added, sum(properties)::BIGINT AS properties FROM (
	SELECT rewritten_data_files_count AS rewritten, added_data_files_count AS added, 0::BIGINT AS properties
	FROM iceberg_rewrite_data_files('my_datalake.default.ctas_updates_source_a', rewrite_all = true)
	UNION ALL
	SELECT 0, 0, Success
	FROM set_iceberg_table_properties(my_datalake.default.ctas_updates_source_b, {'with_rewrite': 'yes'})
);

query III
SELECT rewritten, added, properties FROM my_datalake.default.ctas_updates_result;
----
2	1	1

query I
SELECT id FROM my_datalake.default.ctas_updates_source_a ORDER BY id;
----
1
2

query I
SELECT count(*) FROM iceberg_metadata(my_datalake.default.ctas_updates_source_a)
WHERE content = 'DATA' AND status <> 'DELETED';
----
1

query T
SELECT value FROM iceberg_table_properties(my_datalake.default.ctas_updates_source_b) WHERE key = 'with_rewrite';
----
yes

statement ok
DROP TABLE my_datalake.default.ctas_updates_result;

# The new table and input side effects are visible locally, then disappear on rollback.
statement ok
BEGIN;

statement ok
CREATE TABLE my_datalake.default.ctas_updates_rolled_back AS
SELECT count(*) AS calls, sum(Success)::BIGINT AS changed FROM (
	SELECT * FROM set_iceberg_table_properties(my_datalake.default.ctas_updates_source_a, {'rolled_back': 'a'})
	UNION ALL
	SELECT * FROM set_iceberg_table_properties(my_datalake.default.ctas_updates_source_b, {'rolled_back': 'b'})
);

query II
SELECT calls, changed FROM my_datalake.default.ctas_updates_rolled_back;
----
2	2

query TT
SELECT
	(SELECT value FROM iceberg_table_properties(my_datalake.default.ctas_updates_source_a) WHERE key = 'rolled_back'),
	(SELECT value FROM iceberg_table_properties(my_datalake.default.ctas_updates_source_b) WHERE key = 'rolled_back');
----
a	b

statement ok
ROLLBACK;

statement error
SELECT * FROM my_datalake.default.ctas_updates_rolled_back;
----
does not exist

query II
SELECT
	(SELECT count(*) FROM iceberg_table_properties(my_datalake.default.ctas_updates_source_a) WHERE key = 'rolled_back'),
	(SELECT count(*) FROM iceberg_table_properties(my_datalake.default.ctas_updates_source_b) WHERE key = 'rolled_back');
----
0	0

# An exception inside a table update also aborts the CTAS and the other input update.
statement error
CREATE TABLE my_datalake.default.ctas_updates_result AS
SELECT count(*) AS calls FROM (
	SELECT * FROM set_iceberg_table_properties(my_datalake.default.ctas_updates_source_a, {'failed': 'a'})
	UNION ALL
	SELECT * FROM set_iceberg_table_properties(my_datalake.default.ctas_updates_source_b, {'encryption.key-id': 'unsupported'})
);
----
Iceberg table encryption is not supported

statement error
SELECT * FROM my_datalake.default.ctas_updates_result;
----
does not exist

query II
SELECT
	(SELECT count(*) FROM iceberg_table_properties(my_datalake.default.ctas_updates_source_a) WHERE key = 'failed'),
	(SELECT count(*) FROM iceberg_table_properties(my_datalake.default.ctas_updates_source_b) WHERE key = 'encryption.key-id');
----
0	0

# A fresh statement can acquire the update lock and reuse the failed CTAS name.
statement ok
CREATE TABLE my_datalake.default.ctas_updates_result AS
SELECT Success FROM set_iceberg_table_properties(my_datalake.default.ctas_updates_source_a, {'recovered': 'yes'});

query I
SELECT Success FROM my_datalake.default.ctas_updates_result;
----
1

query T
SELECT value FROM iceberg_table_properties(my_datalake.default.ctas_updates_source_a) WHERE key = 'recovered';
----
yes

foreach table source_a source_b result

statement ok
DROP TABLE my_datalake.default.ctas_updates_{table};

endloop
