# name: test/sql/local/native_catalog/scan_table_statistics.test
# description: iceberg_scan gives the optimizer the distinct counts recorded in the table statistics file of the scanned snapshot
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require json

statement ok
CREATE TABLE my_datalake.default.table_statistics (id INTEGER, category VARCHAR, payload STRUCT(a INTEGER));

statement ok
INSERT INTO my_datalake.default.table_statistics SELECT range, 'c' || (range % 3), {'a': range} FROM range(10);

statement ok
SET VARIABLE first_snapshot = (SELECT snapshot_id FROM iceberg_snapshots(my_datalake.default.table_statistics));

statement ok
SET VARIABLE id_field = (SELECT field_id FROM iceberg_schemas(my_datalake.default.table_statistics) WHERE name = 'id' AND is_current);

statement ok
SET VARIABLE category_field = (SELECT field_id FROM iceberg_schemas(my_datalake.default.table_statistics) WHERE name = 'category' AND is_current);

statement ok
SET VARIABLE payload_field = (SELECT field_id FROM iceberg_schemas(my_datalake.default.table_statistics) WHERE name = 'payload' AND is_current);

# Without a statistics file the optimizer has no distinct count
query I
SELECT stats(category)::VARCHAR NOT LIKE '%approx_unique%' FROM my_datalake.default.table_statistics LIMIT 1;
----
true

statement ok
CREATE MACRO theta_blob(field, snapshot, ndv) AS
	json_object('type', 'apache-datasketches-theta-v1', 'snapshot-id', snapshot, 'sequence-number', 1,
		'fields', json_array(field), 'properties', json_object('ndv', ndv));

statement ok
CREATE MACRO statistics_update(snapshot, blobs) AS
	json_object('requirements', json_array(), 'updates', json_array(json_object('action', 'set-statistics',
		'statistics', json_object('snapshot-id', snapshot, 'statistics-path', 'metadata/' || snapshot || '.stats',
			'file-size-in-bytes', 180, 'file-footer-size-in-bytes', 167, 'blob-metadata', blobs))))::VARCHAR;

# A statistics file for the current snapshot: the id column has 10 distinct values, category 3. The payload blob
# has no 'ndv' property, and the last blob is for a field the schema does not have.
query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/table_statistics',
	statistics_update(getvariable('first_snapshot'), json_array(
		theta_blob(getvariable('id_field'), getvariable('first_snapshot'), '10'),
		theta_blob(getvariable('category_field'), getvariable('first_snapshot'), '3'),
		json_object('type', 'apache-datasketches-theta-v1', 'snapshot-id', getvariable('first_snapshot'),
			'sequence-number', 1, 'fields', json_array(getvariable('payload_field')), 'properties', json_object()),
		theta_blob(999, getvariable('first_snapshot'), '7'))));
----
200

query II
SELECT s.approx_unique::BIGINT, t.approx_unique::BIGINT
FROM (SELECT stats(id) s, stats(category) t FROM my_datalake.default.table_statistics LIMIT 1);
----
10	3

query I
SELECT stats(payload)::VARCHAR NOT LIKE '%approx_unique%' FROM my_datalake.default.table_statistics LIMIT 1;
----
true

# The distinct count is a hint for the optimizer; the data is read as before
query II
SELECT count(DISTINCT id), count(DISTINCT category) FROM my_datalake.default.table_statistics;
----
10	3

# The setting turns the statistics off
statement ok
SET iceberg_enable_table_statistics = false;

query I
SELECT stats(id)::VARCHAR NOT LIKE '%approx_unique%' FROM my_datalake.default.table_statistics LIMIT 1;
----
true

statement ok
RESET iceberg_enable_table_statistics;

# A new snapshot without a statistics file: the file of the previous snapshot is not used for it, but a scan
# of that previous snapshot still gets its counts
statement ok
INSERT INTO my_datalake.default.table_statistics VALUES (10, 'c3', {'a': 10});

query I
SELECT stats(id)::VARCHAR NOT LIKE '%approx_unique%' FROM my_datalake.default.table_statistics LIMIT 1;
----
true

query I
SELECT s.approx_unique::BIGINT FROM (SELECT stats(id) s FROM my_datalake.default.table_statistics AT (VERSION => getvariable('first_snapshot')) LIMIT 1);
----
10

statement ok
SET VARIABLE second_snapshot = (SELECT snapshot_id FROM iceberg_snapshots(my_datalake.default.table_statistics) ORDER BY sequence_number DESC LIMIT 1);

# A blob whose 'ndv' is not a number is ignored
query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/table_statistics',
	statistics_update(getvariable('second_snapshot'), json_array(
		theta_blob(getvariable('id_field'), getvariable('second_snapshot'), 'unknown'),
		theta_blob(getvariable('category_field'), getvariable('second_snapshot'), '4'))));
----
200

query II
SELECT stats(id)::VARCHAR NOT LIKE '%approx_unique%', t.approx_unique::BIGINT
FROM (SELECT id, stats(category) t FROM my_datalake.default.table_statistics LIMIT 1);
----
true	4

# Rows written in this transaction are not in the statistics file: no distinct count until they are committed
statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.table_statistics VALUES (11, 'c4', {'a': 11});

query I
SELECT stats(category)::VARCHAR NOT LIKE '%approx_unique%' FROM my_datalake.default.table_statistics LIMIT 1;
----
true

statement ok
ROLLBACK;

query I
SELECT t.approx_unique::BIGINT FROM (SELECT stats(category) t FROM my_datalake.default.table_statistics LIMIT 1);
----
4

# Removing the statistics file removes the counts
query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/table_statistics',
	json_object('requirements', json_array(), 'updates', json_array(json_object('action', 'remove-statistics',
		'snapshot-id', getvariable('second_snapshot'))))::VARCHAR);
----
200

query I
SELECT stats(category)::VARCHAR NOT LIKE '%approx_unique%' FROM my_datalake.default.table_statistics LIMIT 1;
----
true

statement ok
DROP TABLE my_datalake.default.table_statistics;
