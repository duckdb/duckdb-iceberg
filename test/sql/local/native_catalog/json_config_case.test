# name: test/sql/local/native_catalog/json_config_case.test
# description: Config and headers preserve explicit spelling, reject case collisions and retain layer precedence
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require json

statement ok
CREATE MACRO config_response(defaults, overrides) AS TABLE
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response',
	json_object('method', 'GET', 'path', '/v1/config', 'status', 200,
		'body', json_object('defaults', defaults::JSON, 'overrides', overrides::JSON))::VARCHAR);

foreach order lower_first upper_first

query I
SELECT * FROM config_response(
	CASE WHEN '{order}' = 'lower_first' THEN '{"token":"first","TOKEN":"second"}'
	ELSE '{"TOKEN":"second","token":"first"}' END, '{}');
----
204

statement error
ATTACH '' AS duplicate_options (TYPE ICEBERG, URI 'http://iceberg-mock.invalid', AUTHORIZATION_TYPE 'none');
----
Duplicate Iceberg option 'token'

query I
SELECT * FROM config_response('{}',
	CASE WHEN '{order}' = 'lower_first' THEN '{"header.x-test":"first","HEADER.X-Test":"second"}'
	ELSE '{"HEADER.X-Test":"second","header.x-test":"first"}' END);
----
204

statement error
ATTACH '' AS duplicate_headers (TYPE ICEBERG, URI 'http://iceberg-mock.invalid', AUTHORIZATION_TYPE 'none');
----
Duplicate Iceberg header option 'header.x-test'

endloop

query I
SELECT * FROM config_response('{}', '{}');
----
204

# Duplicate names inside an explicit header map are rejected even without header.* options.
statement error
ATTACH '' AS duplicate_client_headers (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	AUTHORIZATION_TYPE 'none', EXTRA_HTTP_HEADERS MAP {'X-Test': 'first', 'x-test': 'second'});
----
Duplicate Iceberg header option 'x-test'

statement error
ATTACH '' AS duplicate_client_headers (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	AUTHORIZATION_TYPE 'none', "header.X-Test" 'first', EXTRA_HTTP_HEADERS MAP {'x-test': 'second'});
----
Duplicate Iceberg header option

# Explicit header maps retain their names and values on both the bootstrap request
# and requests made after applying the catalog configuration.
query I
SELECT * FROM config_response('{"default_schema":"default"}', '{}');
----
204

statement ok
CALL enable_logging('HTTP');

statement ok
SET redact_http_logs = false;

statement ok
ATTACH '' AS explicit_headers (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	AUTHORIZATION_TYPE 'none',
	EXTRA_HTTP_HEADERS MAP {'X-None-Header': 'none-value', 'X-Second-Header': 'MiXeD-value'});

query TTT
SELECT request.url, request.headers['X-None-Header'], request.headers['X-Second-Header']
FROM duckdb_logs_parsed('HTTP') ORDER BY request.url;
----
http://iceberg-mock.invalid/v1/config	none-value	MiXeD-value
http://iceberg-mock.invalid/v1/namespaces/default	none-value	MiXeD-value

statement ok
DETACH explicit_headers;

# Unknown raw keys can coexist. Known header names merge case-insensitively across layers;
# merged names are normalized and their values remain unchanged.
query I
SELECT * FROM config_response(
	'{"Custom":"first","custom":"second","header.X-Case":"DefaultValue","header.X-Only-Default":"MiXeD"}',
	'{"HEADER.x-case":"OverrideValue","default_schema":"default"}');
----
204

statement ok
CALL truncate_duckdb_logs();

statement ok
ATTACH '' AS header_layers (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	AUTHORIZATION_TYPE 'none',
	EXTRA_HTTP_HEADERS MAP {'x-case': 'ClientValue', 'X-Client-Only': 'MiXeD-Client'});

query TTT
SELECT request.headers['x-case'], request.headers['x-only-default'], request.headers['x-client-only']
FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%/namespaces/default';
----
OverrideValue	MiXeD	MiXeD-Client

statement ok
DETACH header_layers;
