# name: test/sql/local/native_catalog/file_credentials_named_secrets.test
# description: callback-selected regular secrets take precedence over path lookup and reject missing, out-of-scope and wrong-type secrets
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require iceberg_test_credentials

statement ok
PRAGMA iceberg_test_credentials_record('{TEMP_DIR}/iceberg-native');

statement ok
CREATE TABLE my_datalake.default.fc_named AS SELECT range AS i FROM range(3);

statement ok
SET VARIABLE fc_named_files = (SELECT list(DISTINCT filename) FROM my_datalake.default.fc_named);

statement ok
SET VARIABLE fc_named_scope = regexp_extract(getvariable('fc_named_files')[1], '^(.*)/data/[^/]+$', 1);

statement ok
CREATE SECRET fc_path (TYPE s3, SCOPE getvariable('fc_named_scope'), KEY_ID 'PATH_CREDENTIALS', SECRET 'test-secret');

# The named secret has a broader scope than the secret selected by path.
statement ok
CREATE SECRET fc_selected (TYPE s3, SCOPE regexp_extract(getvariable('fc_named_scope'), '^(.*)/warehouse/', 1), KEY_ID 'NAMED_CREDENTIALS', SECRET 'test-secret');

statement ok
PRAGMA iceberg_test_credentials('my_datalake', 'default', 'fc_named', '', secret_name = 'fc_selected');

statement ok
PRAGMA iceberg_test_credentials_clear_reads;

query I
SELECT sum(i) FROM my_datalake.default.fc_named;
----
3

query IIII
SELECT count(*) FILTER (path LIKE '%.avro') > 0, count(*) FILTER (path LIKE '%.parquet') > 0, bool_and(has_credentials), bool_and(key_id = 'NAMED_CREDENTIALS') FROM iceberg_test_credentials_reads() WHERE contains(path, '/warehouse/');
----
true	true	true	true

# A direct read of the same files still selects the more specific secret by path.
statement ok
PRAGMA iceberg_test_credentials_clear_reads;

query I
SELECT sum(i) FROM read_parquet(getvariable('fc_named_files'));
----
3

query III
SELECT count(*) > 0, bool_or(has_credentials), bool_and(key_id = 'PATH_CREDENTIALS') FROM iceberg_test_credentials_reads() WHERE contains(path, '/warehouse/');
----
true	false	true

# Named-secret lookup is case insensitive, including through iceberg_scan.
statement ok
PRAGMA iceberg_test_credentials('my_datalake', 'default', 'fc_named', '', secret_name = 'FC_SELECTED');

statement ok
PRAGMA iceberg_test_credentials_clear_reads;

query I
SELECT sum(i) FROM iceberg_scan('my_datalake.default.fc_named');
----
3

query III
SELECT count(*) > 0, bool_and(has_credentials), bool_and(key_id = 'NAMED_CREDENTIALS') FROM iceberg_test_credentials_reads() WHERE contains(path, '/warehouse/');
----
true	true	true

# Dropping the selected secret must fail even though a valid path secret remains.
statement ok
DROP SECRET fc_selected;

statement error
SELECT sum(i) FROM my_datalake.default.fc_named;
----
<REGEX>:.*Secret 'FC_SELECTED' named by '.*' not found.*

statement ok
CREATE SECRET fc_elsewhere (TYPE s3, SCOPE 's3://unrelated-bucket/', KEY_ID 'ELSEWHERE', SECRET 'test-secret');

statement ok
PRAGMA iceberg_test_credentials('my_datalake', 'default', 'fc_named', '', secret_name = 'fc_elsewhere');

statement error
SELECT sum(i) FROM my_datalake.default.fc_named;
----
the path is outside the secret's scope

statement ok
CREATE SECRET fc_wrong_type (TYPE http, SCOPE getvariable('fc_named_scope'), BEARER_TOKEN 'test-token');

statement ok
PRAGMA iceberg_test_credentials('my_datalake', 'default', 'fc_named', '', secret_name = 'fc_wrong_type');

statement error
SELECT sum(i) FROM my_datalake.default.fc_named;
----
which this read does not take

# Removing the callback's selection restores normal path lookup for table reads.
statement ok
PRAGMA iceberg_test_credentials('my_datalake', 'default', 'fc_named', '');

statement ok
PRAGMA iceberg_test_credentials_clear_reads;

query I
SELECT sum(i) FROM my_datalake.default.fc_named;
----
3

query III
SELECT count(*) > 0, bool_or(has_credentials), bool_and(key_id = 'PATH_CREDENTIALS') FROM iceberg_test_credentials_reads() WHERE contains(path, '/warehouse/');
----
true	false	true
