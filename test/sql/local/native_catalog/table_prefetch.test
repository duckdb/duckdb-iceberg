# name: test/sql/local/native_catalog/table_prefetch.test
# description: Prefetched results are consumed once, honor identifier folding and preserve local state
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

statement ok
ATTACH '' AS prefetch_db (TYPE ICEBERG, URI 'http://iceberg-mock.invalid', AUTHORIZATION_TYPE 'none',
	ACCESS_DELEGATION_MODE 'none', STAGE_CREATE_TABLES true, IDENTIFIER_CASE 'lowercase',
	DEFAULT_SCHEMA 'prefetch', DEFAULT_SCHEMA_POLICY 'create');

statement ok
CREATE TABLE prefetch_db.prefetch.a AS SELECT 1 AS i;

statement ok
CREATE TABLE prefetch_db.prefetch.b AS SELECT 1 AS i;

statement ok
CALL enable_logging('HTTP');

# Exercise caller-driven execution as well as dedicated async workers.
foreach async_threads 0 2

statement ok
SET async_threads = {async_threads};

statement ok
CALL truncate_duckdb_logs();

statement ok
BEGIN;

query I
SELECT count(*) FROM prefetch_db.PREFETCH.A a
JOIN prefetch_db.prefetch.a a2 USING (i)
JOIN prefetch_db.PREFETCH.B b USING (i);
----
1

# The uppercase and repeated references share one canonical request per table.
query II rowsort
SELECT regexp_extract(request.url, '/tables/([^/?]+)$', 1), count(*)
FROM duckdb_logs_parsed('HTTP')
WHERE request.type = 'GET' AND request.url LIKE '%/tables/%'
GROUP BY 1;
----
a	1
b	1

statement ok
CALL truncate_duckdb_logs();

statement ok
INSERT INTO prefetch_db.prefetch.a VALUES (2);

query II
SELECT count(*), sum(i) FROM prefetch_db.prefetch.a;
----
2	3

query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP')
WHERE request.type = 'GET' AND request.url LIKE '%/tables/%';
----
0

statement ok
ROLLBACK;

endloop

statement ok
RESET async_threads;

# A catalog qualifier must not create a same-named schema placeholder that changes binding.
query I
SELECT * FROM prefetch_db.a;
----
1

statement ok
USE prefetch_db.prefetch;

query I
SELECT * FROM prefetch_db.a;
----
1

statement ok
CREATE TABLE memory.main.prefetch_local AS SELECT 7 AS i;

query I
SELECT * FROM memory.prefetch_local;
----
7

statement ok
CALL truncate_duckdb_logs();

# An unused CTE name in a FROM subquery must not generate a speculative request.
query I
SELECT * FROM (WITH a AS (SELECT 42 AS i) SELECT * FROM a) q;
----
42

query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP')
WHERE request.type = 'GET' AND request.url LIKE '%/tables/%';
----
0

statement ok
CALL truncate_duckdb_logs();

query I
WITH x AS (SELECT * FROM a), a AS (SELECT * FROM b) SELECT * FROM x;
----
1

query II rowsort
SELECT regexp_extract(request.url, '/tables/([^/?]+)$', 1), count(*)
FROM duckdb_logs_parsed('HTTP')
WHERE request.type = 'GET' AND request.url LIKE '%/tables/%'
GROUP BY 1;
----
a	1
b	1

statement ok
USE memory.main;

statement ok
DROP TABLE memory.main.prefetch_local;

statement ok
DROP TABLE prefetch_db.prefetch.a;

statement ok
DROP TABLE prefetch_db.prefetch.b;

statement ok
DROP SCHEMA prefetch_db.prefetch;

statement ok
DETACH prefetch_db;
