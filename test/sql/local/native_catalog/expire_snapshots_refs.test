# name: test/sql/local/native_catalog/expire_snapshots_refs.test
# description: Snapshot expiration retains what branches and tags reach and drops refs past their max-ref-age-ms
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require json

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables',
	'{"name":"expire_refs","schema":{"type":"struct","schema-id":0,"fields":[{"id":1,"name":"id","required":false,"type":"int"}]}}');
----
200

# main: S10 <- S20 <- S30 <- S40 <- S50, all far older than the cutoffs below.
query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/expire_refs',
	'{"requirements":[],"updates":[
		{"action":"add-snapshot","snapshot":{"snapshot-id":10,"sequence-number":1,"schema-id":0,"timestamp-ms":10,"manifest-list":"10.avro","summary":{"operation":"append"}}},
		{"action":"set-snapshot-ref","ref-name":"main","type":"branch","snapshot-id":10},
		{"action":"add-snapshot","snapshot":{"snapshot-id":20,"parent-snapshot-id":10,"sequence-number":2,"schema-id":0,"timestamp-ms":20,"manifest-list":"20.avro","summary":{"operation":"append"}}},
		{"action":"set-snapshot-ref","ref-name":"main","type":"branch","snapshot-id":20},
		{"action":"add-snapshot","snapshot":{"snapshot-id":30,"parent-snapshot-id":20,"sequence-number":3,"schema-id":0,"timestamp-ms":30,"manifest-list":"30.avro","summary":{"operation":"append"}}},
		{"action":"set-snapshot-ref","ref-name":"main","type":"branch","snapshot-id":30},
		{"action":"add-snapshot","snapshot":{"snapshot-id":40,"parent-snapshot-id":30,"sequence-number":4,"schema-id":0,"timestamp-ms":40,"manifest-list":"40.avro","summary":{"operation":"append"}}},
		{"action":"set-snapshot-ref","ref-name":"main","type":"branch","snapshot-id":40},
		{"action":"add-snapshot","snapshot":{"snapshot-id":50,"parent-snapshot-id":40,"sequence-number":5,"schema-id":0,"timestamp-ms":50,"manifest-list":"50.avro","summary":{"operation":"append"}}},
		{"action":"set-snapshot-ref","ref-name":"main","type":"branch","snapshot-id":50}
	]}');
----
200

# Two branches forked from S20 with one snapshot of their own each, an old unreferenced snapshot
# (S5) and a young one (S60, far in the future).
query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/expire_refs',
	'{"requirements":[],"updates":[
		{"action":"add-snapshot","snapshot":{"snapshot-id":25,"parent-snapshot-id":20,"sequence-number":6,"schema-id":0,"timestamp-ms":25,"manifest-list":"25.avro","summary":{"operation":"append"}}},
		{"action":"add-snapshot","snapshot":{"snapshot-id":26,"parent-snapshot-id":20,"sequence-number":7,"schema-id":0,"timestamp-ms":26,"manifest-list":"26.avro","summary":{"operation":"append"}}},
		{"action":"add-snapshot","snapshot":{"snapshot-id":5,"sequence-number":8,"schema-id":0,"timestamp-ms":5,"manifest-list":"5.avro","summary":{"operation":"append"}}},
		{"action":"add-snapshot","snapshot":{"snapshot-id":60,"parent-snapshot-id":50,"sequence-number":9,"schema-id":0,"timestamp-ms":253402300799000,"manifest-list":"60.avro","summary":{"operation":"append"}}}
	]}');
----
200

# v1: a tag keeps its snapshot. audit: a branch keeps its own retained prefix. stale and oldfork:
# refs older than their max-ref-age-ms are removed; their snapshots then only survive through other refs.
query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/expire_refs',
	'{"requirements":[],"updates":[
		{"action":"set-snapshot-ref","ref-name":"v1","type":"tag","snapshot-id":10},
		{"action":"set-snapshot-ref","ref-name":"audit","type":"branch","snapshot-id":30,"min-snapshots-to-keep":2},
		{"action":"set-snapshot-ref","ref-name":"stale","type":"tag","snapshot-id":20,"max-ref-age-ms":1},
		{"action":"set-snapshot-ref","ref-name":"fork","type":"branch","snapshot-id":25},
		{"action":"set-snapshot-ref","ref-name":"oldfork","type":"branch","snapshot-id":26,"max-ref-age-ms":1}
	]}');
----
200

query ITI
SELECT name, type, snapshot_id FROM iceberg_refs(my_datalake.default.expire_refs) ORDER BY name;
----
audit	BRANCH	30
fork	BRANCH	25
main	BRANCH	50
oldfork	BRANCH	26
stale	TAG	20
v1	TAG	10

# Expiring a snapshot a retained ref points at is refused before anything is staged.
statement error
SELECT * FROM iceberg_expire_snapshots('my_datalake.default.expire_refs', snapshot_ids => [10]);
----
still referenced by v1

statement error
SELECT * FROM iceberg_expire_snapshots('my_datalake.default.expire_refs', snapshot_ids => [50]);
----
still referenced by main

statement ok
CALL enable_logging('Iceberg');

statement ok
CALL truncate_duckdb_logs();

# main keeps S50 (retain_last), audit keeps S30 and S20 (its min-snapshots-to-keep), fork keeps S25,
# v1 keeps S10, the unreferenced S60 is younger than the cutoff. stale and oldfork are dropped.
# S40, oldfork's S26 and the unreferenced S5 are unreachable.
query II
SELECT * FROM iceberg_expire_snapshots('my_datalake.default.expire_refs', older_than => TIMESTAMP '2999-01-01', retain_last => 1);
----
3	6

# The commit pins every ref it planned from, removes the dropped refs before the snapshots,
# and removes exactly the unreachable snapshots.
query IIIII
WITH commit_log AS (
	SELECT message
	FROM duckdb_logs()
	WHERE type = 'Iceberg'
	  AND message LIKE 'POST % body=%'
	ORDER BY timestamp DESC
	LIMIT 1
)
SELECT
	list_count(regexp_extract_all(message, '"type":"assert-ref-snapshot-id"')),
	list_sort(regexp_extract_all(message, '"ref":"([a-z0-9]+)"', 1)),
	list_sort(regexp_extract_all(message, '"ref-name":"([a-z0-9]+)"', 1)),
	position('"action":"remove-snapshot-ref"' IN message) < position('"action":"remove-snapshots"' IN message),
	contains(message, '"snapshot-ids":[5,26,40]')
FROM commit_log;
----
6	[audit, fork, main, oldfork, stale, v1]	[oldfork, stale]	true	true

query ITI
SELECT name, type, snapshot_id FROM iceberg_refs(my_datalake.default.expire_refs) ORDER BY name;
----
audit	BRANCH	30
fork	BRANCH	25
main	BRANCH	50
v1	TAG	10

query II
SELECT list_sort(json_extract(body, '$.metadata.snapshots[*]."snapshot-id"')::BIGINT[]),
	json_extract(body, '$.metadata."current-snapshot-id"')
FROM iceberg_test_catalog_request('GET', '/v1/namespaces/default/tables/expire_refs', NULL);
----
[10, 20, 25, 30, 50, 60]	50

# A second run has nothing left to do.
query II
SELECT * FROM iceberg_expire_snapshots('my_datalake.default.expire_refs', older_than => TIMESTAMP '2999-01-01', retain_last => 1);
----
0	6

# A branch's own max-snapshot-age-ms overrides the table-wide cutoff for its ancestry.
query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/expire_refs',
	'{"requirements":[],"updates":[
		{"action":"remove-snapshot-ref","ref-name":"v1"},
		{"action":"set-snapshot-ref","ref-name":"audit","type":"branch","snapshot-id":30,"max-snapshot-age-ms":9223372036854775807}
	]}');
----
200

# Without v1, S10 now survives only through audit's own cutoff.
query II
SELECT * FROM iceberg_expire_snapshots('my_datalake.default.expire_refs', older_than => TIMESTAMP '2999-01-01', retain_last => 1);
----
0	6

# Dropping the override leaves only retain_last on audit: S20 and S10 go.
query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/expire_refs',
	'{"requirements":[],"updates":[
		{"action":"set-snapshot-ref","ref-name":"audit","type":"branch","snapshot-id":30}
	]}');
----
200

query II
SELECT * FROM iceberg_expire_snapshots('my_datalake.default.expire_refs', older_than => TIMESTAMP '2999-01-01', retain_last => 1);
----
2	4

query II
SELECT list_sort(json_extract(body, '$.metadata.snapshots[*]."snapshot-id"')::BIGINT[]),
	json_extract(body, '$.metadata.refs.audit."snapshot-id"')
FROM iceberg_test_catalog_request('GET', '/v1/namespaces/default/tables/expire_refs', NULL);
----
[25, 30, 50, 60]	30

query I
SELECT status FROM iceberg_test_catalog_request('DELETE', '/v1/namespaces/default/tables/expire_refs', NULL);
----
204
