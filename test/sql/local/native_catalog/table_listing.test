# name: test/sql/local/native_catalog/table_listing.test
# description: Fresh catalog listings load real schemas once per transaction and handle load failures
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

set ignore_error_messages

# More tables than the request window, exercised both with and without async workers.
loop i 0 12

statement ok
CREATE TABLE my_datalake.default.listing_{i} (id INTEGER, label VARCHAR);

endloop

foreach async_count 0 4

statement ok
SET threads = 1;

statement ok
SET async_threads = {async_count};

foreach resolution lazy eager

statement ok
DETACH my_datalake;

statement ok
ATTACH '' AS my_datalake (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	AUTHORIZATION_TYPE 'none', ACCESS_DELEGATION_MODE 'none', TABLE_RESOLUTION '{resolution}');

statement ok
CALL enable_logging('HTTP');

statement ok
CALL truncate_duckdb_logs();

statement ok
BEGIN;

query II
SELECT count(*), count(*) FILTER (WHERE column_name = '__') FROM information_schema.columns
WHERE table_catalog = 'my_datalake' AND table_schema = 'default' AND table_name LIKE 'listing_%';
----
24	0

loop repeat 0 2

query II
SELECT count(*), count(*) FILTER (WHERE column_names = ['id', 'label']) FROM (SHOW ALL TABLES)
WHERE database = 'my_datalake' AND schema = 'default';
----
12	12

endloop

# A direct lookup after listing reuses the pinned table, including its credentials.
query I
SELECT count(*) FROM my_datalake.default.listing_0;
----
0

statement ok
COMMIT;

query II
SELECT count(*), count(DISTINCT request.url) FROM duckdb_logs_parsed('HTTP')
WHERE request.type = 'GET' AND request.url LIKE '%/namespaces/default/tables/listing_%';
----
12	12

endloop

endloop

# A listed table may disappear before LoadTable. Skip it without publishing a fake schema.
query I
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response',
	'{"method":"GET","path":"/v1/namespaces/default/tables/listing_0","status":404,
	  "body":{"error":{"message":"deleted after listing","type":"NoSuchTableException","code":404}}}');
----
204

query II
SELECT count(*), count(*) FILTER (WHERE name = 'listing_0') FROM (SHOW ALL TABLES)
WHERE database = 'my_datalake' AND schema = 'default';
----
11	0

# Permission failures must be visible, rather than silently returning an invented schema.
query I
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response',
	'{"method":"GET","path":"/v1/namespaces/default/tables/listing_0","status":403,
	  "body":{"error":{"message":"listing load denied","type":"ForbiddenException","code":403}}}');
----
204

statement error
SELECT * FROM information_schema.columns WHERE table_catalog = 'my_datalake';
----
listing load denied

query I
SELECT status FROM iceberg_test_catalog_request('DELETE', '/__test/response', NULL);
----
204

# Failed scans must drain their tasks and allow a subsequent transaction to resolve normally.
query I
SELECT count(*) FROM (SHOW ALL TABLES) WHERE database = 'my_datalake' AND schema = 'default';
----
12

# The explicit staleness policy still allows metadata reuse across transactions.
statement ok
DETACH my_datalake;

statement ok
ATTACH '' AS my_datalake (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	AUTHORIZATION_TYPE 'none', ACCESS_DELEGATION_MODE 'none', MAX_TABLE_STALENESS '5 minutes');

statement ok
CALL truncate_duckdb_logs();

loop repeat 0 2

query I
SELECT count(*) FROM information_schema.columns
WHERE table_catalog = 'my_datalake' AND table_schema = 'default';
----
24

endloop

query II
SELECT count(*), count(DISTINCT request.url) FROM duckdb_logs_parsed('HTTP')
WHERE request.type = 'GET' AND request.url LIKE '%/namespaces/default/tables/listing_%';
----
12	12
