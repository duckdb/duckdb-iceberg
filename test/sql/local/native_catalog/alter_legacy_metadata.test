# name: test/sql/local/native_catalog/alter_legacy_metadata.test
# description: ALTERs bound to legacy V1 metadata protect the implicit unsorted order and assigned partition IDs
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require json

# V1 may omit sort orders and last-partition-id. Its implicit sort order is unsorted (ID 0).
# Script that older LoadTable response while the normal mock handles publication as a V2 catalog.
statement ok
CREATE MACRO legacy_metadata(response) AS json_merge_patch(response::JSON,
	json_object('metadata', json_object(
		'format-version', 1,
		'schema', json_extract(response::JSON, '$.metadata.schemas[0]'),
		'partition-spec', json('[]'),
		'last-partition-id', NULL,
		'sort-orders', NULL,
		'default-sort-order-id', NULL)));

statement ok
ATTACH '' AS legacy_catalog (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	AUTHORIZATION_TYPE 'none', ACCESS_DELEGATION_MODE 'none', DISABLE_MULTI_TABLE_COMMIT true);

statement ok
CREATE TABLE my_datalake.default.legacy_sort_conflict (a INTEGER, b INTEGER);

statement ok
SET VARIABLE legacy_response = (
	SELECT legacy_metadata(body)
	FROM iceberg_test_catalog_request('GET', '/v1/namespaces/default/tables/legacy_sort_conflict', NULL)
);

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response',
	json_object('method', 'GET', 'path', '/v1/namespaces/default/tables/legacy_sort_conflict',
		'status', 200, 'body', getvariable('legacy_response')));
----
204

statement ok writer
BEGIN;

query III writer
SELECT metadata."format-version", metadata."default-sort-order-id" IS NULL, metadata."last-partition-id" IS NULL
FROM iceberg_load_table_response('legacy_catalog.default.legacy_sort_conflict');
----
1	true	true

statement ok writer
ALTER TABLE legacy_catalog.default.legacy_sort_conflict SET ('format-version' = 2);

statement ok writer
ALTER TABLE legacy_catalog.default.legacy_sort_conflict RESET SORTED BY;

query I
SELECT status FROM iceberg_test_catalog_request('DELETE', '/__test/response', NULL);
----
204

# Another writer publishes a V2 sort order after the first writer bound the legacy metadata.
statement ok
ALTER TABLE my_datalake.default.legacy_sort_conflict SET SORTED BY (a);

statement error writer
COMMIT;
----
<REGEX>:.*Conflict_409.*

query II
SELECT metadata."default-sort-order-id", sort_order.fields[1]."source-id"
FROM iceberg_load_table_response('my_datalake.default.legacy_sort_conflict'),
unnest(metadata."sort-orders"::VARIANT[]) AS t(sort_order)
WHERE sort_order."order-id"::INTEGER = metadata."default-sort-order-id"::INTEGER;
----
1	1

# With no concurrent change, the same implicit defaults must let an upgrade and new layout commit.
statement ok
CREATE TABLE my_datalake.default.legacy_layout_upgrade (a INTEGER, b INTEGER);

# Only a historical spec contains fields 1000 and 1001. Both tables now use the empty spec.
statement ok
CREATE TABLE my_datalake.default.legacy_layout_history (a INTEGER, b INTEGER);

statement ok
ALTER TABLE my_datalake.default.legacy_layout_history SET PARTITIONED BY (bucket(4, a), b);

statement ok
ALTER TABLE my_datalake.default.legacy_layout_history RESET PARTITIONED BY;

foreach table,last_id,spec_id legacy_layout_upgrade,999,1 legacy_layout_history,1001,2

statement ok
SET VARIABLE legacy_response = (
	SELECT legacy_metadata(body)
	FROM iceberg_test_catalog_request('GET', '/v1/namespaces/default/tables/{table}', NULL)
);

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response',
	json_object('method', 'GET', 'path', '/v1/namespaces/default/tables/{table}',
		'status', 200, 'body', getvariable('legacy_response')));
----
204

statement ok writer
BEGIN;

statement ok writer
ALTER TABLE legacy_catalog.default.{table} SET ('format-version' = 2);

statement ok writer
ALTER TABLE legacy_catalog.default.{table} SET PARTITIONED BY (a);

statement ok writer
ALTER TABLE legacy_catalog.default.{table} SET SORTED BY (b);

query I
SELECT status FROM iceberg_test_catalog_request('DELETE', '/__test/response', NULL);
----
204

statement ok writer
COMMIT;

query IIII
SELECT metadata."format-version", metadata."default-spec-id"::INTEGER = {spec_id},
	metadata."last-partition-id"::INTEGER = {last_id} + 1, metadata."default-sort-order-id"
FROM iceberg_load_table_response('my_datalake.default.{table}');
----
2	true	true	1

# A successful upgrade must still protect that inferred ID against concurrent field allocation.
query I
SELECT requirement.value->>'last-assigned-partition-id' = '{last_id}'
FROM read_json_auto('{TEMP_DIR}/iceberg-native/*/requests.jsonl') AS journal,
json_each(try_cast(journal.request AS JSON), '$.requirements') AS requirement
WHERE journal.method = 'POST' AND journal.path = '/v1/namespaces/default/tables/{table}'
	AND requirement.value->>'type' = 'assert-last-assigned-partition-id';
----
true

statement ok
INSERT INTO my_datalake.default.{table} VALUES (1, 2);

query II fresh
SELECT * FROM my_datalake.default.{table};
----
1	2

statement ok
DROP TABLE my_datalake.default.{table};

endloop

statement ok
DROP TABLE my_datalake.default.legacy_sort_conflict;

statement ok
DETACH legacy_catalog;
