# name: test/sql/local/native_catalog/metadata_diagnostics.test
# description: Metadata work counters aggregate across workers with defined lifetimes
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

# These assertions measure cold manifest reads/builds.
statement ok
SET iceberg_enable_manifest_cache=false;

statement ok
SET iceberg_use_server_side_scan_planning=false;

statement ok
CREATE TABLE my_datalake.default.metadata_diagnostics (id INTEGER)
WITH ('format-version'='3', 'commit.manifest-merge.enabled'='false');

statement ok
INSERT INTO my_datalake.default.metadata_diagnostics SELECT range FROM range(10);

statement ok
INSERT INTO my_datalake.default.metadata_diagnostics SELECT range FROM range(10,20);

statement ok
DELETE FROM my_datalake.default.metadata_diagnostics WHERE id=0;

statement ok
CALL enable_logging('Iceberg', storage='memory');

foreach threads 1 8

statement ok
SET threads={threads};

statement ok
CALL truncate_duckdb_logs();

query I
SELECT sum(id) FROM my_datalake.default.metadata_diagnostics WHERE id>=0;
----
190

# Two opened files visit only the path-matching delete entry.
# Statistics-only views do not emit an event.
query I
SELECT message FROM duckdb_logs() WHERE type='Iceberg' AND message LIKE '%phase=delete_planning%';
----
Iceberg metadata phase=delete_planning scope=planner_view scan_tasks=2 delete_candidate_visits=1 delete_predicate_evaluations=1

query I
SELECT sum(regexp_extract(message, 'delete_index_builds=(\d+)', 1)::BIGINT)
FROM duckdb_logs() WHERE type='Iceberg' AND message LIKE '%phase=delete_candidate_index%';
----
1

# Data and delete manifests have separate Avro scans. Count actual conversions,
# including entries that might later be pruned, without counting per file logs.
query II
SELECT sum(regexp_extract(message, 'manifest_parses=(\d+)', 1)::BIGINT),
       sum(regexp_extract(message, 'manifest_entries_converted=(\d+)', 1)::BIGINT)
FROM duckdb_logs() WHERE type='Iceberg' AND message LIKE '%phase=manifest_parse%';
----
3	3

query I
SELECT message FROM duckdb_logs() WHERE type='Iceberg' AND message LIKE '%phase=table_metadata_conversion%';
----
Iceberg metadata phase=table_metadata_conversion scope=catalog_initialization table_metadata_conversions=1 snapshots_converted=3

statement ok
CALL truncate_duckdb_logs();

# An unrelated referenced file never needs query-predicate evaluation.
query I
SELECT sum(id) FROM my_datalake.default.metadata_diagnostics WHERE id>=10;
----
145

query I
SELECT message FROM duckdb_logs() WHERE type='Iceberg' AND message LIKE '%phase=delete_planning%';
----
Iceberg metadata phase=delete_planning scope=planner_view scan_tasks=1 delete_candidate_visits=0 delete_predicate_evaluations=0

endloop

statement ok
DROP TABLE my_datalake.default.metadata_diagnostics;
