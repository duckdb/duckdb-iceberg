# name: test/sql/local/native_catalog/parsed_table_metadata.test
# description: Warm parsed metadata preserves snapshot/schema selection and isolates transaction writes
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

statement ok
ATTACH OR REPLACE '' AS my_datalake (TYPE ICEBERG, URI 'http://iceberg-mock.invalid',
	AUTHORIZATION_TYPE 'none', ACCESS_DELEGATION_MODE 'none', STAGE_CREATE_TABLES true,
	MAX_TABLE_STALENESS '1 hour');

statement ok
SET iceberg_use_server_side_scan_planning=false;

statement ok
CREATE TABLE my_datalake.default.parsed_metadata (id INTEGER) WITH ('format-version'='3');

statement ok
INSERT INTO my_datalake.default.parsed_metadata VALUES (1);

statement ok
SET VARIABLE first_snapshot = (SELECT snapshot_id FROM iceberg_snapshots('my_datalake.default.parsed_metadata'));

statement ok
ALTER TABLE my_datalake.default.parsed_metadata ADD COLUMN label VARCHAR DEFAULT 'old';

statement ok
INSERT INTO my_datalake.default.parsed_metadata VALUES (2, 'new');

# Prime the cache with the latest schema and both snapshots.
query IT
SELECT * FROM my_datalake.default.parsed_metadata ORDER BY id;
----
1	old
2	new

statement ok
CALL enable_logging('Iceberg', storage='memory');

foreach iteration 1 2

query I
SELECT * FROM my_datalake.default.parsed_metadata AT (VERSION => getvariable('first_snapshot'));
----
1

query IT
SELECT * FROM my_datalake.default.parsed_metadata ORDER BY id;
----
1	old
2	new

query I
SELECT count(*) FROM iceberg_snapshots('my_datalake.default.parsed_metadata');
----
2

query ITI
SELECT schema_id, name, is_current
FROM iceberg_schemas('my_datalake.default.parsed_metadata')
ORDER BY schema_id, field_id;
----
0	id	false
1	id	true
1	label	true

endloop

query II
SELECT count(*) FILTER (message LIKE '%phase=table_metadata_conversion%'),
       count(*) FILTER (message LIKE '%phase=table_metadata_copy%')
FROM duckdb_logs() WHERE type='Iceberg';
----
0	0

query I
SELECT count(*) > 0 FROM duckdb_logs()
WHERE type='Iceberg' AND message LIKE '%parsed_metadata_hits=1%';
----
true

# Two readers keep the shared old generation while a writer changes its schema and data.
statement ok reader
BEGIN;

query IT reader
SELECT * FROM my_datalake.default.parsed_metadata ORDER BY id;
----
1	old
2	new

statement ok
BEGIN;

statement ok
ALTER TABLE my_datalake.default.parsed_metadata RENAME COLUMN label TO description;

statement ok
INSERT INTO my_datalake.default.parsed_metadata VALUES (3, 'private');

query IT
SELECT id, description FROM my_datalake.default.parsed_metadata ORDER BY id;
----
1	old
2	new
3	private

query IT reader
SELECT id, label FROM my_datalake.default.parsed_metadata ORDER BY id;
----
1	old
2	new

statement ok
ROLLBACK;

query IT
SELECT id, label FROM my_datalake.default.parsed_metadata ORDER BY id;
----
1	old
2	new

statement ok
ALTER TABLE my_datalake.default.parsed_metadata RENAME COLUMN label TO description;

statement ok
INSERT INTO my_datalake.default.parsed_metadata VALUES (3, 'committed');

query IT reader
SELECT id, label FROM my_datalake.default.parsed_metadata ORDER BY id;
----
1	old
2	new

statement ok reader
COMMIT;

query IT reader
SELECT id, description FROM my_datalake.default.parsed_metadata ORDER BY id;
----
1	old
2	new
3	committed

query I
SELECT * FROM my_datalake.default.parsed_metadata AT (VERSION => getvariable('first_snapshot'));
----
1

query IT
SELECT id, description FROM my_datalake.default.parsed_metadata ORDER BY id;
----
1	old
2	new
3	committed

statement ok
DROP TABLE my_datalake.default.parsed_metadata;
