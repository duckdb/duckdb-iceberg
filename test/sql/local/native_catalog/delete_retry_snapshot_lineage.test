# name: test/sql/local/native_catalog/delete_retry_snapshot_lineage.test
# description: Snapshot-isolation DELETE cannot retry across a new lineage published by another writer
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require json

statement ok
CREATE TABLE my_datalake.default.delete_lineage (a INTEGER)
WITH ('format-version' = 2, 'write.delete.isolation-level' = 'snapshot', 'write.delete.mode' = 'merge-on-read');

statement ok
INSERT INTO my_datalake.default.delete_lineage VALUES (1), (2);

# Obtain a real, readable manifest list for the external writer's replacement data.
statement ok
CREATE TABLE my_datalake.default.delete_lineage_source (a INTEGER) WITH ('format-version' = 2);

statement ok
INSERT INTO my_datalake.default.delete_lineage_source VALUES (7);

statement ok
SET VARIABLE external_snapshot = (
    SELECT metadata.snapshots[1]::JSON FROM iceberg_load_table_response(my_datalake.default.delete_lineage_source)
);

statement ok writer
BEGIN;

statement ok writer
DELETE FROM my_datalake.default.delete_lineage WHERE a = 1;

# Publish a parentless append directly, without requiring DuckDB replacement support.
query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/delete_lineage',
    json_object('requirements', json_array(), 'updates', json_array(
        json_object('action', 'add-snapshot', 'snapshot', json_merge_patch(getvariable('external_snapshot'),
            json_object('sequence-number', 2, 'timestamp-ms', epoch_ms(current_timestamp)))),
        json_object('action', 'set-snapshot-ref', 'ref-name', 'main', 'type', 'branch',
            'snapshot-id', json_extract(getvariable('external_snapshot'), '$."snapshot-id"'))
    )));
----
200

# A later ordinary append has a parent, but still does not descend from the DELETE's base.
statement ok
INSERT INTO my_datalake.default.delete_lineage VALUES (8);

query II
SELECT parent_id IS NOT NULL, sequence_number FROM iceberg_snapshots(my_datalake.default.delete_lineage)
ORDER BY sequence_number DESC LIMIT 1;
----
true	3

statement error writer
COMMIT;
----
conflicts with a concurrent commit

query I
SELECT a FROM my_datalake.default.delete_lineage ORDER BY a;
----
7
8

statement ok
DROP TABLE my_datalake.default.delete_lineage;

statement ok
DROP TABLE my_datalake.default.delete_lineage_source;

# Retry must prove the complete chain, not just that the tip has a parent.
# Use readable snapshots and alter only the refresh response so failures cannot
# come from opening the data files or from the mock rejecting a corrupt commit.
foreach history append missing_parent cycle

statement ok
CREATE TABLE my_datalake.default.delete_lineage (a INTEGER)
WITH ('format-version' = 2, 'write.delete.isolation-level' = 'snapshot', 'write.delete.mode' = 'merge-on-read');

statement ok
INSERT INTO my_datalake.default.delete_lineage VALUES (1), (2);

statement ok writer
BEGIN;

statement ok writer
DELETE FROM my_datalake.default.delete_lineage WHERE a = 1;

statement ok
INSERT INTO my_datalake.default.delete_lineage VALUES (7);

statement ok
INSERT INTO my_datalake.default.delete_lineage VALUES (8);

statement ok
SET VARIABLE retry_response = (
	SELECT body::JSON FROM iceberg_test_catalog_request('GET', '/v1/namespaces/default/tables/delete_lineage', NULL)
);

statement ok
SET VARIABLE retry_response = (
	SELECT json_merge_patch(getvariable('retry_response'), json_object('metadata', json_object('snapshots',
		CASE '{history}'
			WHEN 'missing_parent' THEN list_filter(
				(getvariable('retry_response')->'metadata'->'snapshots')::JSON[],
				lambda s: (s->>'sequence-number')::BIGINT != 2)
			WHEN 'cycle' THEN list_transform(
				(getvariable('retry_response')->'metadata'->'snapshots')::JSON[],
				lambda s: CASE WHEN (s->>'sequence-number')::BIGINT = 2
					THEN json_merge_patch(s, json_object('parent-snapshot-id',
						getvariable('retry_response')->'metadata'->'current-snapshot-id'))
					ELSE s END)
			ELSE (getvariable('retry_response')->'metadata'->'snapshots')::JSON[]
		END)))
);

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response',
	json_object('method', 'GET', 'path', '/v1/namespaces/default/tables/delete_lineage',
		'status', 200, 'body', getvariable('retry_response')));
----
204

# A complete chain of multiple appends remains retryable.
onlyif history=append
statement ok writer
COMMIT;

onlyif history=missing_parent
statement error writer
COMMIT;
----
conflicts with a concurrent commit

onlyif history=cycle
statement error writer
COMMIT;
----
conflicts with a concurrent commit

query I
SELECT status FROM iceberg_test_catalog_request('DELETE', '/__test/response', NULL);
----
204

# Read the actual catalog state after clearing the refresh override.
query II
SELECT list(a ORDER BY a) = CASE WHEN '{history}' = 'append' THEN [2, 7, 8] ELSE [1, 2, 7, 8] END,
	(SELECT count(*) FROM iceberg_snapshots('my_datalake.default.delete_lineage')) =
		CASE WHEN '{history}' = 'append' THEN 4 ELSE 3 END
FROM my_datalake.default.delete_lineage;
----
true	true

statement ok
DROP TABLE my_datalake.default.delete_lineage;

endloop
