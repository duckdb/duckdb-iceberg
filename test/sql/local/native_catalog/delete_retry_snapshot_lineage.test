# name: test/sql/local/native_catalog/delete_retry_snapshot_lineage.test
# description: Snapshot-isolation DELETE cannot retry across a new lineage published by another writer
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require json

statement ok
CREATE TABLE my_datalake.default.delete_lineage (a INTEGER)
WITH ('format-version' = 2, 'write.delete.isolation-level' = 'snapshot', 'write.delete.mode' = 'merge-on-read');

statement ok
INSERT INTO my_datalake.default.delete_lineage VALUES (1), (2);

# Obtain a real, readable manifest list for the external writer's replacement data.
statement ok
CREATE TABLE my_datalake.default.delete_lineage_source (a INTEGER) WITH ('format-version' = 2);

statement ok
INSERT INTO my_datalake.default.delete_lineage_source VALUES (7);

statement ok
SET VARIABLE external_snapshot = (
    SELECT metadata.snapshots[1]::JSON FROM iceberg_load_table_response(my_datalake.default.delete_lineage_source)
);

statement ok writer
BEGIN;

statement ok writer
DELETE FROM my_datalake.default.delete_lineage WHERE a = 1;

# Publish a parentless append directly, without requiring DuckDB replacement support.
query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/delete_lineage',
    json_object('requirements', json_array(), 'updates', json_array(
        json_object('action', 'add-snapshot', 'snapshot', json_merge_patch(getvariable('external_snapshot'),
            json_object('sequence-number', 2, 'timestamp-ms', epoch_ms(current_timestamp)))),
        json_object('action', 'set-snapshot-ref', 'ref-name', 'main', 'type', 'branch',
            'snapshot-id', json_extract(getvariable('external_snapshot'), '$."snapshot-id"'))
    )));
----
200

# A later ordinary append has a parent, but still does not descend from the DELETE's base.
statement ok
INSERT INTO my_datalake.default.delete_lineage VALUES (8);

query II
SELECT parent_id IS NOT NULL, sequence_number FROM iceberg_snapshots(my_datalake.default.delete_lineage)
ORDER BY sequence_number DESC LIMIT 1;
----
true	3

statement error writer
COMMIT;
----
conflicts with a concurrent commit

query I
SELECT a FROM my_datalake.default.delete_lineage ORDER BY a;
----
7
8

statement ok
DROP TABLE my_datalake.default.delete_lineage;

statement ok
DROP TABLE my_datalake.default.delete_lineage_source;
