(format parquet, field_ids {id:1, part:6});

statement ok
set variable scan_task_list_6 = (select list(task) from (select * replace('{TEST_DIR}/task_physical.parquet' as file_path,
 (select size from read_blob('{TEST_DIR}/task_physical.parquet'))::bigint as file_size_in_bytes) from tasks) task);

query IT
select id, part from iceberg_scan_tasks(getvariable('scan_task_list_6'));
----
8	physical

statement ok
set variable scan_task_list_7 = (select list(task) from (select * replace({'6':NULL::varchar} as partition_constants) from tasks) task);

# Null partition constants preserve normal missing-column defaults.
