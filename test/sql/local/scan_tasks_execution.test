# One task can yield several chunks before advancing through an empty task to the next file.
statement ok
copy (select i::integer id from range(5000) t(i)) to '{TEST_DIR}/task_large.parquet'
(format parquet, field_ids {id:1});

statement ok
set variable scan_task_list_5 = (select list(task) from (
 select * replace('{TEST_DIR}/task_large.parquet' as file_path,
  (select size from read_blob('{TEST_DIR}/task_large.parquet'))::bigint as file_size_in_bytes,
  5000::bigint as record_count) from tasks
 union all
 select * replace('{TEST_DIR}/task_empty.parquet' as file_path,
  (select size from read_blob('{TEST_DIR}/task_empty.parquet'))::bigint as file_size_in_bytes,
  0::bigint as record_count) from tasks
 union all select * from tasks) task);

query II
select count(*), sum(id) from iceberg_scan_tasks(getvariable('scan_task_list_5'));
----
5004	12497506

