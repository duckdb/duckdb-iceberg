# A source can parallelize a single task independently of task-input cardinality.
statement ok
copy (select i::integer id from range(65536) t(i)) to '{TEST_DIR}/task_parallel.parquet'
(format parquet, row_group_size 2048, field_ids {id:1});

statement ok
copy (select '{TEST_DIR}/task_parallel.parquet'::varchar file_path, i*2048::bigint pos from range(32) t(i))
to '{TEST_DIR}/task_parallel_pos.parquet' (format parquet, field_ids {file_path:2147483546, pos:2147483545});

statement ok
copy (select 12345::integer id) to '{TEST_DIR}/task_parallel_eq.parquet' (format parquet, field_ids {id:1});

statement ok
create temp table parallel_tasks as select * replace(
 '{TEST_DIR}/task_parallel.parquet' as file_path,
 (select size from read_blob('{TEST_DIR}/task_parallel.parquet'))::bigint as file_size_in_bytes,
 65536::bigint as record_count,
 [delete_descriptor('{TEST_DIR}/task_parallel_pos.parquet', 1, [], 32),
  delete_descriptor('{TEST_DIR}/task_parallel_eq.parquet', 2, [1], 1)] as delete_files) from tasks;

statement ok
set variable parallel_task_list = (select list(t) from parallel_tasks t);

statement ok
set variable repeated_task_list = (select list(t) from (
 select p.* replace({'6':i::varchar} as partition_constants) from parallel_tasks p, range(17) r(i)
) t);

statement ok
set variable empty_task_list = (select list(t) from parallel_tasks t where false);

statement ok
set variable null_task_list = (select [case when true then NULL else t end] from parallel_tasks t);

loop threads 1 5

