# Check physical READ ranges, not just decoding: the trailing column keeps footer
# prefetch reads away from the id/value chunks whose byte ranges we assert on.
statement ok
copy (select i::integer id, i::integer value, i::integer dropped from range(100000) t(i))
to '{TEST_DIR}/task_projection_io.parquet'
(format parquet, compression uncompressed, row_group_size 100000, dictionary_size_limit 1,
 field_ids {id:1, value:2, dropped:5});

statement ok
create temp table projection_chunk_ranges as
select path_in_schema as column_name,
       coalesce(dictionary_page_offset, data_page_offset) as start_offset,
       coalesce(dictionary_page_offset, data_page_offset) + total_compressed_size as end_offset
from parquet_metadata('{TEST_DIR}/task_projection_io.parquet')
where path_in_schema in ('id', 'value');

statement ok
set variable projection_io_tasks = (select list(task) from (select * replace(
 '{TEST_DIR}/task_projection_io.parquet' as file_path,
 (select size from read_blob('{TEST_DIR}/task_projection_io.parquet'))::bigint as file_size_in_bytes,
 100000::bigint as record_count) from tasks) task);

statement ok
create temp macro projection_chunk_reads() as table
select r.column_name, count(l.pos) as reads
from projection_chunk_ranges r left join duckdb_logs_parsed('FileSystem') l
on l.op = 'READ' and l.path = '{TEST_DIR}/task_projection_io.parquet'
   and l.pos < r.end_offset and l.pos + l.bytes > r.start_offset
group by r.column_name;

# Test each direction, with a positive control for the selected column's reads.
foreach projected_column id value

statement ok
call enable_logging('FileSystem');

statement ok
call truncate_duckdb_logs();

query I
select sum({projected_column}) from iceberg_scan_tasks(getvariable('projection_io_tasks'));
----
4999950000

query II
select count(*) filter (where column_name = '{projected_column}' and reads > 0),
       count(*) filter (where column_name <> '{projected_column}' and reads = 0)
from projection_chunk_reads();
----
1	1

statement ok
call disable_logging();

endloop

