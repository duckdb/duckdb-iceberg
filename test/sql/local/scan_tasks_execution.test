statement ok
set variable scan_task_list_8 = (select list(task) from (select * replace('{TEST_DIR}/task_names.parquet' as file_path,
 (select size from read_blob('{TEST_DIR}/task_names.parquet'))::bigint as file_size_in_bytes) from tasks) task);

