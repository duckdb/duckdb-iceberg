# name: test/sql/local/maintenance/rewrite_data_files_validation.test
# description: bind-time validation for iceberg_rewrite_data_files parameters
# group: [maintenance]

include test/sql/init_requires

statement error
SELECT * FROM iceberg_rewrite_data_files('bad');
----
does not exist

statement error
SELECT * FROM iceberg_rewrite_data_files('a.b');
----
does not exist

statement error
SELECT * FROM iceberg_rewrite_data_files('a.b.c.d');
----
Too many identifiers in table name

statement error
SELECT * FROM iceberg_rewrite_data_files('.b.c');
----
has an empty component

statement error
SELECT * FROM iceberg_rewrite_data_files('a..c');
----
has an empty component

statement error
SELECT * FROM iceberg_rewrite_data_files('a.b.c', target_file_size_bytes => 0);
----
'target_file_size_bytes' must be > 0 bytes

statement error
SELECT * FROM iceberg_rewrite_data_files('a.b.c', target_file_size_bytes => -1);
----
'target_file_size_bytes' must be > 0 bytes

statement error
SELECT * FROM iceberg_rewrite_data_files('a.b.c', max_file_size_bytes => 0);
----
'max_file_size_bytes' must be > 0 bytes

statement error
SELECT * FROM iceberg_rewrite_data_files('a.b.c', target_file_size_bytes => 'not-bytes');
----
invalid 'target_file_size_bytes'

statement error
SELECT * FROM iceberg_rewrite_data_files('a.b.c', min_input_files => 0);
----
'min_input_files' must be >= 1

statement error
SELECT * FROM iceberg_rewrite_data_files('a.b.c', max_files_to_rewrite => 0);
----
'max_files_to_rewrite' must be >= 1

statement error
SELECT * FROM iceberg_rewrite_data_files('cat.sch.tbl', max_files_to_rewrite => NULL);
----
'max_files_to_rewrite' cannot be NULL

statement error
SELECT * FROM iceberg_rewrite_data_files('a.b.c', output_spec_id => NULL);
----
'output_spec_id' cannot be NULL

statement error
SELECT * FROM iceberg_rewrite_data_files('a.b.c', delete_file_threshold => -1);
----
'delete_file_threshold' must be >= 0, got -1

statement error
SELECT * FROM iceberg_rewrite_data_files('a.b.c', delete_file_threshold => NULL);
----
'delete_file_threshold' cannot be NULL

# A fractional count is refused before it is narrowed: -0.4 must not round to 0 and select every file.
statement error
SELECT * FROM iceberg_rewrite_data_files('a.b.c', delete_file_threshold => -0.4);
----
'delete_file_threshold' must be a whole number, got -0.4

statement error
SELECT * FROM iceberg_rewrite_data_files('a.b.c', delete_file_threshold => 0.4);
----
'delete_file_threshold' must be a whole number, got 0.4

statement error
SELECT * FROM iceberg_rewrite_data_files('a.b.c', delete_file_threshold => 'nan'::DOUBLE);
----
'delete_file_threshold' must be a whole number, got nan

statement error
SELECT * FROM iceberg_rewrite_data_files('a.b.c', delete_file_threshold => '2');
----
'delete_file_threshold' must be a whole number, got 2

# A whole-valued DOUBLE is accepted
statement error
SELECT * FROM iceberg_rewrite_data_files('cat.sch.tbl', delete_file_threshold => 2.0);
----
Catalog "cat" does not exist

statement error
SELECT * FROM iceberg_rewrite_data_files('a.b.c', delete_ratio_threshold => 0);
----
'delete_ratio_threshold' must be > 0 and <= 1, got 0.0

statement error
SELECT * FROM iceberg_rewrite_data_files('a.b.c', delete_ratio_threshold => -0.5);
----
'delete_ratio_threshold' must be > 0 and <= 1, got -0.5

statement error
SELECT * FROM iceberg_rewrite_data_files('a.b.c', delete_ratio_threshold => 1.5);
----
'delete_ratio_threshold' must be > 0 and <= 1, got 1.5

statement error
SELECT * FROM iceberg_rewrite_data_files('a.b.c', delete_ratio_threshold => 'nan'::DOUBLE);
----
'delete_ratio_threshold' must be > 0 and <= 1, got nan

statement error
SELECT * FROM iceberg_rewrite_data_files('a.b.c', delete_ratio_threshold => NULL);
----
'delete_ratio_threshold' cannot be NULL

# Both bounds are accepted
statement error
SELECT * FROM iceberg_rewrite_data_files('cat.sch.tbl', delete_file_threshold => 0, delete_ratio_threshold => 1);
----
Catalog "cat" does not exist

statement error
SELECT * FROM iceberg_rewrite_data_files('a.b.c', min_file_size_bytes => -1);
----
'min_file_size_bytes' must be >= 0 bytes

statement error
SELECT * FROM iceberg_rewrite_data_files(
    'a.b.c',
    min_file_size_bytes => 1000,
    max_file_size_bytes => 500
);
----
'min_file_size_bytes' (1000) must be <= 'max_file_size_bytes' (500)

# Spark accepts a zero minimum when the target still sits strictly inside the band.
statement error
SELECT * FROM iceberg_rewrite_data_files(
    'a.b.c',
    target_file_size_bytes => 1000,
    min_file_size_bytes => 0,
    max_file_size_bytes => 2000
);
----
Catalog "a" does not exist

statement error
SELECT * FROM iceberg_rewrite_data_files(
    'a.b.c',
    target_file_size_bytes => 1000,
    min_file_size_bytes => 1000,
    max_file_size_bytes => 2000
);
----
'target_file_size_bytes' (1000) must be > 'min_file_size_bytes' (1000)

statement error
SELECT * FROM iceberg_rewrite_data_files(
    'a.b.c',
    target_file_size_bytes => 1000,
    min_file_size_bytes => 100,
    max_file_size_bytes => 1000
);
----
'target_file_size_bytes' (1000) must be < 'max_file_size_bytes' (1000)

statement error
SELECT * FROM iceberg_rewrite_data_files(
    'a.b.c',
    target_file_size_bytes => 50,
    min_file_size_bytes => 100,
    max_file_size_bytes => 200
);
----
'target_file_size_bytes' (50) must be > 'min_file_size_bytes' (100)

statement error
SELECT * FROM iceberg_rewrite_data_files(
    'a.b.c',
    target_file_size_bytes => 3000,
    min_file_size_bytes => 100,
    max_file_size_bytes => 2000
);
----
'target_file_size_bytes' (3000) must be < 'max_file_size_bytes' (2000)

statement error
SELECT * FROM iceberg_rewrite_data_files(
    'cat.sch.tbl',
    target_file_size_bytes => '256MiB',
    min_input_files => 3,
    rewrite_all => false
);
----
Catalog "cat" does not exist

statement error
SELECT * FROM iceberg_rewrite_data_files('cat.sch.tbl');
----
Catalog "cat" does not exist
