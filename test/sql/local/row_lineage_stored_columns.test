# name: test/sql/local/row_lineage_stored_columns.test
# description: Row lineage of a data file that stores _row_id and _last_updated_sequence_number, with and without a first_row_id
# group: [local]

include test/sql/init_requires

# The table was upgraded from v2 to v3, see scripts/persistent/row_lineage_stored_columns.py. Its first data file
# stores neither value, only _row_id, only _last_updated_sequence_number, or both (ids 1 to 4).

# Right after the upgrade, the data file has no first_row_id: both columns are NULL, also where the file stores a value.
query IIII
SELECT id, val, _row_id, _last_updated_sequence_number
FROM iceberg_scan('{WORKING_DIRECTORY}/data/persistent/row_lineage_stored_columns/warehouse/default/row_lineage_stored_columns/metadata/00002-upgraded.metadata.json')
ORDER BY id;
----
1	a	NULL	NULL
2	b	NULL	NULL
3	c	NULL	NULL
4	d	NULL	NULL

query II
SELECT id, _last_updated_sequence_number
FROM iceberg_scan('{WORKING_DIRECTORY}/data/persistent/row_lineage_stored_columns/warehouse/default/row_lineage_stored_columns/metadata/00002-upgraded.metadata.json')
ORDER BY id;
----
1	NULL
2	NULL
3	NULL
4	NULL

# The first v3 snapshot assigns first_row_id 0 to the data file: stored values are read as they are, and missing
# values are inherited (first_row_id + position, and the data sequence number 1).
query IIII
SELECT id, val, _row_id, _last_updated_sequence_number
FROM iceberg_scan('{WORKING_DIRECTORY}/data/persistent/row_lineage_stored_columns/warehouse/default/row_lineage_stored_columns')
ORDER BY id;
----
1	a	0	1
2	b	100	1
3	c	2	7
4	d	103	9
5	e	4	2

# Time travel to the snapshot from before the upgrade: no first_row_id again.
query IIII
SELECT id, val, _row_id, _last_updated_sequence_number
FROM iceberg_scan('{WORKING_DIRECTORY}/data/persistent/row_lineage_stored_columns/warehouse/default/row_lineage_stored_columns', snapshot_from_id = 1111111111111111111)
ORDER BY id;
----
1	a	NULL	NULL
2	b	NULL	NULL
3	c	NULL	NULL
4	d	NULL	NULL
