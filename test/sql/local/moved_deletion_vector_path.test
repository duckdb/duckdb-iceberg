# name: test/sql/local/moved_deletion_vector_path.test
# description: allow_moved_paths relocates the Puffin deletion-vector file (v3)
# group: [local]

include test/sql/init_requires

query I
SELECT count(*) FROM iceberg_scan('{WORKING_DIRECTORY}/data/persistent/moved_deletion_vector_path', allow_moved_paths=true);
----
99

query I
SELECT count(*) FROM iceberg_scan('{WORKING_DIRECTORY}/data/persistent/moved_deletion_vector_path', allow_moved_paths=true) WHERE col = 0;
----
0