# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/transactions/test_concurrent_transactions.test
# group: [transactions]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires


statement ok
CALL enable_logging('HTTP');

statement ok
set logging_level='debug'

include test/sql/init_requires

# Reset this small fixture for each test.

statement ok
DROP TABLE IF EXISTS my_datalake.default.quickstart_table;

statement ok
CREATE TABLE my_datalake.default.quickstart_table (
     id BIGINT, data VARCHAR
) WITH ('format-version' = '2');

statement ok
INSERT INTO my_datalake.default.quickstart_table VALUES
	(1, 'some data'),
	(2, 'more data'),
	(3, 'yet more data');

concurrentloop i 1 10

statement ok
SELECT schema_name FROM information_schema.schemata;

statement ok
SELECT * FROM information_schema.columns WHERE table_catalog = 'my_datalake';

statement ok
SELECT * FROM my_datalake.default.quickstart_table LIMIT 1;

endloop
