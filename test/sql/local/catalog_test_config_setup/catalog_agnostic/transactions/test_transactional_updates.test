# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/transactions/test_transactional_updates.test
# group: [transactions]

require-env CATALOG_TEST_CONFIG_SETUP

require-env METADATA_FILE_READ_SUPPORT

require-env METADATA_LOG_SUPPORT

include test/sql/init_requires

statement ok
CALL enable_logging(level='warning');

statement ok
SET warnings_as_errors = True;


statement ok
set iceberg_use_metadata_log = true;

statement ok
set enable_logging=true

statement ok
set logging_level='debug'

# Perform an INSERT and COMMIT it so table has a snapshot id other transactions can find
statement ok
drop table if exists my_datalake.default.multi_transaction_update;

statement ok
create table my_datalake.default.multi_transaction_update (
	a int,
	b int
);

# Insert 0,0
statement ok
insert into my_datalake.default.multi_transaction_update VALUES
	(0, 0);

statement ok con1
begin

statement ok con2
begin

# Insert 2,2
statement ok con2
insert into my_datalake.default.multi_transaction_update VALUES
	(2, 2);

statement ok con2
commit

# con1 doesn't see 2,2 yet
query II con1
select * from my_datalake.default.multi_transaction_update;
----
0	0

# con1 updates 0 to 50 for column a (doesn't affect row inserted by con2)
statement ok con1
update my_datalake.default.multi_transaction_update set a = 50;

# con1 doesn't see 2,2 yet
query II con1
select * from my_datalake.default.multi_transaction_update;
----
50	0

statement error con1
commit;
----
<REGEX>:.*Failed to commit.*

# con1 UPDATE didn't go through
query II
select * from my_datalake.default.multi_transaction_update order by all
----
0	0
2	2
