# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/transactions/test_create_or_replace_conflict.test
# description: Replacement conflicts with concurrent appends even when the original table has no snapshot
# group: [transactions]

require-env CATALOG_TEST_CONFIG_SETUP

require-env ATOMIC_COMMIT_CONFLICT_SUPPORT

require-env MULTI_TABLE_COMMIT_SUPPORT

include test/sql/init_requires

foreach seed 0 1

statement ok
DROP TABLE IF EXISTS my_datalake.default.cor_conflict_{seed};

endloop

statement ok
DROP TABLE IF EXISTS my_datalake.default.cor_companion;

# Cover both an absent main reference and an existing snapshot.
statement ok
CREATE TABLE my_datalake.default.cor_conflict_0 (a INTEGER);

statement ok
CREATE TABLE my_datalake.default.cor_conflict_1 AS SELECT 1 a;

statement ok
CREATE TABLE my_datalake.default.cor_companion AS SELECT 10 a;

loop seed 0 2

statement ok writer
BEGIN;

statement ok writer
CREATE OR REPLACE TABLE my_datalake.default.cor_conflict_{seed} (b VARCHAR);

statement ok writer
INSERT INTO my_datalake.default.cor_companion VALUES (11);

query I writer
SELECT count(*) FROM my_datalake.default.cor_conflict_{seed};
----
0

statement ok
INSERT INTO my_datalake.default.cor_conflict_{seed} VALUES (42);

statement ok
SET VARIABLE cor_published = (SELECT metadata_location FROM iceberg_load_table_response(my_datalake.default.cor_conflict_{seed}));

statement error writer
COMMIT;
----
<REGEX>:.*Failed to commit.*

# Neither the new schema nor the companion table's insert may be published.
query II
SELECT count(*) = {seed} + 1, sum(a) = {seed} + 42 FROM my_datalake.default.cor_conflict_{seed};
----
true	true

query I
SELECT a FROM my_datalake.default.cor_companion;
----
10

query I
SELECT metadata_location = getvariable('cor_published') FROM iceberg_load_table_response(my_datalake.default.cor_conflict_{seed});
----
true

statement ok writer
BEGIN;

statement ok writer
CREATE OR REPLACE TABLE my_datalake.default.cor_conflict_{seed} AS SELECT 'replacement' b;

statement ok
INSERT INTO my_datalake.default.cor_conflict_{seed} VALUES (43);

statement error writer
COMMIT;
----
<REGEX>:.*Failed to commit.*

query II
SELECT count(*) = {seed} + 2, sum(a) = {seed} + 85 FROM my_datalake.default.cor_conflict_{seed};
----
true	true

# Without a concurrent writer, schema-only replacement still commits and permits a later insert.
statement ok
CREATE OR REPLACE TABLE my_datalake.default.cor_conflict_{seed} (b VARCHAR);

query I
SELECT count(*) FROM my_datalake.default.cor_conflict_{seed};
----
0

statement ok
INSERT INTO my_datalake.default.cor_conflict_{seed} VALUES ('after');

query I
SELECT b FROM my_datalake.default.cor_conflict_{seed};
----
after

statement ok
DROP TABLE my_datalake.default.cor_conflict_{seed};

endloop

statement ok
DROP TABLE my_datalake.default.cor_companion;
