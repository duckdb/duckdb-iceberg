# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/transactions/test_transaction_get_from_transaction_start.test
# group: [transactions]

require-env CATALOG_TEST_CONFIG_SETUP

require avro

require parquet

require iceberg

require httpfs


statement ok
set enable_logging=true

statement ok
set logging_level='debug'

# Perform an INSERT and COMMIT it
statement ok
drop table if exists my_datalake.default.multi_transaction_read;

statement ok
create table my_datalake.default.multi_transaction_read (a int, b int);

# make sure the table has a snapshot id to start
statement ok
insert into my_datalake.default.multi_transaction_read select 0, 0;

statement ok con1
begin

statement ok con2
begin

statement ok con2
insert into my_datalake.default.multi_transaction_read select 2, 2;

statement ok con2
commit

# Snapshot isolation defaults to reconstructing the metadata at transaction start,
# even when the table is first resolved after another transaction commits.
query II con1
select * from my_datalake.default.multi_transaction_read order by all;
----
0	0

statement ok con1
rollback
