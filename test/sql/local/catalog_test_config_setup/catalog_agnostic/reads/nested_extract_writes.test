# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/nested_extract_writes.test
# description: UPDATE, DELETE and MERGE filter nested casts using the evolved schema
# group: [reads]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

include test/sql/init_requires

foreach version 2 3

statement ok
DROP TABLE IF EXISTS my_datalake.default.nested_extract_writes;

statement ok
CREATE TABLE my_datalake.default.nested_extract_writes (
	id INTEGER, s STRUCT(n STRUCT(a INTEGER)), tag VARCHAR
) WITH ('format-version' = '{version}');

statement ok
INSERT INTO my_datalake.default.nested_extract_writes VALUES
	(1, {'n': {'a': 11}}, 'old'),
	(2, {'n': {'a': 22}}, 'old'),
	(3, NULL, 'old'),
	(4, {'n': NULL}, 'old');

statement ok
ALTER TABLE my_datalake.default.nested_extract_writes RENAME COLUMN s.n.a TO renamed;

statement ok
ALTER TABLE my_datalake.default.nested_extract_writes ADD COLUMN s.n.extra INTEGER;

statement ok
INSERT INTO my_datalake.default.nested_extract_writes VALUES
	(5, {'n': {'renamed': 55, 'extra': 5}}, 'new');

query I
UPDATE my_datalake.default.nested_extract_writes SET tag = 'updated'
WHERE s.n::VARCHAR = '{''renamed'': 11, ''extra'': NULL}';
----
1

statement ok
BEGIN;

query I
UPDATE my_datalake.default.nested_extract_writes SET tag = 'rolled back'
WHERE s.n::VARCHAR = '{''renamed'': 22, ''extra'': NULL}';
----
1

statement ok
ROLLBACK;

query IT
SELECT id, tag FROM my_datalake.default.nested_extract_writes ORDER BY id;
----
1	updated
2	old
3	old
4	old
5	new

query I
DELETE FROM my_datalake.default.nested_extract_writes
WHERE s.n::VARCHAR = '{''renamed'': 22, ''extra'': NULL}';
----
1

statement ok
MERGE INTO my_datalake.default.nested_extract_writes AS target
USING (VALUES (1, 111), (3, 333), (6, 666)) AS source(id, value)
ON target.id = source.id
WHEN MATCHED AND target.s.n::VARCHAR = '{''renamed'': 11, ''extra'': NULL}'
	THEN UPDATE SET s = {'n': {'renamed': source.value, 'extra': source.id}}, tag = 'merged'
WHEN MATCHED AND target.s.n IS NULL THEN UPDATE SET tag = 'null'
WHEN NOT MATCHED THEN INSERT VALUES
	(source.id, {'n': {'renamed': source.value, 'extra': source.id}}, 'inserted');

query ITT
SELECT id, s.n::VARCHAR, tag FROM my_datalake.default.nested_extract_writes ORDER BY id;
----
1	{'renamed': 111, 'extra': 1}	merged
3	NULL	null
4	NULL	old
5	{'renamed': 55, 'extra': 5}	new
6	{'renamed': 666, 'extra': 6}	inserted

statement ok
UPDATE my_datalake.default.nested_extract_writes SET s = s;

# Rewriting every remaining row must not resurrect a deleted row or erase NULL container validity.
query IIT
SELECT id, s IS NULL, s.n::VARCHAR
FROM my_datalake.default.nested_extract_writes ORDER BY id;
----
1	false	{'renamed': 111, 'extra': 1}
3	true	NULL
4	false	NULL
5	false	{'renamed': 55, 'extra': 5}
6	false	{'renamed': 666, 'extra': 6}

query I
SELECT id FROM my_datalake.default.nested_extract_writes
WHERE s.n::VARCHAR = '{''renamed'': 666, ''extra'': 6}';
----
6

statement ok
DROP TABLE my_datalake.default.nested_extract_writes;

endloop
