# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/filtering/test_filtering_geometry_predicates.test
# group: [filtering]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

require-env GEOMETRY_SUPPORT

require-env SCAN_PLANNING_MODE client

include test/sql/init_requires


statement ok
set enable_logging=true

statement ok
set logging_level='debug'

# Verifies file-level pruning on a GEOMETRY column using the bbox-only
# predicates `&&` and `ST_Intersects_Extent`. Each INSERT lands in its own
# data file, so the file's bbox stats come straight from the row contents.
#
# File -1- bbox: [0..10,  0..10  ]   (lower-left)
# File -2- bbox: [100..120, 100..120] (far upper-right)
# File -3- bbox: [50..60, 50..60]    (middle)

statement ok
drop table if exists my_datalake.default.geom_pruning;

statement ok
create table my_datalake.default.geom_pruning (g GEOMETRY) with ('format-version'='3');

statement ok
insert into my_datalake.default.geom_pruning VALUES
    ('POINT(1 2)'::GEOMETRY),
    ('POINT(5 7)'::GEOMETRY),
    ('LINESTRING(0 0, 10 10)'::GEOMETRY);

statement ok
insert into my_datalake.default.geom_pruning VALUES
    ('POINT(100 100)'::GEOMETRY),
    ('LINESTRING(100 100, 120 120)'::GEOMETRY);

statement ok
insert into my_datalake.default.geom_pruning VALUES
    ('POINT(50 50)'::GEOMETRY),
    ('POINT(60 60)'::GEOMETRY);

statement ok
CALL truncate_duckdb_logs();

# ------------------------------------------------------------------
# `&&`: predicate bbox intersects file -1- only. Prune -2- and -3-.
# ------------------------------------------------------------------

query I
select g::VARCHAR from my_datalake.default.geom_pruning
where g && 'POLYGON((-1 -1, 11 -1, 11 11, -1 11, -1 -1))'
order by g::VARCHAR;
----
LINESTRING (0 0, 10 10)
POINT (1 2)
POINT (5 7)

query I
select count(*) from duckdb_logs()
where type = 'Iceberg' and message.contains('Iceberg Filter Pushdown, skipped ''data_file'':');
----
2

statement ok
CALL truncate_duckdb_logs();

# ------------------------------------------------------------------
# `&&`: predicate bbox intersects file -2- only. Prune -1- and -3-.
# ------------------------------------------------------------------

query I
select g::VARCHAR from my_datalake.default.geom_pruning
where g && 'POLYGON((99 99, 121 99, 121 121, 99 121, 99 99))'
order by g::VARCHAR;
----
LINESTRING (100 100, 120 120)
POINT (100 100)

query I
select count(*) from duckdb_logs()
where type = 'Iceberg' and message.contains('Iceberg Filter Pushdown, skipped ''data_file'':');
----
2

statement ok
CALL truncate_duckdb_logs();

# ------------------------------------------------------------------
# `ST_Intersects_Extent`: predicate bbox intersects file -3- only.
# Prune -1- and -2-.
# ------------------------------------------------------------------

query I
select g::VARCHAR from my_datalake.default.geom_pruning
where ST_Intersects_Extent(g, 'POLYGON((49 49, 61 49, 61 61, 49 61, 49 49))'::GEOMETRY)
order by g::VARCHAR;
----
POINT (50 50)
POINT (60 60)

query I
select count(*) from duckdb_logs()
where type = 'Iceberg' and message.contains('Iceberg Filter Pushdown, skipped ''data_file'':');
----
2

statement ok
CALL truncate_duckdb_logs();

# ------------------------------------------------------------------
# Constant bbox intersects no file. All three should be pruned.
# ------------------------------------------------------------------

query I
select count(*) from my_datalake.default.geom_pruning
where g && 'POLYGON((200 200, 300 200, 300 300, 200 300, 200 200))';
----
0

query I
select count(*) from duckdb_logs()
where type = 'Iceberg' and message.contains('Iceberg Filter Pushdown, skipped ''data_file'':');
----
3

statement ok
CALL truncate_duckdb_logs();

# ------------------------------------------------------------------
# Constant bbox covers every file. Nothing should be pruned.
# ------------------------------------------------------------------

query I
select count(*) from my_datalake.default.geom_pruning
where g && 'POLYGON((-1 -1, 121 -1, 121 121, -1 121, -1 -1))';
----
7

query I
select count(*) from duckdb_logs()
where type = 'Iceberg' and message.contains('Iceberg Filter Pushdown, skipped ''data_file'':');
----
0

# Null counts must prune all-NULL files even when they have no bbox bounds.
statement ok
drop table if exists my_datalake.default.geom_pruning_null;

statement ok
create table my_datalake.default.geom_pruning_null (g GEOMETRY) with ('format-version'='3');

statement ok
insert into my_datalake.default.geom_pruning_null values (NULL), (NULL);

statement ok
CALL truncate_duckdb_logs();

query I
select count(*) from my_datalake.default.geom_pruning_null
where g && 'POINT(0 0)'::GEOMETRY;
----
0

query I
select count(*) from duckdb_logs()
where type = 'Iceberg' and message.contains('Iceberg Filter Pushdown, skipped ''data_file'':');
----
1

statement ok
CALL truncate_duckdb_logs();

query I
select count(*) from my_datalake.default.geom_pruning_null where g is not null;
----
0

query I
select count(*) from duckdb_logs()
where type = 'Iceberg' and message.contains('Iceberg Filter Pushdown, skipped ''data_file'':');
----
1

query I
select count(*) from my_datalake.default.geom_pruning_null where g is null;
----
2

statement ok
drop table my_datalake.default.geom_pruning_null;

# A covering bbox must still reject NULLs and empty geometries. Iceberg does
# not record empty-geometry counts, so bbox coverage alone cannot remove it.
statement ok
insert into my_datalake.default.geom_pruning values (NULL), ('POINT EMPTY'::GEOMETRY);

statement ok
CALL truncate_duckdb_logs();

query I
select count(*) from my_datalake.default.geom_pruning
where g && 'POLYGON((-1 -1, 121 -1, 121 121, -1 121, -1 -1))';
----
7

statement ok
set disabled_optimizers='filter_pushdown';

query I
select count(*) from my_datalake.default.geom_pruning
where g && 'POLYGON((-1 -1, 121 -1, 121 121, -1 121, -1 -1))';
----
7

statement ok
reset disabled_optimizers;

# Reversed arguments, CRS-only casts, and inclusive bbox boundaries.
statement ok
CALL truncate_duckdb_logs();

query I
select count(*) from my_datalake.default.geom_pruning
where ST_Intersects_Extent('POINT(10 10)'::GEOMETRY, g::GEOMETRY);
----
1

query I
select count(*) from duckdb_logs()
where type = 'Iceberg' and message.contains('Iceberg Filter Pushdown, skipped ''data_file'':');
----
2

# XYZ, XYM, and XYZM bounds still prune using XY only.
foreach suffix z m zm

statement ok
drop table if exists my_datalake.default.geom_pruning_{suffix};

statement ok
create table my_datalake.default.geom_pruning_{suffix} (g GEOMETRY) with ('format-version'='3');

endloop

statement ok
insert into my_datalake.default.geom_pruning_z values ('POINT Z (1 2 3)'::GEOMETRY);

statement ok
insert into my_datalake.default.geom_pruning_z values ('POINT Z (100 100 -3)'::GEOMETRY);

statement ok
insert into my_datalake.default.geom_pruning_m values ('POINT M (1 2 3)'::GEOMETRY);

statement ok
insert into my_datalake.default.geom_pruning_m values ('POINT M (100 100 -3)'::GEOMETRY);

statement ok
insert into my_datalake.default.geom_pruning_zm values ('POINT ZM (1 2 3 4)'::GEOMETRY);

statement ok
insert into my_datalake.default.geom_pruning_zm values ('POINT ZM (100 100 -3 -4)'::GEOMETRY);

foreach suffix z m zm

statement ok
CALL truncate_duckdb_logs();

query I
select count(*) from my_datalake.default.geom_pruning_{suffix}
where 'POINT(1 2)'::GEOMETRY && g;
----
1

query I
select count(*) from duckdb_logs()
where type = 'Iceberg' and message.contains('Iceberg Filter Pushdown, skipped ''data_file'':');
----
1

statement ok
drop table my_datalake.default.geom_pruning_{suffix};

endloop

# Missing bbox metrics are unknown, not evidence of an empty geometry.
foreach metrics counts none

statement ok
drop table if exists my_datalake.default.geom_pruning_no_bounds;

statement ok
create table my_datalake.default.geom_pruning_no_bounds (g GEOMETRY)
with ('format-version'='3', 'write.metadata.metrics.default'='{metrics}');

statement ok
insert into my_datalake.default.geom_pruning_no_bounds values ('POINT(1 2)'::GEOMETRY), (NULL), ('POINT EMPTY'::GEOMETRY);

statement ok
CALL truncate_duckdb_logs();

query I
select count(*) from my_datalake.default.geom_pruning_no_bounds
where g && 'POINT(1 2)'::GEOMETRY;
----
1

query I
select count(*) from duckdb_logs()
where type = 'Iceberg' and message.contains('Iceberg Filter Pushdown, skipped ''data_file'':');
----
0

query I
select count(*) from my_datalake.default.geom_pruning_no_bounds where g is null;
----
1

statement ok
drop table my_datalake.default.geom_pruning_no_bounds;

endloop

statement ok
drop table my_datalake.default.geom_pruning;
