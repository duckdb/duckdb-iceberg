# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/filtering/test_prefix_range_metrics_pruning.test
# description: Prefix-range pruning preserves endpoints, NULLs and files with missing metrics
# group: [filtering]

require-env CATALOG_TEST_CONFIG_SETUP

require-env SCAN_PLANNING_MODE client

include test/sql/init_requires

statement ok
SET threads=1;

statement ok
SET dynamic_or_filter_threshold=0;

statement ok
CALL enable_logging('Iceberg');

foreach type INTEGER BIGINT

foreach metrics none counts full

statement ok
DROP TABLE IF EXISTS my_datalake.default.prf_metrics;

statement ok
CREATE TABLE my_datalake.default.prf_metrics (k {type}, id INTEGER)
WITH ('write.metadata.metrics.default'='{metrics}');

statement ok
INSERT INTO my_datalake.default.prf_metrics SELECT range, range FROM range(-100, 0);

statement ok
INSERT INTO my_datalake.default.prf_metrics SELECT range, range FROM range(0, 100);

# A matching file also contains NULLs. Both the lower and upper bound must
# remain inclusive, including a negative lower bound in the first file.
statement ok
INSERT INTO my_datalake.default.prf_metrics
SELECT CASE WHEN range = 150 THEN NULL ELSE range END, range FROM range(100, 200);

statement ok
INSERT INTO my_datalake.default.prf_metrics SELECT NULL, range FROM range(200, 300);

# BIGINT keys additionally exercise a widening cast when the stored key is INTEGER.
statement ok
CREATE OR REPLACE TEMP TABLE prf_metric_keys AS
SELECT unnest([-100::BIGINT, 199::BIGINT, NULL]) AS k;

statement ok
SET disabled_optimizers='join_filter_pushdown';

query I
SELECT list(t.id ORDER BY t.id)
FROM my_datalake.default.prf_metrics t JOIN prf_metric_keys s USING (k);
----
[-100, 199]

statement ok
SET disabled_optimizers='';

statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(t.id ORDER BY t.id)
FROM my_datalake.default.prf_metrics t JOIN prf_metric_keys s USING (k);
----
[-100, 199]

# Without counts an all-NULL file is unknown. Counts alone can prune it,
# while full bounds also eliminate the interior gap [0, 99].
query I
SELECT count(DISTINCT message) =
	CASE '{metrics}' WHEN 'none' THEN 0 WHEN 'counts' THEN 1 ELSE 2 END
FROM duckdb_logs()
WHERE type = 'Iceberg' AND message LIKE '%skipped ''data_file''%';
----
true

query I
SELECT count(DISTINCT message) = CASE WHEN '{metrics}' = 'full' THEN 1 ELSE 0 END
FROM duckdb_logs()
WHERE type = 'Iceberg' AND message LIKE '%skipped ''data_file''%'
	AND message LIKE '%bounds [0, 99]%' AND message LIKE '%IN PRF%';
----
true

statement ok
DROP TABLE my_datalake.default.prf_metrics;

endloop

endloop
