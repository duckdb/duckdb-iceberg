# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/filtering/nested_default_pushdown.test
# description: Nested defaults preserve sibling pushdown and permit field pruning after data-file rewrites
# group: [filtering]

require-env CATALOG_TEST_CONFIG_SETUP

require-env COLUMN_DEFAULT_SUPPORT

require-env FORMAT_V3_SUPPORT

require-env SCAN_PLANNING_MODE client

include test/sql/init_requires

statement ok
SET threads = 1;

statement ok
DROP TABLE IF EXISTS my_datalake.default.nested_default_pushdown;

statement ok
CREATE TABLE my_datalake.default.nested_default_pushdown (
	id INTEGER, s STRUCT(a INTEGER, n STRUCT(b INTEGER))
) WITH ('format-version' = '3', 'write.metadata.metrics.default' = 'full');

statement ok
INSERT INTO my_datalake.default.nested_default_pushdown VALUES
	(1, {'a': 10, 'n': {'b': 1}}),
	(2, {'a': 11, 'n': NULL}),
	(3, NULL);

statement ok
INSERT INTO my_datalake.default.nested_default_pushdown VALUES
	(4, {'a': 100, 'n': {'b': 2}});

statement ok
ALTER TABLE my_datalake.default.nested_default_pushdown ADD COLUMN s.x INTEGER DEFAULT 7;

statement ok
ALTER TABLE my_datalake.default.nested_default_pushdown ADD COLUMN s.n.y INTEGER DEFAULT 5;

# A default in another field must not disable extraction of an existing sibling.
query II
EXPLAIN SELECT s.a FROM my_datalake.default.nested_default_pushdown;
----
physical_plan	<REGEX>:.*Projections: s\.a.*

statement ok
CALL enable_logging('Iceberg');

statement ok
CALL truncate_duckdb_logs();

query I
SELECT id FROM my_datalake.default.nested_default_pushdown WHERE s.a = 10;
----
1

query I
SELECT count(DISTINCT message) FROM duckdb_logs()
WHERE type = 'Iceberg' AND message LIKE '%skipped ''data_file''%' AND message LIKE '%column ''s.a''%';
----
1

# Old files still need the parent validity when filling a field from its default.
query I
SELECT id FROM my_datalake.default.nested_default_pushdown WHERE s.n.y = 5 ORDER BY id;
----
1
4

query I
SELECT id FROM my_datalake.default.nested_default_pushdown WHERE s.n.y IS NULL ORDER BY id;
----
2
3

statement ok
CREATE TEMP TABLE rewritten_nested_defaults AS FROM my_datalake.default.nested_default_pushdown;

statement ok
DELETE FROM my_datalake.default.nested_default_pushdown;

statement ok
INSERT INTO my_datalake.default.nested_default_pushdown FROM rewritten_nested_defaults;

# The schema retains its defaults, but every live file now stores the field.
query II
EXPLAIN SELECT s.n.y FROM my_datalake.default.nested_default_pushdown;
----
physical_plan	<REGEX>:.*Projections: s\.n\.y.*

statement ok
INSERT INTO my_datalake.default.nested_default_pushdown VALUES
	(5, {'a': 200, 'n': {'b': 3, 'y': 9}, 'x': 7});

statement ok
CALL truncate_duckdb_logs();

query I
SELECT id FROM my_datalake.default.nested_default_pushdown WHERE s.n.y = 5 ORDER BY id;
----
1
4

query I
SELECT count(DISTINCT message) FROM duckdb_logs()
WHERE type = 'Iceberg' AND message LIKE '%skipped ''data_file''%' AND message LIKE '%column ''s.n.y''%';
----
1

query II
SELECT id, s.n.y FROM my_datalake.default.nested_default_pushdown
WHERE s.n.y IS NULL OR id = 4 ORDER BY id;
----
2	NULL
3	NULL
4	5

statement ok
DROP TABLE my_datalake.default.nested_default_pushdown;

statement ok
RESET threads;
