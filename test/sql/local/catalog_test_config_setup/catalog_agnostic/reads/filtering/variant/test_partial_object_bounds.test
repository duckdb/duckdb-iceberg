# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/filtering/variant/test_partial_object_bounds.test
# description: Partial VARIANT bounds cannot prune unbounded fields or whole objects
# group: [variant]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

require-env SCAN_PLANNING_MODE client

require-env VARIANT_SUPPORT

include test/sql/init_requires

statement ok
SET iceberg_use_server_side_scan_planning=false;

statement ok
DROP TABLE IF EXISTS my_datalake.default.variant_partial_object_bounds;

statement ok
CREATE TABLE my_datalake.default.variant_partial_object_bounds WITH ('format-version'='3') AS
SELECT {'a': 10, 'extra': []::INTEGER[]}::VARIANT v;

# The empty array remains unshredded, but the sibling scalar has usable bounds.
query II
SELECT lower_bound, upper_bound
FROM iceberg_column_stats(my_datalake.default.variant_partial_object_bounds);
----
{'$[\'a\']': 10}	{'$[\'a\']': 10}

# Project the whole VARIANT: count(*) can use a different projection/pushdown path.
query I
SELECT v FROM my_datalake.default.variant_partial_object_bounds
WHERE v.extra = []::INTEGER[]::VARIANT;
----
{'a': 10, 'extra': []}

query I
SELECT v FROM my_datalake.default.variant_partial_object_bounds
WHERE v = {'a': 10, 'extra': []::INTEGER[]}::VARIANT;
----
{'a': 10, 'extra': []}

query I
SELECT v FROM my_datalake.default.variant_partial_object_bounds WHERE v.extra > 100;
----
{'a': 10, 'extra': []}

# Equality outside the primitive bounds still prunes the file.
statement ok
CALL enable_logging('Iceberg');

statement ok
SELECT v FROM my_datalake.default.variant_partial_object_bounds WHERE v.a = 100;

query I
SELECT count(*) FROM duckdb_logs() WHERE type = 'Iceberg' AND message LIKE '%skipped%';
----
1

statement ok
DROP TABLE my_datalake.default.variant_partial_object_bounds;

# A field omitted because of mixed types is unknown, even when its sibling has bounds.
statement ok
CREATE TABLE my_datalake.default.variant_partial_object_bounds WITH ('format-version'='3') AS
SELECT v FROM (VALUES
    ({'a': 1, 'b': 10}::VARIANT),
    ({'a': 2, 'b': 20}::VARIANT),
    ({'a': 3, 'b': 'fallback'}::VARIANT)
) t(v);

query I
SELECT v FROM my_datalake.default.variant_partial_object_bounds WHERE v.b = 'fallback';
----
{'a': 3, 'b': fallback}

statement ok
DROP TABLE my_datalake.default.variant_partial_object_bounds;
