# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/filtering/variant/test_variant_path_null.test
# description: VARIANT column null counts do not describe extracted paths
# group: [variant]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

require-env SCAN_PLANNING_MODE client

require-env VARIANT_SUPPORT

include test/sql/init_requires

statement ok
set iceberg_use_server_side_scan_planning=false;

statement ok
drop table if exists my_datalake.default.variant_path_null;

statement ok
create table my_datalake.default.variant_path_null (id INTEGER, v VARIANT) with ('format-version'='3');

# The file has no null VARIANT values and has bounds on the path 'a'.
statement ok
insert into my_datalake.default.variant_path_null values
    (1, {'a': 1, 'o': {'b': 7}}::VARIANT),
    (2, {'o': {'c': 8}}::VARIANT),
    (3, {'a': 3, 'o': {'b': NULL::INT}}::VARIANT);

query I
select id from my_datalake.default.variant_path_null where variant_extract(v, 'a') is null;
----
2

query I
select id from my_datalake.default.variant_path_null where variant_extract(v, 'a') is not null order by id;
----
1
3

# The first file has a missing and an explicitly null leaf. In the second,
# the root can be NULL and the parent object can be null or missing.
statement ok
insert into my_datalake.default.variant_path_null values
    (4, NULL), (5, {'o': NULL::INT}::VARIANT), (6, {'x': 6}::VARIANT), (7, {'o': {'b': 9}}::VARIANT);

query I
select id from my_datalake.default.variant_path_null where v.o.b is null order by id;
----
2
3
4
5
6

query I
select id from my_datalake.default.variant_path_null where v.o.b is not null order by id;
----
1
7

statement ok
drop table my_datalake.default.variant_path_null;
