# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/filtering/variant/test_object_containing_array.test
# description: Reconstructed leaf bounds are not bounds for an enclosing object
# group: [variant]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

require-env SCAN_PLANNING_MODE client

require-env VARIANT_SUPPORT

statement ok
DROP TABLE IF EXISTS my_datalake.default.variant_object_array;

statement ok
CREATE TABLE my_datalake.default.variant_object_array WITH ('format-version'='3') AS
SELECT {
    'nested': {
        'arr': [1,2]
    }
}::VARIANT AS v;

statement ok
CREATE TEMP TABLE reference AS FROM my_datalake.default.variant_object_array;

query I
SELECT count(*) FROM reference WHERE v.nested = {'arr': [1,2]}::VARIANT;
----
1

query I
SELECT count(*) FROM my_datalake.default.variant_object_array WHERE v.nested = {'arr': [1,2]}::VARIANT;
----
1

statement ok
DROP TABLE my_datalake.default.variant_object_array;
