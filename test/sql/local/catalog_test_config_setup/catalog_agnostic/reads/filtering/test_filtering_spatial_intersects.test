# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/filtering/test_filtering_spatial_intersects.test
# description: Bounding-box pushdown must preserve exact spatial intersection results
# group: [filtering]

require spatial

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

require-env GEOMETRY_SUPPORT

require-env SCAN_PLANNING_MODE client

include test/sql/init_requires

statement ok
CALL enable_logging('Iceberg');

statement ok
set logging_level='debug';

# Compare Iceberg's default CRS with the reported non-default EPSG:4326 CRS.
foreach crs OGC:CRS84 EPSG:4326

# Use the reported point. Include a polygon with a hole whose bbox matches but
# whose geometry does not, an exact point, an edge, and very small geometries
# around the point to exercise precision at bbox boundaries.
statement ok
create temp table spatial_intersects_source as
select id, wkt::GEOMETRY('{crs}') as geometry from (values
    (1, 'POLYGON((3 41, 3.2 41, 3.2 42, 3 42, 3 41))'),
    (2, 'POLYGON((3 41, 3.2 41, 3.2 42, 3 42, 3 41), (3.12 41.84, 3.12 41.86, 3.14 41.86, 3.14 41.84, 3.12 41.84))'),
    (3, 'POINT(3.1296 41.8476)'),
    (4, 'POLYGON((3.1296 41.8, 3.2 41.8, 3.2 41.9, 3.1296 41.9, 3.1296 41.8))'),
    (5, 'POINT(0 0)'),
    (6, NULL),
    (7, 'POLYGON EMPTY'),
    (8, 'POLYGON((3.129599999 41.847599999, 3.129600001 41.847599999, 3.129600001 41.847600001, 3.129599999 41.847600001, 3.129599999 41.847599999))'),
    (9, 'POINT(3.129600001 41.847600001)')
) t(id, wkt);

# Verify the dataset distinguishes bbox filtering from exact intersection.
query I rowsort
select id from spatial_intersects_source
where geometry && ST_Point(3.1296, 41.8476);
----
1
2
3
4
8

query I rowsort
select id from spatial_intersects_source
where ST_Intersects(geometry, ST_Point(3.1296, 41.8476));
----
1
3
4
8

# Exercise both file metrics and Parquet filtering when file bounds are absent.
foreach metrics full counts none

statement ok
drop table if exists my_datalake.default.spatial_intersects_pushdown;

statement ok
create table my_datalake.default.spatial_intersects_pushdown (id INTEGER, geometry GEOMETRY('{crs}'))
with ('format-version'='3', 'write.metadata.metrics.default'='{metrics}');

# Separate files expose file pruning; two overlapping polygons in the first
# file ensure the exact predicate must still reject the polygon with a hole.
statement ok
insert into my_datalake.default.spatial_intersects_pushdown
select * from spatial_intersects_source where id in (1, 2);

loop id 3 10

statement ok
insert into my_datalake.default.spatial_intersects_pushdown
select * from spatial_intersects_source where id = {id};

endloop

# Verify file pruning independently of the conjunction's throwing expressions.
statement ok
CALL truncate_duckdb_logs();

query I
select count(*) from my_datalake.default.spatial_intersects_pushdown
where geometry && ST_Point(3.1296, 41.8476);
----
5

query I
select case when '{metrics}' = 'full' then count(*) > 0 else true end
from duckdb_logs()
where type = 'Iceberg' and message.contains('Iceberg Filter Pushdown, skipped ''data_file'':');
----
1

# The reported query shape, including ST_Point constant folding and count(*).
query I
select count(*) from my_datalake.default.spatial_intersects_pushdown
where geometry && ST_Point(3.1296, 41.8476)
  and ST_Intersects(geometry, ST_Point(3.1296, 41.8476));
----
4

# Currently the implicit CRS-removing cast can be classified as throwing,
# preventing conjunction pushdown. TRY_CAST lets us also test the scan-level
# conjunction, where bbox pruning must never replace exact intersection.
statement ok
CALL truncate_duckdb_logs();

query I
select count(*) from my_datalake.default.spatial_intersects_pushdown
where TRY_CAST(geometry AS GEOMETRY) && ST_Point(3.1296, 41.8476)
  and ST_Intersects(geometry, ST_Point(3.1296, 41.8476));
----
4

query I
select case when '{metrics}' = 'full' then count(*) > 0 else true end
from duckdb_logs()
where type = 'Iceberg' and message.contains('Iceberg Filter Pushdown, skipped ''data_file'':');
----
1

query I rowsort
select id from my_datalake.default.spatial_intersects_pushdown
where geometry && ST_Point(3.1296, 41.8476)
  and ST_Intersects(geometry, ST_Point(3.1296, 41.8476));
----
1
3
4
8

# Compare with the exact predicate alone, without an explicit bbox predicate.
query I rowsort
select id from my_datalake.default.spatial_intersects_pushdown
where ST_Intersects(geometry, ST_Point(3.1296, 41.8476));
----
1
3
4
8

statement ok
set disabled_optimizers='filter_pushdown';

query I
select count(*) from my_datalake.default.spatial_intersects_pushdown
where geometry && ST_Point(3.1296, 41.8476)
  and ST_Intersects(geometry, ST_Point(3.1296, 41.8476));
----
4

query I rowsort
select id from my_datalake.default.spatial_intersects_pushdown
where geometry && ST_Point(3.1296, 41.8476)
  and ST_Intersects(geometry, ST_Point(3.1296, 41.8476));
----
1
3
4
8

statement ok
reset disabled_optimizers;

statement ok
drop table my_datalake.default.spatial_intersects_pushdown;

endloop

statement ok
drop table spatial_intersects_source;

endloop

# A scaled-down version of the reported layout: one EPSG:4326 column, five
# files, manifest bounds, and multiple native Parquet geometry row groups.
statement ok
set threads=1;

statement ok
drop table if exists my_datalake.default.spatial_intersects_row_groups;

statement ok
create table my_datalake.default.spatial_intersects_row_groups (geometry GEOMETRY('EPSG:4326'))
with ('format-version'='3', 'write.parquet.row-group-size'='2048');

loop file 0 5

statement ok
insert into my_datalake.default.spatial_intersects_row_groups
select ST_MakeEnvelope(x - 0.0004, y - 0.0004, x + 0.0004, y + 0.0004)
from (select 3.1296 + (i % 256 - 128) * 0.001 as x,
             41.8476 + (i // 256 - 80) * 0.001 as y
      from range({file} * 8192, ({file} + 1) * 8192) t(i));

endloop

# Every file must carry geometry bounds in its manifest entry.
query III
select count(*), count(lower_bound), count(upper_bound)
from iceberg_column_stats(my_datalake.default.spatial_intersects_row_groups);
----
5	5	5

# Retain credentials while inspecting the actual Parquet row-group statistics.
statement ok
begin;

statement ok
set variable spatial_files = (select list(file_path)
from iceberg_metadata(my_datalake.default.spatial_intersects_row_groups));

query III
select count(distinct file_name), count(*), count(geo_bbox)
from parquet_metadata(getvariable('spatial_files'));
----
5	20	20

statement ok
commit;

query I
select count(*) from my_datalake.default.spatial_intersects_row_groups
where geometry && ST_Point(3.1296, 41.8476)
  and ST_Intersects(geometry, ST_Point(3.1296, 41.8476));
----
1

query I
select count(*) from my_datalake.default.spatial_intersects_row_groups
where TRY_CAST(geometry AS GEOMETRY) && ST_Point(3.1296, 41.8476)
  and ST_Intersects(geometry, ST_Point(3.1296, 41.8476));
----
1

statement ok
set disabled_optimizers='filter_pushdown';

query I
select count(*) from my_datalake.default.spatial_intersects_row_groups
where geometry && ST_Point(3.1296, 41.8476)
  and ST_Intersects(geometry, ST_Point(3.1296, 41.8476));
----
1

statement ok
reset disabled_optimizers;

statement ok
drop table my_datalake.default.spatial_intersects_row_groups;

statement ok
reset threads;
