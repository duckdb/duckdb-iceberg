# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/filtering/test_exclusion_promoted_bounds.test
# description: Exclusion and OR predicates compare old file bounds at the promoted column's precision
# group: [filtering]

require-env CATALOG_TEST_CONFIG_SETUP

require-env SCAN_PLANNING_MODE client

include test/sql/init_requires

statement ok
SET threads=1;

statement ok
DROP TABLE IF EXISTS my_datalake.default.exclusion_promoted;

statement ok
CREATE TABLE my_datalake.default.exclusion_promoted (id INTEGER, k INTEGER, f FLOAT);

statement ok
INSERT INTO my_datalake.default.exclusion_promoted VALUES
	(1, 2147483647, 16777216), (2, 2147483647, 16777216);

statement ok
INSERT INTO my_datalake.default.exclusion_promoted VALUES
	(3, -2147483648, -1), (4, 0, 'NaN');

statement ok
ALTER TABLE my_datalake.default.exclusion_promoted ALTER k TYPE BIGINT;

statement ok
ALTER TABLE my_datalake.default.exclusion_promoted ALTER f TYPE DOUBLE;

# 16777217 and 16777216.5 are distinct from the old FLOAT singleton only at
# the new precision. The fourth file straddles the INT32 upper limit.
statement ok
INSERT INTO my_datalake.default.exclusion_promoted VALUES (5, 4294967295, 16777217);

statement ok
INSERT INTO my_datalake.default.exclusion_promoted VALUES
	(6, 2147483648, 16777216.5), (7, 2147483647, NULL);

statement ok
CALL enable_logging('Iceberg');

statement ok
CREATE TEMP MACRO skipped() AS (
	SELECT count(*) FROM duckdb_logs() WHERE type='Iceberg' AND message.contains('skipped ''data_file'':')
);

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.exclusion_promoted WHERE f != 16777217;
----
[1, 2, 3, 4, 6]

query I
SELECT skipped();
----
1

statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.exclusion_promoted
WHERE f NOT IN (16777216, 16777217) OR f IS NULL;
----
[3, 4, 6, 7]

query I
SELECT skipped();
----
2

statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.exclusion_promoted
WHERE k NOT IN (2147483647, 4294967295);
----
[3, 4, 6]

query I
SELECT skipped();
----
2

statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.exclusion_promoted
WHERE k < -2147483647 OR k > 2147483647;
----
[3, 5, 6]

query I
SELECT skipped();
----
1

statement ok
DROP TABLE my_datalake.default.exclusion_promoted;
