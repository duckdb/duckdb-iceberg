# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/filtering/test_struct_field_pruning.test
# description: Struct field pruning uses field metrics and preserves NULL ancestors
# group: [filtering]

require-env CATALOG_TEST_CONFIG_SETUP

require-env SCAN_PLANNING_MODE client

include test/sql/init_requires

statement ok
SET threads=1;

statement ok
CALL enable_logging('Iceberg');

foreach metrics none counts full

statement ok
DROP TABLE IF EXISTS my_datalake.default.struct_field_pruning;

statement ok
CREATE TABLE my_datalake.default.struct_field_pruning (
	id INTEGER,
	s STRUCT(x DOUBLE, child STRUCT(x DOUBLE), items INTEGER[], entries MAP(VARCHAR, INTEGER))
) WITH ('write.metadata.metrics.default'='{metrics}');

statement ok
CREATE OR REPLACE TEMP TABLE struct_field_expected AS
SELECT * FROM my_datalake.default.struct_field_pruning LIMIT 0;

statement ok
CREATE OR REPLACE TEMP TABLE struct_field_seed AS
SELECT id, batch,
	CASE WHEN shape = 'root_null' THEN NULL ELSE {
		'x': x,
		'child': CASE WHEN shape = 'child_null' THEN NULL ELSE {'x': x} END,
		'items': CASE
			WHEN shape = 'child_null' THEN NULL
			WHEN shape = 'nan' THEN []
			ELSE [1]
		END,
		'entries': CASE
			WHEN shape = 'child_null' THEN NULL
			WHEN shape = 'nan' THEN MAP()
			ELSE MAP {'a': 1}
		END
	} END AS s
FROM (VALUES
	(1, 1, 'value', 1.0::DOUBLE),
	(2, 1, 'value', 3.0::DOUBLE),
	(3, 2, 'value', NULL::DOUBLE),
	(4, 2, 'value', NULL::DOUBLE),
	(5, 3, 'root_null', NULL::DOUBLE),
	(6, 3, 'root_null', NULL::DOUBLE),
	(7, 4, 'child_null', NULL::DOUBLE),
	(8, 4, 'child_null', NULL::DOUBLE),
	(9, 5, 'nan', 'NaN'::DOUBLE),
	(10, 5, 'nan', 'NaN'::DOUBLE),
	(11, 6, 'value', 2.0::DOUBLE),
	(12, 6, 'root_null', NULL::DOUBLE),
	(13, 7, 'value', 2.0::DOUBLE),
	(14, 7, 'child_null', NULL::DOUBLE)
) t(id, batch, shape, x);

# Each batch occupies a separate file. The last two files have a valid
# child alongside a NULL root or intermediate struct.
foreach batch 1 2 3 4 5 6 7

statement ok
INSERT INTO struct_field_expected SELECT id, s FROM struct_field_seed WHERE batch = {batch};

statement ok
INSERT INTO my_datalake.default.struct_field_pruning
SELECT id, s FROM struct_field_seed WHERE batch = {batch};

endloop

foreach field s.x s.child.x

statement ok
CALL truncate_duckdb_logs();

query I
SELECT (SELECT list(id ORDER BY id) FROM my_datalake.default.struct_field_pruning WHERE {field} IS NULL)
	IS NOT DISTINCT FROM
	(SELECT list(id ORDER BY id) FROM struct_field_expected WHERE {field} IS NULL);
----
true

# Only the finite-only and NaN-only files cannot contain a NULL field.
query I
SELECT count(*) = CASE WHEN '{metrics}' = 'none' THEN 0 ELSE 2 END
FROM duckdb_logs() WHERE type = 'Iceberg' AND message LIKE '%skipped ''data_file''%';
----
true

statement ok
CALL truncate_duckdb_logs();

query I
SELECT (SELECT list(id ORDER BY id) FROM my_datalake.default.struct_field_pruning WHERE {field} IS NOT NULL)
	IS NOT DISTINCT FROM
	(SELECT list(id ORDER BY id) FROM struct_field_expected WHERE {field} IS NOT NULL);
----
true

# NULL leaves, NULL roots and NULL intermediate structs can all be pruned.
query I
SELECT count(*) = CASE WHEN '{metrics}' = 'none' THEN 0 ELSE 3 END
FROM duckdb_logs() WHERE type = 'Iceberg' AND message LIKE '%skipped ''data_file''%';
----
true

statement ok
CALL truncate_duckdb_logs();

query I
SELECT (SELECT list(id ORDER BY id) FROM my_datalake.default.struct_field_pruning WHERE {field} > 5)
	IS NOT DISTINCT FROM
	(SELECT list(id ORDER BY id) FROM struct_field_expected WHERE {field} > 5);
----
true

# Counts exclude all-NULL files; full metrics also exclude finite values.
# The NaN-only file must survive even though it has no finite bounds.
query I
SELECT count(*) = CASE '{metrics}' WHEN 'none' THEN 0 WHEN 'counts' THEN 3 ELSE 6 END
FROM duckdb_logs() WHERE type = 'Iceberg' AND message LIKE '%skipped ''data_file''%';
----
true

endloop

# Container counts may omit NULL ancestors. In particular, the intermediate
# struct's own zero NULL count does not prove s.child IS NULL cannot match.
foreach field s.child s.items s.entries

statement ok
CALL truncate_duckdb_logs();

query I
SELECT (SELECT list(id ORDER BY id) FROM my_datalake.default.struct_field_pruning WHERE {field} IS NULL)
	IS NOT DISTINCT FROM
	(SELECT list(id ORDER BY id) FROM struct_field_expected WHERE {field} IS NULL);
----
true

query I
SELECT count(*) = CASE WHEN '{metrics}' = 'none' THEN 0 ELSE 3 END
FROM duckdb_logs() WHERE type = 'Iceberg' AND message LIKE '%skipped ''data_file''%';
----
true

statement ok
CALL truncate_duckdb_logs();

query I
SELECT (SELECT list(id ORDER BY id) FROM my_datalake.default.struct_field_pruning WHERE {field} IS NOT NULL)
	IS NOT DISTINCT FROM
	(SELECT list(id ORDER BY id) FROM struct_field_expected WHERE {field} IS NOT NULL);
----
true

query I
SELECT count(*) = CASE WHEN '{metrics}' = 'none' THEN 0 ELSE 2 END
FROM duckdb_logs() WHERE type = 'Iceberg' AND message LIKE '%skipped ''data_file''%';
----
true

endloop

# Arbitrary functions, list positions and map keys cannot use the enclosing
# field's bounds or counts as though they described the extracted value.
query I
SELECT (SELECT list(id ORDER BY id) FROM my_datalake.default.struct_field_pruning WHERE s.x % 2 = 1)
	IS NOT DISTINCT FROM
	(SELECT list(id ORDER BY id) FROM struct_field_expected WHERE s.x % 2 = 1);
----
true

query I
SELECT (SELECT list(id ORDER BY id) FROM my_datalake.default.struct_field_pruning WHERE TRY_CAST(s.child.x AS INTEGER) IS NULL)
	IS NOT DISTINCT FROM
	(SELECT list(id ORDER BY id) FROM struct_field_expected WHERE TRY_CAST(s.child.x AS INTEGER) IS NULL);
----
true

query I
SELECT (SELECT list(id ORDER BY id) FROM my_datalake.default.struct_field_pruning WHERE s.items[2] IS NULL)
	IS NOT DISTINCT FROM
	(SELECT list(id ORDER BY id) FROM struct_field_expected WHERE s.items[2] IS NULL);
----
true

query I
SELECT (SELECT list(id ORDER BY id) FROM my_datalake.default.struct_field_pruning WHERE map_extract_value(s.entries, 'missing') IS NULL)
	IS NOT DISTINCT FROM
	(SELECT list(id ORDER BY id) FROM struct_field_expected WHERE map_extract_value(s.entries, 'missing') IS NULL);
----
true

query I
SELECT (SELECT list(id ORDER BY id) FROM my_datalake.default.struct_field_pruning WHERE s.x > 5 OR s.child IS NULL)
	IS NOT DISTINCT FROM
	(SELECT list(id ORDER BY id) FROM struct_field_expected WHERE s.x > 5 OR s.child IS NULL);
----
true

statement ok
DROP TABLE my_datalake.default.struct_field_pruning;

endloop

# Missing metrics for just an ancestor or just the leaf must remain unknown.
# Other available metrics can still prove that an entire ancestor is NULL.
foreach omitted s s.child s.child.x

statement ok
CREATE TABLE my_datalake.default.struct_field_pruning (
	id INTEGER, s STRUCT(child STRUCT(x DOUBLE))
) WITH (
	'write.metadata.metrics.default'='full',
	'write.metadata.metrics.column.{omitted}'='none'
);

statement ok
INSERT INTO my_datalake.default.struct_field_pruning VALUES (1, NULL);

statement ok
INSERT INTO my_datalake.default.struct_field_pruning VALUES (2, {'child': NULL});

statement ok
INSERT INTO my_datalake.default.struct_field_pruning VALUES (3, {'child': {'x': NULL}});

statement ok
INSERT INTO my_datalake.default.struct_field_pruning VALUES (4, {'child': {'x': 42}});

statement ok
INSERT INTO my_datalake.default.struct_field_pruning VALUES
	(5, NULL), (6, {'child': {'x': 42}});

query I
SELECT id FROM my_datalake.default.struct_field_pruning WHERE s.child IS NULL ORDER BY id;
----
1
2
5

query I
SELECT id FROM my_datalake.default.struct_field_pruning WHERE s.child.x IS NULL ORDER BY id;
----
1
2
3
5

statement ok
CALL truncate_duckdb_logs();

query I
SELECT id FROM my_datalake.default.struct_field_pruning WHERE s.child.x IS NOT NULL ORDER BY id;
----
4
6

query I
SELECT count(*) = CASE WHEN '{omitted}' = 's.child.x' THEN 2 ELSE 3 END
FROM duckdb_logs() WHERE type = 'Iceberg' AND message LIKE '%skipped ''data_file''%';
----
true

statement ok
DROP TABLE my_datalake.default.struct_field_pruning;

endloop

# Sibling fields use different IDs and opposite bounds. The nested field must
# use its own metrics even when another field has the same unqualified name.
statement ok
CREATE TABLE my_datalake.default.struct_field_pruning (
	id INTEGER, s STRUCT(x INTEGER, child STRUCT(x INTEGER))
);

statement ok
INSERT INTO my_datalake.default.struct_field_pruning VALUES (1, {'x': 1, 'child': {'x': 100}});

statement ok
INSERT INTO my_datalake.default.struct_field_pruning VALUES (2, {'x': 100, 'child': {'x': 1}});

statement ok
CALL truncate_duckdb_logs();

query I
SELECT id FROM my_datalake.default.struct_field_pruning WHERE s.child.x = 100;
----
1

query I
SELECT count(*) FROM duckdb_logs() WHERE type = 'Iceberg' AND message LIKE '%skipped ''data_file''%';
----
1

statement ok
CALL truncate_duckdb_logs();

query I
SELECT id FROM my_datalake.default.struct_field_pruning WHERE s.x = 100;
----
2

query I
SELECT count(*) FROM duckdb_logs() WHERE type = 'Iceberg' AND message LIKE '%skipped ''data_file''%';
----
1

statement ok
DROP TABLE my_datalake.default.struct_field_pruning;

statement ok
RESET threads;
