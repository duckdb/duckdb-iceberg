# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/filtering/test_prefix_range_string_pruning.test
# description: Prefix-range pruning uses conservative string bounds, including truncated bounds
# group: [filtering]

require-env CATALOG_TEST_CONFIG_SETUP

require-env SCAN_PLANNING_MODE client

include test/sql/init_requires

statement ok
SET threads=1;

statement ok
SET dynamic_or_filter_threshold=0;

statement ok
CALL enable_logging('Iceberg');

foreach metrics full truncate(4) truncate(2)

statement ok
DROP TABLE IF EXISTS my_datalake.default.prf_strings;

statement ok
CREATE TABLE my_datalake.default.prf_strings (k VARCHAR, id INTEGER)
WITH ('write.metadata.metrics.default'='{metrics}');

# Long, non-inline strings exercise the lifetime of reconstructed statistics.
# The build-side prefixes are scattered around the middle file.
foreach prefix aaaa aaac aaae

statement ok
INSERT INTO my_datalake.default.prf_strings
SELECT '{prefix}' || repeat('é', 20) || lpad(range::VARCHAR, 3, '0'), range FROM range(100);

endloop

statement ok
CREATE OR REPLACE TEMP TABLE prf_string_keys AS
SELECT prefix || repeat('é', 20) || suffix AS k
FROM (VALUES ('aaaa'), ('aaae')) p(prefix), (VALUES ('000'), ('099')) s(suffix);

statement ok
SET disabled_optimizers='join_filter_pushdown';

query I
SELECT list(t.id ORDER BY t.id)
FROM my_datalake.default.prf_strings t JOIN prf_string_keys s USING (k);
----
[0, 0, 99, 99]

statement ok
SET disabled_optimizers='';

statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(t.id ORDER BY t.id)
FROM my_datalake.default.prf_strings t JOIN prf_string_keys s USING (k);
----
[0, 0, 99, 99]

# Four-byte bounds still distinguish the interior gap. Two-byte bounds span
# all the build-side prefixes, so none of the files can safely be eliminated.
query I
SELECT count(DISTINCT message) = CASE WHEN '{metrics}' = 'truncate(2)' THEN 0 ELSE 1 END
FROM duckdb_logs()
WHERE type = 'Iceberg' AND message LIKE '%skipped ''data_file''%'
	AND message LIKE '%IN PRF%';
----
true

statement ok
DROP TABLE my_datalake.default.prf_strings;

endloop

# Binary bounds share string statistics but need not contain valid UTF-8.
statement ok
DROP TABLE IF EXISTS my_datalake.default.prf_blobs;

statement ok
CREATE TABLE my_datalake.default.prf_blobs (k BLOB, id INTEGER)
WITH ('write.metadata.metrics.default'='full');

foreach prefix FF000000 FF000002 FF000004

statement ok
INSERT INTO my_datalake.default.prf_blobs
SELECT from_hex('{prefix}') || encode(repeat('x', 20) || lpad(range::VARCHAR, 3, '0')), range FROM range(100);

endloop

statement ok
CREATE TEMP TABLE prf_blob_keys AS
SELECT from_hex(prefix) || encode(repeat('x', 20) || suffix) AS k
FROM (VALUES ('FF000000'), ('FF000004')) p(prefix), (VALUES ('000'), ('099')) s(suffix);

statement ok
SET disabled_optimizers='join_filter_pushdown';

query I
SELECT list(t.id ORDER BY t.id)
FROM my_datalake.default.prf_blobs t JOIN prf_blob_keys s USING (k);
----
[0, 0, 99, 99]

statement ok
SET disabled_optimizers='';

statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(t.id ORDER BY t.id)
FROM my_datalake.default.prf_blobs t JOIN prf_blob_keys s USING (k);
----
[0, 0, 99, 99]

query I
SELECT count(DISTINCT message) FROM duckdb_logs()
WHERE type = 'Iceberg' AND message LIKE '%skipped ''data_file''%'
	AND message LIKE '%IN PRF%';
----
1

statement ok
DROP TABLE my_datalake.default.prf_blobs;
