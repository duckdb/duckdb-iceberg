# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/filtering/test_prefix_range_file_pruning.test
# description: Prune data files against the exact membership of a pushed-down prefix-range join filter
# group: [filtering]

require-env CATALOG_TEST_CONFIG_SETUP

require-env SCAN_PLANNING_MODE client

include test/sql/init_requires

statement ok
create schema if not exists my_datalake.default;

statement ok
drop table if exists my_datalake.default.test_prf_file_pruning;

statement ok
CREATE TABLE my_datalake.default.test_prf_file_pruning (k int, v int);

statement ok
insert into my_datalake.default.test_prf_file_pruning select range, range from range(0, 100);

statement ok
insert into my_datalake.default.test_prf_file_pruning select range, range from range(1000, 1100);

statement ok
insert into my_datalake.default.test_prf_file_pruning select range, range from range(2000, 2100);

# A fourth data file whose key is entirely NULL: no k bounds, null_value_counts == value_counts.
statement ok
insert into my_datalake.default.test_prf_file_pruning select NULL, range from range(3000, 3100);

statement ok
create table scattered_keys as select unnest([50, 2050]) as k;

statement ok
create table contiguous_keys as select range as k from range(1000, 1100);

# Disable the dynamic IN filter so the prefix-range filter is the only exact runtime filter
statement ok
set dynamic_or_filter_threshold=0;

statement ok
CALL enable_logging('Iceberg');

statement ok
CALL truncate_duckdb_logs();

# --- Scattered build-side domain ---
# min/max of the build side spans [50, 2050], which overlaps every file. Only the exact
# membership of the prefix-range filter can prove the middle file (k in [1000, 1100)) is empty.
# The inner join rejects NULL keys, so the all-NULL file is pruned on its null counts alone.
query I
select count(*) from my_datalake.default.test_prf_file_pruning t join scattered_keys s using (k);
----
2

query I
select count(distinct message) from duckdb_logs()
where type = 'Iceberg' and message like '%skipped ''data_file''%';
----
2

query I
select count(distinct message) from duckdb_logs()
where type = 'Iceberg' and message like '%skipped ''data_file''%' and message like '%bounds [1000, 1099]%';
----
1

# The all-NULL file has no bounds to probe; only its null counts prove it empty.
query I
select count(distinct message) from duckdb_logs()
where type = 'Iceberg' and message like '%skipped ''data_file''%' and message like '%bounds [N/A, N/A]%';
----
1

statement ok
CALL truncate_duckdb_logs();

# --- Contiguous build-side domain still prunes ---
# Both value files outside [1000, 1100) are pruned by membership, the all-NULL file by null counts.
query I
select count(*) from my_datalake.default.test_prf_file_pruning t join contiguous_keys c using (k);
----
100

query I
select count(distinct message) from duckdb_logs()
where type = 'Iceberg' and message like '%skipped ''data_file''%';
----
3

statement ok
CALL truncate_duckdb_logs();

# --- Disable knob: no prefix-range pruning (the all-NULL-file prune included), same results ---
statement ok
set iceberg_prefix_range_file_pruning=false;

query I
select count(*) from my_datalake.default.test_prf_file_pruning t join scattered_keys s using (k);
----
2

query I
select count(distinct message) from duckdb_logs()
where type = 'Iceberg' and message like '%skipped ''data_file''%';
----
0

statement ok
set iceberg_prefix_range_file_pruning=true;

statement ok
drop table if exists my_datalake.default.test_prf_file_pruning;
