# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/filtering/test_distinct_from_null_counts.test
# description: NULL-safe comparisons use null counts without confusing missing bounds with all-NULL files
# group: [filtering]

require-env CATALOG_TEST_CONFIG_SETUP

require-env SCAN_PLANNING_MODE client

include test/sql/init_requires

statement ok
SET threads=1;

statement ok
CALL enable_logging('Iceberg');

statement ok
SET VARIABLE null_integer = NULL::INTEGER;

foreach metrics none counts full

statement ok
CREATE TABLE my_datalake.default.distinct_null_counts (id INTEGER, v INTEGER)
WITH ('write.metadata.metrics.default'='{metrics}');

# Three separate data files: all NULL, no NULL, and mixed NULL/non-NULL.
statement ok
INSERT INTO my_datalake.default.distinct_null_counts VALUES (1, NULL);

statement ok
INSERT INTO my_datalake.default.distinct_null_counts VALUES (2, 1);

statement ok
INSERT INTO my_datalake.default.distinct_null_counts VALUES (3, NULL), (4, 1);

statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.distinct_null_counts
WHERE v IS DISTINCT FROM 1;
----
[1, 3]

query I
SELECT count(*) FROM duckdb_logs() WHERE type = 'Iceberg' AND message LIKE '%skipped%data_file%';
----
0

statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.distinct_null_counts
WHERE v IS NOT DISTINCT FROM 1;
----
[2, 4]

# Counts alone prove the all-NULL file cannot match a non-NULL constant.
query I
SELECT count(*) = CASE WHEN '{metrics}' = 'none' THEN 0 ELSE 1 END
FROM duckdb_logs() WHERE type = 'Iceberg' AND message LIKE '%skipped%data_file%';
----
true

foreach optimizer '' 'expression_rewriter'

statement ok
SET disabled_optimizers={optimizer};

statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.distinct_null_counts
WHERE v IS NOT DISTINCT FROM getvariable('null_integer');
----
[1, 3]

query I
SELECT count(*) = CASE WHEN '{metrics}' = 'none' THEN 0 ELSE 1 END
FROM duckdb_logs() WHERE type = 'Iceberg' AND message LIKE '%skipped%data_file%';
----
true

statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.distinct_null_counts
WHERE getvariable('null_integer') IS DISTINCT FROM v;
----
[2, 4]

query I
SELECT count(*) = CASE WHEN '{metrics}' = 'none' THEN 0 ELSE 1 END
FROM duckdb_logs() WHERE type = 'Iceberg' AND message LIKE '%skipped%data_file%';
----
true

endloop

statement ok
RESET disabled_optimizers;

statement ok
DROP TABLE my_datalake.default.distinct_null_counts;

endloop

statement ok
CALL disable_logging();

statement ok
RESET threads;
