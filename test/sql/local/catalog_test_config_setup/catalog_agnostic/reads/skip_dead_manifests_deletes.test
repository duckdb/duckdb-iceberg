# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/skip_dead_manifests_deletes.test
# description: Scans skip delete manifests whose delete files were all replaced, and still apply the live ones
# group: [reads]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

include test/sql/init_requires

statement ok
set enable_logging=true

statement ok
set logging_level='debug'

statement ok
DROP TABLE IF EXISTS my_datalake.default.skip_dead_manifests_deletes;

statement ok
CREATE TABLE my_datalake.default.skip_dead_manifests_deletes (id INTEGER, payload VARCHAR)
WITH ('format-version' = 3, 'commit.manifest-merge.enabled' = false);

statement ok
INSERT INTO my_datalake.default.skip_dead_manifests_deletes VALUES (1, 'a'), (2, 'b'), (3, 'c');

statement ok
DELETE FROM my_datalake.default.skip_dead_manifests_deletes WHERE id = 1;

# The second delete replaces the deletion vector with one that covers both rows, so the first delete manifest is
# left with only a DELETED entry.
statement ok
DELETE FROM my_datalake.default.skip_dead_manifests_deletes WHERE id = 2;

query III
SELECT added_delete_files_count, existing_delete_files_count, deleted_delete_files_count
FROM iceberg_manifests(my_datalake.default.skip_dead_manifests_deletes)
WHERE content = 1
ORDER BY ALL;
----
0	0	1
1	0	0

statement ok
CALL truncate_duckdb_logs();

# Rows 1 and 2 stay deleted: the live deletion vector is still applied.
query IT
SELECT id, payload FROM my_datalake.default.skip_dead_manifests_deletes WHERE id >= 1 ORDER BY id;
----
3	c

query I
SELECT count(*) FROM duckdb_logs()
WHERE type = 'Iceberg' AND message.contains('DELETE manifest has no added or existing files');
----
1

query I
SELECT count(*) FROM duckdb_logs()
WHERE type = 'Iceberg' AND message.contains('DATA manifest has no added or existing files');
----
0

statement ok
CALL truncate_duckdb_logs();

query IT
SELECT id, payload FROM my_datalake.default.skip_dead_manifests_deletes ORDER BY id;
----
3	c

query I
SELECT count(*) FROM duckdb_logs()
WHERE type = 'Iceberg' AND message.contains('DELETE manifest has no added or existing files');
----
1

# Row lineage and the exact count do not depend on the skipped manifest.
query II
SELECT id, _last_updated_sequence_number FROM my_datalake.default.skip_dead_manifests_deletes ORDER BY id;
----
3	1

query I
SELECT count(*) FROM my_datalake.default.skip_dead_manifests_deletes;
----
1

statement ok
DROP TABLE my_datalake.default.skip_dead_manifests_deletes;
