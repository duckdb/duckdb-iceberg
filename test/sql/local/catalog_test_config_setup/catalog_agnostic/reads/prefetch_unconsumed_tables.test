# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/prefetch_unconsumed_tables.test
# description: Statements whose binding does not take every prefetched table must not leave requests running past their commit or rollback
# group: [reads]

include test/sql/init_requires

require-env CATALOG_TEST_CONFIG_SETUP

statement ok
DROP TABLE IF EXISTS my_datalake.default.prefetch_unconsumed;

statement ok
CREATE TABLE my_datalake.default.prefetch_unconsumed AS SELECT i AS id FROM range(3) t(i);

statement ok
USE my_datalake.default;

# A temporary table shadows the Iceberg table, so binding never takes the prefetched response
statement ok
CREATE TEMP TABLE prefetch_unconsumed AS SELECT 7 AS id;

loop i 0 20

query I
SELECT id FROM prefetch_unconsumed;
----
7

endloop

statement ok
DROP TABLE temp.prefetch_unconsumed;

statement ok
USE memory;

statement ok
DROP TABLE my_datalake.default.prefetch_unconsumed;
