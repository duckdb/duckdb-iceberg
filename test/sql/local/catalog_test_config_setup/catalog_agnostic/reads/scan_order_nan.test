# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/scan_order_nan.test
# description: File bounds exclude NaNs and cannot prove that every row ranks before a LIMIT frontier
# group: [reads]

require-env CATALOG_TEST_CONFIG_SETUP

require-env SCAN_PLANNING_MODE client

include test/sql/init_requires

foreach type FLOAT DOUBLE

statement ok
DROP TABLE IF EXISTS my_datalake.default.scan_order_nan;

statement ok
CREATE TABLE my_datalake.default.scan_order_nan (a {type}, id INTEGER)
WITH ('write.metadata.metrics.default' = 'full');

# The files' bounds are [1, 1], [2, 3], [4, 4], but both outer files also
# contain NaN, which sorts after every finite value in DuckDB.
statement ok
INSERT INTO my_datalake.default.scan_order_nan VALUES (1, 1), ('NaN', 10);

statement ok
INSERT INTO my_datalake.default.scan_order_nan VALUES (2, 2), (3, 3);

statement ok
INSERT INTO my_datalake.default.scan_order_nan VALUES (4, 4), ('NaN', 20);

query III
SELECT count(*), count(*) FILTER (WHERE nan_value_count = 0), sum(nan_value_count)
FROM iceberg_column_stats(my_datalake.default.scan_order_nan) WHERE column_name = 'a';
----
3	1	2

# Counting both rows of the first file as smaller than 2 would lose the second file.
query I
SELECT id FROM my_datalake.default.scan_order_nan ORDER BY a ASC, id DESC LIMIT 2;
----
1
2

query I
SELECT id FROM my_datalake.default.scan_order_nan ORDER BY a ASC, id DESC LIMIT 4;
----
1
2
3
4

# Both NaN files are candidates for the first row when a second key breaks the tie.
query I
SELECT id FROM my_datalake.default.scan_order_nan ORDER BY a DESC, id ASC LIMIT 1;
----
10

query I
SELECT id FROM my_datalake.default.scan_order_nan ORDER BY a DESC, id DESC LIMIT 2;
----
20
10

query I
SELECT id FROM my_datalake.default.scan_order_nan ORDER BY a ASC, id DESC LIMIT 2 OFFSET 3;
----
4
20

query I
SELECT id FROM my_datalake.default.scan_order_nan ORDER BY a DESC, id ASC LIMIT 2 OFFSET 1;
----
20
4

statement ok
DROP TABLE my_datalake.default.scan_order_nan;

endloop
