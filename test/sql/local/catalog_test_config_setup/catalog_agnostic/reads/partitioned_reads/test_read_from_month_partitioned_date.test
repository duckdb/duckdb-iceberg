# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/partitioned_reads/test_read_from_month_partitioned_date.test
# group: [partitioned_reads]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

require icu

include test/sql/local/catalog_test_config_setup/catalog_agnostic/setup/month_partitioned_date.test_setup

# Reset this small fixture for each test.

statement ok
DROP TABLE IF EXISTS my_datalake.default.hour_partitioned_timestamp;

statement ok
CREATE TABLE my_datalake.default.hour_partitioned_timestamp (
	id int,
	dt TIMESTAMPTZ,
	customer varchar(20),
    amount double
)
PARTITIONED BY (hour(dt)) WITH ('format-version' = '2');

statement ok
insert into my_datalake.default.hour_partitioned_timestamp values
(1000,TIMESTAMPTZ '2025-01-01 00:00:00+00','C01-00',16.87),
(1001,TIMESTAMPTZ '2025-01-01 00:00:00+00','C01-01',80.19),
(1002,TIMESTAMPTZ '2025-01-01 00:00:00+00','C01-02',49.46),
(1003,TIMESTAMPTZ '2025-01-01 00:00:00+00','C01-03',75.11),
(1004,TIMESTAMPTZ '2025-01-02 00:00:00+00','C01-04',98.02),
(2000,TIMESTAMPTZ '2025-01-02 00:00:00+00','C02-00',58.46),
(2001,TIMESTAMPTZ '2025-01-02 00:00:00+00','C02-01',55.1),
(2002,TIMESTAMPTZ '2025-01-02 00:00:00+00','C02-02',16.48),
(2003,TIMESTAMPTZ '2025-01-02 00:00:00+00','C02-03',34.16),
(2004,TIMESTAMPTZ '2025-01-03 00:00:00+00','C02-04',54.99),
(3000,TIMESTAMPTZ '2025-01-03 00:00:00+00','C03-00',71.13),
(3001,TIMESTAMPTZ '2025-01-03 00:00:00+00','C03-01',82.34),
(3002,TIMESTAMPTZ '2025-01-04 00:00:00+00','C03-02',44.28),
(3003,TIMESTAMPTZ '2025-01-04 00:00:00+00','C03-03',15.93),
(3004,TIMESTAMPTZ '2025-01-04 00:00:00+00','C03-04',35.93);

statement ok
SET default_transaction_invalidation_policy='SYNTACTIC_ERRORS_DO_NOT_INVALIDATE';


statement ok
set enable_logging=true

statement ok
SET TimeZone = 'UTC';

statement ok
call enable_logging('http');

query I
select dt from my_datalake.default.month_partitioned_date where dt = DATE '2025-06-01';
----
2025-06-01

query I
select dt from my_datalake.default.hour_partitioned_timestamp where dt = '2025-01-01 00:00:00';
----
2025-01-01 00:00:00+00
2025-01-01 00:00:00+00
2025-01-01 00:00:00+00
2025-01-01 00:00:00+00
