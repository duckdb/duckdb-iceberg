# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/partitioned_reads/truncate/truncate_binary.test
# group: [truncate]

include test/sql/init_requires

require-env CATALOG_TEST_CONFIG_SETUP

# Reset this small fixture for each test.

statement ok
DROP TABLE IF EXISTS my_datalake.default.truncate_partitioned_binary;

statement ok
CREATE TABLE my_datalake.default.truncate_partitioned_binary (
    id INTEGER,
    nested STRUCT(data BINARY),
    label VARCHAR
)
PARTITIONED BY (truncate(2, nested.data)) WITH ('format-version' = '2');

statement ok
INSERT INTO my_datalake.default.truncate_partitioned_binary
VALUES
    (1,  {'data': from_hex('F09F90AFF09FA689F09F90B4')}, 'tiger_owl_horse'),
    (2,  {'data': from_hex('F09F90AFF09FA689F09F90B8')}, 'tiger_owl_frog'),
    (3,  {'data': from_hex('F09F90AFF09FA689F09FAABF')}, 'tiger_owl_goose'),
    (4,  {'data': from_hex('E298ADE298ABE298A6EFB88E')}, 'happy_fun_times'),
    (5, NULL,  'null_row');

statement ok
create view scan as select * from my_datalake.default.truncate_partitioned_binary;

query I
select count(*) from scan;
----
5

# unconstrained query reads all files
query II
explain analyze select * from scan;
----
analyzed_plan	<REGEX>:.*Total Files Read: 3\s+.*

query I
select count(*) from scan where nested.data >= '\xF0'::blob;
----
3

query I
select count(*) from scan where nested.data >= 'ascii string'::blob;
----
4

query II
explain analyze select * from scan where nested.data >= '\xF0'::blob;
----
analyzed_plan	<REGEX>:.*Total Files Read: 1\s+.*

query II
explain analyze select * from scan where nested.data = '\xe2\x98\xad\xe2\x98\xab\xe2\x98\xa6\xef\xb8\x8e'::BINARY;
----
analyzed_plan	<REGEX>:.*Total Files Read: 1\s+.*
