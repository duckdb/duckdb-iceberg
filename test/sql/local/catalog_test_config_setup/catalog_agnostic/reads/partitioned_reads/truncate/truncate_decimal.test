# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/partitioned_reads/truncate/truncate_decimal.test
# group: [truncate]

include test/sql/init_requires

require-env CATALOG_TEST_CONFIG_SETUP

# Reset this small fixture for each test.

statement ok
DROP TABLE IF EXISTS my_datalake.default.truncate_partitioned_decimal;

statement ok
CREATE TABLE my_datalake.default.truncate_partitioned_decimal (
    id INTEGER,
    nested STRUCT(data decimal(10,2)),
    label VARCHAR
)
PARTITIONED BY (truncate(50, nested.data)) WITH ('format-version' = '2');

statement ok
INSERT INTO my_datalake.default.truncate_partitioned_decimal
VALUES
    (1,  {'data': '10.65'::DECIMAL(10,2)}, 'tiger_owl_horse'),
    (2,  {'data': '10.49'::DECIMAL(10,2)}, 'tiger_owl_frog'),
    (3,  {'data': '10.75'::DECIMAL(10,2)}, 'tiger_owl_goose'),
    (4,  {'data': '10.1'::DECIMAL(10,2)}, 'happy_fun_times'),
    (5, NULL,  'null_row');

statement ok
create view scan as select * from my_datalake.default.truncate_partitioned_decimal;

query I
select count(*) from scan;
----
5

# unconstrained query reads all files
query II
explain analyze select * from scan;
----
analyzed_plan	<REGEX>:.*Total Files Read: 3\s+.*

query I
select count(*) from scan where nested.data >= '10.5'::decimal(10,2);
----
2

query II
explain analyze select * from scan where nested.data >= '10.5'::decimal(10,2);
----
analyzed_plan	<REGEX>:.*Total Files Read: 1\s+.*

query II
explain analyze select * from scan where nested.data = '10.9'::decimal(10,2);
----
analyzed_plan	<REGEX>:.*Total Files Read: 1\s+.*

# Filters on truncate-partitioned DECIMAL columns of every physical storage type
# (INT16, INT32, INT64, INT128) must read the unscaled value correctly.
# truncate(50): 10.65 / 10.75 -> 10.50, 10.49 / 10.10 -> 10.00, -0.01 -> -0.50

foreach dtype decimal(4,2) decimal(9,2) decimal(18,2) decimal(38,2)

statement ok
DROP TABLE IF EXISTS my_datalake.default.truncate_partitioned_decimal_widths;

statement ok
CREATE TABLE my_datalake.default.truncate_partitioned_decimal_widths (
    id INTEGER,
    c {dtype}
)
PARTITIONED BY (truncate(50, c)) WITH ('format-version' = '2');

statement ok
INSERT INTO my_datalake.default.truncate_partitioned_decimal_widths
VALUES
    (1, '10.65'::{dtype}),
    (2, '10.49'::{dtype}),
    (3, '10.75'::{dtype}),
    (4, '10.10'::{dtype}),
    (5, '-0.01'::{dtype}),
    (6, NULL);

query I
select id from my_datalake.default.truncate_partitioned_decimal_widths where c = '10.65'::{dtype};
----
1

query II
explain analyze select * from my_datalake.default.truncate_partitioned_decimal_widths where c = '10.65'::{dtype};
----
analyzed_plan	<REGEX>:.*Total Files Read: 1\s+.*

query I
select id from my_datalake.default.truncate_partitioned_decimal_widths where c >= '10.50'::{dtype} order by id;
----
1
3

query II
explain analyze select * from my_datalake.default.truncate_partitioned_decimal_widths where c >= '10.50'::{dtype};
----
analyzed_plan	<REGEX>:.*Total Files Read: 1\s+.*

query I
select id from my_datalake.default.truncate_partitioned_decimal_widths where c < '0'::{dtype};
----
5

statement ok
DROP TABLE my_datalake.default.truncate_partitioned_decimal_widths;

endloop
