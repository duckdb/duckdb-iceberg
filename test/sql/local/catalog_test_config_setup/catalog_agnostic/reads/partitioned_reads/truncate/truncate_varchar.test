# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/partitioned_reads/truncate/truncate_varchar.test
# group: [truncate]

include test/sql/init_requires

require-env CATALOG_TEST_CONFIG_SETUP

# Reset this small fixture for each test.

statement ok
DROP TABLE IF EXISTS my_datalake.default.truncate_partitioned_varchar;

statement ok
CREATE TABLE my_datalake.default.truncate_partitioned_varchar (
    id INTEGER,
    nested STRUCT(data VARCHAR(16)),
    label VARCHAR
)
PARTITIONED BY (truncate(2, nested.data)) WITH ('format-version' = '2');

statement ok
INSERT INTO my_datalake.default.truncate_partitioned_varchar
VALUES
    (1,  {'data': decode(from_hex('F09F90AFF09FA689F09F90B4'))}, 'tiger_owl_horse'),
    (2,  {'data': decode(from_hex('F09F90AFF09FA689F09F90B8'))}, 'tiger_owl_frog'),
    (3,  {'data': decode(from_hex('F09F90AFF09FA689F09FAABF'))}, 'tiger_owl_goose'),
    (4,  {'data': decode(from_hex('E298ADE298ABE298A6EFB88E'))}, 'happy_fun_times'),
    (5, NULL,  'null_row');

statement ok
create view scan as select * from my_datalake.default.truncate_partitioned_varchar;

query I
select count(*) from scan;
----
5

# unconstrained query reads all files
query II
explain analyze select * from scan;
----
analyzed_plan	<REGEX>:.*Total Files Read: 3\s+.*

query I
select count(*) from scan where nested.data >= '🐯';
----
3

# query II
# explain analyze select * from scan where nested.data >= '🐯';
# ----
# analyzed_plan	<REGEX>:.*Total Files Read: 1\s+.*

query I
select count(*) from scan where nested.data = '☭☫☦︎';
----
1

# query II
# explain analyze select * from scan where nested.data = '☭☫☦︎';
# ----
# analyzed_plan	<REGEX>:.*Total Files Read: 1\s+.*
