# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/test_read_from_partitioned_table.test
# group: [reads]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

require icu

include test/sql/local/catalog_test_config_setup/catalog_agnostic/setup/day_partitioned_table.test_setup

# Reset this small fixture for each test.

statement ok
DROP TABLE IF EXISTS my_datalake.default.month_partitioned_table;

statement ok
CREATE TABLE my_datalake.default.month_partitioned_table (
	id int,
	ts TIMESTAMPTZ,
	customer varchar(20),
    amount double
)
PARTITIONED BY (month(ts)) WITH ('format-version' = '2');

statement ok
insert into my_datalake.default.month_partitioned_table values
(1000,TIMESTAMPTZ '2025-01-01 00:00:00+00','C01-00',16.87),
(1001,TIMESTAMPTZ '2025-01-07 00:00:00+00','C01-01',80.19),
(1002,TIMESTAMPTZ '2025-01-13 00:00:00+00','C01-02',49.46),
(1003,TIMESTAMPTZ '2025-01-19 00:00:00+00','C01-03',75.11),
(1004,TIMESTAMPTZ '2025-01-25 00:00:00+00','C01-04',98.02),
(2000,TIMESTAMPTZ '2025-02-01 00:00:00+00','C02-00',58.46),
(2001,TIMESTAMPTZ '2025-02-07 00:00:00+00','C02-01',55.1),
(2002,TIMESTAMPTZ '2025-02-13 00:00:00+00','C02-02',16.48),
(2003,TIMESTAMPTZ '2025-02-19 00:00:00+00','C02-03',34.16),
(2004,TIMESTAMPTZ '2025-02-25 00:00:00+00','C02-04',54.99),
(3000,TIMESTAMPTZ '2025-03-01 00:00:00+00','C03-00',71.13),
(3001,TIMESTAMPTZ '2025-03-07 00:00:00+00','C03-01',82.34),
(3002,TIMESTAMPTZ '2025-03-13 00:00:00+00','C03-02',44.28),
(3003,TIMESTAMPTZ '2025-03-19 00:00:00+00','C03-03',15.93),
(3004,TIMESTAMPTZ '2025-03-25 00:00:00+00','C03-04',35.93);

statement ok
SET default_transaction_invalidation_policy='SYNTACTIC_ERRORS_DO_NOT_INVALIDATE';


statement ok
set enable_logging=true

statement ok
set logging_level='debug'

statement ok
SET TimeZone = 'UTC';

query I
SELECT count(*) FROM my_datalake.default.month_partitioned_table where ts < TIMESTAMPTZ '2025-02-01';
----
5

query I
SELECT count(*) FROM my_datalake.default.month_partitioned_table where ts <= TIMESTAMPTZ '2025-02-01';
----
6

query I
SELECT count(*) FROM my_datalake.default.month_partitioned_table where ts = TIMESTAMPTZ '2025-02-01';
----
1

query I
SELECT count(*) FROM my_datalake.default.month_partitioned_table where ts > TIMESTAMPTZ '2025-02-01';
----
9

query I
SELECT count(*) FROM my_datalake.default.month_partitioned_table where ts >= TIMESTAMPTZ '2025-02-01';
----
10


query I
SELECT count(*) FROM my_datalake.default.day_partitioned_table where ts < TIMESTAMPTZ '2025-01-02';
----
4

query I
SELECT count(*) FROM my_datalake.default.day_partitioned_table where ts <= TIMESTAMPTZ '2025-01-02';
----
