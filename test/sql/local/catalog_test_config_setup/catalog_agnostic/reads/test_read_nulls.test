# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/test_read_nulls.test
# group: [reads]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

require icu

statement ok
SET default_transaction_invalidation_policy='SYNTACTIC_ERRORS_DO_NOT_INVALIDATE';


statement ok
set enable_logging=true

statement ok
SET TimeZone = 'UTC';

statement ok
set logging_level='debug'

query II
select * from my_datalake.default.test_null_filtering where a is null order by all NULLS FIRST;
----
NULL	NULL
NULL	duck

query II
select * from my_datalake.default.test_null_filtering where a is not null order by all;
----
0	hello
1	world
3	NULL
5	wonderful
6	ducks
10	no nulls

query II
select * from my_datalake.default.test_null_filtering where a is distinct from null order by a;
----
0	hello
1	world
3	NULL
5	wonderful
6	ducks
10	no nulls

query II
select * from my_datalake.default.test_null_filtering where a is not distinct from null order by all NULLS FIRST;
----
NULL	NULL
NULL	duck
