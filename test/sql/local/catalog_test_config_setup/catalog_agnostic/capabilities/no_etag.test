# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/capabilities/no_etag.test
# description: Catalogs without ETags continue returning full table metadata
# group: [capabilities]

require-env CATALOG_TEST_CONFIG_SETUP

require-env-not ETAG_SUPPORT

include test/sql/init_requires

require core_functions

include test/sql/local/catalog_test_config_setup/catalog_agnostic/setup/etag_table.test_setup

loop i 0 2

query I
SELECT id FROM my_datalake.default.etag_revalidation;
----
42

endloop

# Unexpected ETag support fails this probe so the config declaration is updated.
query III
SELECT response.status, request.headers['If-None-Match'] IS NULL, etag IS NULL
FROM etag_load_requests;
----
OK_200	true	true
OK_200	true	true

query I
SELECT count(*) FROM duckdb_logs() WHERE type = 'Iceberg' AND message LIKE '%is unchanged%';
----
0

statement ok
DROP TABLE my_datalake.default.etag_revalidation;
