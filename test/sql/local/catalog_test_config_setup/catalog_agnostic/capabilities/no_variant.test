# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/capabilities/no_variant.test
# description: Reject VARIANT when its catalog capability is absent
# group: [capabilities]

require-env CATALOG_TEST_CONFIG_SETUP

require-env-not VARIANT_SUPPORT

include test/sql/init_requires

require core_functions

# Expected HTTP errors must be checked, not ignored.
set ignore_error_messages

# A successful ordinary write separates capability rejection from connectivity failures.
statement ok
DROP TABLE IF EXISTS my_datalake.default.cap_variant;

statement ok
CREATE TABLE my_datalake.default.cap_variant (id INTEGER);

statement ok
INSERT INTO my_datalake.default.cap_variant VALUES (1);

query I
SELECT id FROM my_datalake.default.cap_variant;
----
1

statement ok
DROP TABLE IF EXISTS my_datalake.default.cap_variant_unsupported;

# A valid V3 type must be rejected when its capability is absent.
statement error
CREATE TABLE my_datalake.default.cap_variant_unsupported (value VARIANT) WITH ('format-version' = 3);
----
HTTP Error

statement ok
DROP TABLE IF EXISTS my_datalake.default.cap_variant_unsupported;

statement ok
DROP TABLE my_datalake.default.cap_variant;
