# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/capabilities/no_time_travel.test
# description: Reject reads of a known earlier snapshot when time travel is absent
# group: [capabilities]

require-env CATALOG_TEST_CONFIG_SETUP

require-env-not TIMETRAVEL_SUPPORT

include test/sql/init_requires

require core_functions

# Expected HTTP errors must be checked, not ignored.
set ignore_error_messages

# A successful ordinary write separates capability rejection from connectivity failures.
statement ok
DROP TABLE IF EXISTS my_datalake.default.cap_time_travel;

statement ok
CREATE TABLE my_datalake.default.cap_time_travel (id INTEGER);

statement ok
INSERT INTO my_datalake.default.cap_time_travel VALUES (1);

query I
SELECT id FROM my_datalake.default.cap_time_travel;
----
1

statement ok
SET VARIABLE cap_first_snapshot = (
    SELECT metadata."current-snapshot-id"::BIGINT FROM iceberg_load_table_response(my_datalake.default.cap_time_travel)
);

statement ok
INSERT INTO my_datalake.default.cap_time_travel VALUES (2);

query I
SELECT sum(id) FROM my_datalake.default.cap_time_travel;
----
3

# This is a real earlier snapshot, not a nonexistent id or a future timestamp.
statement error
SELECT * FROM my_datalake.default.cap_time_travel AT (VERSION => getvariable('cap_first_snapshot'));
----
<REGEX>:.*([Ss]napshot|[Tt]ime.?travel|[Vv]ersion).*

statement ok
DROP TABLE my_datalake.default.cap_time_travel;
