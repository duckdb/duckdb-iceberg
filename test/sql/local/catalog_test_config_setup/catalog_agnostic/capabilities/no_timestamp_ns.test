# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/capabilities/no_timestamp_ns.test
# description: Reject TIMESTAMP_NS when its catalog capability is absent
# group: [capabilities]

require-env CATALOG_TEST_CONFIG_SETUP

require-env-not TIMESTAMP_NS_SUPPORT

include test/sql/init_requires

require core_functions

# Expected HTTP errors must be checked, not ignored.
set ignore_error_messages

# A successful ordinary write separates capability rejection from connectivity failures.
statement ok
DROP TABLE IF EXISTS my_datalake.default.cap_timestamp_ns;

statement ok
CREATE TABLE my_datalake.default.cap_timestamp_ns (id INTEGER);

statement ok
INSERT INTO my_datalake.default.cap_timestamp_ns VALUES (1);

query I
SELECT id FROM my_datalake.default.cap_timestamp_ns;
----
1

statement ok
DROP TABLE IF EXISTS my_datalake.default.cap_timestamp_ns_unsupported;

# A valid V3 type must be rejected when its capability is absent.
statement error
CREATE TABLE my_datalake.default.cap_timestamp_ns_unsupported (value TIMESTAMP_NS) WITH ('format-version' = 3);
----
HTTP Error

statement ok
DROP TABLE IF EXISTS my_datalake.default.cap_timestamp_ns_unsupported;

statement ok
DROP TABLE my_datalake.default.cap_timestamp_ns;
