# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/capabilities/no_case_sensitive_table_names.test
# description: Reject distinct table identifiers that differ only in case
# group: [capabilities]

require-env CATALOG_TEST_CONFIG_SETUP

require-env-not CASE_SENSITIVE_TABLE_NAMES_SUPPORT

include test/sql/init_requires

require core_functions

# Expected HTTP errors must be checked, not ignored.
set ignore_error_messages

# A successful ordinary write separates capability rejection from connectivity failures.
statement ok
DROP TABLE IF EXISTS my_datalake.default.cap_case_sensitive_names;

statement ok
CREATE TABLE my_datalake.default.cap_case_sensitive_names (id INTEGER);

statement ok
INSERT INTO my_datalake.default.cap_case_sensitive_names VALUES (1);

query I
SELECT id FROM my_datalake.default.cap_case_sensitive_names;
----
1

# The lowercase identifier works; only its case differs in the rejected CREATE.
statement error
CREATE TABLE my_datalake.default."CAP_case_sensitive_names" (id INTEGER);
----
<REGEX>:.*([Hh][Tt][Tt][Pp]|already exists).*

statement ok
DROP TABLE my_datalake.default.cap_case_sensitive_names;
