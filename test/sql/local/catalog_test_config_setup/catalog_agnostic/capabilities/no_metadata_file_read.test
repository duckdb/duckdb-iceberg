# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/capabilities/no_metadata_file_read.test
# description: Catalog reads work but direct metadata-file reads are denied
# group: [capabilities]

require-env CATALOG_TEST_CONFIG_SETUP

require-env-not METADATA_FILE_READ_SUPPORT

include test/sql/init_requires

require core_functions

# Expected HTTP errors must be checked, not ignored.
set ignore_error_messages

# A successful ordinary write separates capability rejection from connectivity failures.
statement ok
DROP TABLE IF EXISTS my_datalake.default.cap_metadata_file_read;

statement ok
CREATE TABLE my_datalake.default.cap_metadata_file_read (id INTEGER);

statement ok
INSERT INTO my_datalake.default.cap_metadata_file_read VALUES (1);

query I
SELECT id FROM my_datalake.default.cap_metadata_file_read;
----
1

statement ok
SET VARIABLE cap_metadata_path = (
    SELECT metadata_location FROM iceberg_load_table_response(my_datalake.default.cap_metadata_file_read)
);

query I
SELECT length(getvariable('cap_metadata_path')) > 0;
----
true

statement error
SELECT content FROM read_text(getvariable('cap_metadata_path'));
----
<REGEX>:.*(HTTP|AccessDenied|403|Permission denied).*

statement ok
DROP TABLE my_datalake.default.cap_metadata_file_read;
