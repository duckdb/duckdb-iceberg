# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/capabilities/no_staged_create.test
# description: Non-staged table creation is visible before commit and survives rollback
# group: [capabilities]

require-env CATALOG_TEST_CONFIG_SETUP

require-env-not STAGED_CREATE_SUPPORT

include test/sql/init_requires

require core_functions

# Expected HTTP errors must be checked, not ignored.
set ignore_error_messages

# A successful ordinary write separates capability rejection from connectivity failures.
statement ok
DROP TABLE IF EXISTS my_datalake.default.cap_staged_create;

statement ok
CREATE TABLE my_datalake.default.cap_staged_create (id INTEGER);

statement ok
INSERT INTO my_datalake.default.cap_staged_create VALUES (1);

query I
SELECT id FROM my_datalake.default.cap_staged_create;
----
1

statement ok
DROP TABLE IF EXISTS my_datalake.default.cap_staged_create_visible;

statement ok
BEGIN;

statement ok
CREATE TABLE my_datalake.default.cap_staged_create_visible (id INTEGER);

# LoadTableResponse performs a GET against the catalog, so this checks remote
# visibility rather than the creating connection's uncommitted table cache.
query I con2
SELECT metadata."current-schema-id" FROM iceberg_load_table_response(my_datalake.default.cap_staged_create_visible);
----
0

statement ok
ROLLBACK;

# Non-staged creation has already published the table to the catalog.
query I
SELECT count(*) FROM my_datalake.default.cap_staged_create_visible;
----
0

statement ok
DROP TABLE my_datalake.default.cap_staged_create_visible;

statement ok
DROP TABLE my_datalake.default.cap_staged_create;
