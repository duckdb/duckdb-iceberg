# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/capabilities/no_column_default.test
# description: Reject integer defaults independently of type-specific default support
# group: [capabilities]

require-env CATALOG_TEST_CONFIG_SETUP

require-env-not COLUMN_DEFAULT_SUPPORT

require-env FORMAT_V3_SUPPORT

include test/sql/init_requires

require core_functions

# Expected HTTP errors must be checked, not ignored.
set ignore_error_messages

# A successful ordinary write separates capability rejection from connectivity failures.
statement ok
DROP TABLE IF EXISTS my_datalake.default.cap_column_default;

statement ok
CREATE TABLE my_datalake.default.cap_column_default (id INTEGER);

statement ok
INSERT INTO my_datalake.default.cap_column_default VALUES (1);

query I
SELECT id FROM my_datalake.default.cap_column_default;
----
1

statement ok
DROP TABLE IF EXISTS my_datalake.default.cap_column_default_default;

statement error
CREATE TABLE my_datalake.default.cap_column_default_default (id INTEGER DEFAULT 42) WITH ('format-version' = 3);
----
HTTP Error

statement ok
DROP TABLE IF EXISTS my_datalake.default.cap_column_default_default;

statement ok
DROP TABLE my_datalake.default.cap_column_default;
