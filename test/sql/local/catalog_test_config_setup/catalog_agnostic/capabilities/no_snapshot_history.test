# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/capabilities/no_snapshot_history.test
# description: Verify committed history is absent when its capability is omitted
# group: [capabilities]

require-env CATALOG_TEST_CONFIG_SETUP

require-env-not SNAPSHOT_HISTORY_SUPPORT

include test/sql/init_requires

require core_functions

require json

# Expected HTTP errors must be checked, not ignored.
set ignore_error_messages

# A successful ordinary write separates capability rejection from connectivity failures.
statement ok
DROP TABLE IF EXISTS my_datalake.default.cap_snapshot_history;

statement ok
CREATE TABLE my_datalake.default.cap_snapshot_history (id INTEGER);

statement ok
INSERT INTO my_datalake.default.cap_snapshot_history VALUES (1);

query I
SELECT id FROM my_datalake.default.cap_snapshot_history;
----
1

statement ok
INSERT INTO my_datalake.default.cap_snapshot_history VALUES (2);

query I
SELECT sum(id) FROM my_datalake.default.cap_snapshot_history;
----
3

query I
SELECT coalesce(json_array_length(metadata::JSON, '$.snapshots'), 0) < 2
FROM iceberg_load_table_response(my_datalake.default.cap_snapshot_history);
----
true

statement ok
DROP TABLE my_datalake.default.cap_snapshot_history;
