# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/capabilities/no_unknown.test
# description: Reject "NULL" when its catalog capability is absent
# group: [capabilities]

require-env CATALOG_TEST_CONFIG_SETUP

require-env-not UNKNOWN_SUPPORT

include test/sql/init_requires

require core_functions

# Expected HTTP errors must be checked, not ignored.
set ignore_error_messages

# A successful ordinary write separates capability rejection from connectivity failures.
statement ok
DROP TABLE IF EXISTS my_datalake.default.cap_unknown;

statement ok
CREATE TABLE my_datalake.default.cap_unknown (id INTEGER);

statement ok
INSERT INTO my_datalake.default.cap_unknown VALUES (1);

query I
SELECT id FROM my_datalake.default.cap_unknown;
----
1

statement ok
DROP TABLE IF EXISTS my_datalake.default.cap_unknown_unsupported;

# A valid V3 type must be rejected when its capability is absent.
statement error
CREATE TABLE my_datalake.default.cap_unknown_unsupported (value "NULL") WITH ('format-version' = 3);
----
HTTP Error

statement ok
DROP TABLE IF EXISTS my_datalake.default.cap_unknown_unsupported;

statement ok
DROP TABLE my_datalake.default.cap_unknown;
