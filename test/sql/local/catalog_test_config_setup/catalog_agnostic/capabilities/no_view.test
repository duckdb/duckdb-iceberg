# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/capabilities/no_view.test
# description: Reject CREATE VIEW before commit when the catalog has no view endpoints
# group: [capabilities]

require-env CATALOG_TEST_CONFIG_SETUP

require-env-not VIEW_SUPPORT

include test/sql/init_requires

require core_functions

# Expected errors must be checked, not ignored.
set ignore_error_messages

# A successful ordinary write separates capability rejection from connectivity failures.
statement ok
DROP TABLE IF EXISTS my_datalake.default.cap_view;

statement ok
CREATE TABLE my_datalake.default.cap_view (id INTEGER);

statement ok
INSERT INTO my_datalake.default.cap_view VALUES (1);

query I
SELECT id FROM my_datalake.default.cap_view;
----
1

statement error
CREATE VIEW my_datalake.default.cap_view_unsupported AS SELECT id FROM my_datalake.default.cap_view;
----
This Iceberg REST catalog server does not support creating views

statement error
CREATE VIEW IF NOT EXISTS my_datalake.default.cap_view_unsupported AS SELECT 42 AS answer;
----
This Iceberg REST catalog server does not support creating views

# Inside a transaction the view is rejected at CREATE VIEW, not at COMMIT.
statement ok
BEGIN;

statement error
CREATE VIEW my_datalake.default.cap_view_unsupported AS SELECT 42 AS answer;
----
This Iceberg REST catalog server does not support creating views

statement ok
ROLLBACK;

statement error
SELECT * FROM my_datalake.default.cap_view_unsupported;
----
does not exist

statement ok
DROP TABLE my_datalake.default.cap_view;
