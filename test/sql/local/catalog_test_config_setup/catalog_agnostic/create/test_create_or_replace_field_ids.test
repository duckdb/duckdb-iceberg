# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/create/test_create_or_replace_field_ids.test
# description: Replacement matches case-sensitive nested field paths and preserves existing properties
# group: [create]

require-env CATALOG_TEST_CONFIG_SETUP

require-env TIMETRAVEL_SUPPORT

include test/sql/init_requires

require json

statement ok
CREATE TABLE my_datalake.default.cor_ids (
    a INTEGER, s STRUCT(x INTEGER, y VARCHAR), l STRUCT(k INTEGER)[], m MAP(VARCHAR, STRUCT(v INTEGER))
) WITH ('write.metadata.metrics.column.a' = 'full');

statement ok
SET VARIABLE cor_original = (SELECT metadata::JSON FROM iceberg_load_table_response(my_datalake.default.cor_ids));

statement ok
SET VARIABLE cor_fields = json_extract(getvariable('cor_original'), '$.schemas[0].fields');

statement ok
SET VARIABLE cor_last_id = json_extract(getvariable('cor_original'), '$."last-column-id"')::INTEGER;

# Keep an explicit name mapping unchanged, just as reference replacement does.
statement ok
ALTER TABLE my_datalake.default.cor_ids SET ('schema.name-mapping.default' = json_array(
    json_object('field-id', json_extract(getvariable('cor_fields'), '/0/id'), 'names', ['a', 'old_a'])
));

statement ok
SET VARIABLE cor_mapping = (SELECT value FROM iceberg_table_properties(my_datalake.default.cor_ids)
WHERE key = 'schema.name-mapping.default');

# Reorder roots and struct children, widen a field, and add fields at several depths.
statement ok
CREATE OR REPLACE TABLE my_datalake.default.cor_ids (
    m MAP(VARCHAR, STRUCT(v INTEGER, extra INTEGER)), l STRUCT(k INTEGER, extra INTEGER)[],
    s STRUCT(y VARCHAR, x BIGINT, extra INTEGER), a BIGINT,
    n STRUCT(x INTEGER), z INTEGER
);

statement ok
SET VARIABLE cor_new_fields = (
    SELECT s.fields::JSON FROM iceberg_load_table_response(my_datalake.default.cor_ids),
    unnest(metadata.schemas::VARIANT[]) t(s)
    WHERE s."schema-id"::INTEGER = metadata."current-schema-id"::INTEGER
);

foreach old_path,new_path /0/id,/3/id /1/id,/2/id /1/type/fields/0/id,/2/type/fields/1/id /1/type/fields/1/id,/2/type/fields/0/id /2/id,/1/id /2/type/element-id,/1/type/element-id /2/type/element/fields/0/id,/1/type/element/fields/0/id /3/id,/0/id /3/type/key-id,/0/type/key-id /3/type/value-id,/0/type/value-id /3/type/value/fields/0/id,/0/type/value/fields/0/id

query I
SELECT json_extract(getvariable('cor_fields'), '{old_path}') = json_extract(getvariable('cor_new_fields'), '{new_path}');
----
true

endloop

# Reference allocation assigns sibling IDs first, then visits their children.
foreach path,offset /4/id,1 /5/id,2 /0/type/value/fields/1/id,3 /1/type/element/fields/1/id,4 /2/type/fields/2/id,5 /4/type/fields/0/id,6

query I
SELECT json_extract(getvariable('cor_new_fields'), '{path}')::INTEGER = getvariable('cor_last_id') + {offset};
----
true

endloop

query I
SELECT metadata."last-column-id"::INTEGER = getvariable('cor_last_id') + 6
FROM iceberg_load_table_response(my_datalake.default.cor_ids);
----
true

statement ok
INSERT INTO my_datalake.default.cor_ids VALUES (map(['key'], [{'v':1, 'extra':2}]), [{'k':3, 'extra':4}],
    {'y':'yes', 'x':5, 'extra':6}, 7, {'x':8}, 9);

query IIIII
SELECT m['key'].v, l[1].k, s.x, a, n.x FROM my_datalake.default.cor_ids;
----
1	3	5	7	8

# Repeated replacement with an identical schema reuses it without allocating any IDs.
statement ok
SET VARIABLE cor_schema = (SELECT metadata."current-schema-id"::INTEGER FROM iceberg_load_table_response(my_datalake.default.cor_ids));

statement ok
CREATE OR REPLACE TABLE my_datalake.default.cor_ids AS SELECT * FROM my_datalake.default.cor_ids;

query II
SELECT metadata."current-schema-id"::INTEGER = getvariable('cor_schema'),
       metadata."last-column-id"::INTEGER = getvariable('cor_last_id') + 6
FROM iceberg_load_table_response(my_datalake.default.cor_ids);
----
true	true

# Matching is case-sensitive even though DuckDB SQL name resolution is not.
statement ok
CREATE OR REPLACE TABLE my_datalake.default.cor_ids ("A" INTEGER);

query I
SELECT s.fields[1].id::INTEGER = getvariable('cor_last_id') + 7
FROM iceberg_load_table_response(my_datalake.default.cor_ids), unnest(metadata.schemas::VARIANT[]) t(s)
WHERE s."schema-id"::INTEGER = metadata."current-schema-id"::INTEGER;
----
true

# Dropped columns' properties and name mappings are not rewritten as an ALTER side effect.
query I
SELECT value FROM iceberg_table_properties(my_datalake.default.cor_ids) WHERE key = 'write.metadata.metrics.column.a';
----
full

query I
SELECT value = getvariable('cor_mapping') FROM iceberg_table_properties(my_datalake.default.cor_ids)
WHERE key = 'schema.name-mapping.default';
----
true

statement ok
CREATE OR REPLACE TABLE my_datalake.default.cor_ids (a INTEGER);

query I
SELECT s.fields[1].id::INTEGER = getvariable('cor_last_id') + 8
FROM iceberg_load_table_response(my_datalake.default.cor_ids), unnest(metadata.schemas::VARIANT[]) t(s)
WHERE s."schema-id"::INTEGER = metadata."current-schema-id"::INTEGER;
----
true

statement ok
INSERT INTO my_datalake.default.cor_ids VALUES (42);

statement ok
SET VARIABLE cor_old_snapshot = (SELECT snapshot_id FROM iceberg_snapshots(my_datalake.default.cor_ids)
ORDER BY sequence_number DESC LIMIT 1);

# Replacement matches names even for a non-promotable type change. Snapshot reads
# must still use the old schema, while CTAS writes the new type with the same ID.
statement ok
CREATE OR REPLACE TABLE my_datalake.default.cor_ids AS SELECT a::VARCHAR a FROM my_datalake.default.cor_ids;

query TT
SELECT a, typeof(a) FROM my_datalake.default.cor_ids;
----
42	VARCHAR

query IT
SELECT a, typeof(a) FROM my_datalake.default.cor_ids AT (VERSION => getvariable('cor_old_snapshot'));
----
42	INTEGER

query I
SELECT s.fields[1].id::INTEGER = getvariable('cor_last_id') + 8
FROM iceberg_load_table_response(my_datalake.default.cor_ids), unnest(metadata.schemas::VARIANT[]) t(s)
WHERE s."schema-id"::INTEGER = metadata."current-schema-id"::INTEGER;
----
true

statement ok
DROP TABLE my_datalake.default.cor_ids;
