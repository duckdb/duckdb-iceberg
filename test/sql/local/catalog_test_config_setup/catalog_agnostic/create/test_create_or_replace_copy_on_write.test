# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/create/test_create_or_replace_copy_on_write.test
# description: V2 replacement and copy-on-write DELETE share a transaction without losing rows or history
# group: [create]

require-env CATALOG_TEST_CONFIG_SETUP

require-env SNAPSHOT_HISTORY_SUPPORT

require-env TIMETRAVEL_SUPPORT

include test/sql/init_requires

# Keep the replacement rows in one file so removing one row requires a rewrite.
statement ok
SET threads = 1;

foreach removed 1 3

statement ok
DROP TABLE IF EXISTS my_datalake.default.cor_cow;

statement ok
CREATE TABLE my_datalake.default.cor_cow (original INTEGER)
WITH ('format-version' = '2', 'write.delete.mode' = 'copy-on-write');

statement ok
INSERT INTO my_datalake.default.cor_cow VALUES (7);

statement ok
SET VARIABLE cor_cow_before = (
    SELECT {path: metadata_location, snapshot: metadata."current-snapshot-id"::BIGINT}
    FROM iceberg_load_table_response(my_datalake.default.cor_cow)
);

statement ok
BEGIN;

# A new schema also exercises the keep-row scan's use of transaction-local metadata.
statement ok
CREATE OR REPLACE TABLE my_datalake.default.cor_cow AS
SELECT i::INTEGER id, 'replacement' label FROM range(1, 4) t(i);

statement ok
DELETE FROM my_datalake.default.cor_cow WHERE id <= {removed};

query I
SELECT coalesce(list(id ORDER BY id), []::INTEGER[]) = list_filter([1, 2, 3], lambda x: x > {removed})
       AND count(*) FILTER (WHERE label <> 'replacement') = 0
FROM my_datalake.default.cor_cow;
----
true

statement ok
COMMIT;

query I
SELECT coalesce(list(id ORDER BY id), []::INTEGER[]) = list_filter([1, 2, 3], lambda x: x > {removed})
       AND count(*) FILTER (WHERE label <> 'replacement') = 0
FROM my_datalake.default.cor_cow;
----
true

# Partial deletion rewrites the file, deleting all rows only removes it
query IT
SELECT sequence_number, operation FROM iceberg_snapshots(my_datalake.default.cor_cow)
WHERE sequence_number <= 2 ORDER BY sequence_number;
----
1	append
2	append

query II
SELECT count(*) = 1, bool_and(operation = CASE WHEN {removed} = 3 THEN 'delete' ELSE 'overwrite' END)
FROM iceberg_snapshots(my_datalake.default.cor_cow) WHERE sequence_number = 3;
----
true	true

query I
WITH snapshots AS (
    SELECT sequence_number, parent_id, lag(snapshot_id) OVER (ORDER BY sequence_number) previous_id
    FROM iceberg_snapshots(my_datalake.default.cor_cow)
)
SELECT bool_and(CASE WHEN sequence_number = 2 THEN parent_id IS NULL
                     ELSE parent_id IS NOT DISTINCT FROM previous_id END) FROM snapshots;
----
true

query I
SELECT original FROM my_datalake.default.cor_cow
AT (VERSION => getvariable('cor_cow_before').snapshot);
----
7

statement ok
SET VARIABLE cor_cow_replaced = (
    SELECT snapshot_id FROM iceberg_snapshots(my_datalake.default.cor_cow) WHERE sequence_number = 2
);

query I
SELECT list(id ORDER BY id) = [1, 2, 3] FROM my_datalake.default.cor_cow
AT (VERSION => getvariable('cor_cow_replaced'));
----
true

query I
SELECT coalesce(sum(record_count), 0) = 3 - {removed}
FROM iceberg_metadata(my_datalake.default.cor_cow)
WHERE content = 'DATA' AND status <> 'DELETED';
----
true

query I
SELECT count(*) FROM iceberg_metadata(my_datalake.default.cor_cow)
WHERE content <> 'DATA' AND status <> 'DELETED';
----
0

statement ok
DROP TABLE IF EXISTS my_datalake.default.cor_cow;

statement ok
CREATE TABLE my_datalake.default.cor_cow (original INTEGER)
WITH ('format-version' = '2', 'write.delete.mode' = 'copy-on-write');

statement ok
INSERT INTO my_datalake.default.cor_cow VALUES (7);

statement ok
SET VARIABLE cor_cow_before = (
    SELECT {path: metadata_location, snapshot: metadata."current-snapshot-id"::BIGINT}
    FROM iceberg_load_table_response(my_datalake.default.cor_cow)
);

statement ok
BEGIN;

# A new schema also exercises the keep-row scan's use of transaction-local metadata.
statement ok
CREATE OR REPLACE TABLE my_datalake.default.cor_cow AS
SELECT i::INTEGER id, 'replacement' label FROM range(1, 4) t(i);

statement ok
DELETE FROM my_datalake.default.cor_cow WHERE id <= {removed};

query I
SELECT coalesce(list(id ORDER BY id), []::INTEGER[]) = list_filter([1, 2, 3], lambda x: x > {removed})
       AND count(*) FILTER (WHERE label <> 'replacement') = 0
FROM my_datalake.default.cor_cow;
----
true

statement ok
ROLLBACK;

# Rollback restores the original schema, rows, and exact published metadata pointer.
query I
SELECT original FROM my_datalake.default.cor_cow;
----
7

query I
SELECT metadata_location = getvariable('cor_cow_before').path
FROM iceberg_load_table_response(my_datalake.default.cor_cow);
----
true

query IT
SELECT sequence_number, operation FROM iceberg_snapshots(my_datalake.default.cor_cow);
----
1	append

statement ok
DROP TABLE my_datalake.default.cor_cow;

endloop

statement ok
RESET threads;
