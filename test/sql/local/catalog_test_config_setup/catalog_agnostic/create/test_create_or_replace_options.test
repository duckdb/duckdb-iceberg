# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/create/test_create_or_replace_options.test
# description: Replacement accepts the existing location and validates properties before publication
# group: [create]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

statement ok
DROP TABLE IF EXISTS my_datalake.default.cor_options;

statement ok
CREATE TABLE my_datalake.default.cor_options AS SELECT 1 a;

statement ok
SET VARIABLE cor_identity = (
    SELECT {location: metadata.location, uuid: metadata."table-uuid"}
    FROM iceberg_load_table_response(my_datalake.default.cor_options)
);

foreach option location LOCATION

statement ok
CREATE OR REPLACE TABLE my_datalake.default.cor_options
WITH ('{option}' = getvariable('cor_identity').location, 'cor.keep' = 'retained') AS SELECT 2 a;

query I
SELECT a FROM my_datalake.default.cor_options;
----
2

statement ok
CREATE OR REPLACE TABLE my_datalake.default.cor_options (a INTEGER)
WITH ('{option}' = getvariable('cor_identity').location, 'cor.new' = 'added');

query I
SELECT count(*) FROM my_datalake.default.cor_options;
----
0

query II
SELECT metadata.location = getvariable('cor_identity').location,
       metadata."table-uuid" = getvariable('cor_identity').uuid
FROM iceberg_load_table_response(my_datalake.default.cor_options);
----
true	true

query II
SELECT key, value FROM iceberg_table_properties(my_datalake.default.cor_options)
WHERE key LIKE 'cor.%' ORDER BY key;
----
cor.keep	retained
cor.new	added

query I
SELECT count(*) FROM iceberg_table_properties(my_datalake.default.cor_options) WHERE lower(key) = 'location';
----
0

endloop

statement ok
CREATE OR REPLACE TABLE my_datalake.default.cor_options
WITH ('location' = getvariable('cor_identity').location::VARCHAR || '/') AS SELECT 1 a WHERE false;

query I
SELECT count(*) FROM my_datalake.default.cor_options;
----
0

statement ok
INSERT INTO my_datalake.default.cor_options VALUES (7);

statement ok
SET VARIABLE cor_before = (SELECT metadata_location FROM iceberg_load_table_response(my_datalake.default.cor_options));

statement error
CREATE OR REPLACE TABLE my_datalake.default.cor_options (b INTEGER)
WITH ('location' = getvariable('cor_identity').location || '/different');
----
<REGEX>:.*cannot change the location.*

statement error
CREATE OR REPLACE TABLE my_datalake.default.cor_options WITH ('location' = NULL) AS SELECT 8 b;
----
<REGEX>:.*NULL is not supported.*location.*

foreach property uuid UUID snapshot-count current-snapshot-id current-snapshot-summary current-snapshot-timestamp-ms current-schema default-partition-spec default-sort-order

statement error
CREATE OR REPLACE TABLE my_datalake.default.cor_options (b INTEGER) WITH ('{property}' = 'invalid');
----
<REGEX>:.*reserved Iceberg table property.*

statement error
CREATE OR REPLACE TABLE my_datalake.default.cor_options WITH ('{property}' = 'invalid') AS SELECT 8 b;
----
<REGEX>:.*reserved Iceberg table property.*

endloop

statement error
CREATE OR REPLACE TABLE my_datalake.default.cor_options AS
SELECT CASE WHEN range = 4095 THEN error('replacement source failed') ELSE range END b FROM range(4096);
----
<REGEX>:.*replacement source failed.*

query I
SELECT a FROM my_datalake.default.cor_options;
----
7

query I
SELECT metadata_location = getvariable('cor_before') FROM iceberg_load_table_response(my_datalake.default.cor_options);
----
true

statement ok
DROP TABLE my_datalake.default.cor_options;
