# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/create/test_create_or_replace_copy_on_write_v3.test
# description: A v3 copy-on-write DELETE can remove a whole pending replacement file, but cannot rewrite survivors with unassigned lineage
# group: [create]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

include test/sql/init_requires

statement ok
SET threads = 1;

statement ok
DROP TABLE IF EXISTS my_datalake.default.cor_cow_v3;

statement ok
CREATE TABLE my_datalake.default.cor_cow_v3 (original INTEGER)
WITH ('format-version' = '3', 'write.delete.mode' = 'copy-on-write');

statement ok
INSERT INTO my_datalake.default.cor_cow_v3 VALUES (7);

statement ok
BEGIN;

statement ok
CREATE OR REPLACE TABLE my_datalake.default.cor_cow_v3 AS SELECT * FROM (VALUES (1), (2)) t(id);

statement error
DELETE FROM my_datalake.default.cor_cow_v3 WHERE id = 1;
----
cannot preserve uncommitted row lineage

statement ok
ROLLBACK;

query I
SELECT original FROM my_datalake.default.cor_cow_v3;
----
7

statement ok
BEGIN;

statement ok
CREATE OR REPLACE TABLE my_datalake.default.cor_cow_v3 AS SELECT * FROM (VALUES (1), (2)) t(id);

query I
DELETE FROM my_datalake.default.cor_cow_v3 WHERE id IN (1, 2);
----
2

statement ok
COMMIT;

query I
SELECT count(id) FROM my_datalake.default.cor_cow_v3;
----
0

statement ok
DROP TABLE my_datalake.default.cor_cow_v3;

statement ok
RESET threads;
