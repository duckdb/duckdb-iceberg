# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/create/test_create_geo.test
# group: [create]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

require-env GEOMETRY_SUPPORT

include test/sql/init_requires

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
set enable_logging=true

statement ok
set logging_level='debug'

statement ok
CREATE SCHEMA IF NOT EXISTS my_datalake.default;

statement ok
DROP TABLE IF EXISTS my_datalake.default.tbl;

# Iceberg spec: geometry columns must default to null
statement error
CREATE TABLE my_datalake.default.tbl(
	item_id int,
	g GEOMETRY DEFAULT 'POINT(0 0)'::GEOMETRY
) WITH ('format-version'='3');
----
Invalid Input Error: Non-null DEFAULT values are not accepted for columns of type geometry(ogc:crs84)

# GEOMETRY DEFAULT NULL is allowed
statement ok
DROP TABLE IF EXISTS my_datalake.default.tbl_geo_null;

statement ok
CREATE TABLE my_datalake.default.tbl_geo_null(
	item_id int,
	g GEOMETRY DEFAULT NULL
) WITH ('format-version'='3');

statement ok
DROP TABLE my_datalake.default.tbl_geo_null;

# CTAS must cast geometry to the CRS used by the Iceberg storage schema.
statement ok
DROP TABLE IF EXISTS my_datalake.default.tbl_geo_ctas;

statement ok
CREATE TABLE my_datalake.default.tbl_geo_ctas WITH ('format-version'='3') AS
SELECT 'POINT EMPTY'::GEOMETRY AS g,
       'POINT EMPTY'::GEOMETRY('OGC:CRS84') AS explicit_default,
       {'g': ['POINT EMPTY'::GEOMETRY]} AS nested_geometry,
       'POINT(1 2)'::GEOMETRY('OGC:CRS83') AS other_crs;

query T
SELECT g::VARCHAR FROM my_datalake.default.tbl_geo_ctas;
----
POINT EMPTY

query TTT
SELECT explicit_default::VARCHAR, nested_geometry.g[1]::VARCHAR, other_crs::VARCHAR
FROM my_datalake.default.tbl_geo_ctas;
----
POINT EMPTY	POINT EMPTY	POINT (1 2)

# Iceberg assigns its default CRS even when DuckDB's input has no CRS.
query TTTT
SELECT st_crs(g), st_crs(explicit_default), st_crs(nested_geometry.g[1]), st_crs(other_crs)
FROM my_datalake.default.tbl_geo_ctas;
----
OGC:CRS84	OGC:CRS84	OGC:CRS84	OGC:CRS83

# The default CRS is a constraint, not an unspecified CRS accepting any geometry.
statement error
INSERT INTO my_datalake.default.tbl_geo_ctas (g)
SELECT other_crs FROM my_datalake.default.tbl_geo_ctas;
----
Cannot cast GEOMETRY with CRS 'OGC:CRS83' to GEOMETRY with different CRS 'OGC:CRS84'

statement error
INSERT INTO my_datalake.default.tbl_geo_ctas (other_crs)
SELECT explicit_default FROM my_datalake.default.tbl_geo_ctas;
----
Cannot cast GEOMETRY with CRS 'OGC:CRS84' to GEOMETRY with different CRS 'OGC:CRS83'

# Also cover CTAS from a catalog scan, as in geometry_shred_empty.test.
statement ok
DROP TABLE IF EXISTS my_datalake.default.tbl_geo_ctas_copy;

statement ok
CREATE TABLE my_datalake.default.tbl_geo_ctas_copy WITH ('format-version'='3') AS
SELECT g FROM my_datalake.default.tbl_geo_ctas WHERE g IS NOT NULL;

query T
SELECT g::VARCHAR FROM my_datalake.default.tbl_geo_ctas_copy;
----
POINT EMPTY

query T
SELECT st_crs(g) FROM my_datalake.default.tbl_geo_ctas_copy;
----
OGC:CRS84

statement ok
DROP TABLE my_datalake.default.tbl_geo_ctas_copy;

statement ok
DROP TABLE my_datalake.default.tbl_geo_ctas;
