# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/create/test_view_name_resolution.test
# description: Querying an Iceberg view whose query names a table without its namespace is not supported, since the reader's session could change which table it reads
# group: [create]

require-env CATALOG_TEST_CONFIG_SETUP

require-env VIEW_SUPPORT

include test/sql/init_requires

statement ok
create schema if not exists my_datalake.view_names;

statement ok
use my_datalake.view_names;

statement ok
drop view if exists v_base;

statement ok
drop view if exists v_qualified;

statement ok
drop view if exists v_cte;

statement ok
drop table if exists vn_base;

statement ok
create table vn_base (i integer);

statement ok
insert into vn_base values (1);

statement ok
create view v_base as select i from vn_base;

statement ok
create view v_qualified as select i from my_datalake.view_names.vn_base;

statement ok
create view v_cte as with vn_base as (select 3 as i) select i from vn_base;

# The binder would look vn_base up in the reader's session, starting with its temporary tables
statement error
select i from v_base;
----
<REGEX>:.*Not implemented Error: Querying Iceberg view 'v_base' is not supported: its query names a table without a namespace.*

# A temporary table with the same name doesn't change a view that names the namespace
statement ok
create temp table vn_base as select 999 as i;

query I
select i from v_qualified;
----
1

# A CTE name isn't a table name
query I
select i from v_cte;
----
3

statement ok
drop table temp.main.vn_base;

# The refused view can still be listed and dropped
query I
select count(*) from duckdb_views() where database_name = 'my_datalake' and schema_name = 'view_names' and view_name = 'v_base';
----
1

statement ok
drop view v_base;

statement ok
drop view v_qualified;

statement ok
drop view v_cte;

statement ok
drop table vn_base;
