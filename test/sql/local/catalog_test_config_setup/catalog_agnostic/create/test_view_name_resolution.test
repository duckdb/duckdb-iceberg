# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/create/test_view_name_resolution.test
# description: Creating or querying an Iceberg view whose query names a table without its namespace is not supported, since the reader's session could change which table it reads
# group: [create]

require-env CATALOG_TEST_CONFIG_SETUP

require-env VIEW_SUPPORT

include test/sql/init_requires

statement ok
create schema if not exists my_datalake.view_names;

statement ok
use my_datalake.view_names;

statement ok
drop view if exists v_qualified;

statement ok
drop view if exists v_cte;

statement ok
drop view if exists v_subquery_cte;

statement ok
drop view if exists v_nested_cte;

statement ok
drop view if exists v_recursive_cte;

statement ok
drop table if exists vn_base;

statement ok
create table vn_base (i integer);

statement ok
insert into vn_base values (1);

# The binder would look vn_base up in the reader's session, starting with its temporary tables
statement error
create view v_base as select i from vn_base;
----
<REGEX>:.*Not implemented Error: Creating Iceberg view 'v_base' is not supported: its query names a table without a namespace.*

# Inside a CTE's body, its own name and the names of CTEs defined after it are table names
statement error
create view v_self_cte as with vn_base as (select i + 1 as i from vn_base) select i from vn_base;
----
<REGEX>:.*Not implemented Error: Creating Iceberg view 'v_self_cte' is not supported: its query names a table without a namespace.*

statement error
create view v_later_cte as with a as (select i from vn_base), vn_base as (select 2 as i) select i from a;
----
<REGEX>:.*Not implemented Error: Creating Iceberg view 'v_later_cte' is not supported: its query names a table without a namespace.*

statement ok
create view v_qualified as select i from my_datalake.view_names.vn_base;

statement ok
create view v_cte as with vn_base as (select 3 as i) select i from vn_base;

statement ok
create view v_subquery_cte as select i from (with c as (select 4 as i) select i from c);

statement ok
create view v_nested_cte as with a as (with b as (select 5 as i) select i from b) select i from a;

statement ok
create view v_recursive_cte as with recursive r as (select 1 as i union all select i + 1 from r where i < 3) select count(*) as n from r;

# A temporary table with the same name doesn't change a view that names the namespace
statement ok
create temp table vn_base as select 999 as i;

query I
select i from v_qualified;
----
1

# A CTE name isn't a table name, wherever the CTE is defined
query I
select i from v_cte;
----
3

query I
select i from v_subquery_cte;
----
4

query I
select i from v_nested_cte;
----
5

query I
select n from v_recursive_cte;
----
3

statement ok
drop table temp.main.vn_base;

statement ok
drop view v_qualified;

statement ok
drop view v_cte;

statement ok
drop view v_subquery_cte;

statement ok
drop view v_nested_cte;

statement ok
drop view v_recursive_cte;

statement ok
drop table vn_base;

statement ok
drop schema my_datalake.view_names;
