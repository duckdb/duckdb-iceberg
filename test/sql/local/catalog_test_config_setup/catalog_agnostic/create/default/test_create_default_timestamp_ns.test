# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/create/default/test_create_default_timestamp_ns.test
# group: [default]

require-env CATALOG_TEST_CONFIG_SETUP

require-env COLUMN_DEFAULT_SUPPORT

require-env FORMAT_V3_SUPPORT

require-env TIMESTAMP_NS_DEFAULT_SUPPORT

require-env TIMESTAMP_NS_SUPPORT

include test/sql/init_requires


statement ok
set enable_logging=true

statement ok
set logging_level='debug'

statement ok
CREATE SCHEMA IF NOT EXISTS my_datalake.default;

statement ok
DROP TABLE IF EXISTS my_datalake.default.tbl_types;

# Test TIMESTAMP_NS default
statement ok
CREATE TABLE my_datalake.default.tbl_types(
	id int,
	timestamp_ns_col TIMESTAMP_NS DEFAULT '1969-01-01T23:59:59.9999999'::TIMESTAMP_NS
) WITH ('format-version'='3');

statement ok
INSERT INTO my_datalake.default.tbl_types VALUES(1, DEFAULT);

query II
SELECT * FROM my_datalake.default.tbl_types;
----
1	1969-01-01 23:59:59.9999999

statement ok
DROP TABLE my_datalake.default.tbl_types;
