# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/create/default/test_create_default_struct.test
# description: Regression for non-flat vector in ManifestListReader when manifest_list has many entries
# group: [default]

require-env CATALOG_TEST_CONFIG_SETUP

require-env COLUMN_DEFAULT_SUPPORT

require-env FORMAT_V3_SUPPORT

include test/sql/init_requires


statement ok
drop table if exists my_datalake.default.tbl;

statement ok
SET GLOBAL __iceberg_unsafe_struct_null_default_interp = '{}';

statement ok
create table my_datalake.default.tbl(
	col STRUCT(
		a VARCHAR,
		b INTEGER,
		c BLOB
	) DEFAULT {'a': 'test', 'b': NULL},
	col2 BLOB
) WITH (
	'format-version'= 3
);

# in: - (col not provided)
# col.default: {}
# col.a.default: 'test'
# col.b.default: NULL
# col.c.default: -
# result: {'a': test, 'b': NULL, 'c': NULL}
statement ok
insert into my_datalake.default.tbl (col2) VALUES ('\xaa\xff\xaa'), ('\xAA\xFF\xAA\xAA\xFF\xAA')

query II
select * from my_datalake.default.tbl order by all;
----
{'a': test, 'b': NULL, 'c': NULL}	\xAA\xFF\xAA
{'a': test, 'b': NULL, 'c': NULL}	\xAA\xFF\xAA\xAA\xFF\xAA

# in: {'b': 42}
# col.default: {}
# col.a.default: 'test'
# col.b.default: NULL
# col.c.default: -
# result: {'a': test, 'b': 42, 'c': NULL}
statement ok
insert into my_datalake.default.tbl 
	VALUES ({'b': 42}, NULL)

query II
select * from my_datalake.default.tbl order by all;
----
{'a': test, 'b': 42, 'c': NULL}	NULL
{'a': test, 'b': NULL, 'c': NULL}	\xAA\xFF\xAA
{'a': test, 'b': NULL, 'c': NULL}	\xAA\xFF\xAA\xAA\xFF\xAA

# in: {'c': '\xaa\xff\xaa'}
# col.default: {}
# col.a.default: 'test'
# col.b.default: NULL
# col.c.default: -
# result: {'a': test, 'b': NULL, 'c': '\xaa\xff\xaa'}
statement ok
insert into my_datalake.default.tbl 
	VALUES ({'c': '\xaa\xff\xaa'}, NULL)

query II
select * from my_datalake.default.tbl order by all;
----
{'a': test, 'b': 42, 'c': NULL}	NULL
{'a': test, 'b': NULL, 'c': '\\xAA\\xFF\\xAA'}	NULL
{'a': test, 'b': NULL, 'c': NULL}	\xAA\xFF\xAA
{'a': test, 'b': NULL, 'c': NULL}	\xAA\xFF\xAA\xAA\xFF\xAA

# Nested display escaping must not change the stored BLOB.
query TIT
select typeof(col.c), octet_length(col.c), hex(col.c)
from my_datalake.default.tbl where col.c is not null;
----
BLOB	3	AAFFAA

# Struct nested within another struct

statement ok
drop table if exists my_datalake.default.nested_tbl;

statement ok
create table my_datalake.default.nested_tbl(
	col STRUCT(
		a VARCHAR,
		b STRUCT(
			v1 BIGINT,
			v2 BIGINT,
			v3 BIGINT
		),
		e BOOLEAN
	) DEFAULT {
		'a': 'test',
		'b': {
			'v1': 1000,
			'v3': -500
		},
		'e': NULL
	},
	col2 INTEGER
) WITH (
	'format-version'= 3
);

# col.b.in: -
# col.b.default: {}
# col.b.v1.default: 1000
# col.b.v2.default: -
# col.b.v3.default: -500
# col.b.result: {'v1': 1000, 'v2': NULL, 'v3': -500}
statement ok
insert into my_datalake.default.nested_tbl (col2) VALUES (12)

query II
select * from my_datalake.default.nested_tbl order by all;
----
{'a': test, 'b': {'v1': 1000, 'v2': NULL, 'v3': -500}, 'e': NULL}	12

# Only supply b.v3, which has a default of -500

# col.b.in: {'v3': NULL}
# col.b.default: {}
# col.b.v1.default: 1000
# col.b.v2.default: -
# col.b.v3.default: -500
# col.b.result: {'v1': 1000, 'v2': NULL, 'v3': NULL}
statement ok
insert into my_datalake.default.nested_tbl 
	VALUES (
		{
			'b': {
				'v3': NULL
			}
		},
		24
	)

query II
select * from my_datalake.default.nested_tbl order by all;
----
{'a': test, 'b': {'v1': 1000, 'v2': NULL, 'v3': -500}, 'e': NULL}	12
{'a': test, 'b': {'v1': 1000, 'v2': NULL, 'v3': NULL}, 'e': NULL}	24

# Only supply b.v2, which has no default

# col.b.in: {'v3': 42}
# col.b.default: {}
# col.b.v1.default: 1000
# col.b.v2.default: -
# col.b.v3.default: -500
# col.b.result: {'v1': 1000, 'v2': NULL, 'v3': 42}
statement ok
insert into my_datalake.default.nested_tbl 
	VALUES (
		{
			'b': {
				'v2': 250
			}
		},
		24
	)

query II
select * from my_datalake.default.nested_tbl order by all;
----
{'a': test, 'b': {'v1': 1000, 'v2': 250, 'v3': -500}, 'e': NULL}	24
{'a': test, 'b': {'v1': 1000, 'v2': NULL, 'v3': -500}, 'e': NULL}	12
{'a': test, 'b': {'v1': 1000, 'v2': NULL, 'v3': NULL}, 'e': NULL}	24

statement ok
RESET __iceberg_unsafe_struct_null_default_interp;

# In the default safe mode, DEFAULT NULL on a STRUCT remains NULL.

statement ok
drop table if exists my_datalake.default.tbl_default_null_struct;

statement ok
create table my_datalake.default.tbl_default_null_struct(
	id INTEGER,
	col STRUCT(
		a VARCHAR,
		b INTEGER,
		c STRUCT(
			x BIGINT
		)
	) DEFAULT NULL
) WITH (
	'format-version' = 3
);

statement ok
insert into my_datalake.default.tbl_default_null_struct values
	(1, DEFAULT),
	(2, DEFAULT),
	(3, NULL);

query II
select * from my_datalake.default.tbl_default_null_struct order by id;
----
1	NULL
2	NULL
3	NULL

# A STRUCT's default stays NULL. Its fields' defaults fill the fields missing from a supplied STRUCT.

statement ok
drop table if exists my_datalake.default.struct_field_defaults;

# p's default is NULL. x, y and n.v get the defaults 1, 2 and 3.
statement ok
CREATE TABLE my_datalake.default.struct_field_defaults (
	id INT,
	p STRUCT(x INT, y INT, n STRUCT(v INT, w INT)) DEFAULT {'x': 1, 'y': 2, 'n': {'v': 3}}
) WITH ('format-version' = '3');

statement ok
INSERT INTO my_datalake.default.struct_field_defaults (id) VALUES (1);

statement ok
INSERT INTO my_datalake.default.struct_field_defaults VALUES (2, {'x': 10});

statement ok
INSERT INTO my_datalake.default.struct_field_defaults VALUES (3, {'y': 20, 'n': {'w': 5}});

statement ok
INSERT INTO my_datalake.default.struct_field_defaults VALUES (4, NULL);

statement ok
INSERT INTO my_datalake.default.struct_field_defaults VALUES (5, {'x': NULL});

statement ok
INSERT INTO my_datalake.default.struct_field_defaults VALUES (6, DEFAULT);

statement ok
INSERT INTO my_datalake.default.struct_field_defaults (id, p) VALUES (7, {'y': 70});

query II
SELECT id, p FROM my_datalake.default.struct_field_defaults ORDER BY id;
----
1	NULL
2	{'x': 10, 'y': 2, 'n': NULL}
3	{'x': 1, 'y': 20, 'n': {'v': 3, 'w': 5}}
4	NULL
5	{'x': NULL, 'y': 2, 'n': NULL}
6	NULL
7	{'x': 1, 'y': 70, 'n': NULL}

# A default set on a field later
statement ok
ALTER TABLE my_datalake.default.struct_field_defaults ALTER COLUMN p.y SET DEFAULT 200;

statement ok
INSERT INTO my_datalake.default.struct_field_defaults VALUES (8, {'x': 80});

# n is supplied as NULL, so its fields' defaults don't apply
statement ok
INSERT INTO my_datalake.default.struct_field_defaults VALUES (10, {'x': 100, 'n': NULL});

statement ok
UPDATE my_datalake.default.struct_field_defaults SET p = {'x': 11} WHERE id = 1;

statement ok
UPDATE my_datalake.default.struct_field_defaults SET p = DEFAULT WHERE id = 2;

query I
MERGE INTO my_datalake.default.struct_field_defaults AS t USING (
	VALUES (3, {'x': 30}), (9, {'x': 90})
) AS s(id, p) ON t.id = s.id
WHEN MATCHED THEN UPDATE SET p = s.p
WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.p)
----
2

query II
SELECT id, p FROM my_datalake.default.struct_field_defaults ORDER BY id;
----
1	{'x': 11, 'y': 200, 'n': NULL}
2	NULL
3	{'x': 30, 'y': 200, 'n': NULL}
4	NULL
5	{'x': NULL, 'y': 2, 'n': NULL}
6	NULL
7	{'x': 1, 'y': 70, 'n': NULL}
8	{'x': 80, 'y': 200, 'n': NULL}
9	{'x': 90, 'y': 200, 'n': NULL}
10	{'x': 100, 'y': 200, 'n': NULL}

statement ok
DROP TABLE my_datalake.default.struct_field_defaults;
