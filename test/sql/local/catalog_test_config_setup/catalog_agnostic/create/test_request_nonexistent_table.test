# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/create/test_request_nonexistent_table.test
# description: test create table
# group: [create]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

require core_functions


statement ok
set logging_level='debug'

statement ok
create schema if not exists my_datalake.default;

statement ok
use my_datalake.default;

statement ok
drop table if exists create_table_t1;

# SHOW ALL TABLES below must have real tables to enumerate, even in an isolated catalog.
statement ok
DROP TABLE IF EXISTS my_datalake.default.request_nonexistent_seed_one;

statement ok
DROP TABLE IF EXISTS my_datalake.default.request_nonexistent_seed_two;

statement ok
CREATE TABLE my_datalake.default.request_nonexistent_seed_one (id INTEGER);

statement ok
CREATE TABLE my_datalake.default.request_nonexistent_seed_two (id INTEGER);

# table does not exist
statement error
select * from create_table_t1;
----
<REGEX>:.*table.*does not exist.*

statement ok
use my_datalake.non_existent_schema;

# schema also does not exist, but we cannot handle that
statement error
select * from non_existent_table
----
<REGEX>:.*non_existent_table.*does not exist.*

query I
select "schema" schema_name from (show all tables) where schema_name like '%non_existent_schema%';
----

query I
select count(*) > 1 from (show all tables);
----
1

statement ok
DROP TABLE my_datalake.default.request_nonexistent_seed_one;

statement ok
DROP TABLE my_datalake.default.request_nonexistent_seed_two;
