# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/create/test_not_null_metadata.test
# description: required Iceberg columns are reported as NOT NULL by DESCRIBE, information_schema and duckdb_constraints()
# group: [create]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

statement ok
use my_datalake.default;

statement ok
drop table if exists not_null_metadata_t;

statement ok
create table not_null_metadata_t (a int NOT NULL, b int, c varchar NOT NULL);

query II
SELECT column_name, "null" FROM (DESCRIBE not_null_metadata_t);
----
a	NO
b	YES
c	NO

query II
SELECT column_name, is_nullable FROM information_schema.columns
WHERE table_catalog = 'my_datalake' AND table_name = 'not_null_metadata_t' ORDER BY ordinal_position;
----
a	NO
b	YES
c	NO

query II
SELECT constraint_type, constraint_column_names FROM duckdb_constraints()
WHERE database_name = 'my_datalake' AND table_name = 'not_null_metadata_t' ORDER BY constraint_column_names;
----
NOT NULL	[a]
NOT NULL	[c]

# Writes still enforce the constraint
statement error
insert into not_null_metadata_t values (NULL, 1, 'x');
----
<REGEX>:.*NOT NULL constraint failed.*not_null_metadata_t.a.*

statement ok
insert into not_null_metadata_t values (1, NULL, 'x');

# Renaming a required column keeps it NOT NULL
statement ok
ALTER TABLE not_null_metadata_t RENAME COLUMN c TO c2;

query II
SELECT column_name, "null" FROM (DESCRIBE not_null_metadata_t);
----
a	NO
b	YES
c2	NO

# DROP NOT NULL makes the column nullable in the metadata too
statement ok
ALTER TABLE not_null_metadata_t ALTER COLUMN a DROP NOT NULL;

query II
SELECT column_name, "null" FROM (DESCRIBE not_null_metadata_t);
----
a	YES
b	YES
c2	NO

# Dropping the column before a required column keeps the constraint on the right column
statement ok
ALTER TABLE not_null_metadata_t DROP COLUMN a;

query II
SELECT column_name, "null" FROM (DESCRIBE not_null_metadata_t);
----
b	YES
c2	NO

query I
SELECT constraint_column_names FROM duckdb_constraints()
WHERE database_name = 'my_datalake' AND table_name = 'not_null_metadata_t';
----
[c2]

statement ok
drop table not_null_metadata_t;
