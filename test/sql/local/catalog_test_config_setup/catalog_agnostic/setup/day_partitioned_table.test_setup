# Small fixture: reset on every include.

statement ok
DROP TABLE IF EXISTS my_datalake.default.day_partitioned_table;

statement ok
CREATE TABLE my_datalake.default.day_partitioned_table (
	id int,
	ts TIMESTAMPTZ,
	customer varchar(20),
    amount double
)
PARTITIONED BY (day(ts)) WITH ('format-version' = '2');

