# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/scan_planning/scan_tasks_partition_pruning.test
# description: Planned tasks skip the partitions the scan's filters reject, by their partition_values
# group: [scan_planning]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

require json

statement ok
drop table if exists my_datalake.default.scan_tasks_pruning;

statement ok
create table my_datalake.default.scan_tasks_pruning(id integer, category integer, region varchar)
partitioned by (category) with ('format-version'=2);

statement ok
insert into my_datalake.default.scan_tasks_pruning select i, i % 10, 'r' || (i % 3)::varchar from range(10000) t(i);

statement ok
set iceberg_use_server_side_scan_planning=false;

# Keep the vended storage credentials alive from planning through task execution.
statement ok
begin;

statement ok
create temp table pruning_tasks as select * from iceberg_scan_plan('my_datalake.default.scan_tasks_pruning');

statement ok
set variable pruning_list = (select list(task) from (select * from pruning_tasks) task);

statement ok
set variable pruning_list_without = (select list(task) from (select * exclude (partition_values) from pruning_tasks) task);

statement ok
create temp table pruning_keys(category integer);

statement ok
insert into pruning_keys values (3), (4);

# Keep the task scan on the probe side, so the join's filter reaches it at execution time.
statement ok
set disabled_optimizers='join_order,build_side_probe_side';

# Files skipped by their partition values. iceberg_scan's planner also skips files by their column bounds, which a
# task does not carry; those lines name no partition column.
statement ok
create temp macro skipped_tasks() as
 (select count(*) from duckdb_logs() where type = 'Iceberg'
  and message.contains('Iceberg Filter Pushdown, skipped ''data_file'':') and message.contains('partition column'));

foreach multi_file true false

statement ok
set iceberg_enable_multi_file_scan_tasks={multi_file};

statement ok
call enable_logging('Iceberg');

statement ok
call truncate_duckdb_logs();

# A join's runtime filter skips every task outside the build side's partitions.
query II
select count(*), sum(t.id)
from iceberg_scan_tasks(getvariable('pruning_list')) t
join pruning_keys using (category);
----
2000	9997000

query I
select skipped_tasks() = (select count(*) from pruning_tasks where partition_constants."2" not in (3, 4))
   and skipped_tasks() > 0;
----
true

statement ok
call truncate_duckdb_logs();

# Without partition_values, the same tasks skip nothing.
query II
select count(*), sum(t.id) from iceberg_scan_tasks(getvariable('pruning_list_without')) t join pruning_keys using (category);
----
2000	9997000

query I
select skipped_tasks();
----
0

statement ok
call disable_logging();

# A static filter: the rows, file names and positions of the table's own scan.
query I
select count(*) from (
 (select id, category, region, filename, file_row_number
  from iceberg_scan_tasks(getvariable('pruning_list')) where category = 7
  except all
  select id, category, region, filename, file_row_number from my_datalake.default.scan_tasks_pruning where category = 7)
 union all
 (select id, category, region, filename, file_row_number from my_datalake.default.scan_tasks_pruning where category = 7
  except all
  select id, category, region, filename, file_row_number
  from iceberg_scan_tasks(getvariable('pruning_list')) where category = 7));
----
0

endloop

statement ok
commit;

# ---- an evolved spec: identity on category, then on region ----------------------------------------------------------

statement ok
drop table if exists my_datalake.default.scan_tasks_evolved;

statement ok
create table my_datalake.default.scan_tasks_evolved(id integer, category integer, region varchar)
partitioned by (category) with ('format-version'=2);

statement ok
insert into my_datalake.default.scan_tasks_evolved select i, i % 10, 'r' || (i % 3)::varchar from range(1000) t(i);

statement ok
alter table my_datalake.default.scan_tasks_evolved set partitioned by (region);

statement ok
insert into my_datalake.default.scan_tasks_evolved
select i, i % 10, 'r' || (i % 3)::varchar from range(1000, 2000) t(i);

statement ok
begin;

statement ok
create temp table evolved_tasks as select * from iceberg_scan_plan('my_datalake.default.scan_tasks_evolved');

statement ok
set variable evolved_list = (select list(task) from (select * from evolved_tasks) task);

# Files of both specs: 10 under the first (one per category), 3 under the second (one per region).
query II
select count(*) filter (where partition_spec_id = 0), count(*) filter (where partition_spec_id = 1) from evolved_tasks;
----
10	3

foreach multi_file true false

statement ok
set iceberg_enable_multi_file_scan_tasks={multi_file};

statement ok
call enable_logging('Iceberg');

statement ok
call truncate_duckdb_logs();

# A join on category skips only the first spec's files of other categories: the second spec has no identity value for
# category, so its files are opened and their rows answer.
query II
select count(*), sum(t.id)
from iceberg_scan_tasks(getvariable('evolved_list')) t
join pruning_keys using (category);
----
400	399400

query I
select skipped_tasks();
----
8

statement ok
call truncate_duckdb_logs();

# A static filter on region skips only the second spec's other regions.
query I
select count(*) from iceberg_scan_tasks(getvariable('evolved_list')) where region = 'r1';
----
667

query I
select skipped_tasks();
----
2

statement ok
call disable_logging();

# The same rows, file names and positions as the table's own scan, for both filters.
query I
select count(*) from (
 (select id, category, region, filename, file_row_number
  from iceberg_scan_tasks(getvariable('evolved_list')) t
  where category in (3, 4) or region = 'r1'
  except all
  select id, category, region, filename, file_row_number from my_datalake.default.scan_tasks_evolved
  where category in (3, 4) or region = 'r1')
 union all
 (select id, category, region, filename, file_row_number from my_datalake.default.scan_tasks_evolved
  where category in (3, 4) or region = 'r1'
  except all
  select id, category, region, filename, file_row_number
  from iceberg_scan_tasks(getvariable('evolved_list')) t
  where category in (3, 4) or region = 'r1'));
----
0

endloop

statement ok
commit;

# ---- transforms: a file is skipped by its day, month, bucket or truncate value, as iceberg_scan skips it -----------

statement ok
drop table if exists my_datalake.default.scan_tasks_transforms;

statement ok
create table my_datalake.default.scan_tasks_transforms(id integer, g integer, ts timestamp, d date, k bigint, s varchar)
partitioned by (day(ts), month(d), bucket(4, k), truncate(2, s)) with ('format-version'=2);

# Twelve groups, one file each: group g holds day 2024-01-(1+g), month 2024-(1+g), k = g and s = 'v' || g.
statement ok
insert into my_datalake.default.scan_tasks_transforms
select i, i % 12, timestamp '2024-01-01' + to_days(i % 12) + to_hours(i % 7),
       (date '2024-01-15' + to_months(i % 12))::date, i % 12, 'v' || (i % 12)
from range(1200) t(i);

statement ok
begin;

statement ok
create temp table transform_tasks as select * from iceberg_scan_plan('my_datalake.default.scan_tasks_transforms');

statement ok
set variable transform_list = (select list(task) from (select * from transform_tasks) task);

query I
select count(*) from transform_tasks;
----
12

statement ok
create temp table transform_keys(ts timestamp);

statement ok
insert into transform_keys values ('2024-01-05 03:00:00'), ('2024-01-06 02:00:00');

statement ok
create temp table transform_skips(mode boolean, n integer, table_skips bigint, task_skips bigint);

foreach multi_file true false

statement ok
set iceberg_enable_multi_file_scan_tasks={multi_file};

# For each filter: the tasks skip the files iceberg_scan's planner skips by partition value, and return its rows.
foreach pred (ts>='2024-01-05')and(ts<'2024-01-07') (d>='2024-04-01')and(d<'2024-05-01') k=7 (k=3)or(k=7) s='v1'

statement ok
call enable_logging('Iceberg');

statement ok
call truncate_duckdb_logs();

statement ok
create or replace temp table transform_table_rows as
select id, g, ts, d, k, s from my_datalake.default.scan_tasks_transforms where {pred};

statement ok
create or replace temp table transform_table_skips as select skipped_tasks() n;

statement ok
call truncate_duckdb_logs();

statement ok
create or replace temp table transform_task_rows as
select id, g, ts, d, k, s from iceberg_scan_tasks(getvariable('transform_list')) where {pred};

statement ok
insert into transform_skips select {multi_file}, (select count(*) from transform_skips where mode = {multi_file}),
 (select n from transform_table_skips), skipped_tasks();

statement ok
call disable_logging();

query I
select count(*) from ((select * from transform_task_rows except all select * from transform_table_rows)
 union all (select * from transform_table_rows except all select * from transform_task_rows));
----
0

endloop

# A join's runtime filter on ts: the same skips and rows as iceberg_scan under the same join.
statement ok
call enable_logging('Iceberg');

statement ok
call truncate_duckdb_logs();

statement ok
create or replace temp table transform_table_rows as
select id, g, ts from my_datalake.default.scan_tasks_transforms t join transform_keys using (ts);

statement ok
create or replace temp table transform_table_skips as select skipped_tasks() n;

statement ok
call truncate_duckdb_logs();

statement ok
create or replace temp table transform_task_rows as
select id, g, ts from iceberg_scan_tasks(getvariable('transform_list')) t join transform_keys using (ts);

query II
select skipped_tasks() = (select n from transform_table_skips), skipped_tasks() > 0;
----
true	true

statement ok
call disable_logging();

query II
select count(*), count(distinct g) from transform_task_rows;
----
28	2

query I
select count(*) from ((select * from transform_task_rows except all select * from transform_table_rows)
 union all (select * from transform_table_rows except all select * from transform_task_rows));
----
0

endloop

statement ok
commit;

# The skips of each filter, in loop order, in both modes: the tasks skip what iceberg_scan's planner skips by partition
# value. Neither skips by a bucket under OR.
query TIII
select mode, n, table_skips, task_skips from transform_skips order by mode, n;
----
false	0	9	9
false	1	10	10
false	2	6	6
false	3	0	0
false	4	9	9
true	0	9	9
true	1	10	10
true	2	6	6
true	3	0	0
true	4	9	9

# ---- tasks sent with a schema newer than their plan's, after a type promotion that wrote no snapshot --------------

# A distributed engine can pin its plan to the snapshot a query was bound at and send the tasks with the schema the
# query was bound with. After a promotion that wrote no snapshot, that schema is newer than the snapshot's, so the
# values in partition_values have the older type. They are widened exactly, and the tasks still skip by them.
statement ok
drop table if exists my_datalake.default.scan_tasks_promoted;

statement ok
create table my_datalake.default.scan_tasks_promoted(id integer, k integer, j integer, p integer)
partitioned by (truncate(10, k), bucket(4, j), p) with ('format-version'=2);

statement ok
insert into my_datalake.default.scan_tasks_promoted select i, i, i, nullif(i // 10, 3) from range(40) t(i);

statement ok
set variable promoted_snapshot = (select max(snapshot_id) from iceberg_snapshots(my_datalake.default.scan_tasks_promoted));

statement ok
alter table my_datalake.default.scan_tasks_promoted alter k type bigint;

statement ok
alter table my_datalake.default.scan_tasks_promoted alter j type bigint;

statement ok
alter table my_datalake.default.scan_tasks_promoted alter p type bigint;

statement ok
begin;

statement ok
set variable promoted_schema = (select schema_id from iceberg_scan_plan('my_datalake.default.scan_tasks_promoted') limit 1);

statement ok
create temp table promoted_tasks as select * from iceberg_scan_plan('my_datalake.default.scan_tasks_promoted',
                                                                    snapshot_from_id => getvariable('promoted_snapshot'));

# The plan's values have the snapshot's types, and its schema is older than the current one.
query II
select typeof(partition_values), schema_id < getvariable('promoted_schema') from promoted_tasks limit 1;
----
STRUCT("1000" INTEGER, "1001" INTEGER, "1002" INTEGER)	true

statement ok
set variable promoted_list = (select list(struct_update(t, schema_id := getvariable('promoted_schema'),
                                                         "schema" := NULL::struct(id integer, k bigint, j bigint, p bigint)))
                              from (select * from promoted_tasks) t);

statement ok
call enable_logging('Iceberg');

statement ok
call truncate_duckdb_logs();

query II
select count(*), min(k) from iceberg_scan_tasks(getvariable('promoted_list')) where k = 5;
----
1	5

query I
select skipped_tasks() > 0;
----
true

statement ok
call disable_logging();

# The rows of the table's own scan.
foreach pred k=5 k>=25 j=7 p=2 (k<12)and(j>3)

query I
select count(*) from (
 (select id, k, j from iceberg_scan_tasks(getvariable('promoted_list')) where {pred}
  except all select id, k, j from my_datalake.default.scan_tasks_promoted where {pred})
 union all
 (select id, k, j from my_datalake.default.scan_tasks_promoted where {pred}
  except all select id, k, j from iceberg_scan_tasks(getvariable('promoted_list')) where {pred}));
----
0

endloop

query II
select count(*), min(id) from iceberg_scan_tasks(getvariable('promoted_list')) where p is null;
----
10	30

# If the data file omits the promoted identity column, its old constant must supply the BIGINT value.
statement ok
copy (select 123::integer id) to '{TEST_DIR}/promoted_identity.parquet' (field_ids {id:1});

statement ok
set variable promoted_fallback = (select [struct_update(t, file_path := '{TEST_DIR}/promoted_identity.parquet',
 file_size_in_bytes := (select size::bigint from read_blob('{TEST_DIR}/promoted_identity.parquet')),
 record_count := 1::bigint)] from unnest(getvariable('promoted_list')) u(t)
 where t.partition_values."1002" = 2 limit 1);

query IIT
select id, p, typeof(p) from iceberg_scan_tasks(getvariable('promoted_fallback')) where p = 2;
----
123	2	BIGINT

# The call-level snapshot must authorize the same promotion when the file descriptor omits its context.
statement ok
set variable promoted_files = (select list(f) from (
 select * exclude (snapshot_id, schema_id, metadata, schema)
 from (select t.* from unnest(getvariable('promoted_fallback')) u(t))) f);

statement ok
set variable promoted_metadata = (select metadata from promoted_tasks limit 1);

query IIT
select id, p, typeof(p) from iceberg_scan_tasks(getvariable('promoted_files'),
 metadata := getvariable('promoted_metadata'), schema_id := getvariable('promoted_schema'),
 snapshot_id := getvariable('promoted_snapshot')) where p = 2;
----
123	2	BIGINT

# A value that happens to fit is insufficient. Its type must match the source in the pinned snapshot.
statement ok
set variable mistyped_fallback = (select [struct_update(t, partition_constants := {'4': 2::smallint})]
 from unnest(getvariable('promoted_fallback')) u(t));

statement ok
commit;

statement error
select id, p from iceberg_scan_tasks(getvariable('promoted_files'),
 metadata := getvariable('promoted_metadata'), schema_id := getvariable('promoted_schema'));
----
partition constant 4 does not match the table schemas

statement error
select * from iceberg_scan_tasks(getvariable('mistyped_fallback'));
----
partition constant 4 does not match the table schemas

# Reversing the schema change would narrow the fallback, even when this particular value fits in INTEGER.
statement ok
insert into my_datalake.default.scan_tasks_promoted values (40, 40, 40, 4);

statement ok
begin;

statement ok
set variable narrowed_list = (select [struct_update(t, schema_id := (select min(schema_id) from promoted_tasks),
 "schema" := NULL::struct(id integer, k integer, j integer, p integer))]
 from iceberg_scan_plan('my_datalake.default.scan_tasks_promoted') t where partition_values."1002" = 4);

statement error
select * from iceberg_scan_tasks(getvariable('narrowed_list'));
----
partition constant 4 does not match the table schemas

statement ok
commit;
