# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/scan_planning/scan_tasks.test
# description: Execute lists of stored scan tasks with partition constants and deletes
# group: [scan_planning]

require-env CATALOG_TEST_CONFIG_SETUP

require-env TIMETRAVEL_SUPPORT

include test/sql/init_requires

require json

statement ok
drop table if exists my_datalake.default.scan_tasks_test;

statement ok
create table my_datalake.default.scan_tasks_test(id integer, category integer, payload struct(n integer, tags varchar[]))
partitioned by (category) with ('format-version'=2);

# Keep planning credentials alive until the task list has been consumed.
statement ok
begin;

statement ok
set variable scan_task_list_1 = (select list(task) from (select * from iceberg_scan_plan('my_datalake.default.scan_tasks_test')) task);

# Binding succeeds without receiving a single metadata value.
query I
select count(*) from iceberg_scan_tasks(getvariable('scan_task_list_1'));
----
0

statement ok
commit;

statement ok
insert into my_datalake.default.scan_tasks_test
select i, i % 3, {'n': i, 'tags': [i::varchar]} from range(9000) t(i);

statement ok
set iceberg_use_server_side_scan_planning=false;

# Keep the vended storage credentials alive from planning through task execution.
statement ok
begin;

statement ok
create temp table saved_tasks as select * from iceberg_scan_plan('my_datalake.default.scan_tasks_test');

query II
select bool_and(schema is null), count(*) from saved_tasks;
----
true	3

statement ok
set variable saved_snapshot = (select snapshot_id from saved_tasks limit 1);

statement ok
create temp table expected_scan as select * from my_datalake.default.scan_tasks_test;

# Repeated executions create filtered views with their own cursors while sharing
# the bound scan configuration and manifest caches. Changing the build-side key
# must neither retain the previous filter nor exhaust the original scan.
statement ok
create temp table scan_category(category integer);

statement ok
insert into scan_category values (0);

statement ok
prepare filtered_scan as
select count(*), sum(id) from my_datalake.default.scan_tasks_test join scan_category using(category);

query II
execute filtered_scan;
----
3000	13495500

statement ok
update scan_category set category=2;

query II
execute filtered_scan;
----
3000	13501500

statement ok
update scan_category set category=0;

query II
execute filtered_scan;
----
3000	13495500

statement ok
set variable scan_task_list_2 = (select list(task) from (select * from saved_tasks) task);

statement ok
set variable scan_task_list_3 = (select list(task) from (select * from saved_tasks) task);

# Both directions preserve types, nested values, and multiplicity.
query I
select count(*) from (
  (select * from iceberg_scan_tasks(getvariable('scan_task_list_2')) except all select * from expected_scan)
  union all
  (select * from expected_scan except all select * from iceberg_scan_tasks(getvariable('scan_task_list_3')))
);
----
0

statement ok
set iceberg_use_server_side_scan_planning=true;

statement ok
set variable scan_task_list_4 = (select list(task) from (select * from iceberg_scan_plan('my_datalake.default.scan_tasks_test')) task);

query II
select count(*), sum(id) from iceberg_scan_tasks(getvariable('scan_task_list_4'));
----
9000	40495500

statement ok
