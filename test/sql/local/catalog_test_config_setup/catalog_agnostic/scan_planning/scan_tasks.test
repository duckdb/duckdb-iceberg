# Re-plan the original snapshot in this transaction to acquire credentials for replay.
statement ok
begin;

statement ok
create or replace temp table saved_tasks as
select * from iceberg_scan_plan('my_datalake.default.scan_tasks_test', snapshot_from_id=getvariable('saved_snapshot'));

# Stored plans do not consult the newly altered table schema.
statement ok
alter table my_datalake.default.scan_tasks_test add column added varchar;

statement ok
set variable scan_task_list_21 = (select list(task) from (select * from saved_tasks) task);

query II
select count(*), sum(id) from iceberg_scan_tasks(getvariable('scan_task_list_21'));
