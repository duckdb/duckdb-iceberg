statement ok
set variable scan_task_list_23 = (select list(task) from (select * from iceberg_scan_plan('my_datalake.default.scan_tasks_test', snapshot_from_id=getvariable('saved_snapshot'))) task);

query II
select count(*), sum(id) from iceberg_scan_tasks(getvariable('scan_task_list_23'));
----
9000	40495500

statement ok
commit;

# Drops cannot share a transaction with table updates. Acquire fresh credentials first.
statement ok
begin;

statement ok
create or replace temp table saved_tasks as
select * from iceberg_scan_plan('my_datalake.default.scan_tasks_test', snapshot_from_id=getvariable('saved_snapshot'));

statement ok
drop table my_datalake.default.scan_tasks_test;

statement ok
set variable scan_task_list_24 = (select list(task) from (select * from saved_tasks) task);

# No table exists now, but the referenced files and credentials remain available.
query II
select count(*), sum(id) from iceberg_scan_tasks(getvariable('scan_task_list_24'));
----
9000	40495500

statement ok
commit;

statement ok
create table my_datalake.default.scan_tasks_test(id integer) with ('format-version'=3);

statement ok
insert into my_datalake.default.scan_tasks_test values (1), (2), (3);

statement ok
alter table my_datalake.default.scan_tasks_test add column extra varchar default 'initial';

statement ok
delete from my_datalake.default.scan_tasks_test where id=2;

# Keep planning credentials alive until the task list has been consumed.
statement ok
begin;

statement ok
set variable scan_task_list_25 = (select list(task) from (select * from iceberg_scan_plan('my_datalake.default.scan_tasks_test')) task);

query IT
select * from iceberg_scan_tasks(getvariable('scan_task_list_25')) order by id;
----
