statement ok
set variable scan_task_list_20 = (select list(task) from (select * replace(list_transform(delete_files, lambda d: struct_update(d, content := 0)) as delete_files) from deleted_tasks) task);

statement error
select * from iceberg_scan_tasks(getvariable('scan_task_list_20'));
