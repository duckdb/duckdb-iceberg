query II
select count(*), min(category) from iceberg_scan_tasks(getvariable('scan_task_list_5'));
----
3000	1

statement ok
set variable scan_task_list_6 = (select list(task) from (select schema, 42 as extra, * exclude(schema) from saved_tasks where record_count>0) task);

# Extra/reordered task fields and filtered task lists are accepted.
query I
select count(*) from iceberg_scan_tasks(getvariable('scan_task_list_6'));
----
9000

statement ok
set variable scan_task_list_7 = (select list(task) from (select * from saved_tasks union all select * from saved_tasks) task);

query I
select count(*) from iceberg_scan_tasks(getvariable('scan_task_list_7'));
----
18000

statement ok
set variable scan_task_list_8 = (select list(task) from (select * from saved_tasks) task);

statement ok
prepare replay_scan_tasks as select count(*), sum(id) from iceberg_scan_tasks(getvariable('scan_task_list_8'));

loop threads 1 5

statement ok
set threads={threads};

query II
execute replay_scan_tasks;
----
9000	40495500

endloop

statement ok
commit;

