# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/merge/test_merge_upgraded_table_row_id.test
# description: MERGE INTO finds the target row on a table upgraded from format version 2, before any commit assigns row ids
# group: [merge]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

include test/sql/init_requires

statement ok
create schema if not exists my_datalake.default;

statement ok
drop table if exists my_datalake.default.merge_row_id_upgraded;

statement ok
create table my_datalake.default.merge_row_id_upgraded (id int, data varchar) WITH ('format-version' = 2);

statement ok
insert into my_datalake.default.merge_row_id_upgraded values (1, 'a'), (2, 'b');

statement ok
ALTER TABLE my_datalake.default.merge_row_id_upgraded SET ('format-version' = 3);

# The rows have no _row_id yet. MERGE must still see id 2 as a target row and not insert it again.

statement ok
MERGE INTO my_datalake.default.merge_row_id_upgraded AS t USING (SELECT 2 AS id, 'm' AS data UNION ALL SELECT 3, 'n') AS s ON t.id = s.id WHEN MATCHED THEN UPDATE SET data = s.data WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.data);

query II
SELECT id, data FROM my_datalake.default.merge_row_id_upgraded ORDER BY id;
----
1	a
2	m
3	n

query I
SELECT count(*) = count(DISTINCT _row_id) FROM my_datalake.default.merge_row_id_upgraded;
----
true

statement ok
DROP TABLE my_datalake.default.merge_row_id_upgraded;
