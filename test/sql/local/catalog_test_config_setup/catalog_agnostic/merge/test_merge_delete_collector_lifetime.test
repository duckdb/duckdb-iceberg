# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/merge/test_merge_delete_collector_lifetime.test
# description: Empty and failed MERGE actions do not leak collected deletes into subsequent executions.
# group: [merge]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

require-env SNAPSHOT_HISTORY_SUPPORT

include test/sql/init_requires

foreach version 2 3

statement ok
DROP TABLE IF EXISTS my_datalake.default.merge_delete_collector;

statement ok
CREATE TABLE my_datalake.default.merge_delete_collector (id INTEGER, v VARCHAR)
WITH ('format-version' = '{version}');

statement ok
INSERT INTO my_datalake.default.merge_delete_collector VALUES (1, 'a'), (2, 'b'), (3, 'c');

statement ok
BEGIN;

# Empty actions complete without writing files or a snapshot.
query I
MERGE INTO my_datalake.default.merge_delete_collector t
USING (VALUES (99, 'unused')) s(id, v) ON t.id = s.id
WHEN MATCHED THEN UPDATE SET v = s.v;
----
0

query I
MERGE INTO my_datalake.default.merge_delete_collector t
USING (VALUES (1, 'A'), (4, 'd')) s(id, v) ON t.id = s.id
WHEN MATCHED THEN UPDATE SET v = s.v
WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.v);
----
2

query I
MERGE INTO my_datalake.default.merge_delete_collector t
USING (VALUES (99)) s(id) ON t.id = s.id
WHEN MATCHED THEN DELETE;
----
0

# The next execution must incorporate earlier transaction-local deletes from the same data file.
query I
MERGE INTO my_datalake.default.merge_delete_collector t
USING (VALUES (2, 'unused'), (5, 'e')) s(id, v) ON t.id = s.id
WHEN MATCHED THEN DELETE
WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.v);
----
2

query I
MERGE INTO my_datalake.default.merge_delete_collector t
USING (VALUES (1), (3), (4), (5)) s(id) ON t.id = s.id
WHEN NOT MATCHED BY SOURCE THEN DELETE;
----
0

query IT
SELECT * FROM my_datalake.default.merge_delete_collector ORDER BY id;
----
1	A
3	c
4	d
5	e

statement ok
COMMIT;

query IT
SELECT sequence_number, operation FROM iceberg_snapshots('my_datalake.default.merge_delete_collector')
ORDER BY sequence_number;
----
1	append
2	overwrite
3	overwrite

query IT
SELECT * FROM my_datalake.default.merge_delete_collector ORDER BY id;
----
1	A
3	c
4	d
5	e

statement ok
BEGIN;

statement error
MERGE INTO my_datalake.default.merge_delete_collector t
USING (VALUES (1, 'discarded'), (3, 'error')) s(id, v) ON t.id = s.id
WHEN MATCHED AND s.id = 1 THEN UPDATE SET v = s.v
WHEN MATCHED THEN ERROR;
----
Merge error condition

statement ok
ROLLBACK;

query I
MERGE INTO my_datalake.default.merge_delete_collector t
USING (VALUES (3, 'C')) s(id, v) ON t.id = s.id
WHEN MATCHED THEN UPDATE SET v = s.v;
----
1

query IT
SELECT sequence_number, operation FROM iceberg_snapshots('my_datalake.default.merge_delete_collector')
ORDER BY sequence_number;
----
1	append
2	overwrite
3	overwrite
4	overwrite

query IT
SELECT * FROM my_datalake.default.merge_delete_collector ORDER BY id;
----
1	A
3	C
4	d
5	e

statement ok
DROP TABLE my_datalake.default.merge_delete_collector;

endloop
