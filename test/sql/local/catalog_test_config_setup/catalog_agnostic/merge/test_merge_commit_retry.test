# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/merge/test_merge_commit_retry.test
# description: A MERGE INTO with an UPDATE action retries its commit when a concurrent APPEND landed first; it aborts when a concurrent commit removed/rewrote data it targets
# group: [merge]

require-env CATALOG_TEST_CONFIG_SETUP

require-env METADATA_FILE_READ_SUPPORT

require-env METADATA_LOG_SUPPORT

include test/sql/init_requires

# Do not ignore 'HTTP' / conflict error messages!
# ----------------------------------------------------------------------------
# Concurrent APPEND under 'snapshot' isolation: the merge's targeted data is
# untouched, so on the commit conflict it refreshes and re-applies against the
# new tip and succeeds.
# ----------------------------------------------------------------------------

statement ok
DROP TABLE IF EXISTS my_datalake.default.merge_retry_append;

statement ok
CREATE TABLE my_datalake.default.merge_retry_append (id INTEGER, name VARCHAR) WITH ('write.merge.isolation-level' = 'snapshot');

statement ok
INSERT INTO my_datalake.default.merge_retry_append VALUES (1, 'a'), (2, 'b');

statement ok con1
begin

query I con1
MERGE INTO my_datalake.default.merge_retry_append AS target
USING (VALUES (1, 'z')) AS source(id, name)
ON target.id = source.id
WHEN MATCHED THEN UPDATE SET name = source.name;
----
1

statement ok con2
begin

statement ok con2
INSERT INTO my_datalake.default.merge_retry_append VALUES (3, 'c');

statement ok con2
commit

# con1 commits after con2 — the merge retries against the refreshed tip and lands.
statement ok con1
commit

# id=1 updated, con2's append preserved.
query II
SELECT * FROM my_datalake.default.merge_retry_append ORDER BY id;
----
1	z
2	b
3	c

statement ok
DROP TABLE my_datalake.default.merge_retry_append;

# ----------------------------------------------------------------------------
# Concurrent DELETE on the same file: re-applying is unsafe even under
# 'snapshot' isolation, so the losing merge aborts with a clear conflict.
# ----------------------------------------------------------------------------

statement ok
DROP TABLE IF EXISTS my_datalake.default.merge_retry_conflict;

statement ok
CREATE TABLE my_datalake.default.merge_retry_conflict (id INTEGER, name VARCHAR) WITH ('write.merge.isolation-level' = 'snapshot');

statement ok
INSERT INTO my_datalake.default.merge_retry_conflict VALUES (1, 'a'), (2, 'b'), (3, 'c');

statement ok con3
begin

query I con3
MERGE INTO my_datalake.default.merge_retry_conflict AS target
USING (VALUES (1, 'z')) AS source(id, name)
ON target.id = source.id
WHEN MATCHED THEN UPDATE SET name = source.name;
----
1

statement ok con4
begin

statement ok con4
DELETE FROM my_datalake.default.merge_retry_conflict WHERE id = 2;

statement ok con4
commit

statement error con3
commit
----
MERGE on "merge_retry_conflict" conflicts with a concurrent commit

# con4's delete applied; con3's merge did not.
query II
SELECT * FROM my_datalake.default.merge_retry_conflict ORDER BY id;
----
1	a
3	c

statement ok
DROP TABLE my_datalake.default.merge_retry_conflict;

# ----------------------------------------------------------------------------
# MERGE reads 'write.merge.isolation-level', not 'write.update.isolation-level':
# with only the update property set, the merge keeps the default
# ('serializable') and aborts over a concurrent APPEND.
# ----------------------------------------------------------------------------

statement ok
DROP TABLE IF EXISTS my_datalake.default.merge_retry_update_prop;

statement ok
CREATE TABLE my_datalake.default.merge_retry_update_prop (id INTEGER, name VARCHAR) WITH ('write.update.isolation-level' = 'snapshot');

statement ok
INSERT INTO my_datalake.default.merge_retry_update_prop VALUES (1, 'a'), (2, 'b');

statement ok con5
begin

query I con5
MERGE INTO my_datalake.default.merge_retry_update_prop AS target
USING (VALUES (1, 'z')) AS source(id, name)
ON target.id = source.id
WHEN MATCHED THEN UPDATE SET name = source.name;
----
1

statement ok con6
begin

statement ok con6
INSERT INTO my_datalake.default.merge_retry_update_prop VALUES (3, 'c');

statement ok con6
commit

statement error con5
commit
----
<REGEX>:.*MERGE on .*Set 'write.merge.isolation-level'='snapshot'.*

query II
SELECT * FROM my_datalake.default.merge_retry_update_prop ORDER BY id;
----
1	a
2	b
3	c

statement ok
DROP TABLE my_datalake.default.merge_retry_update_prop;

# ----------------------------------------------------------------------------
# A MERGE with a DELETE action also reads 'write.merge.isolation-level': with it
# set to 'snapshot', the merge retries over a concurrent APPEND and succeeds.
# ----------------------------------------------------------------------------

statement ok
DROP TABLE IF EXISTS my_datalake.default.merge_delete_retry_append;

statement ok
CREATE TABLE my_datalake.default.merge_delete_retry_append (id INTEGER, name VARCHAR) WITH ('write.merge.isolation-level' = 'snapshot');

statement ok
INSERT INTO my_datalake.default.merge_delete_retry_append VALUES (1, 'a'), (2, 'b');

statement ok con7
begin

query I con7
MERGE INTO my_datalake.default.merge_delete_retry_append AS target
USING (VALUES (1)) AS source(id)
ON target.id = source.id
WHEN MATCHED THEN DELETE;
----
1

statement ok con8
begin

statement ok con8
INSERT INTO my_datalake.default.merge_delete_retry_append VALUES (3, 'c');

statement ok con8
commit

statement ok con7
commit

query II
SELECT * FROM my_datalake.default.merge_delete_retry_append ORDER BY id;
----
2	b
3	c

statement ok
DROP TABLE my_datalake.default.merge_delete_retry_append;

# ----------------------------------------------------------------------------
# With only 'write.delete.isolation-level' set, the MERGE DELETE keeps the merge
# default ('serializable') and aborts over a concurrent APPEND.
# ----------------------------------------------------------------------------

statement ok
DROP TABLE IF EXISTS my_datalake.default.merge_delete_retry_delete_prop;

statement ok
CREATE TABLE my_datalake.default.merge_delete_retry_delete_prop (id INTEGER, name VARCHAR) WITH ('write.delete.isolation-level' = 'snapshot');

statement ok
INSERT INTO my_datalake.default.merge_delete_retry_delete_prop VALUES (1, 'a'), (2, 'b');

statement ok con9
begin

query I con9
MERGE INTO my_datalake.default.merge_delete_retry_delete_prop AS target
USING (VALUES (1)) AS source(id)
ON target.id = source.id
WHEN MATCHED THEN DELETE;
----
1

statement ok con10
begin

statement ok con10
INSERT INTO my_datalake.default.merge_delete_retry_delete_prop VALUES (3, 'c');

statement ok con10
commit

statement error con9
commit
----
<REGEX>:.*MERGE on .*Set 'write.merge.isolation-level'='snapshot'.*

query II
SELECT * FROM my_datalake.default.merge_delete_retry_delete_prop ORDER BY id;
----
1	a
2	b
3	c

statement ok
DROP TABLE my_datalake.default.merge_delete_retry_delete_prop;

# ----------------------------------------------------------------------------
# An insert-only MERGE commits an APPEND snapshot, but it still reads the table.
# Under the default ('serializable') it aborts when a concurrent commit inserts
# the key it did not match.
# ----------------------------------------------------------------------------

statement ok
DROP TABLE IF EXISTS my_datalake.default.merge_insert_race;

statement ok
CREATE TABLE my_datalake.default.merge_insert_race (id INTEGER, name VARCHAR);

statement ok
INSERT INTO my_datalake.default.merge_insert_race VALUES (1, 'a');

statement ok con11
begin

query I con11
MERGE INTO my_datalake.default.merge_insert_race AS target
USING (VALUES (42, 'a')) AS source(id, name)
ON target.id = source.id
WHEN NOT MATCHED THEN INSERT VALUES (source.id, source.name);
----
1

query I con12
MERGE INTO my_datalake.default.merge_insert_race AS target
USING (VALUES (42, 'a')) AS source(id, name)
ON target.id = source.id
WHEN NOT MATCHED THEN INSERT VALUES (source.id, source.name);
----
1

statement error con11
commit
----
<REGEX>:.*MERGE on "merge_insert_race" conflicts with a concurrent commit.*

query I
SELECT count(*) FROM my_datalake.default.merge_insert_race WHERE id = 42;
----
1

statement ok
DROP TABLE my_datalake.default.merge_insert_race;

# ----------------------------------------------------------------------------
# With 'write.merge.isolation-level'='snapshot', the same insert-only MERGE
# retries over the concurrent APPEND and both rows land.
# ----------------------------------------------------------------------------

statement ok
DROP TABLE IF EXISTS my_datalake.default.merge_insert_race_snapshot;

statement ok
CREATE TABLE my_datalake.default.merge_insert_race_snapshot (id INTEGER, name VARCHAR) WITH ('write.merge.isolation-level' = 'snapshot');

statement ok
INSERT INTO my_datalake.default.merge_insert_race_snapshot VALUES (1, 'a');

statement ok con13
begin

query I con13
MERGE INTO my_datalake.default.merge_insert_race_snapshot AS target
USING (VALUES (42, 'a')) AS source(id, name)
ON target.id = source.id
WHEN NOT MATCHED THEN INSERT VALUES (source.id, source.name);
----
1

query I con14
MERGE INTO my_datalake.default.merge_insert_race_snapshot AS target
USING (VALUES (42, 'a')) AS source(id, name)
ON target.id = source.id
WHEN NOT MATCHED THEN INSERT VALUES (source.id, source.name);
----
1

statement ok con13
commit

query I
SELECT count(*) FROM my_datalake.default.merge_insert_race_snapshot WHERE id = 42;
----
2

statement ok
DROP TABLE my_datalake.default.merge_insert_race_snapshot;

# ----------------------------------------------------------------------------
# The same race on an empty table: the MERGE scanned no snapshot, and the
# concurrent commit creates the first one. Under the default ('serializable')
# the MERGE aborts.
# ----------------------------------------------------------------------------

statement ok
DROP TABLE IF EXISTS my_datalake.default.merge_insert_race_empty;

statement ok
CREATE TABLE my_datalake.default.merge_insert_race_empty (id INTEGER, name VARCHAR);

statement ok con15
begin

query I con15
MERGE INTO my_datalake.default.merge_insert_race_empty AS target
USING (VALUES (42, 'a')) AS source(id, name)
ON target.id = source.id
WHEN NOT MATCHED THEN INSERT VALUES (source.id, source.name);
----
1

query I con16
MERGE INTO my_datalake.default.merge_insert_race_empty AS target
USING (VALUES (42, 'a')) AS source(id, name)
ON target.id = source.id
WHEN NOT MATCHED THEN INSERT VALUES (source.id, source.name);
----
1

statement error con15
commit
----
<REGEX>:.*MERGE on "merge_insert_race_empty" conflicts with a concurrent commit.*

query I
SELECT count(*) FROM my_datalake.default.merge_insert_race_empty WHERE id = 42;
----
1

statement ok
DROP TABLE my_datalake.default.merge_insert_race_empty;

# ----------------------------------------------------------------------------
# With 'write.merge.isolation-level'='snapshot', the empty-table race retries
# over the concurrent APPEND and both rows land.
# ----------------------------------------------------------------------------

statement ok
DROP TABLE IF EXISTS my_datalake.default.merge_insert_race_empty_snapshot;

statement ok
CREATE TABLE my_datalake.default.merge_insert_race_empty_snapshot (id INTEGER, name VARCHAR) WITH ('write.merge.isolation-level' = 'snapshot');

statement ok con17
begin

query I con17
MERGE INTO my_datalake.default.merge_insert_race_empty_snapshot AS target
USING (VALUES (42, 'a')) AS source(id, name)
ON target.id = source.id
WHEN NOT MATCHED THEN INSERT VALUES (source.id, source.name);
----
1

query I con18
MERGE INTO my_datalake.default.merge_insert_race_empty_snapshot AS target
USING (VALUES (42, 'a')) AS source(id, name)
ON target.id = source.id
WHEN NOT MATCHED THEN INSERT VALUES (source.id, source.name);
----
1

statement ok con17
commit

query I
SELECT count(*) FROM my_datalake.default.merge_insert_race_empty_snapshot WHERE id = 42;
----
2

statement ok
DROP TABLE my_datalake.default.merge_insert_race_empty_snapshot;
