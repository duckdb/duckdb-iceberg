# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/iceberg_types/variant/test_write_variant_container_stats.test
# description: VARIANT container counts and bounds for fully shredded fields
# group: [variant]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

require-env VARIANT_SUPPORT

include test/sql/init_requires

statement ok
SET threads=1;

statement ok
DROP TABLE IF EXISTS my_datalake.default.variant_container_stats;

# Wrapper groups named value, typed_value, or metadata are ordinary object fields.
# The empty object cannot be shredded and remains in the root's value blob.
statement ok
CREATE TABLE my_datalake.default.variant_container_stats WITH ('format-version'='3') AS
SELECT {'value': 10, 'typed_value': 20, 'metadata': 30, 'extra': empty_struct}::VARIANT v
FROM test_all_types() WHERE int = 2147483647
UNION ALL
SELECT NULL::VARIANT;

query III
SELECT column_name, value_count, null_value_count
FROM iceberg_column_stats(my_datalake.default.variant_container_stats);
----
v	2	1

# The excess field does not invalidate bounds for the three shredded fields.
query II
SELECT lower_bound, upper_bound
FROM iceberg_column_stats(my_datalake.default.variant_container_stats);
----
{'$[\'metadata\']': 30, '$[\'typed_value\']': 20, '$[\'value\']': 10}	{'$[\'metadata\']': 30, '$[\'typed_value\']': 20, '$[\'value\']': 10}

query I
SELECT count(*) FROM my_datalake.default.variant_container_stats WHERE v IS NULL;
----
1

statement ok
DROP TABLE my_datalake.default.variant_container_stats;

# Partial paths can be deeper than an unrelated field, or have several siblings.
statement ok
CREATE TABLE my_datalake.default.variant_container_stats WITH ('format-version'='3') AS
SELECT v FROM (VALUES
    ({'typed_value': 1, 'b': 2, 'deep': {'mixed': 3}, 'stable': 10}::VARIANT),
    ({'typed_value': 4, 'b': 5, 'deep': {'mixed': 6}, 'stable': 20}::VARIANT),
    ({'typed_value': 'fallback', 'b': 'fallback', 'deep': {'mixed': 'fallback'}, 'stable': 30}::VARIANT)
) t(v);

query II
SELECT lower_bound, upper_bound
FROM iceberg_column_stats(my_datalake.default.variant_container_stats);
----
{'$[\'stable\']': 10}	{'$[\'stable\']': 30}

statement ok
DROP TABLE my_datalake.default.variant_container_stats;

# A fallback at the root invalidates all descendant bounds.
statement ok
CREATE TABLE my_datalake.default.variant_container_stats WITH ('format-version'='3') AS
SELECT v FROM (VALUES
    ({'a': 1}::VARIANT),
    ({'a': 2}::VARIANT),
    ('fallback'::VARIANT),
    (NULL::VARIANT)
) t(v);

query IIII
SELECT value_count, null_value_count, lower_bound, upper_bound
FROM iceberg_column_stats(my_datalake.default.variant_container_stats);
----
4	1	NULL	NULL

statement ok
DROP TABLE my_datalake.default.variant_container_stats;

# Counts also apply to primitive and list variants, including empty and all-null lists.
foreach TYPE primitive list

statement ok
CREATE TABLE my_datalake.default.variant_container_stats (v VARIANT)
WITH ('format-version'='3', 'write.metadata.metrics.default'='counts');

statement ok
INSERT INTO my_datalake.default.variant_container_stats
SELECT CASE WHEN '{TYPE}' = 'primitive' THEN 42::VARIANT ELSE []::INTEGER[]::VARIANT END
UNION ALL SELECT CASE WHEN '{TYPE}' = 'primitive' THEN 99::VARIANT ELSE [NULL]::INTEGER[]::VARIANT END
UNION ALL SELECT NULL::VARIANT;

query IIII
SELECT value_count, null_value_count, lower_bound, upper_bound
FROM iceberg_column_stats(my_datalake.default.variant_container_stats);
----
3	1	NULL	NULL

statement ok
DROP TABLE my_datalake.default.variant_container_stats;

endloop

statement ok
CREATE TABLE my_datalake.default.variant_container_stats (v VARIANT NOT NULL)
WITH ('format-version'='3');

statement ok
INSERT INTO my_datalake.default.variant_container_stats VALUES ([]::INTEGER[]::VARIANT);

statement error
INSERT INTO my_datalake.default.variant_container_stats VALUES (NULL);
----
NOT NULL constraint failed

query I
SELECT count(*) FROM my_datalake.default.variant_container_stats;
----
1

statement ok
DROP TABLE my_datalake.default.variant_container_stats;
