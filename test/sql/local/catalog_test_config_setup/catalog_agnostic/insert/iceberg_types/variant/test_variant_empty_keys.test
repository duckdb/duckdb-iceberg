# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/iceberg_types/variant/test_variant_empty_keys.test
# description: VARIANT objects with an empty key keep the key through an Iceberg write and read
# group: [variant]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

require-env VARIANT_SUPPORT

include test/sql/init_requires

require json

statement ok
DROP TABLE IF EXISTS my_datalake.default.variant_empty_keys;

statement ok
CREATE TABLE my_datalake.default.variant_empty_keys (id INTEGER, v VARIANT)
WITH ('format-version'='3', 'write.parquet.shred-variants'='true');

# source: inputs and expected values of duckdb/test/parquet/variant/variant_shredding_empty_keys.test
statement ok
INSERT INTO my_datalake.default.variant_empty_keys VALUES
	(1, '{"": 1, "x": 2}'::JSON::VARIANT),
	(2, '{"x": {"": "t"}}'::JSON::VARIANT),
	(3, '{"": {"y": true}, "x": 3}'::JSON::VARIANT),
	(4, '{"x": 4}'::JSON::VARIANT);

query IT
SELECT id, v::JSON FROM my_datalake.default.variant_empty_keys ORDER BY id;
----
1	{"":1,"x":2}
2	{"x":{"":"t"}}
3	{"":{"y":true},"x":3}
4	{"x":4}

statement ok
BEGIN;

statement ok
SET VARIABLE variant_empty_keys_files = (
	SELECT list(file_path) FROM iceberg_metadata('my_datalake.default.variant_empty_keys')
);

# the other keys are still shredded
query I
SELECT count(*) > 0 FROM parquet_schema(getvariable('variant_empty_keys_files')) WHERE name = 'x';
----
true

# the empty key is not a shredded field, under its own name or under a positional one
query I
SELECT count(*) FROM parquet_schema(getvariable('variant_empty_keys_files')) WHERE name = '' OR name LIKE 'element%';
----
0

statement ok
COMMIT;

# an object with only an empty key, and an empty key in a nested object; each INSERT writes its own data file
statement ok
INSERT INTO my_datalake.default.variant_empty_keys VALUES (5, '{"": "t"}'::JSON::VARIANT);

statement ok
INSERT INTO my_datalake.default.variant_empty_keys
SELECT 6 + i, '{"x": {"": 1, "y": 2}}'::JSON::VARIANT FROM range(3) t(i);

query IT
SELECT id, v::JSON FROM my_datalake.default.variant_empty_keys WHERE id >= 5 ORDER BY id;
----
5	{"":"t"}
6	{"x":{"":1,"y":2}}
7	{"x":{"":1,"y":2}}
8	{"x":{"":1,"y":2}}

# source: inputs and expected values of duckdb/test/sql/storage/types/variant/variant_shredding_empty_keys.test
statement ok
INSERT INTO my_datalake.default.variant_empty_keys VALUES (9, '{"": 1, "x": {"y": "t"}}'::JSON::VARIANT);

statement ok
INSERT INTO my_datalake.default.variant_empty_keys VALUES (10, '{"x": "hello", "": "world"}'::JSON::VARIANT);

query IT
SELECT id, v FROM my_datalake.default.variant_empty_keys WHERE id >= 9 ORDER BY id;
----
9	{'': 1, 'x': {'y': t}}
10	{'': world, 'x': hello}

statement ok
DROP TABLE my_datalake.default.variant_empty_keys;
