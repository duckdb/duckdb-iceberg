# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/test_written_files_lifecycle.test
# description: Written-file storage is opt-in, connection-local, and transactional; logging is independent
# group: [insert]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

statement ok
DROP TABLE IF EXISTS my_datalake.default.written_files_lifecycle;

statement ok
CREATE TABLE my_datalake.default.written_files_lifecycle (id INTEGER, p INTEGER)
PARTITIONED BY (p) WITH ('format-version' = '2');

statement ok
CALL enable_logging('IcebergDataFileWritten', storage := 'memory');

statement ok
SET iceberg_store_written_files = true;

# No files means neither a tracking table nor log entries.
query I
INSERT INTO my_datalake.default.written_files_lifecycle SELECT 1, 0 WHERE false;
----
0

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'temp' AND table_name = 'iceberg_written_files';
----
0

query I
SELECT count(*) FROM duckdb_logs_parsed('IcebergDataFileWritten');
----
0

# The first write creates the tracking table in the same transaction.
statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.written_files_lifecycle VALUES (1, 0);

query I
SELECT sum(record_count) FROM temp.main.iceberg_written_files;
----
1

statement ok
ROLLBACK;

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'temp' AND table_name = 'iceberg_written_files';
----
0

query I
SELECT count(*) FROM my_datalake.default.written_files_lifecycle;
----
0

# Logs describe staged files even when their transaction rolls back.
query I
SELECT sum(record_count) FROM duckdb_logs_parsed('IcebergDataFileWritten');
----
1

statement ok
CALL truncate_duckdb_logs();

statement ok
INSERT INTO my_datalake.default.written_files_lifecycle VALUES (2, 0), (3, 1);

# The tracking query ID is the writing statement's logging query ID.
query I
SELECT count(*) FROM (
    (SELECT * FROM temp.main.iceberg_written_files
     EXCEPT ALL
     SELECT query_id, "table", file_path, record_count, file_size_in_bytes, operation, written_at
     FROM duckdb_logs_parsed('IcebergDataFileWritten'))
    UNION ALL
    (SELECT query_id, "table", file_path, record_count, file_size_in_bytes, operation, written_at
     FROM duckdb_logs_parsed('IcebergDataFileWritten')
     EXCEPT ALL SELECT * FROM temp.main.iceberg_written_files)
);
----
0

# All partitions produced by this write share its operation and staging timestamp.
query TII
SELECT operation, count(DISTINCT written_at), sum(record_count)
FROM temp.main.iceberg_written_files GROUP BY operation;
----
INSERT	1	2

# Disabling, clearing, or resetting storage leaves existing rows alone and still logs writes.
statement ok
SET iceberg_store_written_files = false;

statement ok
INSERT INTO my_datalake.default.written_files_lifecycle VALUES (4, 0);

statement ok
SET iceberg_store_written_files = NULL;

statement ok
INSERT INTO my_datalake.default.written_files_lifecycle VALUES (5, 0);

statement ok
RESET iceberg_store_written_files;

statement ok
INSERT INTO my_datalake.default.written_files_lifecycle VALUES (6, 0);

query II
SELECT count(DISTINCT query_id), sum(record_count) FROM temp.main.iceberg_written_files;
----
1	2

query I
SELECT sum(record_count) FROM duckdb_logs_parsed('IcebergDataFileWritten');
----
5

query TI
SELECT operation, bool_and(written_at IS NOT NULL)
FROM duckdb_logs_parsed('IcebergDataFileWritten') GROUP BY operation;
----
INSERT	true

# A second connection can independently enable storage and write to the same Iceberg table.
query I con2
SELECT current_setting('iceberg_store_written_files');
----
false

statement ok con2
SET iceberg_store_written_files = true;

statement ok con2
INSERT INTO my_datalake.default.written_files_lifecycle VALUES (7, 2);

query I con2
SELECT sum(record_count) FROM temp.main.iceberg_written_files;
----
1

query I
SELECT sum(record_count) FROM temp.main.iceberg_written_files;
----
2

# Dropping the tracking table allows the next enabled write to recreate it.
statement ok
DROP TABLE temp.main.iceberg_written_files;

statement ok
SET iceberg_store_written_files = true;

statement ok
INSERT INTO my_datalake.default.written_files_lifecycle VALUES (8, 0);

query II
SELECT count(DISTINCT query_id), sum(record_count) FROM temp.main.iceberg_written_files;
----
1	1

query II
SELECT count(*), sum(id) FROM my_datalake.default.written_files_lifecycle;
----
7	35

statement ok
DROP TABLE my_datalake.default.written_files_lifecycle;
