----
<REGEX>:.*PARTITION value '5x' cannot be used for column "i" of type INTEGER: Could not convert string '5x' to INT32.*

statement error
INSERT OVERWRITE my_datalake.default.overwrite_values PARTITION (i = 3000000000, b, d, w, y, x) VALUES (99, 5, 1.50, 1.50, 1.50, 0.5);
----
<REGEX>:.*PARTITION value 3000000000 cannot be used for column "i" of type INTEGER: Type INT64 with value 3000000000 can't be cast because the value is out of range for the destination type INT32.*

statement error
INSERT OVERWRITE my_datalake.default.overwrite_values PARTITION (i = '3000000000', b, d, w, y, x) VALUES (99, 5, 1.50, 1.50, 1.50, 0.5);
----
<REGEX>:.*PARTITION value '3000000000' cannot be used for column "i" of type INTEGER: Could not convert string '3000000000' to INT32.*

