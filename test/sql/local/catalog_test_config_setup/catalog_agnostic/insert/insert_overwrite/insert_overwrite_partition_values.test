# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/insert_overwrite/insert_overwrite_partition_values.test
# description: A static PARTITION value has to be a value of its column: written as a number, a string or a parameter
# group: [insert_overwrite]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

statement ok
SET active_grammar_extensions = ['iceberg_insert_overwrite'];

statement ok
DROP TABLE IF EXISTS my_datalake.default.overwrite_values;

statement ok
CREATE TABLE my_datalake.default.overwrite_values (id INTEGER, i INTEGER, b BIGINT, d DECIMAL(10,2), w DECIMAL(38,2), y DECIMAL(36,2), x DOUBLE)
PARTITIONED BY (i, b, d, w, y, x);

statement ok
INSERT INTO my_datalake.default.overwrite_values VALUES (1, 5, 5, 1.50, 1.50, 1.50, 0.5);

# every statement below names the one partition of the table in another way: it is taken when the value is that
# value, and then replaces the row

# INTEGER
statement ok
INSERT OVERWRITE my_datalake.default.overwrite_values PARTITION (i = 5, b, d, w, y, x) VALUES (2, 5, 1.50, 1.50, 1.50, 0.5);

query I
SELECT id FROM my_datalake.default.overwrite_values;
----
2

statement ok
INSERT OVERWRITE my_datalake.default.overwrite_values PARTITION (i = '5', b, d, w, y, x) VALUES (3, 5, 1.50, 1.50, 1.50, 0.5);

query I
