# a parameter is checked like the value it is given
statement ok
PREPARE overwrite_values AS INSERT OVERWRITE my_datalake.default.overwrite_values PARTITION (i = $1, b, d = $2, w, y, x) VALUES ($3, 5, 1.50, 1.50, 0.5);

statement error
EXECUTE overwrite_values('5.5', 1.5, 99);
----
<REGEX>:.*PARTITION value '5.5' cannot be used for column "i" of type INTEGER: the value does not fit the type exactly.*

statement error
EXECUTE overwrite_values(5, '1.555', 99);
----
<REGEX>:.*PARTITION value '1.555' cannot be used for column "d" of type DECIMAL\(10,2\): the value does not fit the type exactly.*

statement error
EXECUTE overwrite_values(5.5, 1.5, 99);
----
<REGEX>:.*PARTITION value 5.5 cannot be used for column "i" of type INTEGER: the value does not fit the type exactly.*

statement ok
EXECUTE overwrite_values('05', '1.50', 25);

# nothing but the statements that were taken changed the table
query IIITTTT
SELECT id, i, b, d, w, y, x FROM my_datalake.default.overwrite_values;
----
25	5	5	1.50	1.50	1.50	0.5

statement ok
DEALLOCATE overwrite_values;

statement ok
DROP TABLE my_datalake.default.overwrite_values;
