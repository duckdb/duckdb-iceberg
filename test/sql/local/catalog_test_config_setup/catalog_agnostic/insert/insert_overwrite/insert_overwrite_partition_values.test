# refused: the cast to the column's type would round or truncate the value, or the text is no plain number
statement error
INSERT OVERWRITE my_datalake.default.overwrite_values PARTITION (i = 1.5, b, d, w, y, x) VALUES (99, 5, 1.50, 1.50, 1.50, 0.5);
----
<REGEX>:.*PARTITION value 1.5 cannot be used for column "i" of type INTEGER: the value does not fit the type exactly.*

statement error
INSERT OVERWRITE my_datalake.default.overwrite_values PARTITION (i = '1.5', b, d, w, y, x) VALUES (99, 5, 1.50, 1.50, 1.50, 0.5);
----
<REGEX>:.*PARTITION value '1.5' cannot be used for column "i" of type INTEGER: the value does not fit the type exactly.*

statement error
INSERT OVERWRITE my_datalake.default.overwrite_values PARTITION (i = '5.5', b, d, w, y, x) VALUES (99, 5, 1.50, 1.50, 1.50, 0.5);
----
<REGEX>:.*PARTITION value '5.5' cannot be used for column "i" of type INTEGER: the value does not fit the type exactly.*

statement error
INSERT OVERWRITE my_datalake.default.overwrite_values PARTITION (i = 5.5::DOUBLE, b, d, w, y, x) VALUES (99, 5, 1.50, 1.50, 1.50, 0.5);
----
<REGEX>:.*PARTITION value 5.5 cannot be used for column "i" of type INTEGER: the value does not fit the type exactly.*

statement error
INSERT OVERWRITE my_datalake.default.overwrite_values PARTITION (i = '1e1', b, d, w, y, x) VALUES (99, 5, 1.50, 1.50, 1.50, 0.5);
----
<REGEX>:.*PARTITION value '1e1' cannot be used for column "i" of type INTEGER: a number for this column is written as digits with an optional fraction.*

statement error
INSERT OVERWRITE my_datalake.default.overwrite_values PARTITION (i = '0x5', b, d, w, y, x) VALUES (99, 5, 1.50, 1.50, 1.50, 0.5);
----
<REGEX>:.*PARTITION value '0x5' cannot be used for column "i" of type INTEGER: a number for this column is written as digits with an optional fraction.*

statement error
