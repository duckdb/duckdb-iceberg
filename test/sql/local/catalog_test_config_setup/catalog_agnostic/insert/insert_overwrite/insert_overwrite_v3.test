# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/insert_overwrite/insert_overwrite_v3.test
# description: INSERT OVERWRITE on a format-version 3 table: rows, and the deletion vectors of replaced data files
# group: [insert_overwrite]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

require-env SNAPSHOT_HISTORY_SUPPORT

include test/sql/init_requires

statement ok
SET active_grammar_extensions = ['iceberg_insert_overwrite'];

# every row of an unpartitioned table
statement ok
DROP TABLE IF EXISTS my_datalake.default.overwrite_v3_plain;

statement ok
CREATE TABLE my_datalake.default.overwrite_v3_plain (id INTEGER, v VARCHAR) WITH ('format-version' = '3');

statement ok
INSERT INTO my_datalake.default.overwrite_v3_plain VALUES (1, 'a'), (2, 'b');

query I
INSERT OVERWRITE my_datalake.default.overwrite_v3_plain VALUES (10, 'x'), (11, 'y'), (12, 'z');
----
3

query IT
SELECT id, v FROM my_datalake.default.overwrite_v3_plain ORDER BY id;
----
10	x
11	y
12	z

query TIIII
SELECT operation, summary['added-records']::BIGINT, summary['deleted-records']::BIGINT,
       summary['total-data-files']::BIGINT, summary['total-records']::BIGINT
FROM iceberg_snapshots(my_datalake.default.overwrite_v3_plain) ORDER BY sequence_number DESC LIMIT 1;
----
overwrite	3	2	1	3

statement ok
DROP TABLE my_datalake.default.overwrite_v3_plain;

# a partitioned table with deletion vectors
statement ok
DROP TABLE IF EXISTS my_datalake.default.overwrite_v3;

statement ok
CREATE TABLE my_datalake.default.overwrite_v3 (id INTEGER, p INTEGER, v VARCHAR) PARTITIONED BY (p) WITH ('format-version' = '3');

statement ok
INSERT INTO my_datalake.default.overwrite_v3 VALUES (1, 1, 'a'), (2, 1, 'b'), (3, 2, 'c'), (4, 2, 'd'), (5, 3, 'e'), (6, 3, 'f');

# one deleted row in each data file
statement ok
DELETE FROM my_datalake.default.overwrite_v3 WHERE id = 1;

statement ok
DELETE FROM my_datalake.default.overwrite_v3 WHERE id = 3;

statement ok
DELETE FROM my_datalake.default.overwrite_v3 WHERE id = 5;

query IIT
SELECT id, p, v FROM my_datalake.default.overwrite_v3 ORDER BY id;
----
2	1	b
4	2	d
6	3	f

query TIIIII
SELECT operation, coalesce(summary['deleted-data-files']::BIGINT, 0),
       coalesce(summary['removed-delete-files']::BIGINT, 0), coalesce(summary['removed-dvs']::BIGINT, 0),
       summary['total-data-files']::BIGINT, summary['total-delete-files']::BIGINT
FROM iceberg_snapshots(my_datalake.default.overwrite_v3) ORDER BY sequence_number DESC LIMIT 1;
----
delete	0	0	0	3	3

# a static value: the data file of p = 1 is removed, and its deletes with it
statement ok
INSERT OVERWRITE my_datalake.default.overwrite_v3 PARTITION (p = 1) VALUES (10, 'x');

query IIT
SELECT id, p, v FROM my_datalake.default.overwrite_v3 ORDER BY id;
----
4	2	d
6	3	f
10	1	x

query TIIIII
SELECT operation, coalesce(summary['deleted-data-files']::BIGINT, 0),
       coalesce(summary['removed-delete-files']::BIGINT, 0), coalesce(summary['removed-dvs']::BIGINT, 0),
       summary['total-data-files']::BIGINT, summary['total-delete-files']::BIGINT
FROM iceberg_snapshots(my_datalake.default.overwrite_v3) ORDER BY sequence_number DESC LIMIT 1;
----
overwrite	1	1	1	3	2

# dynamic mode: the same for the partition that receives rows
statement ok
SET iceberg_partition_overwrite_mode = 'dynamic';

statement ok
INSERT OVERWRITE my_datalake.default.overwrite_v3 VALUES (11, 2, 'y');

query IIT
SELECT id, p, v FROM my_datalake.default.overwrite_v3 ORDER BY id;
----
6	3	f
10	1	x
11	2	y

query TIIIII
SELECT operation, coalesce(summary['deleted-data-files']::BIGINT, 0),
       coalesce(summary['removed-delete-files']::BIGINT, 0), coalesce(summary['removed-dvs']::BIGINT, 0),
       summary['total-data-files']::BIGINT, summary['total-delete-files']::BIGINT
FROM iceberg_snapshots(my_datalake.default.overwrite_v3) ORDER BY sequence_number DESC LIMIT 1;
----
overwrite	1	1	1	3	1

# no static value: every data file and every delete is removed
statement ok
SET iceberg_partition_overwrite_mode = 'static';

statement ok
INSERT OVERWRITE my_datalake.default.overwrite_v3 VALUES (12, 4, 'z'), (13, 4, 'w');

query IIT
SELECT id, p, v FROM my_datalake.default.overwrite_v3 ORDER BY id;
----
12	4	z
13	4	w

query TIIIII
SELECT operation, coalesce(summary['deleted-data-files']::BIGINT, 0),
       coalesce(summary['removed-delete-files']::BIGINT, 0), coalesce(summary['removed-dvs']::BIGINT, 0),
       summary['total-data-files']::BIGINT, summary['total-delete-files']::BIGINT
FROM iceberg_snapshots(my_datalake.default.overwrite_v3) ORDER BY sequence_number DESC LIMIT 1;
----
overwrite	3	1	1	1	0

# the new rows are deleted and updated as any other
statement ok
DELETE FROM my_datalake.default.overwrite_v3 WHERE id = 12;

statement ok
UPDATE my_datalake.default.overwrite_v3 SET v = 'updated' WHERE id = 13;

statement ok
INSERT INTO my_datalake.default.overwrite_v3 VALUES (14, 5, 'appended');

query IIT
SELECT id, p, v FROM my_datalake.default.overwrite_v3 ORDER BY id;
----
13	4	updated
14	5	appended

# a query without rows removes the data files of the partition and their deletes
query I
INSERT OVERWRITE my_datalake.default.overwrite_v3 PARTITION (p = 4) SELECT 1, 'none' WHERE false;
----
0

query IIT
SELECT id, p, v FROM my_datalake.default.overwrite_v3 ORDER BY id;
----
14	5	appended

statement ok
DROP TABLE my_datalake.default.overwrite_v3;
