# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/partitions/temporal/test_timestamp_ns_boundary.test
# description: year/month/day/hour partitions on nanosecond timestamps round down, also in the last nanoseconds before a boundary
# group: [temporal]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

require-env TIMESTAMP_NS_SUPPORT

include test/sql/init_requires

require icu

statement ok
SET TimeZone='UTC';

foreach type TIMESTAMP_NS TIMESTAMPTZ_NS

foreach transform year month day hour

statement ok
DROP TABLE IF EXISTS my_datalake.default.ts_ns_boundary_{transform};

statement ok
CREATE TABLE my_datalake.default.ts_ns_boundary_{transform} (id INT, ts {type})
PARTITIONED BY ({transform}(ts))
WITH ('format-version' = 3);

# 1 ns before the epoch, 499 ns and 1 ns before the end of 2024
statement ok
INSERT INTO my_datalake.default.ts_ns_boundary_{transform} VALUES
	(1, '1969-12-31 23:59:59.999999999'::{type}),
	(2, '2024-12-31 23:59:59.999999501'::{type}),
	(3, '2024-12-31 23:59:59.999999999'::{type});

# each row is found by an equality filter, and by a range ending at the last nanosecond before the boundary
query I
SELECT id FROM my_datalake.default.ts_ns_boundary_{transform}
WHERE ts = '1969-12-31 23:59:59.999999999'::{type};
----
1

query I
SELECT id FROM my_datalake.default.ts_ns_boundary_{transform}
WHERE ts = '2024-12-31 23:59:59.999999501'::{type};
----
2

query I
SELECT id FROM my_datalake.default.ts_ns_boundary_{transform}
WHERE ts = '2024-12-31 23:59:59.999999999'::{type};
----
3

query I
SELECT id FROM my_datalake.default.ts_ns_boundary_{transform}
WHERE ts BETWEEN '2024-12-31 23:00:00'::{type} AND '2024-12-31 23:59:59.999999999'::{type}
ORDER BY id;
----
2
3

# transform
endloop

# the partition values round down, like the Iceberg spec
query II
SELECT partition.year_ts_2, record_count FROM iceberg_partitions('my_datalake.default.ts_ns_boundary_year') ORDER BY ALL;
----
-1	1
54	2

query II
SELECT partition.month_ts_2, record_count FROM iceberg_partitions('my_datalake.default.ts_ns_boundary_month') ORDER BY ALL;
----
-1	1
659	2

query II
SELECT partition.day_ts_2, record_count FROM iceberg_partitions('my_datalake.default.ts_ns_boundary_day') ORDER BY ALL;
----
1969-12-31	1
2024-12-31	2

query II
SELECT partition.hour_ts_2, record_count FROM iceberg_partitions('my_datalake.default.ts_ns_boundary_hour') ORDER BY ALL;
----
-1	1
482135	2

# UPDATE writes the new value to the right partition too
foreach transform year month day hour

statement ok
UPDATE my_datalake.default.ts_ns_boundary_{transform} SET ts = '2023-12-31 23:59:59.999999999'::{type} WHERE id = 1;

query I
SELECT id FROM my_datalake.default.ts_ns_boundary_{transform}
WHERE ts = '2023-12-31 23:59:59.999999999'::{type};
----
1

# transform
endloop

# type
endloop
