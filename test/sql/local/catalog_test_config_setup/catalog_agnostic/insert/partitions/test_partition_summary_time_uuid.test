# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/partitions/test_partition_summary_time_uuid.test
# description: TIME and UUID identity partitions get manifest-list summaries that hold for their values, so readers don't treat their manifests as all-null and skip them
# group: [partitions]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

# ---- TIME ----

statement ok
DROP TABLE IF EXISTS my_datalake.default.partition_summary_time;

statement ok
CREATE TABLE my_datalake.default.partition_summary_time (id INTEGER, t TIME);

statement ok
ALTER TABLE my_datalake.default.partition_summary_time SET PARTITIONED BY (t);

statement ok
INSERT INTO my_datalake.default.partition_summary_time VALUES
	(1, TIME '08:00:00'),
	(2, TIME '12:30:00'),
	(3, TIME '23:59:59.999999'),
	(4, NULL);

query IIII
SELECT lower_bound, upper_bound, contains_null, contains_nan
FROM iceberg_partition_stats('my_datalake.default.partition_summary_time');
----
08:00:00	23:59:59.999999	true	false

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.partition_summary_time WHERE t = TIME '12:30:00';
----
[2]

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.partition_summary_time WHERE t > TIME '09:00:00';
----
[2, 3]

query I
SELECT count(*) FROM my_datalake.default.partition_summary_time WHERE t < TIME '08:00:00';
----
0

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.partition_summary_time WHERE t IS NULL;
----
[4]

# TIME data files get column bounds too
query II
SELECT count(lower_bound), count(upper_bound)
FROM iceberg_column_stats('my_datalake.default.partition_summary_time') WHERE column_name = 't';
----
3	3

statement ok
DROP TABLE my_datalake.default.partition_summary_time;

# ---- UUID starting with 0-7 only ----

statement ok
DROP TABLE IF EXISTS my_datalake.default.partition_summary_uuid_low;

statement ok
CREATE TABLE my_datalake.default.partition_summary_uuid_low (id INTEGER, u UUID);

statement ok
ALTER TABLE my_datalake.default.partition_summary_uuid_low SET PARTITIONED BY (u);

statement ok
INSERT INTO my_datalake.default.partition_summary_uuid_low VALUES
	(1, '11111111-1111-4111-8111-111111111111'),
	(2, '7fffffff-ffff-4fff-bfff-ffffffffffff');

query III
SELECT lower_bound, upper_bound, contains_null
FROM iceberg_partition_stats('my_datalake.default.partition_summary_uuid_low');
----
11111111-1111-4111-8111-111111111111	7fffffff-ffff-4fff-bfff-ffffffffffff	false

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.partition_summary_uuid_low WHERE u = '7fffffff-ffff-4fff-bfff-ffffffffffff';
----
[2]

statement ok
DROP TABLE my_datalake.default.partition_summary_uuid_low;

# ---- UUID starting with 8-f only ----

statement ok
DROP TABLE IF EXISTS my_datalake.default.partition_summary_uuid_high;

statement ok
CREATE TABLE my_datalake.default.partition_summary_uuid_high (id INTEGER, u UUID);

statement ok
ALTER TABLE my_datalake.default.partition_summary_uuid_high SET PARTITIONED BY (u);

statement ok
INSERT INTO my_datalake.default.partition_summary_uuid_high VALUES
	(3, '80000000-0000-4000-8000-000000000000'),
	(4, 'f79c3e09-677c-4bbd-a479-3f349cb785e7');

query III
SELECT lower_bound, upper_bound, contains_null
FROM iceberg_partition_stats('my_datalake.default.partition_summary_uuid_high');
----
80000000-0000-4000-8000-000000000000	f79c3e09-677c-4bbd-a479-3f349cb785e7	false

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.partition_summary_uuid_high WHERE u = 'f79c3e09-677c-4bbd-a479-3f349cb785e7';
----
[4]

statement ok
DROP TABLE my_datalake.default.partition_summary_uuid_high;

# ---- UUID starting with both 0-7 and 8-f ----

statement ok
DROP TABLE IF EXISTS my_datalake.default.partition_summary_uuid;

statement ok
CREATE TABLE my_datalake.default.partition_summary_uuid (id INTEGER, u UUID);

statement ok
ALTER TABLE my_datalake.default.partition_summary_uuid SET PARTITIONED BY (u);

statement ok
INSERT INTO my_datalake.default.partition_summary_uuid VALUES
	(1, '11111111-1111-4111-8111-111111111111'),
	(2, '7fffffff-ffff-4fff-bfff-ffffffffffff'),
	(3, '80000000-0000-4000-8000-000000000000'),
	(4, 'f79c3e09-677c-4bbd-a479-3f349cb785e7'),
	(5, NULL);

# The lowest and highest value differ between comparing the bytes in order and comparing both 64-bit halves
# as signed longs, so the manifest gets no partition summaries
query I
SELECT count(*) FROM iceberg_partition_stats('my_datalake.default.partition_summary_uuid');
----
0

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.partition_summary_uuid WHERE u = '11111111-1111-4111-8111-111111111111';
----
[1]

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.partition_summary_uuid WHERE u = '7fffffff-ffff-4fff-bfff-ffffffffffff';
----
[2]

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.partition_summary_uuid WHERE u = '80000000-0000-4000-8000-000000000000';
----
[3]

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.partition_summary_uuid WHERE u = 'f79c3e09-677c-4bbd-a479-3f349cb785e7';
----
[4]

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.partition_summary_uuid WHERE u IS NULL;
----
[5]

# UUID data files get no bounds
query II
SELECT count(lower_bound), count(upper_bound)
FROM iceberg_column_stats('my_datalake.default.partition_summary_uuid') WHERE column_name = 'u';
----
0	0

statement ok
DROP TABLE my_datalake.default.partition_summary_uuid;

# ---- UUID with equal first halves ----

statement ok
DROP TABLE IF EXISTS my_datalake.default.partition_summary_uuid_halves;

statement ok
CREATE TABLE my_datalake.default.partition_summary_uuid_halves (id INTEGER, u UUID);

statement ok
ALTER TABLE my_datalake.default.partition_summary_uuid_halves SET PARTITIONED BY (u);

# The second halves of rows 1 and 2 start with 8 and 7, so the two orders disagree on the lowest value
statement ok
INSERT INTO my_datalake.default.partition_summary_uuid_halves VALUES
	(1, '10000000-0000-0000-8000-000000000000'),
	(2, '10000000-0000-0000-7000-000000000000'),
	(3, '20000000-0000-0000-0000-000000000000');

query I
SELECT count(*) FROM iceberg_partition_stats('my_datalake.default.partition_summary_uuid_halves');
----
0

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.partition_summary_uuid_halves WHERE u = '10000000-0000-0000-7000-000000000000';
----
[2]

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.partition_summary_uuid_halves WHERE u = '10000000-0000-0000-8000-000000000000';
----
[1]

statement ok
DROP TABLE my_datalake.default.partition_summary_uuid_halves;

# ---- DELETE across UUIDs starting with 0-7 and 8-f ----

statement ok
DROP TABLE IF EXISTS my_datalake.default.partition_summary_uuid_delete;

statement ok
CREATE TABLE my_datalake.default.partition_summary_uuid_delete (id INTEGER, u UUID) WITH ('format-version' = '2');

statement ok
ALTER TABLE my_datalake.default.partition_summary_uuid_delete SET PARTITIONED BY (u);

statement ok
INSERT INTO my_datalake.default.partition_summary_uuid_delete VALUES
	(1, '11111111-1111-4111-8111-111111111111'),
	(2, '11111111-1111-4111-8111-111111111111'),
	(3, '80000000-0000-4000-8000-000000000000'),
	(4, '80000000-0000-4000-8000-000000000000');

# One delete manifest covers both partitions
statement ok
DELETE FROM my_datalake.default.partition_summary_uuid_delete WHERE id IN (1, 3);

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.partition_summary_uuid_delete;
----
[2, 4]

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.partition_summary_uuid_delete WHERE u = '11111111-1111-4111-8111-111111111111';
----
[2]

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.partition_summary_uuid_delete WHERE u = '80000000-0000-4000-8000-000000000000';
----
[4]

statement ok
DROP TABLE my_datalake.default.partition_summary_uuid_delete;
