# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/partitions/schema_evolution/test_pending_float_partition_promotion.test
# description: Pending identity partitions retain the precision of the column that produced them
# group: [schema_evolution]

require-env CATALOG_TEST_CONFIG_SETUP

require-env SCAN_PLANNING_MODE client

include test/sql/init_requires

statement ok
SET iceberg_use_server_side_scan_planning=false;

statement ok
DROP TABLE IF EXISTS my_datalake.default.pending_float_promotion;

statement ok
CREATE TABLE my_datalake.default.pending_float_promotion (id INTEGER, p FLOAT)
PARTITIONED BY (p) WITH ('format-version' = 2, 'write.metadata.metrics.default' = 'none');

statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.pending_float_promotion VALUES (1, 0.1), (2, NULL), (3, 'NaN');

statement ok
ALTER TABLE my_datalake.default.pending_float_promotion ALTER p TYPE DOUBLE;

# The two files have the same printable partition key but different physical values.
statement ok
INSERT INTO my_datalake.default.pending_float_promotion VALUES (4, 0.1);

query I
SELECT id FROM my_datalake.default.pending_float_promotion WHERE p = 0.1::FLOAT::DOUBLE;
----
1

query I
SELECT id FROM my_datalake.default.pending_float_promotion WHERE p = 0.1::DOUBLE;
----
4

query II
SELECT count(*), min(partition_values."1000") = 0.1::FLOAT::DOUBLE
FROM iceberg_scan_plan('my_datalake.default.pending_float_promotion', row_filter := 'p = 0.1::FLOAT::DOUBLE');
----
1	true

statement ok
SET VARIABLE pending_float_tasks = (
	SELECT list(task) FROM iceberg_scan_plan('my_datalake.default.pending_float_promotion') task
);

query I
SELECT id FROM iceberg_scan_tasks(getvariable('pending_float_tasks')) WHERE p = 0.1::FLOAT::DOUBLE;
----
1

query I
SELECT id FROM my_datalake.default.pending_float_promotion WHERE p IS NULL OR p = 'NaN'::DOUBLE ORDER BY id;
----
2
3

statement ok
DELETE FROM my_datalake.default.pending_float_promotion WHERE p = 0.1::FLOAT::DOUBLE;

statement ok
COMMIT;

query I
SELECT id FROM my_datalake.default.pending_float_promotion ORDER BY id;
----
2
3
4

statement ok
DROP TABLE my_datalake.default.pending_float_promotion;
