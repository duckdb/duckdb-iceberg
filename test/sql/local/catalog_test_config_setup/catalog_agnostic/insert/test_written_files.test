# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/test_written_files.test
# description: the IcebergDataFileWritten log type records the data files an Iceberg write staged
# group: [insert]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

statement ok
DROP TABLE IF EXISTS my_datalake.default.written_files;

statement ok
DROP TABLE IF EXISTS my_datalake.default.written_files_ctas;

statement ok
CREATE TABLE my_datalake.default.written_files (id INTEGER, p INTEGER) PARTITIONED BY (p) WITH ('format-version' = '2');

statement ok
CALL enable_logging('IcebergDataFileWritten');

statement ok
INSERT INTO my_datalake.default.written_files SELECT i, i % 3 FROM range(10) t(i);

# one entry per data file, from one query of this connection, with the counts the manifest records
query III
SELECT count(DISTINCT query_id), bool_and(connection_id = current_connection_id()), sum(record_count)
FROM duckdb_logs_parsed('IcebergDataFileWritten');
----
1	true	10

query I
SELECT count(*) FROM (
    (SELECT file_path, record_count FROM duckdb_logs_parsed('IcebergDataFileWritten')
     EXCEPT SELECT file_path, record_count FROM iceberg_metadata(my_datalake.default.written_files)
     WHERE manifest_content = 'DATA')
    UNION ALL
    (SELECT file_path, record_count FROM iceberg_metadata(my_datalake.default.written_files)
     WHERE manifest_content = 'DATA'
     EXCEPT SELECT file_path, record_count FROM duckdb_logs_parsed('IcebergDataFileWritten'))
);
----
0

query II
SELECT DISTINCT "table", bool_and(file_size_in_bytes > 0) OVER () FROM duckdb_logs_parsed('IcebergDataFileWritten');
----
my_datalake.default.written_files	true

# a write that fails while running logs none
statement ok
CALL truncate_duckdb_logs();

statement error
INSERT INTO my_datalake.default.written_files SELECT CASE WHEN i = 5 THEN error('boom') ELSE i END, 0 FROM range(10) t(i);
----
boom

query I
SELECT count(*) FROM duckdb_logs_parsed('IcebergDataFileWritten');
----
0

# inside a transaction the files are logged when the INSERT stages them, with the transaction's id
statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.written_files VALUES (100, 1);

query II
SELECT count(*), count(DISTINCT transaction_id) FROM duckdb_logs_parsed('IcebergDataFileWritten');
----
1	1

statement ok
ROLLBACK;

# CREATE TABLE AS
statement ok
CALL truncate_duckdb_logs();

statement ok
CREATE TABLE my_datalake.default.written_files_ctas AS SELECT i AS id FROM range(5) t(i);

query I
SELECT count(*) FROM (
    (SELECT file_path FROM duckdb_logs_parsed('IcebergDataFileWritten')
     EXCEPT SELECT file_path FROM iceberg_metadata(my_datalake.default.written_files_ctas) WHERE manifest_content = 'DATA')
    UNION ALL
    (SELECT file_path FROM iceberg_metadata(my_datalake.default.written_files_ctas) WHERE manifest_content = 'DATA'
     EXCEPT SELECT file_path FROM duckdb_logs_parsed('IcebergDataFileWritten'))
);
----
0

# a MERGE that inserts rows logs the file it wrote
statement ok
CALL truncate_duckdb_logs();

statement ok
MERGE INTO my_datalake.default.written_files t USING (SELECT 1000 AS id, 1 AS p) s ON t.id = s.id
WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.p);

query I
SELECT sum(record_count) FROM duckdb_logs_parsed('IcebergDataFileWritten');
----
1

statement ok
DROP TABLE my_datalake.default.written_files;

statement ok
DROP TABLE my_datalake.default.written_files_ctas;
