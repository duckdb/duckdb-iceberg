# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/test_write_value_counts.test
# description: Verify value_counts are written to manifest on INSERT
# group: [insert]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

require icu

require core_functions


statement ok
SET TimeZone = 'UTC';

# --- All NULLs: value_counts includes nulls (100 rows), null_value_counts = 100 ---
statement ok
DROP TABLE IF EXISTS my_datalake.default.value_counts_all_null;

statement ok
CREATE TABLE my_datalake.default.value_counts_all_null (
	int_type INT,
	float_type FLOAT,
	double_type DOUBLE,
	varchar_type VARCHAR
);

statement ok
INSERT INTO my_datalake.default.value_counts_all_null
SELECT NULL, NULL, NULL, NULL FROM range(100);

# Start transaction to keep necessary credentials in scope
statement ok
begin

statement ok
SET VARIABLE manifest_all_null = (
	SELECT manifest_path FROM iceberg_metadata(my_datalake.default.value_counts_all_null)
	ORDER BY manifest_sequence_number DESC LIMIT 1
);

query II
SELECT unnest(map_keys(value_counts)), unnest(map_values(value_counts))
FROM (SELECT unnest(data_file) FROM read_avro(getvariable('manifest_all_null')))
ORDER BY ALL;
----
1	100
2	100
3	100
4	100

query II
SELECT unnest(map_keys(null_value_counts)), unnest(map_values(null_value_counts))
FROM (SELECT unnest(data_file) FROM read_avro(getvariable('manifest_all_null')))
ORDER BY ALL;
----
1	100
2	100
3	100
4	100

query IIIII
SELECT
	column_sizes IS NOT NULL,
	nan_value_counts IS NOT NULL,
	split_offsets IS NULL,
	sort_order_id IS NULL,
	referenced_data_file IS NULL
FROM (SELECT unnest(data_file) FROM read_avro(getvariable('manifest_all_null')));
----
true	true	true	true	true

statement ok
commit

# --- All NaN floats: value_counts = 100, null_value_counts = 0 ---
statement ok
DROP TABLE IF EXISTS my_datalake.default.value_counts_all_nan;

statement ok
CREATE TABLE my_datalake.default.value_counts_all_nan (
	float_type FLOAT,
	double_type DOUBLE
);

statement ok
INSERT INTO my_datalake.default.value_counts_all_nan
SELECT 'NaN'::FLOAT, 'NaN'::DOUBLE FROM range(100);

# Start transaction to keep necessary credentials in scope
statement ok
begin

statement ok
SET VARIABLE manifest_all_nan = (
	SELECT manifest_path FROM iceberg_metadata(my_datalake.default.value_counts_all_nan)
	ORDER BY manifest_sequence_number DESC LIMIT 1
);

query II
SELECT unnest(map_keys(value_counts)), unnest(map_values(value_counts))
FROM (SELECT unnest(data_file) FROM read_avro(getvariable('manifest_all_nan')))
ORDER BY ALL;
----
1	100
2	100

query II
SELECT unnest(map_keys(null_value_counts)), unnest(map_values(null_value_counts))
FROM (SELECT unnest(data_file) FROM read_avro(getvariable('manifest_all_nan')))
ORDER BY ALL;
----
1	0
2	0

statement ok
commit

# every value is NaN, so each column's nan_value_count is the row count
query II
SELECT column_name, nan_value_count FROM iceberg_column_stats(my_datalake.default.value_counts_all_nan)
ORDER BY ALL;
----
double_type	100
float_type	100

# --- Nested types from test_all_types (3 rows) ---
statement ok
DROP TABLE IF EXISTS my_datalake.default.value_counts_nested;

statement ok
CREATE TABLE my_datalake.default.value_counts_nested AS
SELECT
	struct,
	int_array,
	map,
	varchar_array
FROM test_all_types();

# Start transaction to keep necessary credentials in scope
statement ok
begin

statement ok
SET VARIABLE manifest_nested = (
	SELECT manifest_path FROM iceberg_metadata(my_datalake.default.value_counts_nested)
	ORDER BY manifest_sequence_number DESC LIMIT 1
);

# Both leaf fields and containers get value_counts. Each top-level container has 3 rows.
query II
SELECT column_name, value_count
FROM iceberg_column_stats(my_datalake.default.value_counts_nested)
ORDER BY column_name, value_count;
----
a	3
b	3
element	6
element	7
int_array	3
key	4
map	3
struct	3
value	4
varchar_array	3

# Manifest avro: Iceberg field ids are assigned by the catalog (Nessie vs fixture use
# different ids for nested columns), but value_counts values are stable.
# Include the four container counts alongside the six leaf counts.
# Assert on the value_count multiset, not field_id pairs.
query I
SELECT count(*) FROM (
	SELECT unnest(map_values(value_counts)) AS value_count
	FROM (SELECT unnest(data_file) FROM read_avro(getvariable('manifest_nested')))
);
----
10

query I
SELECT list_sort(list(value_count::BIGINT)) = [3, 3, 3, 3, 3, 3, 4, 4, 6, 7]::BIGINT[] FROM (
	SELECT unnest(map_values(value_counts)) AS value_count
	FROM (SELECT unnest(data_file) FROM read_avro(getvariable('manifest_nested')))
);
----
true

statement ok
commit

# --- struct_of_arrays from test_all_types (struct containing lists) ---
statement ok
DROP TABLE IF EXISTS my_datalake.default.value_counts_struct_of_arrays;

statement ok
CREATE TABLE my_datalake.default.value_counts_struct_of_arrays AS
SELECT struct_of_arrays FROM test_all_types();

# Start transaction to keep necessary credentials in scope
statement ok
begin

statement ok
SET VARIABLE manifest_struct_of_arrays = (
	SELECT manifest_path FROM iceberg_metadata(my_datalake.default.value_counts_struct_of_arrays)
	ORDER BY manifest_sequence_number DESC LIMIT 1
);

# Child containers exclude the absent parent struct, but include their own NULLs.
query IIII
SELECT column_name, column_type, value_count, null_value_count
FROM iceberg_column_stats(my_datalake.default.value_counts_struct_of_arrays)
WHERE value_count IS NOT NULL
ORDER BY column_name, column_type;
----
a	INTEGER[]	2	1
b	VARCHAR[]	2	1
element	INTEGER	7	4
element	VARCHAR	6	3
struct_of_arrays	STRUCT(a INTEGER[], b VARCHAR[])	3	1

query I
SELECT list_sort(list(value_count::BIGINT)) = [2, 2, 3, 6, 7]::BIGINT[] FROM (
	SELECT unnest(map_values(value_counts)) AS value_count
	FROM (SELECT unnest(data_file) FROM read_avro(getvariable('manifest_struct_of_arrays')))
);
----
true

statement ok
commit

