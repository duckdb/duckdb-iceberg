include test/sql/init_requires

require core_functions


statement ok
CALL enable_logging('HTTP');

statement ok
set logging_level='debug'

statement ok
DROP TABLE IF EXISTS my_datalake.default.test;

statement ok
CREATE TABLE my_datalake.default.test(a VARCHAR, b BOOLEAN, c INTEGER);

statement ok
BEGIN

statement ok
INSERT INTO my_datalake.default.test(b, a) VALUES (true, 'test');

query III
SELECT * FROM my_datalake.default.test;
----
test	true	NULL

statement ok
ABORT

statement ok
BEGIN

statement ok
INSERT INTO my_datalake.default.test(a, c) VALUES ('test', 42);

query III
SELECT * FROM my_datalake.default.test;
----
