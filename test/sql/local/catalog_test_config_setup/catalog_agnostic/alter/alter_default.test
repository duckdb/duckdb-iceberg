# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/alter/alter_default.test
# group: [alter]

require-env CATALOG_TEST_CONFIG_SETUP

require-env COLUMN_DEFAULT_SUPPORT

require-env FORMAT_V3_SUPPORT

require-env STAGED_CREATE_SUPPORT

include test/sql/init_requires

statement ok
SET default_transaction_invalidation_policy='SYNTACTIC_ERRORS_DO_NOT_INVALIDATE';


statement ok
set enable_logging=true

statement ok
set logging_level='debug'

statement ok
drop table if exists my_datalake.default.drop_default;

statement ok
begin transaction

statement ok
create table my_datalake.default.drop_default(
	a VARCHAR,
	b BOOLEAN
) WITH (
	'format-version'='3'
);

statement error
ALTER TABLE my_datalake.default.drop_default ALTER COLUMN b SET DEFAULT uuid()
----
Not implemented Error: Only foldable expressions are allowed as DEFAULT values

statement ok
abort

statement ok
begin transaction

statement ok
create table my_datalake.default.drop_default(
	a VARCHAR
) WITH (
	'format-version'='3'
);

statement ok
insert into my_datalake.default.drop_default (a) VALUES ('hello world')

statement ok
ALTER TABLE my_datalake.default.drop_default ADD COLUMN b bool DEFAULT false

query II
select * from my_datalake.default.drop_default
----
hello world	false

statement ok
ALTER TABLE my_datalake.default.drop_default ALTER COLUMN b SET DEFAULT true

statement ok
insert into my_datalake.default.drop_default (a) VALUES ('test')

query II
select * from my_datalake.default.drop_default order by all
----
hello world	false
test	true

statement ok
commit

query II
select * from my_datalake.default.drop_default order by all
----
hello world	false
test	true

statement ok
ALTER TABLE my_datalake.default.drop_default ALTER COLUMN b DROP DEFAULT;

statement ok
insert into my_datalake.default.drop_default(a) VALUES ('not null')

# without a 'write-default' new rows are NULL, the 'initial-default' only applies to rows written before 'b' existed
query II
select a, b::BOOLEAN from my_datalake.default.drop_default order by all
----
hello world	false
not null	NULL
test	true

statement ok
drop table if exists my_datalake.default.drop_create_default;

statement ok
create table my_datalake.default.drop_create_default(
	id INT,
	c INT DEFAULT 5
) WITH (
	'format-version'='3'
);

statement ok
insert into my_datalake.default.drop_create_default (id) VALUES (1)

statement ok
ALTER TABLE my_datalake.default.drop_create_default ALTER COLUMN c DROP DEFAULT;

statement ok
insert into my_datalake.default.drop_create_default (id) VALUES (2)

statement ok
begin transaction

statement ok
insert into my_datalake.default.drop_create_default (id) VALUES (3)

statement ok
commit

query II
select * from my_datalake.default.drop_create_default order by id
----
1	5
2	NULL
3	NULL
