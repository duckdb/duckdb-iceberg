# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/alter/sorted_by/test_sort_defaults.test
# description: Resolve CREATE, CTAS and ALTER sort defaults from client settings
# group: [sorted_by]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

statement ok
DROP TABLE IF EXISTS my_datalake.default.sort_defaults;

statement ok
SET default_order = 'DESC';

statement ok
SET default_null_order = 'NULLS_FIRST_ON_ASC_LAST_ON_DESC';

statement ok
CREATE TABLE my_datalake.default.sort_defaults SORTED BY (a) AS FROM (VALUES (1), (NULL), (3), (2)) v(a);

query TT
SELECT f.direction, f."null-order"
FROM iceberg_load_table_response(my_datalake.default.sort_defaults),
unnest(metadata."sort-orders"::VARIANT[]) AS s(o),
unnest(o.fields::VARIANT[]) AS fields(f)
WHERE o."order-id"::INTEGER = metadata."default-sort-order-id"
ORDER BY f."source-id"::INTEGER ASC;
----
desc	nulls-last

query I
SELECT a FROM my_datalake.default.sort_defaults ORDER BY filename ASC, file_row_number ASC;
----
3
2
1
NULL

statement ok
ALTER TABLE my_datalake.default.sort_defaults SET SORTED BY (a ASC);

query TT
SELECT f.direction, f."null-order"
FROM iceberg_load_table_response(my_datalake.default.sort_defaults),
unnest(metadata."sort-orders"::VARIANT[]) AS s(o),
unnest(o.fields::VARIANT[]) AS fields(f)
WHERE o."order-id"::INTEGER = metadata."default-sort-order-id"
ORDER BY f."source-id"::INTEGER ASC;
----
asc	nulls-first

statement ok
SET default_null_order = 'NULLS_LAST_ON_ASC_FIRST_ON_DESC';

statement ok
ALTER TABLE my_datalake.default.sort_defaults SET SORTED BY (a);

query TT
SELECT f.direction, f."null-order"
FROM iceberg_load_table_response(my_datalake.default.sort_defaults),
unnest(metadata."sort-orders"::VARIANT[]) AS s(o),
unnest(o.fields::VARIANT[]) AS fields(f)
WHERE o."order-id"::INTEGER = metadata."default-sort-order-id"
ORDER BY f."source-id"::INTEGER ASC;
----
desc	nulls-first

# Explicit directives override both settings.
statement ok
ALTER TABLE my_datalake.default.sort_defaults SET SORTED BY (a ASC NULLS LAST);

query TT
SELECT f.direction, f."null-order"
FROM iceberg_load_table_response(my_datalake.default.sort_defaults),
unnest(metadata."sort-orders"::VARIANT[]) AS s(o),
unnest(o.fields::VARIANT[]) AS fields(f)
WHERE o."order-id"::INTEGER = metadata."default-sort-order-id"
ORDER BY f."source-id"::INTEGER ASC;
----
asc	nulls-last

statement ok
DROP TABLE my_datalake.default.sort_defaults;

statement ok
SET default_null_order = 'NULLS_FIRST';

statement ok
CREATE TABLE my_datalake.default.sort_defaults (a INTEGER) SORTED BY (a);

query TT
SELECT f.direction, f."null-order"
FROM iceberg_load_table_response(my_datalake.default.sort_defaults),
unnest(metadata."sort-orders"::VARIANT[]) AS s(o),
unnest(o.fields::VARIANT[]) AS fields(f)
WHERE o."order-id"::INTEGER = metadata."default-sort-order-id"
ORDER BY f."source-id"::INTEGER ASC;
----
desc	nulls-first

statement ok
DROP TABLE my_datalake.default.sort_defaults;

statement ok
SET default_null_order = 'NULLS_LAST';

statement ok
CREATE TABLE my_datalake.default.sort_defaults (a INTEGER) SORTED BY (a);

query TT
SELECT f.direction, f."null-order"
FROM iceberg_load_table_response(my_datalake.default.sort_defaults),
unnest(metadata."sort-orders"::VARIANT[]) AS s(o),
unnest(o.fields::VARIANT[]) AS fields(f)
WHERE o."order-id"::INTEGER = metadata."default-sort-order-id"
ORDER BY f."source-id"::INTEGER ASC;
----
desc	nulls-last

statement ok
DROP TABLE my_datalake.default.sort_defaults;

statement ok
RESET default_order;

statement ok
RESET default_null_order;

# Partition-only writes must not advertise a sort order.
statement ok
CREATE TABLE my_datalake.default.sort_defaults (p INTEGER, a INTEGER) PARTITIONED BY (p);

statement ok
INSERT INTO my_datalake.default.sort_defaults VALUES (1, 3), (1, 1), (2, 4), (2, 2);

statement ok
BEGIN;

statement ok
SET VARIABLE manifest_path = (SELECT manifest_path FROM iceberg_metadata(my_datalake.default.sort_defaults) LIMIT 1);

query I
SELECT count(*) > 0 AND count(data_file.sort_order_id) = 0
FROM read_avro(getvariable('manifest_path'));
----
true

statement ok
COMMIT;

statement ok
DROP TABLE my_datalake.default.sort_defaults;
