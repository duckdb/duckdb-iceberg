# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/alter/alter_unknown_type.test
# description: UNKNOWN can evolve to every Iceberg type at the root and inside containers
# group: [alter]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

require-env UNKNOWN_SUPPORT

require avro

require parquet

require iceberg

require httpfs

require core_functions

# Surface catalog errors instead of treating them as ignored test failures.
set ignore_error_messages

# Use an alias so the struct type is a single foreach token.
statement ok
CREATE TYPE unknown_target_struct AS STRUCT(n INTEGER, s VARCHAR);

# Non-NULL values with exact representations, including all decimal storage widths.
# VARIANT has separate coverage because nested VARIANT writing is not supported.
statement ok
CREATE TEMP TABLE unknown_type_values AS SELECT
    true AS "BOOLEAN",
    42::INTEGER AS "INTEGER",
    9223372036854775807::BIGINT AS "BIGINT",
    1.5::FLOAT AS "FLOAT",
    2.25::DOUBLE AS "DOUBLE",
    12.3::DECIMAL(4,1) AS "DECIMAL(4,1)",
    12345.6789::DECIMAL(9,4) AS "DECIMAL(9,4)",
    123456789012.345678::DECIMAL(18,6) AS "DECIMAL(18,6)",
    12345678901234567890.1234567890::DECIMAL(38,10) AS "DECIMAL(38,10)",
    DATE '2024-02-29' AS "DATE",
    TIME '12:34:56.123456' AS "TIME",
    TIMESTAMP '2024-02-29 12:34:56.123456' AS "TIMESTAMP",
    TIMESTAMPTZ '2024-02-29 12:34:56.123456+00' AS "TIMESTAMPTZ",
    TIMESTAMP_NS '2024-02-29 12:34:56.123456789' AS "TIMESTAMP_NS",
    TIMESTAMPTZ_NS '2024-02-29 12:34:56.123456789+00' AS "TIMESTAMPTZ_NS",
    UUID '12345678-1234-5678-9abc-123456789abc' AS "UUID",
    'unknown becomes a string'::VARCHAR AS "VARCHAR",
    '\x00\x01\xFF'::BLOB AS "BLOB",
    {'n': 42, 's': 'hello'}::unknown_target_struct AS "unknown_target_struct",
    [42, NULL, 7]::INTEGER[] AS "INTEGER[]",
    MAP {1: 'hello', 2: NULL} AS "MAP(INTEGER,VARCHAR)",
    'POINT (1 2)'::GEOMETRY('OGC:CRS84') AS "GEOMETRY('OGC:CRS84')";

foreach type BOOLEAN INTEGER BIGINT FLOAT DOUBLE DECIMAL(4,1) DECIMAL(9,4) DECIMAL(18,6) DECIMAL(38,10) DATE TIME TIMESTAMP TIMESTAMPTZ TIMESTAMP_NS TIMESTAMPTZ_NS UUID VARCHAR BLOB unknown_target_struct INTEGER[] MAP(INTEGER,VARCHAR) GEOMETRY('OGC:CRS84')

statement ok
DROP TABLE IF EXISTS my_datalake.default.alter_unknown_type;

statement ok
CREATE TABLE my_datalake.default.alter_unknown_type (
    id INTEGER,
    r "NULL" DEFAULT NULL,
    s STRUCT(kept INTEGER, v "NULL")
) WITH ('format-version' = '3');

# Commit old data before the promotion. The root column is omitted from the data file, and the struct keeps a
# field to write, so both can be written.
statement ok
INSERT INTO my_datalake.default.alter_unknown_type VALUES (1, NULL, {'kept': 42, 'v': NULL});

statement ok
ALTER TABLE my_datalake.default.alter_unknown_type ALTER COLUMN r TYPE {type};

statement ok
ALTER TABLE my_datalake.default.alter_unknown_type ALTER COLUMN s.v TYPE {type};

# Check the actual bound field types on the row committed before the promotion.
query II
SELECT
	CASE WHEN typeof(r) = typeof(v) THEN true::VARIANT ELSE {
		'actual': typeof(r),
		'expected': typeof(v)
	}::VARIANT END,
	CASE WHEN typeof(s.v) = typeof(v) THEN true::VARIANT ELSE {
		'actual': typeof(s.v),
		'expected': typeof(v)
	}::VARIANT END
FROM my_datalake.default.alter_unknown_type,
     (SELECT "{type}" AS v FROM unknown_type_values) expected
WHERE id = 1;
----
true	true

statement ok
INSERT INTO my_datalake.default.alter_unknown_type
SELECT 2, v, {'kept': 7, 'v': v} FROM (SELECT "{type}" AS v FROM unknown_type_values);

# The old row keeps its NULLs and the field written next to them, and the new row keeps its values.
query IIIIII
SELECT id, r IS NULL, s.v IS NULL, s.kept, r IS NOT DISTINCT FROM v, s.v IS NOT DISTINCT FROM v
FROM my_datalake.default.alter_unknown_type,
     (SELECT "{type}" AS v FROM unknown_type_values) expected
ORDER BY id;
----
1	true	true	42	false	false
2	false	false	7	true	true

statement ok
DROP TABLE my_datalake.default.alter_unknown_type;

statement ok
DROP TABLE IF EXISTS my_datalake.default.alter_unknown_type_containers;

statement ok
CREATE TABLE my_datalake.default.alter_unknown_type_containers (
    id INTEGER,
    s STRUCT(v "NULL"),
    m MAP(VARCHAR, "NULL"),
    l "NULL"[]
) WITH ('format-version' = '3');

# These containers hold nothing but UNKNOWN, so they have no data file representation and carry no old rows.
statement ok
ALTER TABLE my_datalake.default.alter_unknown_type_containers ALTER COLUMN s.v TYPE {type};

statement ok
ALTER TABLE my_datalake.default.alter_unknown_type_containers ALTER COLUMN m.value TYPE {type};

statement ok
ALTER TABLE my_datalake.default.alter_unknown_type_containers ALTER COLUMN l.element TYPE {type};

statement ok
INSERT INTO my_datalake.default.alter_unknown_type_containers
SELECT 1, {'v': v}, MAP {'new': v}, [v, NULL]
FROM (SELECT "{type}" AS v FROM unknown_type_values);

# Check actual bound field types, including children of newly introduced containers.
query III
SELECT
	CASE WHEN typeof(s.v) = typeof(v) THEN true::VARIANT ELSE {
		'actual': typeof(s.v),
		'expected': typeof(v)
	}::VARIANT END,
	CASE WHEN typeof(map_extract_value(m, 'new')) = typeof(v) THEN true::VARIANT ELSE {
		'actual': typeof(map_extract_value(m, 'new')),
		'expected': typeof(v)
	}::VARIANT END,
	CASE WHEN typeof(l[1]) = typeof(v) THEN true::VARIANT ELSE {
		'actual': typeof(l[1]),
		'expected': typeof(v)
	}::VARIANT END
FROM my_datalake.default.alter_unknown_type_containers,
     (SELECT "{type}" AS v FROM unknown_type_values) expected;
----
true	true	true

# Verify values, not only successful insertion or the new schema.
query IIIIIII
SELECT s.v IS NOT DISTINCT FROM v, map_extract_value(m, 'new') IS NOT DISTINCT FROM v,
       l[1] IS NOT DISTINCT FROM v, map_keys(m) = ['new'], cardinality(m), len(l), l[2] IS NULL
FROM my_datalake.default.alter_unknown_type_containers,
     (SELECT "{type}" AS v FROM unknown_type_values) expected;
----
true	true	true	true	1	2	true

statement ok
DROP TABLE my_datalake.default.alter_unknown_type_containers;

endloop

# Multiple nested evolutions in one transaction allocate disjoint child field IDs.
# Explicit NULL defaults must also acquire the new type.
statement ok
CREATE TABLE my_datalake.default.alter_unknown_type (
    id INTEGER, a "NULL" DEFAULT NULL, b "NULL" DEFAULT NULL
) WITH ('format-version' = '3');

statement ok
INSERT INTO my_datalake.default.alter_unknown_type(id) VALUES (1);

statement ok
BEGIN;

statement ok
ALTER TABLE my_datalake.default.alter_unknown_type ALTER COLUMN a TYPE STRUCT(x INTEGER, y INTEGER[]);

statement ok
ALTER TABLE my_datalake.default.alter_unknown_type ALTER COLUMN b TYPE MAP(INTEGER, STRUCT(v VARCHAR));

statement ok
ALTER TABLE my_datalake.default.alter_unknown_type ADD COLUMN c BOOLEAN;

statement ok
INSERT INTO my_datalake.default.alter_unknown_type VALUES
    (2, {'x': 42, 'y': [7, NULL]}, MAP {9: {'v': 'hello'}}, true);

statement ok
COMMIT;

statement ok
INSERT INTO my_datalake.default.alter_unknown_type(id) VALUES (3);

query IIII
SELECT id, a IS NULL, b IS NULL, c FROM my_datalake.default.alter_unknown_type ORDER BY id;
----
1	true	true	NULL
2	false	false	true
3	true	true	NULL

query III
SELECT a.x, a.y, map_extract_value(b, 9).v FROM my_datalake.default.alter_unknown_type WHERE id = 2;
----
42	[7, NULL]	hello

statement ok
DROP TABLE my_datalake.default.alter_unknown_type;

statement ok
DROP TABLE unknown_type_values;

statement ok
DROP TYPE unknown_target_struct;
