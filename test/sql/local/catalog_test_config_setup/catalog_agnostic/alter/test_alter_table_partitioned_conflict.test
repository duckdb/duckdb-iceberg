# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/alter/test_alter_table_partitioned_conflict.test
# group: [alter]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires


statement ok
CALL enable_logging(level='warning');

statement ok
SET warnings_as_errors = True;

statement ok
drop table if exists my_datalake.default.alter_table_conflict;

statement ok
CREATE TABLE my_datalake.default.alter_table_conflict AS (select range a, range%2 b, range%4 c FROM range(10));

statement ok con1
begin;

# select from alter_table_conflict so we do not request table state again
statement ok con1
select * from my_datalake.default.alter_table_conflict;

statement ok con2
begin;

# con2 alters the partition
statement ok con2
Alter table my_datalake.default.alter_table_conflict SET PARTITIONED BY (b);

statement ok con2
commit;

statement ok con1
Alter table my_datalake.default.alter_table_conflict SET PARTITIONED BY (a);

# con1 should error since the partition spec id has updated before con1 could commit;
statement error con1
commit;
----
<REGEX>:.*Conflict.*

# a partition change that adds no new partition field conflicts as well
statement ok
Alter table my_datalake.default.alter_table_conflict SET PARTITIONED BY (a);

statement ok con1
begin;

statement ok con1
Alter table my_datalake.default.alter_table_conflict SET PARTITIONED BY (c);

statement ok con2
begin;

# con2 switches back to the spec on (b), which exists already
statement ok con2
Alter table my_datalake.default.alter_table_conflict SET PARTITIONED BY (b);

statement ok con2
commit;

statement error con1
commit;
----
<REGEX>:.*Conflict_409.*

# the table is partitioned by (b)
query ITT
SELECT metadata."default-spec-id", spec.fields[1].name, spec.fields[2].name
FROM iceberg_load_table_response('my_datalake.default.alter_table_conflict'),
unnest(metadata."partition-specs"::VARIANT[]) AS t(spec)
WHERE try_cast(spec."spec-id" AS INTEGER) = metadata."default-spec-id";
----
1	b	NULL

statement ok con1
begin;

statement ok con1
Alter table my_datalake.default.alter_table_conflict SET PARTITIONED BY (c);

statement ok con2
begin;

# con2 adds a spec on (a, b), which reuses the partition fields of the earlier specs
statement ok con2
Alter table my_datalake.default.alter_table_conflict SET PARTITIONED BY (a, b);

statement ok con2
commit;

statement error con1
commit;
----
<REGEX>:.*Conflict_409.*

# the table is partitioned by (a, b)
query ITT
SELECT metadata."default-spec-id", spec.fields[1].name, spec.fields[2].name
FROM iceberg_load_table_response('my_datalake.default.alter_table_conflict'),
unnest(metadata."partition-specs"::VARIANT[]) AS t(spec)
WHERE try_cast(spec."spec-id" AS INTEGER) = metadata."default-spec-id";
----
3	a	b

statement ok con1
begin;

# both connections switch back to a spec that exists already: neither adds a spec
statement ok con1
Alter table my_datalake.default.alter_table_conflict SET PARTITIONED BY (a);

statement ok con2
begin;

statement ok con2
Alter table my_datalake.default.alter_table_conflict SET PARTITIONED BY (b);

statement ok con2
commit;

statement error con1
commit;
----
<REGEX>:.*Conflict_409.*

# the table is partitioned by (b)
query ITT
SELECT metadata."default-spec-id", spec.fields[1].name, spec.fields[2].name
FROM iceberg_load_table_response('my_datalake.default.alter_table_conflict'),
unnest(metadata."partition-specs"::VARIANT[]) AS t(spec)
WHERE try_cast(spec."spec-id" AS INTEGER) = metadata."default-spec-id";
----
1	b	NULL

statement ok con1
begin;

statement ok con1
Alter table my_datalake.default.alter_table_conflict SET PARTITIONED BY (bucket(8, b));

statement ok con2
begin;

# con2 adds a spec with a new partition field and switches back to the spec on (b): the default spec id is
# back where it was, but the partition field id that con1 picked is taken
statement ok con2
Alter table my_datalake.default.alter_table_conflict SET PARTITIONED BY (bucket(4, a));

statement ok con2
Alter table my_datalake.default.alter_table_conflict SET PARTITIONED BY (b);

statement ok con2
commit;

statement error con1
commit;
----
<REGEX>:.*Conflict_409.*

# the table is still partitioned by (b)
query ITT
SELECT metadata."default-spec-id", spec.fields[1].name, spec.fields[2].name
FROM iceberg_load_table_response('my_datalake.default.alter_table_conflict'),
unnest(metadata."partition-specs"::VARIANT[]) AS t(spec)
WHERE try_cast(spec."spec-id" AS INTEGER) = metadata."default-spec-id";
----
1	b	NULL

# Reusing a spec allocates no fields, so an increased last-partition-id alone must not block it.
statement ok
SET VARIABLE previous_last_partition_id = (
	SELECT metadata."last-partition-id"::INTEGER
	FROM iceberg_load_table_response('my_datalake.default.alter_table_conflict')
);

statement ok con1
BEGIN;

statement ok con1
ALTER TABLE my_datalake.default.alter_table_conflict RESET PARTITIONED BY;

statement ok con2
BEGIN;

statement ok con2
ALTER TABLE my_datalake.default.alter_table_conflict SET PARTITIONED BY (truncate(4, c));

statement ok con2
ALTER TABLE my_datalake.default.alter_table_conflict SET PARTITIONED BY (b);

statement ok con2
COMMIT;

query I
SELECT metadata."last-partition-id"::INTEGER > getvariable('previous_last_partition_id')
FROM iceberg_load_table_response('my_datalake.default.alter_table_conflict');
----
true

statement ok con1
COMMIT;

query II
SELECT metadata."default-spec-id", len(spec.fields::VARIANT[])
FROM iceberg_load_table_response('my_datalake.default.alter_table_conflict'),
unnest(metadata."partition-specs"::VARIANT[]) AS t(spec)
WHERE try_cast(spec."spec-id" AS INTEGER) = metadata."default-spec-id";
----
0	0

statement ok
DROP TABLE my_datalake.default.alter_table_conflict;
