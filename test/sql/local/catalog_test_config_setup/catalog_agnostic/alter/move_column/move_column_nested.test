# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/alter/move_column/move_column_nested.test
# description: iceberg_move_column moves a struct field within its struct, also in a list element or a map value; map keys are refused
# group: [move_column]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

require json

statement ok
DROP TABLE IF EXISTS my_datalake.default.move_nested;

# struct<count, data>: data moves first
statement ok
CREATE TABLE my_datalake.default.move_nested (
	id BIGINT,
	s STRUCT(count BIGINT, data VARCHAR),
	other STRUCT(count BIGINT, data VARCHAR)
);

statement ok
INSERT INTO my_datalake.default.move_nested VALUES (1, {'count': 10, 'data': 'a'}, {'count': 20, 'data': 'b'});

query II
SELECT previous_schema_id, current_schema_id
FROM iceberg_move_column('my_datalake.default.move_nested', 's.data', first => true);
----
0	1

# only the fields of s change places
query II
SELECT column_name, column_type FROM (DESCRIBE my_datalake.default.move_nested);
----
id	BIGINT
s	STRUCT("data" VARCHAR, count BIGINT)
other	STRUCT(count BIGINT, "data" VARCHAR)

# the row written before the move keeps each value under its field
query III
SELECT id, s, other FROM my_datalake.default.move_nested;
----
1	{'data': a, 'count': 10}	{'count': 20, 'data': b}

query II
SELECT s.count, s.data FROM my_datalake.default.move_nested;
----
10	a

statement ok
DROP TABLE my_datalake.default.move_nested;

# data before the first field
statement ok
CREATE TABLE my_datalake.default.move_nested (id BIGINT, s STRUCT(count BIGINT, data VARCHAR));

statement ok
CALL iceberg_move_column('my_datalake.default.move_nested', 's.data', before => 's.count');

query I
SELECT column_type FROM (DESCRIBE my_datalake.default.move_nested) WHERE column_name = 's';
----
STRUCT("data" VARCHAR, count BIGINT)

statement ok
DROP TABLE my_datalake.default.move_nested;

# count after the last field
statement ok
CREATE TABLE my_datalake.default.move_nested (id BIGINT, s STRUCT(count BIGINT, data VARCHAR));

statement ok
CALL iceberg_move_column('my_datalake.default.move_nested', 's.count', after => 's.data');

query I
SELECT column_type FROM (DESCRIBE my_datalake.default.move_nested) WHERE column_name = 's';
----
STRUCT("data" VARCHAR, count BIGINT)

statement ok
DROP TABLE my_datalake.default.move_nested;

# struct<count, data, ts>: ts after count
statement ok
CREATE TABLE my_datalake.default.move_nested (id BIGINT, s STRUCT(count BIGINT, data VARCHAR, ts DATE));

statement ok
CALL iceberg_move_column('my_datalake.default.move_nested', 's.ts', after => 's.count');

query I
SELECT column_type FROM (DESCRIBE my_datalake.default.move_nested) WHERE column_name = 's';
----
STRUCT(count BIGINT, ts DATE, "data" VARCHAR)

statement ok
DROP TABLE my_datalake.default.move_nested;

# struct<ts, count, data>: ts before data
statement ok
CREATE TABLE my_datalake.default.move_nested (id BIGINT, s STRUCT(ts DATE, count BIGINT, data VARCHAR));

statement ok
CALL iceberg_move_column('my_datalake.default.move_nested', 's.ts', before => 's.data');

query I
SELECT column_type FROM (DESCRIBE my_datalake.default.move_nested) WHERE column_name = 's';
----
STRUCT(count BIGINT, ts DATE, "data" VARCHAR)

statement ok
DROP TABLE my_datalake.default.move_nested;

# a struct inside a struct
statement ok
CREATE TABLE my_datalake.default.move_nested (id BIGINT, s STRUCT(a INTEGER, sub STRUCT(x INTEGER, y INTEGER)));

statement ok
INSERT INTO my_datalake.default.move_nested VALUES (1, {'a': 1, 'sub': {'x': 2, 'y': 3}});

statement ok
CALL iceberg_move_column('my_datalake.default.move_nested', 's.sub.y', first => true);

query I
SELECT column_type FROM (DESCRIBE my_datalake.default.move_nested) WHERE column_name = 's';
----
STRUCT(a INTEGER, sub STRUCT(y INTEGER, x INTEGER))

query I
SELECT s FROM my_datalake.default.move_nested;
----
{'a': 1, 'sub': {'y': 3, 'x': 2}}

statement ok
DROP TABLE my_datalake.default.move_nested;

# the struct of a list element and of a map value; the paths name the element and value level
statement ok
CREATE TABLE my_datalake.default.move_nested (
	id BIGINT,
	l STRUCT(ts DATE, count BIGINT, data VARCHAR)[],
	m MAP(VARCHAR, STRUCT(ts DATE, count BIGINT, data VARCHAR))
);

statement ok
INSERT INTO my_datalake.default.move_nested VALUES (
	1,
	[{'ts': DATE '2026-01-01', 'count': 1, 'data': 'x'}],
	MAP {'k': {'ts': DATE '2026-01-02', 'count': 2, 'data': 'y'}}
);

statement ok
CALL iceberg_move_column('my_datalake.default.move_nested', 'l.element.ts', before => 'l.element.data');

statement ok
CALL iceberg_move_column('my_datalake.default.move_nested', 'm.value.ts', before => 'm.value.data');

query II
SELECT column_name, column_type FROM (DESCRIBE my_datalake.default.move_nested);
----
id	BIGINT
l	STRUCT(count BIGINT, ts DATE, "data" VARCHAR)[]
m	MAP(VARCHAR, STRUCT(count BIGINT, ts DATE, "data" VARCHAR))

query II
SELECT l, m FROM my_datalake.default.move_nested;
----
[{'count': 1, 'ts': 2026-01-01, 'data': x}]	{k={'count': 2, 'ts': 2026-01-02, 'data': y}}

statement ok
DROP TABLE my_datalake.default.move_nested;

statement ok
DROP TABLE IF EXISTS my_datalake.default.move_map_key;

# a map key, and a field of a map key, can't be moved: the error of ALTER TABLE
statement ok
CREATE TABLE my_datalake.default.move_map_key (
	id INTEGER,
	m MAP(STRUCT(k INTEGER, k2 INTEGER), VARCHAR),
	mk MAP(INTEGER, VARCHAR)
);

statement error
CALL iceberg_move_column('my_datalake.default.move_map_key', 'm.key.k2', first => true);
----
Catalog Error: Cannot alter 'm.key.k2': map keys can't be changed

statement error
CALL iceberg_move_column('my_datalake.default.move_map_key', 'm.key.k2', before => 'm.key.k');
----
Catalog Error: Cannot alter 'm.key.k2': map keys can't be changed

statement error
CALL iceberg_move_column('my_datalake.default.move_map_key', 'mk.key', after => 'mk.value');
----
Catalog Error: Cannot alter 'mk.key': map keys can't be changed

# the refused moves leave the table as it was
query II
SELECT column_name, column_type FROM (DESCRIBE my_datalake.default.move_map_key);
----
id	INTEGER
m	MAP(STRUCT(k INTEGER, k2 INTEGER), VARCHAR)
mk	MAP(INTEGER, VARCHAR)

query II
SELECT metadata."current-schema-id"::INTEGER, len(metadata.schemas::VARIANT[])
FROM iceberg_load_table_response('my_datalake.default.move_map_key');
----
0	1

statement ok
DROP TABLE my_datalake.default.move_map_key;
