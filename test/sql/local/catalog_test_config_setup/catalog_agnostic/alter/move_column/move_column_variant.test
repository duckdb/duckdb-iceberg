# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/alter/move_column/move_column_variant.test
# description: A path into a VARIANT column names no field of the schema: iceberg_move_column refuses it as ALTER TABLE does
# group: [move_column]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

require-env VARIANT_SUPPORT

include test/sql/init_requires

statement ok
DROP TABLE IF EXISTS my_datalake.default.move_variant;

statement ok
CREATE TABLE my_datalake.default.move_variant (id INTEGER, v VARIANT) WITH ('format-version' = '3');

statement error
CALL iceberg_move_column('my_datalake.default.move_variant', 'v.a', first => true);
----
Invalid Input Error: Column path v.a points to child of variant column v

statement error
CALL iceberg_move_column('my_datalake.default.move_variant', 'id', after => 'v.a');
----
Invalid Input Error: Column path v.a points to child of variant column v

query II
SELECT column_name, column_type FROM (DESCRIBE my_datalake.default.move_variant);
----
id	INTEGER
v	VARIANT

# the column itself moves
statement ok
CALL iceberg_move_column('my_datalake.default.move_variant', 'v', first => true);

query II
SELECT column_name, column_type FROM (DESCRIBE my_datalake.default.move_variant);
----
v	VARIANT
id	INTEGER

statement ok
DROP TABLE my_datalake.default.move_variant;
