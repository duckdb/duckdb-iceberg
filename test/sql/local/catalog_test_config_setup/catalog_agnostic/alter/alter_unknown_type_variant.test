# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/alter/alter_unknown_type_variant.test
# description: UNKNOWN to VARIANT preserves old NULLs; nested VARIANT writes remain unsupported
# group: [alter]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

require-env UNKNOWN_SUPPORT

require-env VARIANT_SUPPORT

require avro

require parquet

require iceberg

require httpfs

set ignore_error_messages

statement ok
DROP TABLE IF EXISTS my_datalake.default.unknown_variant_root;

statement ok
CREATE TABLE my_datalake.default.unknown_variant_root(id INTEGER, v "NULL" DEFAULT NULL)
WITH ('format-version' = '3');

statement ok
INSERT INTO my_datalake.default.unknown_variant_root(id) VALUES (1);

statement ok
ALTER TABLE my_datalake.default.unknown_variant_root ALTER COLUMN v TYPE VARIANT;

statement ok
INSERT INTO my_datalake.default.unknown_variant_root VALUES (2, {'n': 42, 's': 'hello'}::VARIANT);

query III
SELECT id, typeof(v) = 'VARIANT',
       CASE WHEN id = 1 THEN v IS NULL ELSE v IS NOT DISTINCT FROM {'n': 42, 's': 'hello'}::VARIANT END
FROM my_datalake.default.unknown_variant_root ORDER BY id;
----
1	true	true
2	true	true

statement ok
DROP TABLE my_datalake.default.unknown_variant_root;

foreach suffix s m l

statement ok
DROP TABLE IF EXISTS my_datalake.default.unknown_variant_{suffix};

endloop

statement ok
CREATE TABLE my_datalake.default.unknown_variant_s(id INTEGER, v STRUCT(n "NULL")) WITH ('format-version' = '3');

statement ok
CREATE TABLE my_datalake.default.unknown_variant_m(id INTEGER, v MAP(VARCHAR, "NULL")) WITH ('format-version' = '3');

statement ok
CREATE TABLE my_datalake.default.unknown_variant_l(id INTEGER, v "NULL"[]) WITH ('format-version' = '3');

# Each table exercises the writer limitation independently.
foreach suffix,path,value s,v.n,{'n':42::VARIANT} m,v.value,MAP{'key':42::VARIANT} l,v.element,[42::VARIANT]

statement ok
ALTER TABLE my_datalake.default.unknown_variant_{suffix} ALTER COLUMN {path} TYPE VARIANT;

statement error
INSERT INTO my_datalake.default.unknown_variant_{suffix} VALUES (2, {value});
----
ColumnWriter of type 'VARIANT' requires a transform, but is not a root column

statement ok
DROP TABLE my_datalake.default.unknown_variant_{suffix};

endloop
