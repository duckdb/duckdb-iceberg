# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/alter/add_column/alter_add_column_nested.test
# description: ALTER TABLE ADD COLUMN adds STRUCT, LIST and MAP columns on V2 catalogs
# group: [add_column]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

statement ok
DROP TABLE IF EXISTS my_datalake.default.add_column_nested;

# ---------- STRUCT, LIST and MAP ----------

statement ok
CREATE TABLE my_datalake.default.add_column_nested (id INTEGER) WITH ('format-version' = '2');

statement ok
INSERT INTO my_datalake.default.add_column_nested VALUES (1);

statement ok
ALTER TABLE my_datalake.default.add_column_nested ADD COLUMN s STRUCT(a INTEGER, b STRUCT(c VARCHAR));

statement ok
ALTER TABLE my_datalake.default.add_column_nested ADD COLUMN l INTEGER[];

statement ok
ALTER TABLE my_datalake.default.add_column_nested ADD COLUMN m MAP(VARCHAR, INTEGER);

statement ok
ALTER TABLE my_datalake.default.add_column_nested ADD COLUMN ls STRUCT(x INTEGER)[];

query TT
SELECT column_name, column_type FROM (DESCRIBE my_datalake.default.add_column_nested) ORDER BY ALL;
----
id	INTEGER
l	INTEGER[]
ls	STRUCT(x INTEGER)[]
m	MAP(VARCHAR, INTEGER)
s	STRUCT(a INTEGER, b STRUCT(c VARCHAR))

# rows written before the columns were added read them as NULL
statement ok
INSERT INTO my_datalake.default.add_column_nested VALUES (2, {'a': 5, 'b': {'c': 'hi'}}, [1, 2], MAP {'k': 7}, [{'x': 9}]);

query IIIII
SELECT * FROM my_datalake.default.add_column_nested ORDER BY id;
----
1	NULL	NULL	NULL	NULL
2	{'a': 5, 'b': {'c': hi}}	[1, 2]	{k=7}	[{'x': 9}]

query I
SELECT id FROM my_datalake.default.add_column_nested WHERE s IS NULL;
----
1

query I
SELECT id FROM my_datalake.default.add_column_nested WHERE l[1] = 1;
----
2

query I
SELECT id FROM my_datalake.default.add_column_nested WHERE m['k'] = 7;
----
2

# field ids of the nested children are taken into account for later columns
statement ok
ALTER TABLE my_datalake.default.add_column_nested ADD COLUMN after_nested INTEGER;

statement ok
INSERT INTO my_datalake.default.add_column_nested VALUES (3, {'a': 6, 'b': {'c': 'yo'}}, NULL, NULL, NULL, 42);

query III
SELECT id, s, after_nested FROM my_datalake.default.add_column_nested ORDER BY id;
----
1	NULL	NULL
2	{'a': 5, 'b': {'c': hi}}	NULL
3	{'a': 6, 'b': {'c': yo}}	42

statement ok
SET VARIABLE last_nested_id = (
	SELECT metadata."last-column-id"::INTEGER
	FROM iceberg_load_table_response(my_datalake.default.add_column_nested)
);

statement ok
ALTER TABLE my_datalake.default.add_column_nested ADD COLUMN IF NOT EXISTS s STRUCT(a INTEGER);

# A no-op cannot replace the existing nested type.
query I
SELECT typeof(s) FROM my_datalake.default.add_column_nested WHERE id = 2;
----
STRUCT(a INTEGER, b STRUCT(c VARCHAR))

statement error
ALTER TABLE my_datalake.default.add_column_nested ADD COLUMN s STRUCT(a INTEGER);
----
Column with name "s" already exists

# Removing the blanket nested-type guard must retain the unsupported-type checks.
statement error
ALTER TABLE my_datalake.default.add_column_nested ADD COLUMN fixed_array INTEGER[2];
----
Array type not supported in Iceberg type. Please cast to LIST

statement error
ALTER TABLE my_datalake.default.add_column_nested ADD COLUMN bad STRUCT(n UNION(i INTEGER, s VARCHAR));
----
Column type UNION is not a valid Iceberg Type

statement error
ALTER TABLE my_datalake.default.add_column_nested ADD COLUMN nonnull STRUCT(n INTEGER) DEFAULT {'n': 7};
----
non-null DEFAULT values are not supported for <V3 tables

query I
SELECT metadata."last-column-id"::INTEGER = getvariable('last_nested_id')
FROM iceberg_load_table_response(my_datalake.default.add_column_nested);
----
true

query TT
SELECT column_name, column_type FROM (DESCRIBE my_datalake.default.add_column_nested) ORDER BY column_name;
----
after_nested	INTEGER
id	INTEGER
l	INTEGER[]
ls	STRUCT(x INTEGER)[]
m	MAP(VARCHAR, INTEGER)
s	STRUCT(a INTEGER, b STRUCT(c VARCHAR))

statement ok
DROP TABLE my_datalake.default.add_column_nested;
