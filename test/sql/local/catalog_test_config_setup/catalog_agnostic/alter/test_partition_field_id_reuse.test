# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/alter/test_partition_field_id_reuse.test
# group: [alter]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

statement ok
DROP TABLE IF EXISTS my_datalake.default.partition_field_id_reuse;

statement ok
CREATE TABLE my_datalake.default.partition_field_id_reuse (
	a INTEGER,
	b INTEGER,
	c INTEGER
) PARTITIONED BY (
	a,
	bucket(4, b)
) WITH ('format-version' = '2');

statement ok
CREATE TEMP VIEW current_partition_ids AS
SELECT
	list_transform(
		spec.fields::VARIANT[],
		lambda f: f."field-id"::INTEGER
	) AS ids,
	metadata."last-partition-id"::INTEGER AS last_id
FROM iceberg_load_table_response(
	'my_datalake.default.partition_field_id_reuse'
), unnest(
	metadata."partition-specs"::VARIANT[]
) AS t(spec)
WHERE spec."spec-id"::INTEGER = metadata."default-spec-id"::INTEGER;

query TI
SELECT ids, last_id FROM current_partition_ids;
----
[1000, 1001]	1001

# Retained fields keep their IDs, even when reordered; only c is new.
statement ok
ALTER TABLE my_datalake.default.partition_field_id_reuse SET PARTITIONED BY (
	bucket(4, b),
	c,
	a
);

query TI
SELECT ids, last_id FROM current_partition_ids;
----
[1001, 1002, 1000]	1002

# A changed transform parameter and a different source column require new IDs.
statement ok
ALTER TABLE my_datalake.default.partition_field_id_reuse SET PARTITIONED BY (
	bucket(8, b),
	bucket(4, c),
	a
);

query TI
SELECT ids, last_id FROM current_partition_ids;
----
[1003, 1004, 1000]	1004

# Recycle fields absent from the current spec without advancing the high-water mark.
statement ok
ALTER TABLE my_datalake.default.partition_field_id_reuse RESET PARTITIONED BY;

statement ok
ALTER TABLE my_datalake.default.partition_field_id_reuse SET PARTITIONED BY (
	c,
	bucket(4, b)
);

query TI
SELECT ids, last_id FROM current_partition_ids;
----
[1002, 1001]	1004

# Renaming a source column does not change its identity or its partition field name.
statement ok
ALTER TABLE my_datalake.default.partition_field_id_reuse RENAME a TO renamed_a;

statement ok
ALTER TABLE my_datalake.default.partition_field_id_reuse SET PARTITIONED BY (
	renamed_a,
	c
);

query TI
SELECT ids, last_id FROM current_partition_ids;
----
[1000, 1002]	1004

query T
SELECT
	spec.fields[1].name::VARCHAR
FROM
	iceberg_load_table_response(
		'my_datalake.default.partition_field_id_reuse'
	), unnest(
		metadata."partition-specs"::VARIANT[]
	) AS t(spec)
WHERE spec."spec-id"::INTEGER = metadata."default-spec-id"::INTEGER;
----
identity_a_1

# Multiple alterations in one transaction must allocate distinct new IDs.
statement ok
BEGIN;

statement ok
ALTER TABLE my_datalake.default.partition_field_id_reuse SET PARTITIONED BY (
	truncate(2, renamed_a),
	c
);

statement ok
ALTER TABLE my_datalake.default.partition_field_id_reuse SET PARTITIONED BY (
	truncate(3, renamed_a),
	c
);

statement ok
COMMIT;

query TI
SELECT ids, last_id FROM current_partition_ids;
----
[1006, 1002]	1006

statement ok
ALTER TABLE my_datalake.default.partition_field_id_reuse SET PARTITIONED BY (
	truncate(2, renamed_a),
	bucket(4, b)
);

query TI
SELECT ids, last_id FROM current_partition_ids;
----
[1005, 1001]	1006

# Returning to the initial spec should reuse the whole spec as well.
statement ok
ALTER TABLE my_datalake.default.partition_field_id_reuse SET PARTITIONED BY (
	renamed_a,
	bucket(4, b)
);

query TI
SELECT ids, last_id FROM current_partition_ids;
----
[1000, 1001]	1006

query I
SELECT metadata."default-spec-id"::INTEGER FROM iceberg_load_table_response(
	'my_datalake.default.partition_field_id_reuse'
);
----
0

statement ok
DROP TABLE my_datalake.default.partition_field_id_reuse;

