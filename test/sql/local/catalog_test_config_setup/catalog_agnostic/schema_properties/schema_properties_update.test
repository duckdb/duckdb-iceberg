# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/schema_properties/schema_properties_update.test
# group: [schema_properties]

require-env CATALOG_TEST_CONFIG_SETUP

require-env NAMESPACE_PROPERTIES_SUPPORT

statement ok
DROP SCHEMA IF EXISTS my_datalake.myschema123;

statement ok
CREATE SCHEMA IF NOT EXISTS my_datalake.myschema123;

# Catalogs supply different properties when a namespace is created.
statement ok
CREATE TABLE initial_properties AS FROM iceberg_schema_properties(my_datalake.myschema123);

query I
SELECT success - (SELECT count(*) FROM initial_properties)
FROM set_iceberg_schema_properties(my_datalake.myschema123,
    {
    'myprop1' : '1',
    'myprop2' : '2',
    'myprop3' : '3',
    }
);
----
3

query II
FROM iceberg_schema_properties(my_datalake.myschema123)
EXCEPT FROM initial_properties ORDER BY ALL;
----
myprop1	1
myprop2	2
myprop3	3

query I
SELECT success - (SELECT count(*) FROM initial_properties)
FROM remove_iceberg_schema_properties(my_datalake.myschema123, ['myprop2']);
----
2

query II
FROM iceberg_schema_properties(my_datalake.myschema123)
EXCEPT FROM initial_properties ORDER BY ALL;
----
myprop1	1
myprop3	3


query I
SELECT success - (SELECT count(*) FROM initial_properties)
FROM remove_iceberg_schema_properties(my_datalake.myschema123, ['non_exisiting_prop']);
----
2

query I
SELECT success - (SELECT count(*) FROM initial_properties)
FROM set_iceberg_schema_properties(my_datalake.myschema123, {'myprop2': '2', 'myprop4': '4'});
----
4

query I
SELECT success - (SELECT count(*) FROM initial_properties)
FROM remove_iceberg_schema_properties(my_datalake.myschema123, ['myprop1', 'myprop3', 'myprop4']);
----
1

query II
FROM iceberg_schema_properties(my_datalake.myschema123)
EXCEPT FROM initial_properties ORDER BY ALL;
----
myprop2	2

statement ok
DROP SCHEMA my_datalake.myschema123;
