# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/drop/test_drop_schema_not_empty.test
# description: DROP SCHEMA without CASCADE refuses a schema that still contains tables
# group: [drop]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

# Expected errors must be checked, not ignored.
set ignore_error_messages

statement ok
DROP TABLE IF EXISTS my_datalake.drop_schema_not_empty.t;

statement ok
DROP SCHEMA IF EXISTS my_datalake.drop_schema_not_empty;

statement ok
DROP SCHEMA IF EXISTS my_datalake.drop_schema_pending;

statement ok
DROP TABLE IF EXISTS my_datalake.drop_schema_raced.t;

statement ok
DROP SCHEMA IF EXISTS my_datalake.drop_schema_raced;

statement ok
CREATE SCHEMA my_datalake.drop_schema_not_empty;

statement ok
CREATE TABLE my_datalake.drop_schema_not_empty.t (i INTEGER);

statement ok
INSERT INTO my_datalake.drop_schema_not_empty.t VALUES (42);

statement error
DROP SCHEMA my_datalake.drop_schema_not_empty;
----
Dependency Error: Cannot drop schema "drop_schema_not_empty" because it is not empty

statement error
DROP SCHEMA IF EXISTS my_datalake.drop_schema_not_empty;
----
Dependency Error: Cannot drop schema "drop_schema_not_empty" because it is not empty

# The schema is refused when it is dropped, not when the transaction commits
statement ok
BEGIN;

statement error
DROP SCHEMA my_datalake.drop_schema_not_empty;
----
Dependency Error: Cannot drop schema "drop_schema_not_empty" because it is not empty

statement ok
ROLLBACK;

query I
SELECT i FROM my_datalake.drop_schema_not_empty.t;
----
42

# A table created in the same transaction counts
statement ok
CREATE SCHEMA my_datalake.drop_schema_pending;

statement ok
BEGIN;

statement ok
CREATE TABLE my_datalake.drop_schema_pending.t (i INTEGER);

statement error
DROP SCHEMA my_datalake.drop_schema_pending;
----
Dependency Error: Cannot drop schema "drop_schema_pending" because it is not empty

statement ok
ROLLBACK;

# A table dropped earlier in the same transaction does not count
statement ok
BEGIN;

statement ok
DROP TABLE my_datalake.drop_schema_not_empty.t;

statement ok
DROP SCHEMA my_datalake.drop_schema_not_empty;

statement ok
COMMIT;

statement error
DROP SCHEMA my_datalake.drop_schema_not_empty;
----
<REGEX>:.*Catalog Error: Schema with name .*drop_schema_not_empty.* does not exist.*

# An empty schema drops
statement ok
DROP SCHEMA my_datalake.drop_schema_pending;

statement error
DROP SCHEMA my_datalake.drop_schema_pending;
----
<REGEX>:.*Catalog Error: Schema with name .*drop_schema_pending.* does not exist.*

# A table renamed in the same transaction still counts, under its new name
statement ok
CREATE SCHEMA my_datalake.drop_schema_pending;

statement ok
CREATE TABLE my_datalake.drop_schema_pending.t (i INTEGER);

statement ok
BEGIN;

statement ok
ALTER TABLE my_datalake.drop_schema_pending.t RENAME TO renamed;

statement error
DROP SCHEMA my_datalake.drop_schema_pending;
----
Dependency Error: Cannot drop schema "drop_schema_pending" because it is not empty: it contains table "renamed"

statement ok
ROLLBACK;

statement ok
DROP TABLE my_datalake.drop_schema_pending.t;

statement ok
DROP SCHEMA my_datalake.drop_schema_pending;

# A table another connection creates after the schema was dropped is checked for again at commit
statement ok
CREATE SCHEMA my_datalake.drop_schema_raced;

statement ok con1
BEGIN;

statement ok con1
DROP SCHEMA my_datalake.drop_schema_raced;

statement ok con2
CREATE TABLE my_datalake.drop_schema_raced.t (i INTEGER);

statement ok con2
INSERT INTO my_datalake.drop_schema_raced.t VALUES (7);

statement error con1
COMMIT;
----
Failed to commit Iceberg transaction: Cannot drop schema "drop_schema_raced" because it is not empty: it contains table "t"

query I con2
SELECT i FROM my_datalake.drop_schema_raced.t;
----
7

statement ok con2
DROP TABLE my_datalake.drop_schema_raced.t;

statement ok con2
DROP SCHEMA my_datalake.drop_schema_raced;
