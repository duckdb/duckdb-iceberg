# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/drop/test_drop_schema_with_view.test
# description: DROP SCHEMA without CASCADE refuses a schema that still contains a view
# group: [drop]

require-env CATALOG_TEST_CONFIG_SETUP

require-env VIEW_SUPPORT

include test/sql/init_requires

# Expected errors must be checked, not ignored.
set ignore_error_messages

statement ok
DROP VIEW IF EXISTS my_datalake.drop_schema_with_view.v;

statement ok
DROP SCHEMA IF EXISTS my_datalake.drop_schema_with_view;

statement ok
CREATE SCHEMA my_datalake.drop_schema_with_view;

statement ok
CREATE VIEW my_datalake.drop_schema_with_view.v AS SELECT 42 AS answer;

statement error
DROP SCHEMA my_datalake.drop_schema_with_view;
----
Dependency Error: Cannot drop schema "drop_schema_with_view" because it is not empty

query I
SELECT answer FROM my_datalake.drop_schema_with_view.v;
----
42

statement ok
DROP VIEW my_datalake.drop_schema_with_view.v;

statement ok
DROP SCHEMA my_datalake.drop_schema_with_view;
