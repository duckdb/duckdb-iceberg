# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/drop/test_drop_schema_with_view.test
# description: DROP SCHEMA without CASCADE refuses a schema that still contains a view
# group: [drop]

require-env CATALOG_TEST_CONFIG_SETUP

require-env VIEW_SUPPORT

include test/sql/init_requires

# Expected errors must be checked, not ignored.
set ignore_error_messages

statement ok
DROP VIEW IF EXISTS my_datalake.drop_schema_with_view.v;

statement ok
DROP SCHEMA IF EXISTS my_datalake.drop_schema_with_view;

statement ok
DROP VIEW IF EXISTS my_datalake.drop_schema_view_pending.v;

statement ok
DROP SCHEMA IF EXISTS my_datalake.drop_schema_view_pending;

statement ok
CREATE SCHEMA my_datalake.drop_schema_with_view;

statement ok
CREATE VIEW my_datalake.drop_schema_with_view.v AS SELECT 42 AS answer;

statement error
DROP SCHEMA my_datalake.drop_schema_with_view;
----
Dependency Error: Cannot drop schema "drop_schema_with_view" because it is not empty

query I
SELECT answer FROM my_datalake.drop_schema_with_view.v;
----
42

# A view dropped earlier in the same transaction does not count. The commit is still refused, since a view
# change commits on its own, so the view and the schema stay.
statement ok
BEGIN;

statement ok
DROP VIEW my_datalake.drop_schema_with_view.v;

statement ok
DROP SCHEMA my_datalake.drop_schema_with_view;

statement error
COMMIT;
----
cannot commit view changes atomically with other catalog changes

query I
SELECT answer FROM my_datalake.drop_schema_with_view.v;
----
42

# A view created earlier in the same transaction counts
statement ok
CREATE SCHEMA my_datalake.drop_schema_view_pending;

statement ok
BEGIN;

statement ok
CREATE VIEW my_datalake.drop_schema_view_pending.v AS SELECT 1 AS one;

statement error
DROP SCHEMA my_datalake.drop_schema_view_pending;
----
Dependency Error: Cannot drop schema "drop_schema_view_pending" because it is not empty: it contains view "v"

statement ok
ROLLBACK;

statement ok
DROP SCHEMA my_datalake.drop_schema_view_pending;

statement ok
DROP VIEW my_datalake.drop_schema_with_view.v;

statement ok
DROP SCHEMA my_datalake.drop_schema_with_view;
