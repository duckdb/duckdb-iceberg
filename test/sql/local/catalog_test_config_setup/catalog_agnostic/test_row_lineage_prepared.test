# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/test_row_lineage_prepared.test
# description: prepared statements that read the row lineage columns under a LIMIT
# group: [catalog_agnostic]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

include test/sql/init_requires

statement ok
DROP TABLE IF EXISTS my_datalake.default.row_lineage_prepared;

statement ok
CREATE TABLE my_datalake.default.row_lineage_prepared (
	id INTEGER,
	v VARCHAR
) WITH (
	'format-version' = 3
);

statement ok
INSERT INTO my_datalake.default.row_lineage_prepared VALUES (1, 'a'), (2, 'b'), (3, 'c');

statement ok
INSERT INTO my_datalake.default.row_lineage_prepared VALUES (4, 'd'), (5, 'e');

# EXECUTE plans the statement again on the bind data of the PREPARE. The LIMIT makes the optimizer ask the scan for
# its cardinality while preparing, which freezes the scan configuration; the second plan asks for the lineage
# columns again.
statement ok
PREPARE row_ids AS
SELECT id, _row_id FROM my_datalake.default.row_lineage_prepared ORDER BY id LIMIT 3;

query II
EXECUTE row_ids;
----
1	0
2	1
3	2

query II
EXECUTE row_ids;
----
1	0
2	1
3	2

statement ok
PREPARE sequence_numbers AS
SELECT id, _last_updated_sequence_number FROM my_datalake.default.row_lineage_prepared ORDER BY id DESC LIMIT 2;

query II
EXECUTE sequence_numbers;
----
5	2
4	2

# A plain LIMIT, without ORDER BY, freezes the configuration in the same way
statement ok
PREPARE first_rows AS
SELECT _row_id, _last_updated_sequence_number FROM my_datalake.default.row_lineage_prepared LIMIT 3;

query II rowsort
EXECUTE first_rows;
----
0	1
1	1
2	1

statement ok
PREPARE row_id_filter AS
SELECT id FROM my_datalake.default.row_lineage_prepared WHERE _row_id = 3 LIMIT 1;

query I
EXECUTE row_id_filter;
----
4

# Without a LIMIT nothing freezes the configuration while preparing
statement ok
PREPARE all_rows AS
SELECT id, _row_id, _last_updated_sequence_number FROM my_datalake.default.row_lineage_prepared ORDER BY id;

query III
EXECUTE all_rows;
----
1	0	1
2	1	1
3	2	1
4	3	2
5	4	2
