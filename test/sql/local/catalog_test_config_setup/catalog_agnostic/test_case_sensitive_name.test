# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/test_case_sensitive_name.test
# description: test integration with iceberg catalog read
# group: [catalog_agnostic]

require-env CATALOG_TEST_CONFIG_SETUP

require-env CASE_SENSITIVE_TABLE_NAMES_SUPPORT

include test/sql/init_requires

require tpch

statement ok
DROP TABLE IF EXISTS my_datalake.default.Buy;

statement ok
DROP TABLE IF EXISTS my_datalake.default.buy;

statement ok
create table my_datalake.default.Buy (price float, name varchar);

statement ok
create table my_datalake.default.buy (price float, name varchar);

statement ok
insert into my_datalake.default."Buy" values (1, 'upper');

statement ok
insert into my_datalake.default."buy" values (2, 'lower');

query II fresh
select price, name from my_datalake.default."Buy";
----
1.0	upper

query II fresh
select price, name from my_datalake.default."buy";
----
2.0	lower

query I
select
	(select metadata."table-uuid" from iceberg_load_table_response(my_datalake.default."Buy")) <>
	(select metadata."table-uuid" from iceberg_load_table_response(my_datalake.default."buy"));
----
true

statement ok
drop table my_datalake.default."Buy";

query II fresh
select price, name from my_datalake.default."buy";
----
2.0	lower

statement ok
drop table my_datalake.default."buy";
