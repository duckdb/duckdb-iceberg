# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/delete/test_dml_dv_replaces_position_delete_file.test
# description: UPDATE, MERGE and a multi-DELETE transaction after a v2 to v3 upgrade remove the file-scoped position delete file their deletion vector replaces
# group: [delete]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

include test/sql/init_requires

foreach dml update merge transaction

statement ok
DROP TABLE IF EXISTS my_datalake.default.dv_replaces_position_delete_{dml};

statement ok
CREATE TABLE my_datalake.default.dv_replaces_position_delete_{dml} (id INTEGER) WITH ('format-version' = '2');

# Two inserts, two data files
statement ok
INSERT INTO my_datalake.default.dv_replaces_position_delete_{dml} SELECT range FROM range(10);

statement ok
INSERT INTO my_datalake.default.dv_replaces_position_delete_{dml} SELECT range FROM range(10, 20);

# v2: one file-scoped position delete file per data file (two positions for the first, one for the second)
statement ok
DELETE FROM my_datalake.default.dv_replaces_position_delete_{dml} WHERE id IN (1, 2, 15);

statement ok
ALTER TABLE my_datalake.default.dv_replaces_position_delete_{dml} SET ('format-version' = '3');

endloop

statement ok
UPDATE my_datalake.default.dv_replaces_position_delete_update SET id = 105 WHERE id = 5;

statement ok
MERGE INTO my_datalake.default.dv_replaces_position_delete_merge AS t
USING (SELECT 5 AS id) AS s ON t.id = s.id
WHEN MATCHED THEN DELETE;

statement ok
BEGIN;

statement ok
DELETE FROM my_datalake.default.dv_replaces_position_delete_transaction WHERE id = 5;

statement ok
DELETE FROM my_datalake.default.dv_replaces_position_delete_transaction WHERE id = 6;

statement ok
COMMIT;

query I
SELECT string_agg(id, ',' ORDER BY id) FROM my_datalake.default.dv_replaces_position_delete_update;
----
0,3,4,6,7,8,9,10,11,12,13,14,16,17,18,19,105

query I
SELECT string_agg(id, ',' ORDER BY id) FROM my_datalake.default.dv_replaces_position_delete_merge;
----
0,3,4,6,7,8,9,10,11,12,13,14,16,17,18,19

query I
SELECT string_agg(id, ',' ORDER BY id) FROM my_datalake.default.dv_replaces_position_delete_transaction;
----
0,3,4,7,8,9,10,11,12,13,14,16,17,18,19

# The deletion vector for the first data file absorbs its two v2 positions, so their file is removed.
# The file for the untouched data file stays live.
foreach dml update merge

query III
SELECT file_format, status = 'DELETED', record_count
FROM iceberg_metadata(my_datalake.default.dv_replaces_position_delete_{dml})
WHERE content = 'POSITION_DELETES'
ORDER BY file_format, record_count;
----
parquet	false	1
parquet	true	2
puffin	false	3

query II
SELECT summary['removed-position-delete-files'], summary['total-position-deletes']
FROM iceberg_snapshots(my_datalake.default.dv_replaces_position_delete_{dml})
ORDER BY sequence_number DESC LIMIT 1;
----
1	4

endloop

# The v2 file is removed once. The second vector replaces the first and holds all four positions.
query III
SELECT file_format, status = 'DELETED', record_count
FROM iceberg_metadata(my_datalake.default.dv_replaces_position_delete_transaction)
WHERE content = 'POSITION_DELETES'
ORDER BY file_format, record_count;
----
parquet	false	1
parquet	true	2
puffin	true	3
puffin	false	4

foreach dml update merge transaction

statement ok
DROP TABLE my_datalake.default.dv_replaces_position_delete_{dml};

endloop
