# ---- year(ts): a range spanning the whole year ----

statement ok
DROP TABLE IF EXISTS my_datalake.default.test_metadata_only_year;

statement ok
CREATE TABLE my_datalake.default.test_metadata_only_year (id INT, ts TIMESTAMP, val VARCHAR)
PARTITIONED BY (year(ts));

statement ok
INSERT INTO my_datalake.default.test_metadata_only_year VALUES
    (1, '2020-01-01 00:00:00'::TIMESTAMP, 'a'),
    (2, '2020-12-31 23:59:59'::TIMESTAMP, 'b'),
    (3, '2021-03-10 08:00:00'::TIMESTAMP, 'c');

query I
DELETE FROM my_datalake.default.test_metadata_only_year
WHERE ts >= '2020-01-01 00:00:00'::TIMESTAMP AND ts < '2021-01-01 00:00:00'::TIMESTAMP;
----
2

query III
SELECT id, ts, val FROM my_datalake.default.test_metadata_only_year ORDER BY id;
----
