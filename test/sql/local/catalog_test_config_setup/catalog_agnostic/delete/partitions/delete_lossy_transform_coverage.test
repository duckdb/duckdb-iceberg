# ---- truncate(3, category) on VARCHAR ----

statement ok
DROP TABLE IF EXISTS my_datalake.default.test_lossy_truncate_varchar;

statement ok
CREATE TABLE my_datalake.default.test_lossy_truncate_varchar (id INT, category VARCHAR, val VARCHAR)
PARTITIONED BY (truncate(3, category));

statement ok
INSERT INTO my_datalake.default.test_lossy_truncate_varchar VALUES
    (1, 'catalog',  'a'),
    (2, 'catapult', 'b'),
    (3, 'category', 'c');

query I
DELETE FROM my_datalake.default.test_lossy_truncate_varchar WHERE category = 'catapult';
