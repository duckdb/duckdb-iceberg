# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/delete/partitions/delete_lossy_transform_coverage.test
# description: A predicate that lands inside one partition of a lossy transform must never drop the whole data file - the partition value is shared by source values that do not match. Covers both equality and ranges; delete_metadata_only_coverage.test holds the partition-aligned ranges that do drop
# group: [partitions]

require-env CATALOG_TEST_CONFIG_SETUP

require avro

require parquet

require iceberg

require httpfs


statement ok
CALL enable_logging('HTTP');

statement ok
set logging_level='debug'

# Every table below puts all its rows in one partition and deletes only some of them: dropping the file
# on the strength of its partition value would take the siblings with it.

# ---- Equality ----

# ---- day(ts) on TIMESTAMP: one day holds many instants ----

statement ok
DROP TABLE IF EXISTS my_datalake.default.test_lossy_day_ts;

statement ok
CREATE TABLE my_datalake.default.test_lossy_day_ts (id INT, ts TIMESTAMP, val VARCHAR)
PARTITIONED BY (day(ts));

statement ok
INSERT INTO my_datalake.default.test_lossy_day_ts VALUES
    (1, '2021-05-01 00:00:00'::TIMESTAMP, 'a'),
    (2, '2021-05-01 12:00:00'::TIMESTAMP, 'b'),
    (3, '2021-05-01 23:59:59'::TIMESTAMP, 'c');

query I
DELETE FROM my_datalake.default.test_lossy_day_ts WHERE ts = '2021-05-01 12:00:00'::TIMESTAMP;
----
1

query III
SELECT id, ts, val FROM my_datalake.default.test_lossy_day_ts ORDER BY id;
----
1	2021-05-01 00:00:00	a
3	2021-05-01 23:59:59	c

# The row-level path ran, so a delete file was written.
query I
SELECT count(*) FROM iceberg_metadata(my_datalake.default.test_lossy_day_ts)
WHERE content = 'POSITION_DELETES';
----
1

statement ok
DROP TABLE my_datalake.default.test_lossy_day_ts;

# ---- hour(ts) ----

statement ok
DROP TABLE IF EXISTS my_datalake.default.test_lossy_hour;

statement ok
CREATE TABLE my_datalake.default.test_lossy_hour (id INT, ts TIMESTAMP, val VARCHAR)
PARTITIONED BY (hour(ts));

statement ok
INSERT INTO my_datalake.default.test_lossy_hour VALUES
    (1, '2021-05-01 10:00:00'::TIMESTAMP, 'a'),
    (2, '2021-05-01 10:30:00'::TIMESTAMP, 'b');

query I
DELETE FROM my_datalake.default.test_lossy_hour WHERE ts = '2021-05-01 10:30:00'::TIMESTAMP;
----
1

query III
SELECT id, ts, val FROM my_datalake.default.test_lossy_hour ORDER BY id;
----
1	2021-05-01 10:00:00	a

query I
SELECT count(*) FROM iceberg_metadata(my_datalake.default.test_lossy_hour)
WHERE content = 'POSITION_DELETES';
----
1

statement ok
DROP TABLE my_datalake.default.test_lossy_hour;

