statement ok
DROP TABLE my_datalake.default.test_lossy_truncate_varchar;

# ---- bucket(1, id): hashing is not order-preserving, and one bucket holds every id ----

statement ok
DROP TABLE IF EXISTS my_datalake.default.test_lossy_bucket;

statement ok
CREATE TABLE my_datalake.default.test_lossy_bucket (id INT, val VARCHAR)
PARTITIONED BY (bucket(1, id));

statement ok
INSERT INTO my_datalake.default.test_lossy_bucket VALUES
    (1, 'a'), (2, 'b'), (3, 'c');

query I
DELETE FROM my_datalake.default.test_lossy_bucket WHERE id = 2;
----
1

query II
SELECT id, val FROM my_datalake.default.test_lossy_bucket ORDER BY id;
----
1	a
3	c

query I
SELECT count(*) FROM iceberg_metadata(my_datalake.default.test_lossy_bucket)
WHERE content = 'POSITION_DELETES';
----
1

# A range is no safer than equality on a bucket partition: the bucket value says nothing about
# the ordering of the ids inside it.
query I
DELETE FROM my_datalake.default.test_lossy_bucket WHERE id >= 3;
----
1

query II
SELECT id, val FROM my_datalake.default.test_lossy_bucket ORDER BY id;
----
1	a

statement ok
DROP TABLE my_datalake.default.test_lossy_bucket;

# ---- Ranges that stay inside one partition ----
# An endpoint inside the file's own partition transforms to that same partition value, so a non-strict
# comparison against it holds trivially. Only a strict test keeps these files.

# ---- day(ts): a range inside a single day ----

statement ok
DROP TABLE IF EXISTS my_datalake.default.test_lossy_range_day;

statement ok
CREATE TABLE my_datalake.default.test_lossy_range_day (id INT, ts TIMESTAMP, val VARCHAR)
PARTITIONED BY (day(ts));

statement ok
INSERT INTO my_datalake.default.test_lossy_range_day VALUES
    (1, '2021-05-01 00:00:00'::TIMESTAMP, 'a'),
    (2, '2021-05-01 10:30:00'::TIMESTAMP, 'b'),
    (3, '2021-05-01 23:59:59'::TIMESTAMP, 'c');

query I
DELETE FROM my_datalake.default.test_lossy_range_day
WHERE ts >= '2021-05-01 10:00:00'::TIMESTAMP AND ts <= '2021-05-01 11:00:00'::TIMESTAMP;
----
1

query III
SELECT id, ts, val FROM my_datalake.default.test_lossy_range_day ORDER BY id;
----
1	2021-05-01 00:00:00	a
3	2021-05-01 23:59:59	c

query I
SELECT count(*) FROM iceberg_metadata(my_datalake.default.test_lossy_range_day)
WHERE content = 'POSITION_DELETES';
----
1

statement ok
DROP TABLE my_datalake.default.test_lossy_range_day;

