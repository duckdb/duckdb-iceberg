# ---- truncate(10, id) on INT ----

statement ok
DROP TABLE IF EXISTS my_datalake.default.test_lossy_truncate_int;

statement ok
CREATE TABLE my_datalake.default.test_lossy_truncate_int (id INT, val VARCHAR)
PARTITIONED BY (truncate(10, id));

statement ok
INSERT INTO my_datalake.default.test_lossy_truncate_int VALUES
    (11, 'a'), (12, 'b'), (13, 'c');

query I
