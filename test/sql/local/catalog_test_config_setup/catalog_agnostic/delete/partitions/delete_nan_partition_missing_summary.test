# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/delete/partitions/delete_nan_partition_missing_summary.test
# description: Missing NaN summaries must retain deletes across floating point, NULL, and multi-column partitions
# group: [partitions]

require-env CATALOG_TEST_CONFIG_SETUP

require-env METADATA_FILE_READ_SUPPORT

include test/sql/init_requires

require json

foreach type FLOAT DOUBLE

statement ok
CREATE TABLE my_datalake.default.nan_missing_summary (id INTEGER, x {type}, category VARCHAR)
PARTITIONED BY (x, category) WITH ('format-version' = 2);

statement ok
INSERT INTO my_datalake.default.nan_missing_summary VALUES
	(1, 1, 'A'), (2, 2, 'A'), (3, 'NaN', 'A'), (4, '-NaN', 'A'),
	(5, 'NaN', 'B'), (6, NULL, 'A'), (7, NULL, 'A'), (8, '-Infinity', 'A'), (9, 'Infinity', 'A');

statement ok
DELETE FROM my_datalake.default.nan_missing_summary WHERE id IN (2, 3, 6, 8, 9);

# The delete manifest has numeric bounds even though it also contains NaN and NULL.
query IIIII
SELECT content, partition_summaries[1].contains_nan, partition_summaries[1].contains_null,
	partition_summaries[1].lower_bound, partition_summaries[1].upper_bound
FROM iceberg_manifests(my_datalake.default.nan_missing_summary) ORDER BY content;
----
0	true	true	-inf	inf
1	true	true	-inf	inf

# Keep vended credentials alive for both the metadata reads and the scans of the copied metadata.
statement ok
BEGIN;

statement ok
SET VARIABLE nan_metadata = (
	SELECT metadata::JSON FROM iceberg_load_table_response(my_datalake.default.nan_missing_summary)
);

statement ok
SET VARIABLE nan_manifest_list = (
	SELECT manifest_list FROM iceberg_snapshots(my_datalake.default.nan_missing_summary)
	ORDER BY sequence_number DESC LIMIT 1
);

statement ok
CREATE OR REPLACE TEMP TABLE nan_manifest_list AS
SELECT * FROM read_avro(getvariable('nan_manifest_list'));

# External writers may include contains_nan with a NULL value.
statement ok
COPY (
	SELECT * REPLACE (list_transform(partitions, lambda p: struct_update(p, contains_nan := NULL::BOOLEAN)) AS partitions)
	FROM nan_manifest_list
) TO '{TEST_DIR}/nan_{type}_null_list.avro' (
	FORMAT AVRO,
	FIELD_IDS {
		manifest_path: 500, manifest_length: 501, partition_spec_id: 502,
		content: 517, sequence_number: 515, min_sequence_number: 516, added_snapshot_id: 503,
		added_files_count: 504, existing_files_count: 505, deleted_files_count: 506,
		added_rows_count: 512, existing_rows_count: 513, deleted_rows_count: 514,
		partitions: {__duckdb_field_id: 507, list: {__duckdb_field_id: 508,
			contains_null: 509, contains_nan: {__duckdb_field_id: 518, __duckdb_nullable: true},
			lower_bound: 510, upper_bound: 511}}
	}
);

# They may also omit the optional field from the Avro schema entirely.
statement ok
COPY (
	SELECT * REPLACE (list_transform(partitions, lambda p: {
		contains_null: p.contains_null, lower_bound: p.lower_bound, upper_bound: p.upper_bound
	}) AS partitions)
	FROM nan_manifest_list
) TO '{TEST_DIR}/nan_{type}_absent_list.avro' (
	FORMAT AVRO,
	FIELD_IDS {
		manifest_path: 500, manifest_length: 501, partition_spec_id: 502,
		content: 517, sequence_number: 515, min_sequence_number: 516, added_snapshot_id: 503,
		added_files_count: 504, existing_files_count: 505, deleted_files_count: 506,
		added_rows_count: 512, existing_rows_count: 513, deleted_rows_count: 514,
		partitions: {__duckdb_field_id: 507, list: {__duckdb_field_id: 508,
			contains_null: 509, lower_bound: 510, upper_bound: 511}}
	}
);

foreach summary null absent

statement ok
COPY (
	SELECT json_merge_patch(getvariable('nan_metadata'), json_object(
		'snapshots', json_array(json_merge_patch(snapshot.value,
			json_object('manifest-list', '{TEST_DIR}/nan_{type}_{summary}_list.avro')))
	))
	FROM json_each(getvariable('nan_metadata'), '$.snapshots') snapshot
	WHERE snapshot.value->>'snapshot-id' = getvariable('nan_metadata')->>'current-snapshot-id'
) TO '{TEST_DIR}/nan_{type}_{summary}.metadata.json' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '');

query I
SELECT partition_summaries[1].contains_nan IS NULL
FROM iceberg_manifests('{TEST_DIR}/nan_{type}_{summary}.metadata.json') WHERE content = 1;
----
true

query III
SELECT id, x, category FROM iceberg_scan('{TEST_DIR}/nan_{type}_{summary}.metadata.json') ORDER BY id;
----
1	1.0	A
4	nan	A
5	nan	B
7	NULL	A

query I
SELECT id FROM iceberg_scan('{TEST_DIR}/nan_{type}_{summary}.metadata.json') WHERE isnan(x) ORDER BY id;
----
4
5

query I
SELECT id FROM iceberg_scan('{TEST_DIR}/nan_{type}_{summary}.metadata.json')
WHERE category = 'A' AND x IS NOT NULL ORDER BY id;
----
1
4

endloop

statement ok
COMMIT;

statement ok
DROP TABLE my_datalake.default.nan_missing_summary;

endloop
