# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/delete/partitions/delete_nan_partition_pruning.test
# description: NaN partition matching must still prune known non-NaN manifests and mismatched later partition fields
# group: [partitions]

require-env CATALOG_TEST_CONFIG_SETUP

require-env SCAN_PLANNING_MODE client

include test/sql/init_requires

statement ok
SET threads = 1;

statement ok
SET enable_external_file_cache = false;

statement ok
CALL enable_logging('Iceberg', storage = 'memory');

statement ok
SET logging_level = 'debug';

foreach type FLOAT DOUBLE

statement ok
CREATE TABLE my_datalake.default.nan_delete_pruning (x {type}, category VARCHAR, id INTEGER)
PARTITIONED BY (x, category) WITH ('format-version' = 2, 'commit.manifest-merge.enabled' = 'false');

# Keep partial deletes and disjoint id bounds so the probe opens only the NaN/B data file.
statement ok
INSERT INTO my_datalake.default.nan_delete_pruning VALUES
	(1, 'A', 1), (2, 'B', 2), (2, 'B', 3), ('NaN', 'A', 5), ('NaN', 'A', 6),
	('NaN', 'B', 8), ('NaN', 'B', 9);

statement ok
DELETE FROM my_datalake.default.nan_delete_pruning WHERE id = 2;

query I
SELECT partition_summaries[1].contains_nan
FROM iceberg_manifests(my_datalake.default.nan_delete_pruning) WHERE content = 1;
----
false

statement ok
CALL truncate_duckdb_logs();

# The id filter selects a NaN data file without pruning the delete manifest by a partition predicate.
# contains_nan=false proves that this manifest cannot apply; it should not be opened.
query I
SELECT id FROM my_datalake.default.nan_delete_pruning WHERE id = 8;
----
8

query I
SELECT count(*) FROM duckdb_logs()
WHERE type = 'Iceberg' AND message.contains('phase=delete_manifest_scan_started');
----
0

statement ok
DELETE FROM my_datalake.default.nan_delete_pruning WHERE id = 5;

query II
SELECT partition_summaries[1].contains_nan, partition_summaries[2].lower_bound
FROM iceberg_manifests(my_datalake.default.nan_delete_pruning) WHERE content = 1 ORDER BY ALL;
----
false	B
true	A

statement ok
CALL truncate_duckdb_logs();

# The new manifest matches x=NaN, but its second partition field is A, not B.
# Matching NaN must continue checking the remaining fields.
query I
SELECT id FROM my_datalake.default.nan_delete_pruning WHERE id = 8;
----
8

query I
SELECT count(*) FROM duckdb_logs()
WHERE type = 'Iceberg' AND message.contains('phase=delete_manifest_scan_started');
----
0

query I
SELECT id FROM my_datalake.default.nan_delete_pruning ORDER BY id;
----
1
3
6
8
9

statement ok
DROP TABLE my_datalake.default.nan_delete_pruning;

endloop
