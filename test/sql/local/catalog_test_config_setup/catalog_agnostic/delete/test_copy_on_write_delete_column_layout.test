# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/delete/test_copy_on_write_delete_column_layout.test
# description: A copy-on-write DELETE keeps the right rows and columns when files span several chunks and table columns are named like the virtual columns
# group: [delete]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

require core_functions

foreach threads 1 4

statement ok
SET threads = {threads};

statement ok
DROP TABLE IF EXISTS my_datalake.default.cow_delete_layout;

# Table columns named like the scan's filename and file_row_number virtual columns, around a regular column
statement ok
CREATE TABLE my_datalake.default.cow_delete_layout (filename VARCHAR, id INTEGER, file_row_number BIGINT)
WITH ('format-version' = '2', 'write.delete.mode' = 'copy-on-write');

# File 1 spans several chunks; files 2 and 3 are small
statement ok
INSERT INTO my_datalake.default.cow_delete_layout SELECT 'f' || i, i, i * 10 FROM range(5000) t(i);

statement ok
INSERT INTO my_datalake.default.cow_delete_layout SELECT 'f' || i, i, i * 10 FROM range(5000, 5010) t(i);

statement ok
INSERT INTO my_datalake.default.cow_delete_layout SELECT 'f' || i, i, i * 10 FROM range(6000, 6010) t(i);

# Rows in each of file 1's chunks (up to 4999 in the last one), and one row of file 2
query I
DELETE FROM my_datalake.default.cow_delete_layout WHERE (id < 5000 AND id % 1000 = 7) OR id IN (4999, 5003);
----
7

query I
SELECT count(*) = 5013
   AND sum(id) = (SELECT sum(i) FROM range(5000) t(i)) - (7 + 1007 + 2007 + 3007 + 4007 + 4999)
                 + (SELECT sum(i) FROM range(5000, 5010) t(i)) - 5003
                 + (SELECT sum(i) FROM range(6000, 6010) t(i))
   AND bool_and(filename = 'f' || id AND file_row_number = id * 10)
FROM my_datalake.default.cow_delete_layout;
----
true

query I
SELECT count(*) FROM my_datalake.default.cow_delete_layout WHERE (id < 5000 AND id % 1000 = 7) OR id IN (4999, 5003);
----
0

# Files 1 and 2 were replaced, file 3 had no matching row and was kept
query I
SELECT count(*) FROM iceberg_metadata(my_datalake.default.cow_delete_layout) WHERE status = 'DELETED';
----
2

query I
SELECT count(*) FROM iceberg_metadata(my_datalake.default.cow_delete_layout) WHERE content != 'DATA';
----
0

statement ok
DROP TABLE my_datalake.default.cow_delete_layout;

endloop

statement ok
RESET threads;
