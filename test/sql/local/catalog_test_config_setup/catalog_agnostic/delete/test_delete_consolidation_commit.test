# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/delete/test_delete_consolidation_commit.test
# description: test integration with iceberg catalog read
# group: [delete]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

include test/sql/init_requires

require core_functions


statement ok
set enable_logging=true

statement ok
set logging_level='debug'

statement ok
drop table if exists my_datalake.default.write_v3_update_and_delete;

statement ok
create table my_datalake.default.write_v3_update_and_delete (
	id INTEGER,
	data VARCHAR
) WITH (
	'format-version' = 3
);

statement ok
begin transaction;

statement ok
insert into my_datalake.default.write_v3_update_and_delete values
	(1, 'a'),
	(2, 'b'),
	(3, 'c'),
	(4, 'd'),
	(5, 'e');

query IIII
select _last_updated_sequence_number, _row_id, id, data from my_datalake.default.write_v3_update_and_delete order by id;
----
NULL	NULL	1	a
NULL	NULL	2	b
NULL	NULL	3	c
NULL	NULL	4	d
NULL	NULL	5	e

# Create the first delete on the table
statement ok
DELETE FROM my_datalake.default.write_v3_update_and_delete
WHERE id IN (2, 4);

query IIII
select _last_updated_sequence_number, _row_id, id, data from my_datalake.default.write_v3_update_and_delete order by id;
----
NULL	NULL	1	a
NULL	NULL	3	c
NULL	NULL	5	e

# Create a new delete that needs to invalidate the existing delete and include its contents
statement ok
DELETE FROM my_datalake.default.write_v3_update_and_delete
WHERE id = 5;

query IIII
select _last_updated_sequence_number, _row_id, id, data from my_datalake.default.write_v3_update_and_delete order by id;
----
NULL	NULL	1	a
NULL	NULL	3	c

# Create a new delete that needs to invalidate the existing delete and include its contents
statement ok
DELETE FROM my_datalake.default.write_v3_update_and_delete
WHERE id = 3;

query IIII
select _last_updated_sequence_number, _row_id, id, data from my_datalake.default.write_v3_update_and_delete order by id;
----
NULL	NULL	1	a

statement ok
commit;

query IIII
select _last_updated_sequence_number, _row_id, id, data from my_datalake.default.write_v3_update_and_delete order by _row_id;
----
1	0	1	a

# Start transaction to keep necessary credentials in scope
statement ok
begin

# Snapshots created within this transaction can share a millisecond timestamp.
statement ok
set variable last_manifest_list = (
	select manifest_list from iceberg_snapshots(
		my_datalake.default.write_v3_update_and_delete
	) order by sequence_number desc
	offset 0 limit 1
)

# The last snapshot keeps two delete manifests: the tombstone for the deletion vector it replaced and
# the new deletion vector. The tombstone-only manifest from the previous snapshot is not carried forward.
query I
select count(*) from read_avro(getvariable('last_manifest_list')) where content = 1;
----
2

statement ok
set variable delete_manifests = (
	select list(manifest_path) from read_avro(getvariable('last_manifest_list')) where content = 1
);

# Per delete manifest: (DELETED entries, live entries). One tombstone-only manifest, one live deletion vector.
query II
select count(*) filter (where status = 2), count(*) filter (where status != 2)
from read_avro(getvariable('delete_manifests'), filename = true)
group by filename
order by all;
----
0	1
1	0

statement ok
abort
