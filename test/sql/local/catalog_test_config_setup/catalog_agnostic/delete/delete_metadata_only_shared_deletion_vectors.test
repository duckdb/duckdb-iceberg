# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/delete/delete_metadata_only_shared_deletion_vectors.test
# description: Dropping a covered partition invalidates only its blob in a shared Puffin file
# group: [delete]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

include test/sql/init_requires

foreach threads 1 4

statement ok
SET threads = {threads};

statement ok
CREATE TABLE my_datalake.default.metadata_only_shared_dvs (p INT, id INT)
PARTITIONED BY (p) WITH ('format-version' = 3);

statement ok
INSERT INTO my_datalake.default.metadata_only_shared_dvs VALUES (1, 10), (1, 11), (2, 20), (2, 21);

# The predicate has a non-partition column, so it writes two vectors into one Puffin file.
query I
DELETE FROM my_datalake.default.metadata_only_shared_dvs WHERE id IN (10, 20);
----
2

query III
SELECT count(*), count(DISTINCT file_path), sum(record_count)
FROM iceberg_metadata(my_datalake.default.metadata_only_shared_dvs)
WHERE content = 'POSITION_DELETES' AND status != 'DELETED';
----
2	1	2

statement ok
BEGIN;

query I
DELETE FROM my_datalake.default.metadata_only_shared_dvs WHERE p = 1;
----
1

# The sibling vector must keep row 20 deleted, including before commit.
query II
SELECT p, id FROM my_datalake.default.metadata_only_shared_dvs ORDER BY p, id;
----
2	21

statement ok
ROLLBACK;

query II
SELECT p, id FROM my_datalake.default.metadata_only_shared_dvs ORDER BY p, id;
----
1	11
2	21

query I
DELETE FROM my_datalake.default.metadata_only_shared_dvs WHERE p = 1;
----
1

query II
SELECT p, id FROM my_datalake.default.metadata_only_shared_dvs ORDER BY p, id;
----
2	21

# One vector is tombstoned and its sibling stays live at the same physical path.
query III
SELECT count(*) FILTER (WHERE status = 'DELETED'),
       count(*) FILTER (WHERE status != 'DELETED'), count(DISTINCT file_path)
FROM iceberg_metadata(my_datalake.default.metadata_only_shared_dvs)
WHERE content = 'POSITION_DELETES';
----
1	1	1

query I
DELETE FROM my_datalake.default.metadata_only_shared_dvs WHERE p = 2;
----
1

query I
SELECT count(*) FROM my_datalake.default.metadata_only_shared_dvs;
----
0

query I
SELECT count(*) FROM iceberg_metadata(my_datalake.default.metadata_only_shared_dvs)
WHERE content = 'POSITION_DELETES' AND status != 'DELETED';
----
0

statement ok
DROP TABLE my_datalake.default.metadata_only_shared_dvs;

endloop

statement ok
RESET threads;
