# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/delete/equality_deletes/test_equality_delete_fast_filter_mixed.test
# description: Compose hash, expression and positional deletes with composite NULL and long string keys
# group: [equality_deletes]

require-env CATALOG_TEST_CONFIG_SETUP

require-env EQUALITY_DELETE_WRITES_ENABLED 1

require avro

require parquet

require iceberg

require httpfs

statement ok
set iceberg_use_server_side_scan_planning=false;

statement ok
set unsafe_and_disabled_for_iceberg_v3_enable_equality_deletes=true;

statement ok
drop table if exists my_datalake.default.eq_fast_mixed;

statement ok
create table my_datalake.default.eq_fast_mixed (id integer, k integer, label varchar, f double);

# Long strings share their prefix but differ beyond the inline string storage.
# Include near misses for every NULL tuple: NULL is a key value, not a wildcard.
statement ok
insert into my_datalake.default.eq_fast_mixed
select id, k, case when label in ('A', 'B') then repeat('prefix-', 20) || label else label end, f
from (values
	(0, 10, 'keep', 0.0),
	(1, 11, 'keep', '-0.0'::double),
	(2, 12, 'keep', 'NaN'::double),
	(3, NULL, 'A', 1.0),
	(4, NULL, 'B', 1.0),
	(5, 1, NULL, 1.0),
	(6, 2, NULL, 1.0),
	(7, NULL, NULL, 1.0),
	(8, 1, '', 1.0),
	(9, 99, 'keep', 1.0),
	(10, 4, 'keep', 1.0),
	(11, 5, 'keep', 1.0),
	(12, NULL, '', 1.0),
	(13, 1, 'A', 1.0),
	(14, 99, 'keep', 'NaN'::double),
	(15, NULL, 'A', 'NaN'::double),
	(16, 77, 'keep', 1.0)
) t(id, k, label, f);

statement ok
delete from my_datalake.default.eq_fast_mixed where k is null and label = repeat('prefix-', 20) || 'A';

statement ok
delete from my_datalake.default.eq_fast_mixed where k = 1 and label is null;

statement ok
delete from my_datalake.default.eq_fast_mixed where k is null and label is null;

# Duplicate keys across files in the same layout must remain idempotent.
statement ok
delete from my_datalake.default.eq_fast_mixed where k = 99;

statement ok
delete from my_datalake.default.eq_fast_mixed where k = 99;

# DOUBLE is deliberately unsupported by the hash path. Its fallback must remove
# NaN and both signs of zero before the hash filter composes its selection.
statement ok
delete from my_datalake.default.eq_fast_mixed where f in (0.0, 'NaN'::double);

statement ok
set unsafe_and_disabled_for_iceberg_v3_enable_equality_deletes=false;

statement ok
delete from my_datalake.default.eq_fast_mixed where id = 10;

query III rowsort
select content, count(*), sum(record_count)
from iceberg_metadata(my_datalake.default.eq_fast_mixed)
where content in ('EQUALITY_DELETES', 'POSITION_DELETES') and status != 'DELETED'
group by content;
----
EQUALITY_DELETES	6	7
POSITION_DELETES	1	1

statement ok
call enable_logging('Iceberg');

foreach fast_filter true false

statement ok
set iceberg_equality_delete_fast_filter={fast_filter};

statement ok
call truncate_duckdb_logs();

# Only project the payload id, leaving every equality field private.
query I
select id from my_datalake.default.eq_fast_mixed order by id;
----
4
6
8
11
12
13
16

# Assert actual partial acceleration, so this cannot pass using fallback alone.
query I
select (count(*) > 0) = {fast_filter}
from duckdb_logs()
where type = 'Iceberg' and message = 'Accelerated 5 of 6 equality-delete files using a hash filter';
----
true

# Exercise an empty selection after fallback, all matches in a hash layout,
# and a selection containing only surviving rows.
query I
select id from my_datalake.default.eq_fast_mixed where id < 3;
----

query I
select id from my_datalake.default.eq_fast_mixed where id in (3, 5, 7, 9, 14, 15);
----

query I
select id from my_datalake.default.eq_fast_mixed where id in (4, 6, 8) order by id;
----
4
6
8

endloop

statement ok
drop table my_datalake.default.eq_fast_mixed;
