# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/delete/equality_deletes/test_equality_delete_null_data_file_pruning.test
# description: Null equality-delete keys prevent unsafe data-file bounds pruning
# group: [equality_deletes]

require-env CATALOG_TEST_CONFIG_SETUP

require-env EQUALITY_DELETE_WRITES_ENABLED 1

require avro

require parquet

require iceberg

require httpfs

statement ok
set unsafe_and_disabled_for_iceberg_v3_enable_equality_deletes=true;

statement ok
set iceberg_use_server_side_scan_planning=false;

statement ok
set threads=1;

statement ok
set disabled_optimizers='column_lifetime,statistics_propagation,join_order';

statement ok
set enable_external_file_cache=false;

statement ok
call enable_logging('Iceberg');

statement ok
drop table if exists my_datalake.default.equality_delete_null_data_file_pruning;

statement ok
create table my_datalake.default.equality_delete_null_data_file_pruning (value integer);

statement ok
insert into my_datalake.default.equality_delete_null_data_file_pruning values (NULL), (0), (1);

# The non-null key gives the delete file bounds [50, 50], disjoint from data bounds [0, 1].
# The NULL key still matches the data file, so those bounds must not prune the equality delete.
statement ok
delete from my_datalake.default.equality_delete_null_data_file_pruning
where value IS NULL or value = 50;

# Verify this took the equality-delete path and materialized both keys.
query II
select content, record_count
from iceberg_metadata(my_datalake.default.equality_delete_null_data_file_pruning)
where content = 'EQUALITY_DELETES' and status != 'DELETED';
----
EQUALITY_DELETES	2

# The non-null key supplies bounds, but a missing null count means "maybe contains NULL".
query III
select lower_bound is not null, upper_bound is not null, null_value_count is null
from iceberg_column_stats(my_datalake.default.equality_delete_null_data_file_pruning)
where file_path like '%equality-deletes.parquet' and column_name = 'value';
----
true	true	true

statement ok
call truncate_duckdb_logs();

# The NULL row is deleted, proving the disjoint non-null bounds did not discard the equality delete.
query II
select count(*), sum(case when value is null then 1 else 0 end)
from my_datalake.default.equality_delete_null_data_file_pruning;
----
2	0

query I
select count(*)
from duckdb_logs()
where type = 'Iceberg' and message.starts_with('Iceberg Equality Delete Pruning');
----
0

statement ok
drop table my_datalake.default.equality_delete_null_data_file_pruning;
