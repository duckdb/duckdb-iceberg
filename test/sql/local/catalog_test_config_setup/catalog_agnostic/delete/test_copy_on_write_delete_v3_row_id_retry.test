# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/delete/test_copy_on_write_delete_v3_row_id_retry.test
# description: A whole-file delete can rebase pending row IDs, while a partial rewrite rejects a conflicting commit
# group: [delete]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

require-env ATOMIC_COMMIT_CONFLICT_SUPPORT true

require-env TIMETRAVEL_SUPPORT

require-env SNAPSHOT_HISTORY_SUPPORT

include test/sql/init_requires

statement ok
DROP TABLE IF EXISTS my_datalake.default.cow_retry_ids;

statement ok
CREATE TABLE my_datalake.default.cow_retry_ids (k INTEGER, part INTEGER) PARTITIONED BY (part)
WITH ('format-version' = '3', 'write.delete.mode' = 'copy-on-write', 'write.delete.isolation-level' = 'snapshot');

statement ok
INSERT INTO my_datalake.default.cow_retry_ids VALUES (10, 0);

statement ok rewriter
BEGIN;

statement ok rewriter
INSERT INTO my_datalake.default.cow_retry_ids VALUES (20, 1), (21, 1), (30, 2);

query I rewriter
DELETE FROM my_datalake.default.cow_retry_ids WHERE part = 1;
----
2

# This writer claims ID 1 before the pending insert and delete can commit.
statement ok writer
INSERT INTO my_datalake.default.cow_retry_ids VALUES (40, 3);

statement ok rewriter
COMMIT;

statement ok
SET VARIABLE retried_append = (
    SELECT snapshot_id FROM iceberg_snapshots(my_datalake.default.cow_retry_ids) WHERE sequence_number = 3
);

statement ok
CREATE TEMP TABLE before_file_removal AS
SELECT k, _row_id AS rid, _last_updated_sequence_number AS seq
FROM my_datalake.default.cow_retry_ids AT (VERSION => getvariable('retried_append'));

query IIII
SELECT count(DISTINCT rid), min(rid), max(rid), count(*) FILTER (WHERE seq IS DISTINCT FROM 3)
FROM before_file_removal WHERE k IN (20, 21, 30);
----
3	2	4	0

# Removing the other partition from the same manifest must preserve the ID assigned to row 30 on retry.
query III
SELECT k, _row_id = rid, _last_updated_sequence_number = seq
FROM my_datalake.default.cow_retry_ids JOIN before_file_removal USING (k) ORDER BY k;
----
10	true	true
30	true	true
40	true	true

statement ok
INSERT INTO my_datalake.default.cow_retry_ids VALUES (50, 2);

# A whole-file delete uses no fresh IDs, and none of the deleted IDs can be used by the next append.
query III
SELECT k, _row_id, _last_updated_sequence_number FROM my_datalake.default.cow_retry_ids WHERE k != 30 ORDER BY k;
----
10	0	1
40	1	2
50	5	5

# A partial rewrite of a committed file is safe to execute alongside a pending append.
# If another writer wins, the whole transaction must fail, including its pending append.
statement ok
INSERT INTO my_datalake.default.cow_retry_ids VALUES (60, 4), (61, 4);

statement ok rewriter
BEGIN;

statement ok rewriter
INSERT INTO my_datalake.default.cow_retry_ids VALUES (70, 5);

query I rewriter
DELETE FROM my_datalake.default.cow_retry_ids WHERE k = 60;
----
1

query III rewriter
SELECT k, _row_id, _last_updated_sequence_number FROM my_datalake.default.cow_retry_ids WHERE k >= 60 ORDER BY k;
----
61	7	6
70	NULL	NULL

statement ok writer
INSERT INTO my_datalake.default.cow_retry_ids VALUES (80, 6);

statement error rewriter
COMMIT;
----
TransactionContext Error

query III
SELECT k, _row_id, _last_updated_sequence_number FROM my_datalake.default.cow_retry_ids WHERE k >= 60 ORDER BY k;
----
60	6	6
61	7	6
80	8	7

query I
SELECT metadata."next-row-id"::BIGINT FROM iceberg_load_table_response(my_datalake.default.cow_retry_ids);
----
9

statement ok
DROP TABLE my_datalake.default.cow_retry_ids;
