# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/delete/test_snapshot_summary_delete_metrics.test
# description: Verify a DELETE populates the standard Iceberg snapshot-summary delete-file metrics (added-delete-files / total-delete-files) via iceberg_load_table_response, and no longer inflates the data-file metrics
# group: [delete]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

require json

statement ok
DROP TABLE IF EXISTS my_datalake.default.test_snapshot_summary_delete_metrics;

# Default (v2) format-version so the delete writes a positional delete file (no v3 upgrade),
# which is supported on every configured catalog.
statement ok
CREATE TABLE my_datalake.default.test_snapshot_summary_delete_metrics (id INTEGER, data VARCHAR);

# Single INSERT -> one data file -> one 'append' snapshot
statement ok
INSERT INTO my_datalake.default.test_snapshot_summary_delete_metrics VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e');

# DELETE two rows from the single data file -> one delete file -> one 'delete' snapshot
statement ok
DELETE FROM my_datalake.default.test_snapshot_summary_delete_metrics WHERE id IN (2, 4);

# Sanity: an append snapshot and a delete snapshot exist.
query I
select count(*) from iceberg_snapshots(my_datalake.default.test_snapshot_summary_delete_metrics);
----
2

# Read the per-snapshot summaries out of the load-table response. Snapshots are selected by
# their operation rather than by array position, because the order of metadata.snapshots is
# not guaranteed across catalogs.
#
# The append snapshot is accounted as a data-only snapshot and seeds total-delete-files at 0.
query III
WITH snaps AS (
    SELECT unnest(json_extract(metadata::JSON, '$.snapshots[*]')) AS snap
    FROM iceberg_load_table_response(my_datalake.default.test_snapshot_summary_delete_metrics)
)
SELECT json_extract_string(snap, '$.summary.operation'),
       json_extract_string(snap, '$.summary."total-data-files"'),
       json_extract_string(snap, '$.summary."total-delete-files"')
FROM snaps
WHERE json_extract_string(snap, '$.summary.operation') = 'append';
----
append	1	0

# The delete snapshot now populates the delete-file metrics, AND does not inflate
# total-data-files (the delete manifest was previously mis-counted as an added data
# file, which would have bumped total-data-files to 2).
#
# Position-delete file counts and record counts are tracked independently.
query IIIIIII
WITH snaps AS (
    SELECT unnest(json_extract(metadata::JSON, '$.snapshots[*]')) AS snap
    FROM iceberg_load_table_response(my_datalake.default.test_snapshot_summary_delete_metrics)
)
SELECT json_extract_string(snap, '$.summary.operation'),
       json_extract_string(snap, '$.summary."total-data-files"'),
       json_extract_string(snap, '$.summary."added-delete-files"'),
       json_extract_string(snap, '$.summary."total-delete-files"'),
       json_extract_string(snap, '$.summary."added-position-delete-files"'),
       json_extract_string(snap, '$.summary."added-position-deletes"'),
       json_extract_string(snap, '$.summary."total-position-deletes"')
FROM snaps
WHERE json_extract_string(snap, '$.summary.operation') = 'delete';
----
delete	1	1	1	1	2	2

statement ok
DROP TABLE my_datalake.default.test_snapshot_summary_delete_metrics;

# A V3 deletion vector contributes one delete file and one DV, while its record count
# contributes to the position-delete record metrics. Replacing a DV must remove the old
# vector and its records before adding the consolidated replacement.
statement ok
DROP TABLE IF EXISTS my_datalake.default.test_snapshot_summary_dv_metrics;

statement ok
CREATE TABLE my_datalake.default.test_snapshot_summary_dv_metrics (id INTEGER, data VARCHAR)
WITH ('format-version' = 3);

statement ok
INSERT INTO my_datalake.default.test_snapshot_summary_dv_metrics
VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e');

statement ok
DELETE FROM my_datalake.default.test_snapshot_summary_dv_metrics WHERE id IN (2, 4);

statement ok
DELETE FROM my_datalake.default.test_snapshot_summary_dv_metrics WHERE id = 5;

# Keep credentials in scope while reading the manifest files.
statement ok
BEGIN;

statement ok
SET VARIABLE latest_dv_snapshot_id = (
	SELECT snapshot_id::BIGINT
	FROM iceberg_snapshots(my_datalake.default.test_snapshot_summary_dv_metrics)
	ORDER BY sequence_number DESC LIMIT 1
);

statement ok
SET VARIABLE latest_dv_manifest_list = (
	SELECT manifest_list
	FROM iceberg_snapshots(my_datalake.default.test_snapshot_summary_dv_metrics)
	ORDER BY sequence_number DESC LIMIT 1
);

statement ok
SET VARIABLE latest_dv_manifest = (
	SELECT manifest_path
	FROM read_avro(getvariable('latest_dv_manifest_list'))
	WHERE content = 1
	  AND added_snapshot_id = getvariable('latest_dv_snapshot_id')
	  AND added_files_count > 0
	LIMIT 1
);

statement ok
SET VARIABLE latest_dv_content_size = (
	SELECT content_size_in_bytes::BIGINT
	FROM (SELECT status, unnest(data_file) FROM read_avro(getvariable('latest_dv_manifest')))
	WHERE status = 1
	LIMIT 1
);

query IIIIIIIIIII
WITH snaps AS (
	SELECT unnest(json_extract(metadata::JSON, '$.snapshots[*]')) AS snap
	FROM iceberg_load_table_response(my_datalake.default.test_snapshot_summary_dv_metrics)
)
SELECT json_extract_string(snap, '$.summary."added-delete-files"')::BIGINT,
       json_extract_string(snap, '$.summary."removed-delete-files"')::BIGINT,
       json_extract_string(snap, '$.summary."total-delete-files"')::BIGINT,
       json_extract_string(snap, '$.summary."added-position-delete-files"')::BIGINT,
       json_extract_string(snap, '$.summary."removed-position-delete-files"')::BIGINT,
       json_extract_string(snap, '$.summary."added-dvs"')::BIGINT,
       json_extract_string(snap, '$.summary."removed-dvs"')::BIGINT,
       json_extract_string(snap, '$.summary."added-position-deletes"')::BIGINT,
       json_extract_string(snap, '$.summary."removed-position-deletes"')::BIGINT,
       json_extract_string(snap, '$.summary."total-position-deletes"')::BIGINT,
       json_extract_string(snap, '$.summary."added-files-size"')::BIGINT =
	       getvariable('latest_dv_content_size')
FROM snaps
WHERE json_extract_string(snap, '$."snapshot-id"')::BIGINT = getvariable('latest_dv_snapshot_id');
----
1	1	1	0	0	1	1	3	2	3	true

statement ok
COMMIT;

statement ok
DROP TABLE my_datalake.default.test_snapshot_summary_dv_metrics;
