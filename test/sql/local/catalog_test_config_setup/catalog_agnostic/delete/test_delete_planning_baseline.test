CREATE OR REPLACE TEMP TABLE keys AS SELECT unnest(['b00000-r000000','b00002-r000000','b00000-r000016','b00002-r000016','b00000-r000032','b00002-r000032','b00000-r000048','b00002-r000048','b00000-r000064','b00002-r000064','b00000-r000080','b00000-r000001','b00002-r000001','b00000-r000017','b00002-r000017','b00000-r000033','b00002-r000033','b00000-r000049','b00002-r000049','b00000-r000065','b00002-r000065','b00000-r000081','b00000-r000002','b00002-r000002','b00000-r000018','b00002-r000018','b00000-r000034','b00002-r000034','b00000-r000050','b00002-r000050','b00000-r000066','b00002-r000066','b00000-r000082','b00000-r000003','b00002-r000003','b00000-r000019','b00002-r000019','b00000-r000035','b00002-r000035','b00000-r000051','b00002-r000051','b00000-r000067','b00002-r000067','b00000-r000083']) AS k;

query I
SELECT count(*) AS result FROM my_datalake.default.metadata_delete_baseline WHERE k IN (SELECT k FROM keys) AND d BETWEEN DATE '2025-01-01' AND DATE '2025-04-21';
