# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/delete/test_delete_planning_baseline.test
# group: [delete]

# Generated by scripts/metadata_performance/generate.py; edit workloads.py.
# Reduced #1654 correctness and physical-layout regression, with no timing gate.
require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

include test/sql/init_requires

require icu

statement ok
SET threads=1;

statement ok
SET iceberg_use_server_side_scan_planning=false;

statement ok
CREATE TABLE my_datalake.default.metadata_delete_baseline (k VARCHAR, d DATE, v BIGINT)
        PARTITIONED BY (month(d)) WITH (
        'format-version'='3', 'commit.manifest-merge.enabled'='false');

statement ok
INSERT INTO my_datalake.default.metadata_delete_baseline
            SELECT printf('b%05d-r%06d', 0, i),
                (DATE '2025-01-01' + to_months((i % 4)::INTEGER))::DATE
                    + ((i // 4 + 0) % 28)::INTEGER, i
            FROM range(112) t(i);

statement ok
INSERT INTO my_datalake.default.metadata_delete_baseline
            SELECT printf('b%05d-r%06d', 1, i),
                (DATE '2025-01-01' + to_months((i % 4)::INTEGER))::DATE
                    + ((i // 4 + 1) % 28)::INTEGER, i
            FROM range(112) t(i);

statement ok
INSERT INTO my_datalake.default.metadata_delete_baseline
            SELECT printf('b%05d-r%06d', 2, i),
                (DATE '2025-01-01' + to_months((i % 4)::INTEGER))::DATE
                    + ((i // 4 + 2) % 28)::INTEGER, i
            FROM range(112) t(i);

statement ok
INSERT INTO my_datalake.default.metadata_delete_baseline
            SELECT printf('b%05d-r%06d', 3, i),
                (DATE '2025-01-01' + to_months((i % 4)::INTEGER))::DATE
                    + ((i // 4 + 3) % 28)::INTEGER, i
            FROM range(112) t(i);

statement ok
DELETE FROM my_datalake.default.metadata_delete_baseline WHERE k IN ('b00000-r000000','b00000-r000001','b00000-r000002','b00000-r000003');

statement ok
BEGIN;

query IIIIII
SELECT
        count(*) FILTER (WHERE manifest_content='DATA' AND status<>'DELETED') AS data_files,
        coalesce(sum(record_count) FILTER (WHERE manifest_content='DATA' AND status<>'DELETED'),0)::BIGINT AS data_rows,
        count(*) FILTER (WHERE manifest_content='DELETE' AND status<>'DELETED') AS live_delete_entries,
        count(DISTINCT manifest_path) FILTER (WHERE manifest_content='DATA') AS data_manifests,
        count(DISTINCT manifest_path) FILTER (WHERE manifest_content='DELETE') AS delete_manifests,
        count(DISTINCT file_path) FILTER (WHERE manifest_content='DELETE' AND status<>'DELETED') AS delete_files
        FROM iceberg_metadata('my_datalake.default.metadata_delete_baseline');
----
16	448	4	4	1	1

statement ok
COMMIT;

query I
SELECT count(*) FROM my_datalake.default.metadata_delete_baseline;
----
444

