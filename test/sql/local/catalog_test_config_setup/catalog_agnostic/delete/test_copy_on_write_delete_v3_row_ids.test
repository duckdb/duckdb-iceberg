# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/delete/test_copy_on_write_delete_v3_row_ids.test
# description: Repeated deletes by Iceberg row ID preserve each survivor's lineage across files and chunks
# group: [delete]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

include test/sql/init_requires

statement ok
DROP TABLE IF EXISTS my_datalake.default.cow_row_ids;

statement ok
CREATE TABLE my_datalake.default.cow_row_ids (k INTEGER, part INTEGER) PARTITIONED BY (part)
WITH ('format-version' = '3', 'write.delete.mode' = 'copy-on-write');

statement ok
INSERT INTO my_datalake.default.cow_row_ids SELECT i, i % 2 FROM range(12288) r(i);

statement ok
INSERT INTO my_datalake.default.cow_row_ids SELECT i, i % 2 FROM range(12288, 24576) r(i);

# Capture the key-to-ID mapping independently of partition and file order.
statement ok
CREATE TEMP TABLE original_lineage AS
SELECT k, _row_id AS rid, _last_updated_sequence_number AS seq FROM my_datalake.default.cow_row_ids;

query III
SELECT count(*), count(DISTINCT rid), count(DISTINCT seq) FROM original_lineage;
----
24576	24576	2

statement ok
PREPARE remove_residue AS DELETE FROM my_datalake.default.cow_row_ids WHERE _row_id % 4 = $1;

# The first execution uses inherited IDs. The second reads stored IDs from the replacement files,
# where removing every fourth row has shifted the physical positions of the survivors.
foreach residue 0 1

query I
EXECUTE remove_residue({residue});
----
6144

query III
WITH expected AS (SELECT * FROM original_lineage WHERE rid % 4 > {residue}),
     actual AS (SELECT k, _row_id AS rid, _last_updated_sequence_number AS seq FROM my_datalake.default.cow_row_ids)
SELECT count(*) FILTER (WHERE a.k IS NULL OR e.k IS NULL),
       count(*) FILTER (WHERE a.rid IS DISTINCT FROM e.rid OR a.seq IS DISTINCT FROM e.seq),
       count(a.rid) - count(DISTINCT a.rid)
FROM expected e FULL JOIN actual a USING (k);
----
0	0	0

endloop

statement ok
DEALLOCATE remove_residue;

statement ok
DROP TABLE my_datalake.default.cow_row_ids;
