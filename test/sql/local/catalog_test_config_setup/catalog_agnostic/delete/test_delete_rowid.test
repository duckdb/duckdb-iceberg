# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/delete/test_delete_rowid.test
# description: test integration with iceberg catalog read
# group: [delete]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires


statement ok
CALL enable_logging('HTTP');

statement ok
set logging_level='debug'

statement ok
drop table if exists my_datalake.default.test_delete_table;

statement ok
create table my_datalake.default.test_delete_table (a int) with ('format-version' = 2);

statement ok
insert into my_datalake.default.test_delete_table select range a from range(1000);

# _row_id is a v3 row lineage column, a v2 table doesn't have it
statement error
delete from my_datalake.default.test_delete_table where _row_id in (0, 2, 4, 6);
