# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/delete/test_copy_on_write_delete_transaction_retry.test
# description: CoW retries rebuild pending manifest identities, and partial rewrites keep the whole transaction non-retryable
# group: [delete]

require-env CATALOG_TEST_CONFIG_SETUP

require-env ATOMIC_COMMIT_CONFLICT_SUPPORT true

require-env METADATA_FILE_READ_SUPPORT

include test/sql/init_requires

statement ok
DROP TABLE IF EXISTS my_datalake.default.cow_pending_retry;

statement ok
CREATE TABLE my_datalake.default.cow_pending_retry (id INTEGER, part INTEGER)
PARTITIONED BY (part) WITH (
    'format-version' = '2',
    'write.delete.mode' = 'copy-on-write',
    'write.delete.isolation-level' = 'snapshot',
    'commit.manifest-merge.enabled' = 'false'
);

statement ok
INSERT INTO my_datalake.default.cow_pending_retry VALUES (0, 0);

# The pending append has two files in the same manifest. Removing one entire
# file needs no replacement rows, but rewriting its manifest must also preserve
# the surviving file's identities. Neither file's scan-time sequence is final.
statement ok rewriter
BEGIN;

statement ok rewriter
INSERT INTO my_datalake.default.cow_pending_retry VALUES (10, 1), (11, 1), (20, 2);

query I rewriter
DELETE FROM my_datalake.default.cow_pending_retry WHERE part = 1;
----
2

statement ok rewriter
INSERT INTO my_datalake.default.cow_pending_retry VALUES (21, 2);

query I rewriter
SELECT id FROM my_datalake.default.cow_pending_retry ORDER BY id;
----
0
20
21

# This takes sequence 2, so the pending append, delete, and final append must
# become sequences 3, 4, and 5 when the commit retries.
statement ok writer
INSERT INTO my_datalake.default.cow_pending_retry VALUES (30, 3);

statement ok rewriter
COMMIT;

query I
SELECT id FROM my_datalake.default.cow_pending_retry ORDER BY id;
----
0
20
21
30

query IIITI
SELECT data_sequence_number, file_sequence_number, manifest_sequence_number, status, record_count
FROM iceberg_metadata(my_datalake.default.cow_pending_retry)
ORDER BY data_sequence_number, status;
----
1	1	1	ADDED	1
2	2	2	ADDED	1
3	3	4	DELETED	2
3	3	4	EXISTING	1
5	5	5	ADDED	1

# Check the explicit identities persisted in the replacement manifest, rather
# than only the values resolved by the metadata reader.
statement ok
BEGIN;

statement ok
SET VARIABLE cow_pending_replacement_manifest = (
    SELECT DISTINCT manifest_path FROM iceberg_metadata(my_datalake.default.cow_pending_retry)
    WHERE manifest_sequence_number = 4
);

query III
SELECT status, sequence_number, file_sequence_number
FROM read_avro(getvariable('cow_pending_replacement_manifest'))
ORDER BY status;
----
0	3	3
2	3	3

statement ok
COMMIT;

# A partial rewrite of pending data must prevent retry even if a later CoW
# delete removes its whole output file and the last operation is an append.
statement ok rewriter
BEGIN;

statement ok rewriter
INSERT INTO my_datalake.default.cow_pending_retry VALUES (40, 4), (41, 4);

query I rewriter
DELETE FROM my_datalake.default.cow_pending_retry WHERE id = 40;
----
1

query I rewriter
DELETE FROM my_datalake.default.cow_pending_retry WHERE id = 41;
----
1

statement ok rewriter
INSERT INTO my_datalake.default.cow_pending_retry VALUES (42, 4);

query I rewriter
SELECT id FROM my_datalake.default.cow_pending_retry ORDER BY id;
----
0
20
21
30
42

statement ok writer
INSERT INTO my_datalake.default.cow_pending_retry VALUES (50, 5);

statement ok
SET VARIABLE cow_pending_before_conflict = (
    SELECT metadata_location FROM iceberg_load_table_response(my_datalake.default.cow_pending_retry)
);

statement error rewriter
COMMIT;
----
TransactionContext Error

query I
SELECT metadata_location = getvariable('cow_pending_before_conflict')
FROM iceberg_load_table_response(my_datalake.default.cow_pending_retry);
----
true

query I
SELECT id FROM my_datalake.default.cow_pending_retry ORDER BY id;
----
0
20
21
30
50

statement ok
DROP TABLE my_datalake.default.cow_pending_retry;
