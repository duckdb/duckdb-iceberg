# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/irc_nested_types.test
# description: test integration with iceberg catalog read
# group: [catalog_agnostic]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

# Reset this small fixture for each test.

statement ok
DROP TABLE IF EXISTS my_datalake.default.nested_types;

statement ok
CREATE TABLE my_datalake.default.nested_types (
    id INTEGER, name VARCHAR, address STRUCT(street VARCHAR, city VARCHAR, zip VARCHAR),
    phone_numbers VARCHAR[], metadata MAP(VARCHAR, VARCHAR)
);

statement ok
INSERT INTO my_datalake.default.nested_types VALUES (
    1, 'Alice', {'street': '123 Main St', 'city': 'Metropolis', 'zip': '12345'},
    ['123-456-7890', '987-654-3210'], MAP {'age': '30', 'membership': 'gold'}
);

statement ok
set enable_logging=true

statement ok
set logging_level='debug'

statement ok
use my_datalake.default;

query IIIII
select * from nested_types
