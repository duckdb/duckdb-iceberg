# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/logging/test_partition_read_logic_month.test
# group: [logging]

require-env CATALOG_TEST_CONFIG_SETUP

require-env SCAN_PLANNING_MODE client

include test/sql/init_requires

require icu

include test/sql/local/catalog_test_config_setup/catalog_agnostic/setup/day_partitioned_table.test_setup

statement ok
SET default_transaction_invalidation_policy='SYNTACTIC_ERRORS_DO_NOT_INVALIDATE';


statement ok
set enable_logging=true

statement ok
SET TimeZone = 'UTC';

statement ok
call enable_logging('Iceberg');

query I
select ts from my_datalake.default.day_partitioned_table where ts = '2025-01-04 00:00:00'::TIMESTAMP;
----
2025-01-04 00:00:00+00
2025-01-04 00:00:00+00
2025-01-04 00:00:00+00

# The first three days must be pruned by the day partition value.
query I
select count(*) from duckdb_logs() where type = 'Iceberg' and regexp_matches(message, '.*skipped.*data_file.*partition column.*with transform.*does not match filter.*ts\s*=\s*''2025-01-04 00:00:00\+00''.*');
----
3
