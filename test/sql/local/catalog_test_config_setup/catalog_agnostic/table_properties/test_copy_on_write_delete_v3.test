# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/table_properties/test_copy_on_write_delete_v3.test
# description: A copy-on-write DELETE on a v3 table keeps the row lineage of every row it rewrites
# group: [table_properties]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

require-env METADATA_FILE_READ_SUPPORT

require-env SNAPSHOT_HISTORY_SUPPORT

require-env TIMETRAVEL_SUPPORT

include test/sql/init_requires

require core_functions

statement ok
DROP TABLE IF EXISTS my_datalake.default.cow_delete_v3;

statement ok
CREATE TABLE my_datalake.default.cow_delete_v3 (id INTEGER, v VARCHAR) WITH (
    'format-version' = '3',
    'write.delete.mode' = 'copy-on-write'
);

# two inserts, so two data files: row IDs 0-2 at sequence number 1, and 3-4 at sequence number 2

statement ok
INSERT INTO my_datalake.default.cow_delete_v3 VALUES (1, 'a'), (2, 'b'), (3, 'c');

statement ok
INSERT INTO my_datalake.default.cow_delete_v3 VALUES (4, 'd'), (5, 'e');

query I
DELETE FROM my_datalake.default.cow_delete_v3 WHERE id = 2;
----
1

# the rows of the rewritten file keep their row ID and last updated sequence number

query IIII
SELECT id, v, _row_id, _last_updated_sequence_number FROM my_datalake.default.cow_delete_v3 ORDER BY id;
----
1	a	0	1
3	c	2	1
4	d	3	2
5	e	4	2

# the file is replaced in an overwrite snapshot, and no deletion vector is written

query T
SELECT operation FROM iceberg_snapshots(my_datalake.default.cow_delete_v3) ORDER BY sequence_number DESC LIMIT 1;
----
overwrite

query I
SELECT count(*) FROM iceberg_metadata(my_datalake.default.cow_delete_v3) WHERE content != 'DATA';
----
0

# the rewritten file stores the lineage of its rows

statement ok
BEGIN;

statement ok
SET VARIABLE cow_delete_v3_file = (SELECT filename FROM my_datalake.default.cow_delete_v3 WHERE id = 1);

query III
SELECT id, _row_id, _last_updated_sequence_number FROM read_parquet(getvariable('cow_delete_v3_file')) ORDER BY id;
----
1	0	1
3	2	1

statement ok
COMMIT;

# the rewritten file still takes a fresh range of row IDs, so a later insert does not reuse an ID

query I
SELECT metadata."next-row-id"::BIGINT FROM iceberg_load_table_response('my_datalake.default.cow_delete_v3');
----
7

statement ok
INSERT INTO my_datalake.default.cow_delete_v3 VALUES (6, 'f');

query III
SELECT _row_id, _last_updated_sequence_number, (SELECT count(DISTINCT _row_id) FROM my_datalake.default.cow_delete_v3)
FROM my_datalake.default.cow_delete_v3 WHERE id = 6;
----
7	4	5

# the previous snapshot still reads the rows as they were

statement ok
SET VARIABLE cow_delete_v3_previous = (
    SELECT snapshot_id FROM iceberg_snapshots(my_datalake.default.cow_delete_v3) WHERE sequence_number = 2);

query III
SELECT id, _row_id, _last_updated_sequence_number
FROM my_datalake.default.cow_delete_v3 AT (VERSION => getvariable('cow_delete_v3_previous')) ORDER BY id;
----
1	0	1
2	1	1
3	2	1
4	3	2
5	4	2

# write.update.mode is not set, so it defaults to merge-on-read: the UPDATE writes deletion vectors for the
# old rows and a new data file. A later copy-on-write DELETE keeps the sequence number of that UPDATE, not
# the one of the rewrite, and the rows the deletion vectors removed stay removed

statement ok
UPDATE my_datalake.default.cow_delete_v3 SET v = upper(v) WHERE id IN (3, 4);

# one deletion vector for each of the two files that held the updated rows

query I
SELECT count(*) FROM iceberg_metadata(my_datalake.default.cow_delete_v3)
WHERE content = 'POSITION_DELETES' AND file_format = 'puffin' AND status != 'DELETED';
----
2

query I
DELETE FROM my_datalake.default.cow_delete_v3 WHERE id IN (4, 5);
----
2

query IIII
SELECT id, v, _row_id, _last_updated_sequence_number FROM my_datalake.default.cow_delete_v3 ORDER BY id;
----
1	a	0	1
3	C	2	5
6	f	7	4

# the deletion vector of the removed file is removed with it
query I
SELECT count(*) FROM iceberg_metadata(my_datalake.default.cow_delete_v3)
WHERE content = 'POSITION_DELETES' AND file_format = 'puffin' AND status != 'DELETED';
----
1

# the UPDATE's snapshot still lists both deletion vectors: time travel to it still sees only the updated versions
# of rows 3 and 4, not the old ones the deletion vectors removed

statement ok
SET VARIABLE cow_delete_v3_update = (
    SELECT snapshot_id FROM iceberg_snapshots(my_datalake.default.cow_delete_v3) WHERE sequence_number = 5);

query IIII
SELECT id, v, _row_id, _last_updated_sequence_number
FROM my_datalake.default.cow_delete_v3 AT (VERSION => getvariable('cow_delete_v3_update')) ORDER BY id;
----
1	a	0	1
3	C	2	5
4	D	3	5
5	e	4	2
6	f	7	4

# a DELETE that matches nothing commits nothing

query I
DELETE FROM my_datalake.default.cow_delete_v3 WHERE id = 42;
----
0

query I
SELECT count(*) FROM iceberg_snapshots(my_datalake.default.cow_delete_v3);
----
6

# within a transaction: committed rows keep their lineage through two rewrites, and a row inserted in the
# transaction has no row ID until the commit assigns one

statement ok
DROP TABLE IF EXISTS my_datalake.default.cow_delete_v3_transaction;

statement ok
CREATE TABLE my_datalake.default.cow_delete_v3_transaction (id INTEGER) WITH (
    'format-version' = '3',
    'write.delete.mode' = 'copy-on-write'
);

statement ok
INSERT INTO my_datalake.default.cow_delete_v3_transaction VALUES (1), (2), (3);

statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.cow_delete_v3_transaction VALUES (4), (5);

query I
DELETE FROM my_datalake.default.cow_delete_v3_transaction WHERE id IN (2, 4);
----
2

query III
SELECT id, _row_id, _last_updated_sequence_number FROM my_datalake.default.cow_delete_v3_transaction ORDER BY id;
----
1	0	1
3	2	1
5	NULL	NULL

query I
DELETE FROM my_datalake.default.cow_delete_v3_transaction WHERE id = 1;
----
1

query III
SELECT id, _row_id, _last_updated_sequence_number FROM my_datalake.default.cow_delete_v3_transaction ORDER BY id;
----
3	2	1
5	NULL	NULL

statement ok
COMMIT;

# after the commit: the committed row keeps its lineage, and the inserted row has a row ID and sequence number.
# The last rewrite writes both rows into one file with first_row_id 8; row 5 is at position 0 or 1 of that file,
# depending on the order the rewrite read the rows in, so its row ID is 8 or 9

query III
SELECT id, CASE WHEN id = 5 THEN (_row_id IN (8, 9))::VARCHAR ELSE _row_id::VARCHAR END, _last_updated_sequence_number
FROM my_datalake.default.cow_delete_v3_transaction ORDER BY id;
----
3	2	1
5	true	4

query IIII
SELECT count(*), count(DISTINCT _row_id), min(_row_id) FILTER (WHERE id = 3),
       min(_last_updated_sequence_number) FILTER (WHERE id = 3)
FROM my_datalake.default.cow_delete_v3_transaction;
----
2	2	2	1

# the inserted row gets an ID from the range of the last rewrite, at that rewrite's sequence number

query II
SELECT _row_id >= 3 AND _row_id < metadata."next-row-id"::BIGINT, _last_updated_sequence_number
FROM my_datalake.default.cow_delete_v3_transaction, iceberg_load_table_response('my_datalake.default.cow_delete_v3_transaction')
WHERE id = 5;
----
true	4

# a rolled back DELETE leaves the rows and the row ID counter as they were

statement ok
SET VARIABLE cow_delete_v3_next_row_id = (
    SELECT metadata."next-row-id"::BIGINT FROM iceberg_load_table_response('my_datalake.default.cow_delete_v3_transaction'));

statement ok
BEGIN;

query I
DELETE FROM my_datalake.default.cow_delete_v3_transaction WHERE id = 5;
----
1

statement ok
ROLLBACK;

query II
SELECT id, _row_id FROM my_datalake.default.cow_delete_v3_transaction WHERE id = 3;
----
3	2

query I
SELECT metadata."next-row-id"::BIGINT = getvariable('cow_delete_v3_next_row_id')
FROM iceberg_load_table_response('my_datalake.default.cow_delete_v3_transaction');
----
true

# a partitioned table: the rows stay in their partition and keep their lineage

statement ok
DROP TABLE IF EXISTS my_datalake.default.cow_delete_v3_partitioned;

statement ok
CREATE TABLE my_datalake.default.cow_delete_v3_partitioned (id INTEGER, part VARCHAR) PARTITIONED BY (part) WITH (
    'format-version' = '3',
    'write.delete.mode' = 'copy-on-write'
);

statement ok
INSERT INTO my_datalake.default.cow_delete_v3_partitioned VALUES (1, 'x'), (2, 'x'), (3, 'y'), (4, 'y');

statement ok
SET VARIABLE cow_delete_v3_lineage = (
    SELECT list({'id': id, 'row_id': _row_id, 'seq': _last_updated_sequence_number} ORDER BY id)
    FROM my_datalake.default.cow_delete_v3_partitioned WHERE id != 1);

query I
DELETE FROM my_datalake.default.cow_delete_v3_partitioned WHERE id = 1;
----
1

query I
SELECT list({'id': id, 'row_id': _row_id, 'seq': _last_updated_sequence_number} ORDER BY id)
    = getvariable('cow_delete_v3_lineage')
FROM my_datalake.default.cow_delete_v3_partitioned;
----
true

query II
SELECT part, count(*) FROM my_datalake.default.cow_delete_v3_partitioned GROUP BY part ORDER BY part;
----
x	1
y	2

query I
SELECT count(*) FROM iceberg_metadata(my_datalake.default.cow_delete_v3_partitioned) WHERE status != 'DELETED';
----
2

# a table upgraded from v2 to v3 in the same transaction: its rows have no row ID before the commit

statement ok
DROP TABLE IF EXISTS my_datalake.default.cow_delete_v3_upgrade;

statement ok
CREATE TABLE my_datalake.default.cow_delete_v3_upgrade (id INTEGER) WITH (
    'format-version' = '2',
    'write.delete.mode' = 'copy-on-write'
);

statement ok
INSERT INTO my_datalake.default.cow_delete_v3_upgrade VALUES (1), (2), (3);

statement ok
BEGIN;

statement ok
ALTER TABLE my_datalake.default.cow_delete_v3_upgrade SET ('format-version' = 3);

query I
DELETE FROM my_datalake.default.cow_delete_v3_upgrade WHERE id = 2;
----
1

query III
SELECT id, _row_id, _last_updated_sequence_number FROM my_datalake.default.cow_delete_v3_upgrade ORDER BY id;
----
1	NULL	NULL
3	NULL	NULL

statement ok
COMMIT;

query III
SELECT count(*), count(DISTINCT _row_id), count(_last_updated_sequence_number)
FROM my_datalake.default.cow_delete_v3_upgrade;
----
2	2	2

statement ok
DROP TABLE my_datalake.default.cow_delete_v3;

statement ok
DROP TABLE my_datalake.default.cow_delete_v3_transaction;

statement ok
DROP TABLE my_datalake.default.cow_delete_v3_partitioned;

statement ok
DROP TABLE my_datalake.default.cow_delete_v3_upgrade;
