# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/table_properties/test_write_format_properties.test
# description: Writes are refused when write.format.default or write.delete.format.default asks for a format other than Parquet
# group: [table_properties]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

include test/sql/init_requires

require core_functions

statement ok
DROP TABLE IF EXISTS my_datalake.default.write_format_orc;

statement ok
CREATE TABLE my_datalake.default.write_format_orc (id INTEGER, v VARCHAR) WITH ('format-version'='2');

statement ok
INSERT INTO my_datalake.default.write_format_orc VALUES (1, 'a'), (2, 'b'), (3, 'c');

statement ok
CALL set_iceberg_table_properties(my_datalake.default.write_format_orc, {'write.format.default': 'orc'});

statement error
INSERT INTO my_datalake.default.write_format_orc VALUES (4, 'd');
----
Cannot write data file with 'write.format.default'='orc': only parquet is supported

# UPDATE, DELETE and MERGE are refused

statement error
UPDATE my_datalake.default.write_format_orc SET v = 'z' WHERE id = 2;
----
Cannot write delete file with 'write.format.default'='orc': only parquet is supported

statement error
DELETE FROM my_datalake.default.write_format_orc WHERE id = 2;
----
Cannot write delete file with 'write.format.default'='orc': only parquet is supported

statement error
MERGE INTO my_datalake.default.write_format_orc AS t USING (SELECT 5 AS id, 'e' AS v) AS s ON t.id = s.id
WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.v);
----
Cannot write data file with 'write.format.default'='orc': only parquet is supported

statement error
CALL iceberg_rewrite_data_files('my_datalake.default.write_format_orc', min_input_files => 1);
----
Cannot write data file with 'write.format.default'='orc': only parquet is supported

# reads still work, and the refused writes publish no snapshot

query II
SELECT id, v FROM my_datalake.default.write_format_orc ORDER BY id;
----
1	a
2	b
3	c

query I
SELECT count(*) FROM iceberg_snapshots(my_datalake.default.write_format_orc);
----
1

# the format is case-insensitive, and Parquet is allowed

statement ok
CALL set_iceberg_table_properties(my_datalake.default.write_format_orc, {'write.format.default': 'PARQUET'});

query I
INSERT INTO my_datalake.default.write_format_orc VALUES (4, 'd');
----
1

# a format set earlier in the same transaction applies

statement ok
BEGIN;

statement ok
ALTER TABLE my_datalake.default.write_format_orc SET ('write.format.default' = 'avro');

statement error
INSERT INTO my_datalake.default.write_format_orc VALUES (5, 'e');
----
Cannot write data file with 'write.format.default'='avro': only parquet is supported

statement ok
ROLLBACK;

# CREATE TABLE AS is refused before the table is created

statement ok
DROP TABLE IF EXISTS my_datalake.default.write_format_ctas;

statement error
CREATE TABLE my_datalake.default.write_format_ctas WITH ('write.format.default' = 'orc') AS SELECT 1 AS id;
----
Cannot write data file with 'write.format.default'='orc': only parquet is supported

statement error
SELECT * FROM my_datalake.default.write_format_ctas;
----
<REGEX>:.*write_format_ctas does not exist.*

# --- V3 tables: deletes are deletion vectors, so only data file writes are refused -------------

statement ok
DROP TABLE IF EXISTS my_datalake.default.write_format_avro_v3;

statement ok
CREATE TABLE my_datalake.default.write_format_avro_v3 (id INTEGER, v VARCHAR) WITH ('format-version'='3');

statement ok
INSERT INTO my_datalake.default.write_format_avro_v3 VALUES (1, 'a'), (2, 'b');

statement ok
CALL set_iceberg_table_properties(my_datalake.default.write_format_avro_v3, {'write.format.default': 'avro'});

statement error
INSERT INTO my_datalake.default.write_format_avro_v3 VALUES (3, 'c');
----
Cannot write data file with 'write.format.default'='avro': only parquet is supported

statement error
UPDATE my_datalake.default.write_format_avro_v3 SET v = 'z' WHERE id = 2;
----
Cannot write data file with 'write.format.default'='avro': only parquet is supported

query I
DELETE FROM my_datalake.default.write_format_avro_v3 WHERE id = 2;
----
1

query II
SELECT id, v FROM my_datalake.default.write_format_avro_v3 ORDER BY id;
----
1	a

statement ok
DROP TABLE IF EXISTS my_datalake.default.write_delete_format;

statement ok
CREATE TABLE my_datalake.default.write_delete_format (id INTEGER, v VARCHAR) WITH ('format-version'='2', 'write.delete.format.default'='orc');

query I
INSERT INTO my_datalake.default.write_delete_format VALUES (1, 'a'), (2, 'b'), (3, 'c');
----
3

statement error
DELETE FROM my_datalake.default.write_delete_format WHERE id = 2;
----
Cannot write delete file with 'write.delete.format.default'='orc': only parquet is supported

statement error
UPDATE my_datalake.default.write_delete_format SET v = 'z' WHERE id = 2;
----
Cannot write delete file with 'write.delete.format.default'='orc': only parquet is supported

statement error
MERGE INTO my_datalake.default.write_delete_format AS t USING (SELECT 2 AS id) AS s ON t.id = s.id
WHEN MATCHED THEN DELETE;
----
Cannot write delete file with 'write.delete.format.default'='orc': only parquet is supported

# an explicit Parquet delete format allows deletes even when data files are not Parquet

statement ok
CALL set_iceberg_table_properties(my_datalake.default.write_delete_format,
    {'write.format.default': 'orc', 'write.delete.format.default': 'parquet'});

query I
DELETE FROM my_datalake.default.write_delete_format WHERE id = 2;
----
1

query II
SELECT id, v FROM my_datalake.default.write_delete_format ORDER BY id;
----
1	a
3	c

statement ok
DROP TABLE my_datalake.default.write_format_orc;

statement ok
DROP TABLE my_datalake.default.write_format_avro_v3;

statement ok
DROP TABLE my_datalake.default.write_delete_format;
