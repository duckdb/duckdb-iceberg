# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/test_show_table_duplicates.test
# description: test integration with iceberg catalog read
# group: [catalog_agnostic]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires


statement ok
DROP TABLE IF EXISTS my_datalake.default.show_table_duplicates;

statement ok
CREATE TABLE my_datalake.default.show_table_duplicates (id INTEGER, nested STRUCT(value INTEGER));

statement ok
set enable_logging=true

statement ok
set logging_level='debug'

query I
SELECT table_name,
FROM information_schema.tables where table_name == 'show_table_duplicates' and table_schema == 'default';
----
show_table_duplicates
