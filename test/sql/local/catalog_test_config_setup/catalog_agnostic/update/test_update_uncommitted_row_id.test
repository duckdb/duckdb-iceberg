statement ok
insert into my_datalake.default.merge_row_id_committed values (1, 'a'), (2, 'b');

statement ok
MERGE INTO my_datalake.default.merge_row_id_committed AS t USING (SELECT 2 AS id, 'm' AS data) AS s ON t.id = s.id WHEN MATCHED THEN UPDATE SET data = s.data;

statement ok
SET VARIABLE files = (SELECT list(file_path) FROM iceberg_metadata('my_datalake.default.merge_row_id_committed') WHERE content = 'DATA');

