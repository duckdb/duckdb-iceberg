statement ok
begin

statement ok
update my_datalake.default.update_row_id_delete_first set data = 'u' where id = 1;

statement ok
insert into my_datalake.default.update_row_id_delete_first values (2, 'b');

statement ok
update my_datalake.default.update_row_id_delete_first set data = 'v' where id = 2;

statement ok
commit

query III
SELECT _row_id, id, data FROM my_datalake.default.update_row_id_delete_first WHERE id < 1000 ORDER BY id;
----
100	1	u
103	2	v

query I
SELECT metadata."next-row-id" FROM iceberg_load_table_response(my_datalake.default.update_row_id_delete_first);
----
104

query I
SELECT (SELECT metadata."next-row-id" FROM iceberg_load_table_response(my_datalake.default.update_row_id_delete_first))
	= (SELECT max(_row_id) FROM my_datalake.default.update_row_id_delete_first) + 1;
----
true

statement ok
insert into my_datalake.default.update_row_id_delete_first values (3, 'c');

query III
SELECT _row_id, id, data FROM my_datalake.default.update_row_id_delete_first WHERE id < 1000 ORDER BY id;
----
100	1	u
103	2	v
104	3	c

query IIIII
SELECT count(*), count(DISTINCT _row_id), min(_row_id), max(_row_id), sum(_row_id) FROM my_datalake.default.update_row_id_delete_first;
----
103	103	0	104	5257

query I
SELECT metadata."next-row-id" FROM iceberg_load_table_response(my_datalake.default.update_row_id_delete_first);
----
105

query I
SELECT (SELECT metadata."next-row-id" FROM iceberg_load_table_response(my_datalake.default.update_row_id_delete_first))
	= (SELECT max(_row_id) FROM my_datalake.default.update_row_id_delete_first) + 1;
----
true

statement ok
DROP TABLE my_datalake.default.update_row_id_delete_first;

