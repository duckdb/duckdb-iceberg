# G1. MERGE updates a row that the transaction inserted and inserts a new row

statement ok
drop table if exists my_datalake.default.merge_row_id_uncommitted;

statement ok
create table my_datalake.default.merge_row_id_uncommitted (id int, data varchar) WITH ('format-version' = 3);

statement ok
insert into my_datalake.default.merge_row_id_uncommitted select range + 1000, 'seed' from range(100);

statement ok
insert into my_datalake.default.merge_row_id_uncommitted values (1, 'a');

statement ok
begin

statement ok
insert into my_datalake.default.merge_row_id_uncommitted values (2, 'b');

statement ok
MERGE INTO my_datalake.default.merge_row_id_uncommitted AS t USING (SELECT 2 AS id, 'm' AS data UNION ALL SELECT 3, 'n') AS s ON t.id = s.id WHEN MATCHED THEN UPDATE SET data = s.data WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.data);

statement ok
commit

statement ok
SET VARIABLE files = (SELECT list(file_path) FROM iceberg_metadata('my_datalake.default.merge_row_id_uncommitted') WHERE content = 'DATA');

query II
SELECT id, _row_id FROM read_parquet(getvariable('files'), union_by_name = true) WHERE data IN ('m', 'n') ORDER BY id;
----
2	NULL
3	NULL

query II
SELECT id, data FROM my_datalake.default.merge_row_id_uncommitted WHERE id < 1000 ORDER BY id;
----
1	a
2	m
3	n

# The order of rows 2 and 3 in the new files depends on the MERGE, so they get 102 and 103 in any order.

query II
SELECT min(_row_id) FILTER (WHERE id = 1), list(_row_id ORDER BY _row_id) FILTER (WHERE id IN (2, 3)) FROM my_datalake.default.merge_row_id_uncommitted;
----
100	[102, 103]

query IIIII
SELECT count(*), count(DISTINCT _row_id), min(_row_id), max(_row_id), sum(_row_id) FROM my_datalake.default.merge_row_id_uncommitted;
----
103	103	0	103	5255

query I
SELECT metadata."next-row-id" FROM iceberg_load_table_response(my_datalake.default.merge_row_id_uncommitted);
----
104

query I
SELECT (SELECT metadata."next-row-id" FROM iceberg_load_table_response(my_datalake.default.merge_row_id_uncommitted))
	= (SELECT max(_row_id) FROM my_datalake.default.merge_row_id_uncommitted) + 1;
----
true

statement ok
DROP TABLE my_datalake.default.merge_row_id_uncommitted;

# G2. MERGE updates a committed row

statement ok
drop table if exists my_datalake.default.merge_row_id_committed;

statement ok
create table my_datalake.default.merge_row_id_committed (id int, data varchar) WITH ('format-version' = 3);

statement ok
