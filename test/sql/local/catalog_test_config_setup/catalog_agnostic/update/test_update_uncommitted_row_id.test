# B'. Seed with gaps (DELETE 10, UPDATE 10), then b. c0 = 110, so the rows get 110 and 112.

statement ok
drop table if exists my_datalake.default.update_row_id_gap_uncommitted;

statement ok
create table my_datalake.default.update_row_id_gap_uncommitted (id int, data varchar) WITH ('format-version' = 3);

statement ok
insert into my_datalake.default.update_row_id_gap_uncommitted select range + 1000, 'seed' from range(100);

statement ok
begin

statement ok
delete from my_datalake.default.update_row_id_gap_uncommitted where id between 1000 and 1009;

statement ok
update my_datalake.default.update_row_id_gap_uncommitted set data = 'g' where id between 1010 and 1019;

statement ok
commit

# 90 live rows. The UPDATE file holds 10 rows with stored _row_id 10-19 and takes row ids 100-109.

query IIIII
SELECT count(*), count(DISTINCT _row_id), min(_row_id), max(_row_id), sum(_row_id) FROM my_datalake.default.update_row_id_gap_uncommitted;
----
90	90	10	99	4905

query I
SELECT metadata."next-row-id" FROM iceberg_load_table_response(my_datalake.default.update_row_id_gap_uncommitted);
----
110

statement ok
SET VARIABLE c0 = (SELECT metadata."next-row-id" FROM iceberg_load_table_response(my_datalake.default.update_row_id_gap_uncommitted));

# Run b on the table with gaps

