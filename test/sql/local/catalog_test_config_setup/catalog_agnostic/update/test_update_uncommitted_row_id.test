statement ok
MERGE INTO my_datalake.default.update_row_id_v2_merge AS t USING (SELECT 4 AS id, 'm' AS data UNION ALL SELECT 5, 'n') AS s ON t.id = s.id WHEN MATCHED THEN UPDATE SET data = s.data WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.data);

statement ok
commit

