# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/update/test_update_uncommitted_row_id.test
# description: Rows that the transaction did not commit yet have no _row_id; committed rows keep their _row_id
# group: [update]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

include test/sql/init_requires

statement ok
create schema if not exists my_datalake.default;

# Each scenario first commits 100 seed rows (id 1000-1099, _row_id 0-99, next-row-id 100).
# Scenario rows have id < 1000. The commit gives the next row ids to all rows of new data files,
# also to rows that keep a stored _row_id. Thus next-row-id is max(_row_id) + 1 only when the last new row has no stored _row_id.

# a. Committed row: UPDATE keeps the stored _row_id

statement ok
drop table if exists my_datalake.default.update_row_id_committed;

statement ok
create table my_datalake.default.update_row_id_committed (id int, data varchar) WITH ('format-version' = 3);

statement ok
insert into my_datalake.default.update_row_id_committed select range + 1000, 'seed' from range(100);

statement ok
insert into my_datalake.default.update_row_id_committed values (1, 'a'), (2, 'b');

statement ok
update my_datalake.default.update_row_id_committed set data = 'x' where id = 2;

statement ok
SET VARIABLE files = (SELECT list(file_path) FROM iceberg_metadata('my_datalake.default.update_row_id_committed') WHERE content = 'DATA');

query II
SELECT id, _row_id FROM read_parquet(getvariable('files'), union_by_name = true) WHERE data = 'x';
----
2	101

query III
SELECT _row_id, id, data FROM my_datalake.default.update_row_id_committed WHERE id < 1000 ORDER BY id;
----
100	1	a
101	2	x

query IIIII
SELECT count(*), count(DISTINCT _row_id), min(_row_id), max(_row_id), sum(_row_id) FROM my_datalake.default.update_row_id_committed;
----
102	102	0	101	5151

# The new file of the UPDATE takes row id 102, but its row keeps _row_id 101

query I
SELECT metadata."next-row-id" FROM iceberg_load_table_response(my_datalake.default.update_row_id_committed);
----
103

statement ok
DROP TABLE my_datalake.default.update_row_id_committed;

statement ok
drop table if exists my_datalake.default.update_row_id_uncommitted;

statement ok
create table my_datalake.default.update_row_id_uncommitted (id int, data varchar) WITH ('format-version' = 3);

statement ok
insert into my_datalake.default.update_row_id_uncommitted select range + 1000, 'seed' from range(100);

# b. Row inserted and updated in one transaction: UPDATE writes a NULL _row_id

statement ok
insert into my_datalake.default.update_row_id_uncommitted values (1, 'a');

statement ok
begin

statement ok
insert into my_datalake.default.update_row_id_uncommitted values (2, 'b');

statement ok
update my_datalake.default.update_row_id_uncommitted set data = 'y' where id = 2;

statement ok
commit

statement ok
SET VARIABLE files = (SELECT list(file_path) FROM iceberg_metadata('my_datalake.default.update_row_id_uncommitted') WHERE content = 'DATA');

query II
SELECT id, _row_id FROM read_parquet(getvariable('files'), union_by_name = true) WHERE data = 'y';
----
2	NULL

query III
SELECT _row_id, id, data FROM my_datalake.default.update_row_id_uncommitted WHERE id < 1000 ORDER BY id;
----
100	1	a
102	2	y

query IIIII
SELECT count(*), count(DISTINCT _row_id), min(_row_id), max(_row_id), sum(_row_id) FROM my_datalake.default.update_row_id_uncommitted;
----
102	102	0	102	5152

query I
SELECT metadata."next-row-id" FROM iceberg_load_table_response(my_datalake.default.update_row_id_uncommitted);
----
103

query I
SELECT count(*) = count(DISTINCT _row_id) FROM my_datalake.default.update_row_id_uncommitted;
----
true

query I
SELECT (SELECT metadata."next-row-id" FROM iceberg_load_table_response(my_datalake.default.update_row_id_uncommitted))
	= (SELECT max(_row_id) FROM my_datalake.default.update_row_id_uncommitted) + 1;
----
true

statement ok
DROP TABLE my_datalake.default.update_row_id_uncommitted;

# c. One UPDATE on a committed row and an uncommitted row

statement ok
drop table if exists my_datalake.default.update_row_id_mixed;

statement ok
create table my_datalake.default.update_row_id_mixed (id int, data varchar) WITH ('format-version' = 3);

statement ok
insert into my_datalake.default.update_row_id_mixed select range + 1000, 'seed' from range(100);

statement ok
insert into my_datalake.default.update_row_id_mixed values (1, 'a');

statement ok
begin

statement ok
insert into my_datalake.default.update_row_id_mixed values (2, 'b');

statement ok
update my_datalake.default.update_row_id_mixed set data = 'z' where id < 1000;

statement ok
commit

statement ok
SET VARIABLE files = (SELECT list(file_path) FROM iceberg_metadata('my_datalake.default.update_row_id_mixed') WHERE content = 'DATA');

query II
SELECT id, _row_id FROM read_parquet(getvariable('files'), union_by_name = true) WHERE data = 'z' ORDER BY id;
----
1	100
2	NULL

# The UPDATE file holds both rows. Their order in the file depends on the scan, so row 2 gets 102 or 103.

query IIT
SELECT id, CASE WHEN id = 2 THEN _row_id IN (102, 103) ELSE _row_id = 100 END, data FROM my_datalake.default.update_row_id_mixed WHERE id < 1000 ORDER BY id;
----
1	true	z
2	true	z

query III
SELECT count(*), count(DISTINCT _row_id), min(_row_id) FROM my_datalake.default.update_row_id_mixed;
----
102	102	0

query I
SELECT metadata."next-row-id" FROM iceberg_load_table_response(my_datalake.default.update_row_id_mixed);
----
104

statement ok
DROP TABLE my_datalake.default.update_row_id_mixed;

# d. A delete manifest earlier in the transaction must not move the row ids of later data files

statement ok
drop table if exists my_datalake.default.update_row_id_delete_first;

statement ok
create table my_datalake.default.update_row_id_delete_first (id int, data varchar) WITH ('format-version' = 3);

