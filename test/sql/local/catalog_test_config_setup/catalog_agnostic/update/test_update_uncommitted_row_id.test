----
0	1	a
2	2	y

query I
SELECT metadata."next-row-id" - getvariable('c0') FROM iceberg_load_table_response(my_datalake.default.update_row_id_gap_uncommitted);
----
3

query I
SELECT count(*) = count(DISTINCT _row_id) FROM my_datalake.default.update_row_id_gap_uncommitted;
----
true

query I
SELECT (SELECT metadata."next-row-id" FROM iceberg_load_table_response(my_datalake.default.update_row_id_gap_uncommitted))
	= (SELECT max(_row_id) FROM my_datalake.default.update_row_id_gap_uncommitted) + 1;
----
true

