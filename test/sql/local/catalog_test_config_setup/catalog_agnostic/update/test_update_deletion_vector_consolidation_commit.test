# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/update/test_update_deletion_vector_consolidation_commit.test
# description: test integration with iceberg catalog read
# group: [update]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

include test/sql/init_requires

require core_functions


statement ok
set enable_logging=true

statement ok
set logging_level='debug'

statement ok
drop table if exists my_datalake.default.tbl;

statement ok
create table my_datalake.default.tbl (
	id INTEGER,
	data VARCHAR
) WITH (
	'format-version' = 3
);

statement ok
begin transaction;

statement ok
insert into my_datalake.default.tbl values
	(1, 'a'),
	(2, 'b'),
	(3, 'c'),
	(4, 'd'),
	(5, 'e');

query IIII
select _last_updated_sequence_number, _row_id, id, data from my_datalake.default.tbl order by id;
----
NULL	NULL	1	a
NULL	NULL	2	b
NULL	NULL	3	c
NULL	NULL	4	d
NULL	NULL	5	e

# Create the first delete on the table
statement ok
UPDATE my_datalake.default.tbl
SET data = data || '_u1'
WHERE id IN (2, 4);

query IIII
select _last_updated_sequence_number, _row_id, id, data from my_datalake.default.tbl order by id;
----
NULL	NULL	1	a
NULL	NULL	2	b_u1
NULL	NULL	3	c
NULL	NULL	4	d_u1
NULL	NULL	5	e

# Create a new delete that needs to invalidate the existing delete and include its contents
statement ok
DELETE FROM my_datalake.default.tbl
WHERE id = 5;

query IIII
select _last_updated_sequence_number, _row_id, id, data from my_datalake.default.tbl order by id;
----
NULL	NULL	1	a
NULL	NULL	2	b_u1
NULL	NULL	3	c
NULL	NULL	4	d_u1

# Create a new delete that needs to invalidate the existing delete and include its contents
statement ok
UPDATE my_datalake.default.tbl
SET data = data || '_u3'
WHERE id IN (1, 4);

query IIII
select _last_updated_sequence_number, _row_id, id, data from my_datalake.default.tbl order by id;
----
NULL	NULL	1	a_u3
NULL	NULL	2	b_u1
NULL	NULL	3	c
NULL	NULL	4	d_u1_u3

statement ok
commit;

query IIII
select _last_updated_sequence_number, _row_id, id, data from my_datalake.default.tbl where id not in (1, 4) order by id;
----
2	5	2	b_u1
1	2	3	c

# Rows 1 and 4 inherit from the final UPDATE's allocation; their file order is unspecified.
query III
select _last_updated_sequence_number, id, data from my_datalake.default.tbl where id in (1, 4) order by id;
----
4	1	a_u3
4	4	d_u1_u3

query II
select list(_row_id order by _row_id), count(distinct _row_id) from my_datalake.default.tbl where id in (1, 4);
----
[7, 8]	2
