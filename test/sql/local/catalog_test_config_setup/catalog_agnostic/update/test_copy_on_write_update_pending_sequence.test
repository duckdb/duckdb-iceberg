# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/update/test_copy_on_write_update_pending_sequence.test
# description: A second copy-on-write UPDATE preserves assigned row IDs and respects pending update sequences
# group: [update]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

include test/sql/init_requires

statement ok
USE my_datalake.default;

statement ok
DROP TABLE IF EXISTS cow_pending_update;

statement ok
CREATE TABLE cow_pending_update (id INTEGER, v INTEGER)
WITH ('format-version' = '3', 'write.update.mode' = 'copy-on-write');

statement ok
INSERT INTO cow_pending_update VALUES (10, 0), (20, 0), (30, 0);

statement ok
PREPARE update_by_row_id AS UPDATE cow_pending_update SET v = v + 1 WHERE _row_id = $1;

statement ok
BEGIN;

query I
EXECUTE update_by_row_id(1);
----
1

query IIII
SELECT id, v, _row_id, _last_updated_sequence_number FROM cow_pending_update ORDER BY id;
----
10	0	0	1
20	1	1	NULL
30	0	2	1

# Row 20 already has an ID, but moving it without updating it would overwrite its pending sequence.
statement error
EXECUTE update_by_row_id(0);
----
Copy-on-write UPDATE cannot preserve uncommitted row lineage

statement ok
ROLLBACK;

query IIII
SELECT id, v, _row_id, _last_updated_sequence_number FROM cow_pending_update ORDER BY id;
----
10	0	0	1
20	0	1	1
30	0	2	1

statement ok
BEGIN;

query I
EXECUTE update_by_row_id(1);
----
1

# The same pending row can be updated again, even after its physical position changed.
query I
EXECUTE update_by_row_id(1);
----
1

statement ok
COMMIT;

query IIII
SELECT id, v, _row_id, _last_updated_sequence_number FROM cow_pending_update ORDER BY id;
----
10	0	0	1
20	2	1	3
30	0	2	1

statement ok
DEALLOCATE update_by_row_id;

statement ok
DROP TABLE cow_pending_update;
