# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/update/basic_update.test
# description: Test ducklake updates
# group: [update]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

require core_functions


statement ok
CALL enable_logging('HTTP');

statement ok
set logging_level='debug'

statement ok
DROP TABLE IF EXISTS my_datalake.default.test;

statement ok
CREATE TABLE my_datalake.default.test AS SELECT 1000 + i id, i % 10 as val FROM range(1000) t(i);

statement ok
BEGIN

query III
SELECT COUNT(*), SUM(id), SUM(val) FROM my_datalake.default.test
----
1000	1499500	4500

query I
UPDATE my_datalake.default.test SET id=id+2 WHERE id%2=0
----
500

query III
SELECT COUNT(*), SUM(id), SUM(val) FROM my_datalake.default.test
----
1000	1500500	4500

statement ok
COMMIT

query III
SELECT COUNT(*), SUM(id), SUM(val) FROM my_datalake.default.test
----
1000	1500500	4500

