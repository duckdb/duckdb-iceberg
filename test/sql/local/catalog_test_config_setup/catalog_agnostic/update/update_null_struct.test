# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/update/update_null_struct.test
# description: NULL struct updates retain the target column type
# group: [update]

require-env CATALOG_TEST_CONFIG_SETUP

require iceberg

foreach version 2 3

statement ok
DROP TABLE IF EXISTS my_datalake.default.null_struct_updates;

statement ok
CREATE TABLE my_datalake.default.null_struct_updates(i INTEGER, s STRUCT(a INTEGER, n STRUCT(b VARCHAR))) WITH ('format-version' = {version});

statement ok
INSERT INTO my_datalake.default.null_struct_updates VALUES (1, {'a': 10, 'n': {'b': 'one'}}), (2, {'a': 20, 'n': {'b': 'two'}});

statement ok
UPDATE my_datalake.default.null_struct_updates SET s = NULL WHERE i = 1;

query II rowsort
SELECT i, s FROM my_datalake.default.null_struct_updates;
----
1	NULL
2	{'a': 20, 'n': {'b': two}}

statement ok
UPDATE my_datalake.default.null_struct_updates SET s = {'a': 30, 'n': NULL} WHERE i = 1;

query II rowsort
SELECT i, s FROM my_datalake.default.null_struct_updates;
----
1	{'a': 30, 'n': NULL}
2	{'a': 20, 'n': {'b': two}}

statement ok
UPDATE my_datalake.default.null_struct_updates SET s = NULL;

query I
SELECT count(*) FROM my_datalake.default.null_struct_updates WHERE s IS NULL;
----
2

statement ok
DROP TABLE my_datalake.default.null_struct_updates;

endloop
