# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/maintenance/rewrite_manifests_v3_row_lineage.test
# description: iceberg_rewrite_manifests keeps V3 row IDs and does not consume new ones.
# group: [maintenance]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

require-env METADATA_FILE_READ_SUPPORT

include test/sql/init_requires

require json

statement ok
DROP TABLE IF EXISTS my_datalake.default.rewrite_manifests_v3_row_lineage;

statement ok
CREATE TABLE my_datalake.default.rewrite_manifests_v3_row_lineage (id INTEGER, category VARCHAR)
PARTITIONED BY (category)
WITH ('format-version' = 3, 'commit.manifest-merge.enabled' = false);

statement ok
INSERT INTO my_datalake.default.rewrite_manifests_v3_row_lineage VALUES (1, 'a'), (2, 'b');

statement ok
INSERT INTO my_datalake.default.rewrite_manifests_v3_row_lineage VALUES (3, 'b'), (4, 'a');

statement ok
INSERT INTO my_datalake.default.rewrite_manifests_v3_row_lineage VALUES (5, 'a'), (6, 'b');

statement ok
SET VARIABLE lineage_before = (
    SELECT list((id, _row_id, _last_updated_sequence_number) ORDER BY id)
    FROM my_datalake.default.rewrite_manifests_v3_row_lineage
);

query II
CALL iceberg_rewrite_manifests('my_datalake.default.rewrite_manifests_v3_row_lineage');
----
3	1

query I
SELECT list((id, _row_id, _last_updated_sequence_number) ORDER BY id) = getvariable('lineage_before')
FROM my_datalake.default.rewrite_manifests_v3_row_lineage;
----
true

# The rewrite assigns no row IDs: next-row-id is unchanged and the snapshot adds no rows.
query II
SELECT
    json_extract_string(metadata::JSON, '$."next-row-id"')::BIGINT,
    (
        SELECT json_extract_string(snap, '$."added-rows"')
        FROM (SELECT unnest(json_extract(metadata::JSON, '$.snapshots[*]')) AS snap)
        ORDER BY json_extract_string(snap, '$."sequence-number"')::BIGINT DESC
        LIMIT 1
    )::BIGINT
FROM iceberg_load_table_response(my_datalake.default.rewrite_manifests_v3_row_lineage);
----
6	0

statement ok
BEGIN;

statement ok
SET VARIABLE rewritten_manifest = (
    SELECT DISTINCT manifest_path FROM iceberg_metadata(my_datalake.default.rewrite_manifests_v3_row_lineage)
);

# Each entry carries its own row-ID range, since it no longer sits at its original manifest position.
query II
SELECT count(*), list(data_file.first_row_id ORDER BY data_file.first_row_id)
FROM read_avro(getvariable('rewritten_manifest'));
----
6	[0, 1, 2, 3, 4, 5]

statement ok
COMMIT;

statement ok
INSERT INTO my_datalake.default.rewrite_manifests_v3_row_lineage VALUES (7, 'a');

query I
SELECT _row_id FROM my_datalake.default.rewrite_manifests_v3_row_lineage WHERE id = 7;
----
6

statement ok
DROP TABLE my_datalake.default.rewrite_manifests_v3_row_lineage;

# A V2 table upgraded in the same transaction: the rewrite materializes the row IDs the upgrade assigns.
statement ok
CREATE TABLE my_datalake.default.rewrite_manifests_v3_row_lineage (id INTEGER, category VARCHAR)
PARTITIONED BY (category)
WITH ('format-version' = 2, 'commit.manifest-merge.enabled' = false);

statement ok
INSERT INTO my_datalake.default.rewrite_manifests_v3_row_lineage VALUES (1, 'a'), (2, 'b');

statement ok
INSERT INTO my_datalake.default.rewrite_manifests_v3_row_lineage VALUES (3, 'a');

statement ok
BEGIN;

statement ok
ALTER TABLE my_datalake.default.rewrite_manifests_v3_row_lineage SET ('format-version' = 3);

query II
CALL iceberg_rewrite_manifests('my_datalake.default.rewrite_manifests_v3_row_lineage');
----
2	1

statement ok
COMMIT;

query I
SELECT list(_row_id ORDER BY _row_id) FROM my_datalake.default.rewrite_manifests_v3_row_lineage;
----
[0, 1, 2]

statement ok
BEGIN;

statement ok
SET VARIABLE rewritten_manifest = (
    SELECT DISTINCT manifest_path FROM iceberg_metadata(my_datalake.default.rewrite_manifests_v3_row_lineage)
);

query TI
SELECT
    (SELECT value FROM avro_metadata(getvariable('rewritten_manifest')) WHERE key = 'format-version'),
    count(data_file.first_row_id)
FROM read_avro(getvariable('rewritten_manifest'));
----
3	3

statement ok
COMMIT;

statement ok
INSERT INTO my_datalake.default.rewrite_manifests_v3_row_lineage VALUES (4, 'b');

query I
SELECT _row_id FROM my_datalake.default.rewrite_manifests_v3_row_lineage WHERE id = 4;
----
3

statement ok
DROP TABLE my_datalake.default.rewrite_manifests_v3_row_lineage;
