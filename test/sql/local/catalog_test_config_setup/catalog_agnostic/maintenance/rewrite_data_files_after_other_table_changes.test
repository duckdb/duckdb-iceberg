# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/maintenance/rewrite_data_files_after_other_table_changes.test
# description: Pending changes to another table don't block iceberg_rewrite_data_files; the transaction commits both tables
# group: [maintenance]

require-env CATALOG_TEST_CONFIG_SETUP

require-env MULTI_TABLE_COMMIT_SUPPORT

include test/sql/init_requires

statement ok
DROP TABLE IF EXISTS my_datalake.default.rewrite_other_pending;

statement ok
DROP TABLE IF EXISTS my_datalake.default.rewrite_other_pending_other;

statement ok
CREATE TABLE my_datalake.default.rewrite_other_pending (id INTEGER) WITH ('format-version' = '2');

statement ok
INSERT INTO my_datalake.default.rewrite_other_pending VALUES (1), (2);

statement ok
INSERT INTO my_datalake.default.rewrite_other_pending VALUES (3), (4);

statement ok
CREATE TABLE my_datalake.default.rewrite_other_pending_other (id INTEGER) WITH ('format-version' = '2');

statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.rewrite_other_pending_other VALUES (1);

query I
SELECT rewritten_data_files_count FROM iceberg_rewrite_data_files('my_datalake.default.rewrite_other_pending', rewrite_all = true);
----
2

statement ok
COMMIT;

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.rewrite_other_pending;
----
[1, 2, 3, 4]

query I
SELECT count(*) FROM iceberg_metadata(my_datalake.default.rewrite_other_pending)
WHERE content = 'DATA' AND status <> 'DELETED';
----
1

query I
SELECT count(*) FROM my_datalake.default.rewrite_other_pending_other;
----
1

statement ok
DROP TABLE my_datalake.default.rewrite_other_pending;

statement ok
DROP TABLE my_datalake.default.rewrite_other_pending_other;
