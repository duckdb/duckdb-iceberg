# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/maintenance/manifest_tombstones_partial_delete.test
# description: Removing grouped deletion vectors records current tombstones while preserving other offsets and snapshot history
# group: [maintenance]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

require-env TIMETRAVEL_SUPPORT

require-env METADATA_FILE_READ_SUPPORT

include test/sql/init_requires

require json

statement ok
CREATE TABLE my_datalake.default.tombstone_partial_delete (id INTEGER, p INTEGER)
PARTITIONED BY (p) WITH ('format-version' = 3, 'commit.manifest-merge.enabled' = false);

statement ok
INSERT INTO my_datalake.default.tombstone_partial_delete SELECT i, i // 3 FROM range(9) t(i);

# All three vectors share a Puffin file, but have distinct content offsets.
statement ok
DELETE FROM my_datalake.default.tombstone_partial_delete WHERE id IN (0, 3, 6);

statement ok
BEGIN;

statement ok
SET VARIABLE original_delete_snapshot = (
	SELECT snapshot_id FROM iceberg_snapshots(my_datalake.default.tombstone_partial_delete)
	WHERE sequence_number = 2
);

statement ok
SET VARIABLE original_delete_manifest = (
	SELECT DISTINCT manifest_path FROM iceberg_metadata(my_datalake.default.tombstone_partial_delete)
	WHERE content = 'POSITION_DELETES'
);

statement ok
CREATE TEMP TABLE original_vectors AS SELECT * FROM read_avro(getvariable('original_delete_manifest'));

query III
SELECT count(*), count(DISTINCT data_file.file_path), count(DISTINCT data_file.content_offset)
FROM original_vectors;
----
3	1	3

statement ok
COMMIT;

statement ok
BEGIN;

# Remove the first and last vectors from the original manifest, retaining its middle entry.
statement ok
DELETE FROM my_datalake.default.tombstone_partial_delete WHERE id IN (1, 7);

# A second snapshot removes that final live entry and drops older tombstones from its replacement.
statement ok
DELETE FROM my_datalake.default.tombstone_partial_delete WHERE id = 4;

statement ok
COMMIT;

statement ok
BEGIN;

statement ok
SET VARIABLE partial_snapshot = (
	SELECT snapshot_id FROM iceberg_snapshots(my_datalake.default.tombstone_partial_delete)
	WHERE sequence_number = 3
);

statement ok
SET VARIABLE partial_list = (
	SELECT manifest_list FROM iceberg_snapshots(my_datalake.default.tombstone_partial_delete)
	WHERE sequence_number = 3
);

statement ok
SET VARIABLE partial_manifests = (
	SELECT list(manifest_path) FROM read_avro(getvariable('partial_list')) WHERE content = 1
);

statement ok
SET VARIABLE original_delete_list = (
	SELECT manifest_list FROM iceberg_snapshots(my_datalake.default.tombstone_partial_delete)
	WHERE sequence_number = 2
);

statement ok
SET VARIABLE original_delete_manifest = (
	SELECT manifest_path FROM read_avro(getvariable('original_delete_list')) WHERE content = 1
);

# The retained entry still has its original snapshot, sequence numbers and Puffin offset.
query IIIII
SELECT count(*), bool_and(e.status = 0), bool_and(e.snapshot_id = getvariable('original_delete_snapshot')),
       bool_and(e.sequence_number = 2), bool_and(e.file_sequence_number = 2)
FROM read_avro(getvariable('partial_manifests')) e JOIN original_vectors o
ON e.data_file.file_path = o.data_file.file_path
AND e.data_file.content_offset = o.data_file.content_offset
WHERE e.status = 0;
----
1	true	true	true	true

query III
SELECT count(*) FILTER (WHERE status = 2), count(*) FILTER (WHERE status <> 2),
       sum(data_file.record_count) FILTER (WHERE status <> 2)
FROM read_avro(getvariable('partial_manifests'));
----
2	3	5

# Engines discover removed delete files from current-snapshot DELETED entries.
# Their deleting snapshot changes, but their original data/file sequences and offsets must survive.
query IIIII
SELECT count(*), bool_and(coalesce(e.snapshot_id, m.added_snapshot_id) = getvariable('partial_snapshot')),
       bool_and(e.sequence_number = 2), bool_and(e.file_sequence_number = 2),
       count(DISTINCT e.data_file.content_offset)
FROM read_avro(getvariable('partial_manifests'), filename = true) e
JOIN read_avro(getvariable('partial_list')) m ON e.filename = m.manifest_path
JOIN original_vectors o ON e.data_file.file_path = o.data_file.file_path
AND e.data_file.content_offset = o.data_file.content_offset
WHERE e.status = 2;
----
2	true	true	true	2

# Later snapshots leave the original manifest unchanged.
query III
SELECT count(*), count(*) FILTER (WHERE status = 1), sum(data_file.record_count)
FROM read_avro(getvariable('original_delete_manifest'));
----
3	3	3

statement ok
COMMIT;

query I
SELECT string_agg(id, ',' ORDER BY id) FROM my_datalake.default.tombstone_partial_delete
AT (VERSION => getvariable('original_delete_snapshot'));
----
1,2,4,5,7,8

query I
SELECT string_agg(id, ',' ORDER BY id) FROM my_datalake.default.tombstone_partial_delete
AT (VERSION => getvariable('partial_snapshot'));
----
2,4,5,8

query I
SELECT string_agg(id, ',' ORDER BY id) FROM my_datalake.default.tombstone_partial_delete;
----
2,5,8

query III
SELECT added_delete_files_count, existing_delete_files_count, deleted_delete_files_count
FROM iceberg_manifests(my_datalake.default.tombstone_partial_delete) WHERE content = 1 ORDER BY ALL;
----
0	0	1
1	0	0
2	0	0

query IIIII
WITH snapshots AS (
	SELECT unnest(metadata::JSON->'snapshots'->'$[*]') AS snap
	FROM iceberg_load_table_response(my_datalake.default.tombstone_partial_delete)
)
SELECT (snap->>'sequence-number')::BIGINT,
       (snap->'summary'->>'removed-delete-files')::BIGINT,
       (snap->'summary'->>'removed-position-deletes')::BIGINT,
       (snap->'summary'->>'total-delete-files')::BIGINT,
       (snap->'summary'->>'total-position-deletes')::BIGINT
FROM snapshots WHERE (snap->>'sequence-number')::BIGINT IN (3, 4) ORDER BY 1;
----
3	2	2	3	5
4	1	1	3	6

# An append prunes the final tombstone-only manifest without removing any live vectors.
statement ok
INSERT INTO my_datalake.default.tombstone_partial_delete VALUES (9, 3);

query III
SELECT count(*) FILTER (WHERE status = 'DELETED'), count(*), sum(record_count)
FROM iceberg_metadata(my_datalake.default.tombstone_partial_delete) WHERE content = 'POSITION_DELETES';
----
0	3	6

statement ok
DROP TABLE my_datalake.default.tombstone_partial_delete;
