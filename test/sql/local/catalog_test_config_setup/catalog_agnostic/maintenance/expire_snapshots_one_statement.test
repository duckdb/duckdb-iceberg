# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/maintenance/expire_snapshots_one_statement.test
# description: Two iceberg_expire_snapshots calls on one table in the same statement: the second one plans from what the first left
# group: [maintenance]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

statement ok
SET threads=4;

statement ok
DROP TABLE IF EXISTS my_datalake.default.expire_one_statement;

statement ok
CREATE TABLE my_datalake.default.expire_one_statement (id INTEGER);

foreach value 1 2 3

statement ok
INSERT INTO my_datalake.default.expire_one_statement VALUES ({value});

endloop

# The two calls run at the same time only because the aggregate is on top: a bare UNION ALL returns its branches in
# order and runs them one after the other. One call expires the two old snapshots, the other finds none left.
query IIII
SELECT count(*), sum(deleted_snapshots), min(retained_snapshots), max(retained_snapshots) FROM (
	SELECT * FROM iceberg_expire_snapshots(
		'my_datalake.default.expire_one_statement', retain_last => 1, older_than => timestamp '2999-01-01')
	UNION ALL
	SELECT * FROM iceberg_expire_snapshots(
		'my_datalake.default.expire_one_statement', retain_last => 1, older_than => timestamp '2999-01-01')
);
----
2	2	1	1

query I
SELECT count(*) FROM iceberg_snapshots('my_datalake.default.expire_one_statement');
----
1

query II
SELECT count(*), sum(id) FROM my_datalake.default.expire_one_statement;
----
3	6

statement ok
DROP TABLE my_datalake.default.expire_one_statement;
