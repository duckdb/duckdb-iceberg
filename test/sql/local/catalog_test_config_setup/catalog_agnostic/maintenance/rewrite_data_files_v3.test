# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/maintenance/rewrite_data_files_v3.test
# description: rewriting V3 data files keeps each row's lineage and removes the deletion vectors of rewritten files
# group: [maintenance]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

include test/sql/init_requires

statement ok
DROP TABLE IF EXISTS my_datalake.default.rewrite_v3;

statement ok
CREATE TABLE my_datalake.default.rewrite_v3 (k INTEGER, v INTEGER) WITH ('format-version' = '3');

statement ok
INSERT INTO my_datalake.default.rewrite_v3 VALUES (1, 0), (2, 0), (3, 0);

statement ok
INSERT INTO my_datalake.default.rewrite_v3 VALUES (4, 0), (5, 0), (6, 0);

statement ok
INSERT INTO my_datalake.default.rewrite_v3 VALUES (7, 0), (8, 0), (9, 0);

# Writes k = 2 to a new file with its _row_id, and a deletion vector for the old row
statement ok
UPDATE my_datalake.default.rewrite_v3 SET v = 1 WHERE k = 2;

statement ok
DELETE FROM my_datalake.default.rewrite_v3 WHERE k = 5;

# Rows of the INSERT files inherit their lineage; k = 2 stores its _row_id and gets the UPDATE's sequence number
query IIII
SELECT k, v, _row_id, _last_updated_sequence_number FROM my_datalake.default.rewrite_v3 ORDER BY k;
----
1	0	0	1
2	1	1	4
3	0	2	1
4	0	3	2
6	0	5	2
7	0	6	3
8	0	7	3
9	0	8	3

query II
SELECT content, count(*) FROM iceberg_metadata('my_datalake.default.rewrite_v3')
WHERE status <> 'DELETED' GROUP BY content ORDER BY content;
----
DATA	4
POSITION_DELETES	2

query I
SELECT metadata."next-row-id"::BIGINT FROM iceberg_load_table_response(my_datalake.default.rewrite_v3);
----
10

query IIIII
CALL iceberg_rewrite_data_files('my_datalake.default.rewrite_v3', rewrite_all := true);
----
4	1	<REGEX>:[1-9][0-9]*	0	2

# SPEC: a rewrite copies every _row_id and _last_updated_sequence_number, inherited or stored
query IIII
SELECT k, v, _row_id, _last_updated_sequence_number FROM my_datalake.default.rewrite_v3 ORDER BY k;
----
1	0	0	1
2	1	1	4
3	0	2	1
4	0	3	2
6	0	5	2
7	0	6	3
8	0	7	3
9	0	8	3

# SPEC: removing a data file also removes its deletion vector
query II
SELECT content, count(*) FROM iceberg_metadata('my_datalake.default.rewrite_v3')
WHERE status <> 'DELETED' GROUP BY content ORDER BY content;
----
DATA	1

query I
SELECT operation FROM iceberg_snapshots(my_datalake.default.rewrite_v3) ORDER BY sequence_number DESC LIMIT 1;
----
replace

# A later change still assigns new rows fresh ids and keeps the copied ones
statement ok
INSERT INTO my_datalake.default.rewrite_v3 VALUES (10, 0);

query I
SELECT (SELECT _row_id FROM my_datalake.default.rewrite_v3 WHERE k = 10) >=
       (SELECT max(_row_id) FROM my_datalake.default.rewrite_v3 WHERE k < 10) + 1;
----
true

query II
SELECT count(*), count(DISTINCT _row_id) FROM my_datalake.default.rewrite_v3;
----
9	9

statement ok
DROP TABLE IF EXISTS my_datalake.default.rewrite_v3;

# One DELETE writes the deletion vectors of two data files into one Puffin file. Rewriting one of them removes only
# that file's vector.
statement ok
DROP TABLE IF EXISTS my_datalake.default.rewrite_v3_shared_puffin;

statement ok
CREATE TABLE my_datalake.default.rewrite_v3_shared_puffin (p VARCHAR, k INTEGER) WITH ('format-version' = '3');

statement ok
ALTER TABLE my_datalake.default.rewrite_v3_shared_puffin SET PARTITIONED BY (p);

statement ok
INSERT INTO my_datalake.default.rewrite_v3_shared_puffin VALUES ('a', 1), ('a', 2), ('b', 3), ('b', 4);

statement ok
INSERT INTO my_datalake.default.rewrite_v3_shared_puffin VALUES ('a', 5), ('a', 6);

statement ok
DELETE FROM my_datalake.default.rewrite_v3_shared_puffin WHERE k IN (1, 3);

query II
SELECT count(*), count(DISTINCT file_path) FROM iceberg_metadata('my_datalake.default.rewrite_v3_shared_puffin')
WHERE content = 'POSITION_DELETES' AND status <> 'DELETED';
----
2	1

query III
SELECT p, k, _row_id FROM my_datalake.default.rewrite_v3_shared_puffin ORDER BY k;
----
a	2	1
b	4	3
a	5	4
a	6	5

# Partition 'b' has one file, fewer than min_input_files, so only partition 'a' is rewritten. Half of that file's rows
# are deleted, so delete_ratio_threshold => 1.0 keeps it from being selected by its deletes.
query III
SELECT rewritten_data_files_count, added_data_files_count, removed_delete_files_count
FROM iceberg_rewrite_data_files('my_datalake.default.rewrite_v3_shared_puffin', min_input_files := 2,
	delete_ratio_threshold := 1.0);
----
2	1	1

query I
SELECT count(*) FROM iceberg_metadata('my_datalake.default.rewrite_v3_shared_puffin')
WHERE content = 'POSITION_DELETES' AND status <> 'DELETED';
----
1

query III
SELECT p, k, _row_id FROM my_datalake.default.rewrite_v3_shared_puffin ORDER BY k;
----
a	2	1
b	4	3
a	5	4
a	6	5

statement ok
DROP TABLE IF EXISTS my_datalake.default.rewrite_v3_shared_puffin;

# A table upgraded from V2: rows written before the upgrade get their ids from the first V3 snapshot, and a V2
# position delete file is removed like a deletion vector
statement ok
DROP TABLE IF EXISTS my_datalake.default.rewrite_v3_upgraded;

statement ok
CREATE TABLE my_datalake.default.rewrite_v3_upgraded (k INTEGER) WITH ('format-version' = 2);

statement ok
INSERT INTO my_datalake.default.rewrite_v3_upgraded VALUES (1), (2), (3);

statement ok
INSERT INTO my_datalake.default.rewrite_v3_upgraded VALUES (4), (5);

statement ok
DELETE FROM my_datalake.default.rewrite_v3_upgraded WHERE k = 2;

statement ok
ALTER TABLE my_datalake.default.rewrite_v3_upgraded SET ('format-version' = 3);

statement ok
INSERT INTO my_datalake.default.rewrite_v3_upgraded VALUES (6);

statement ok
SET VARIABLE upgraded_lineage = (
	SELECT list((k, _row_id, _last_updated_sequence_number) ORDER BY k) FROM my_datalake.default.rewrite_v3_upgraded);

query II
SELECT len(getvariable('upgraded_lineage')), list_bool_and([x[2] IS NOT NULL AND x[3] IS NOT NULL
	FOR x IN getvariable('upgraded_lineage')]);
----
5	true

query IIIII
CALL iceberg_rewrite_data_files('my_datalake.default.rewrite_v3_upgraded', rewrite_all := true);
----
3	1	<REGEX>:[1-9][0-9]*	0	1

query I
SELECT list((k, _row_id, _last_updated_sequence_number) ORDER BY k) = getvariable('upgraded_lineage')
FROM my_datalake.default.rewrite_v3_upgraded;
----
true

query II
SELECT content, count(*) FROM iceberg_metadata('my_datalake.default.rewrite_v3_upgraded')
WHERE status <> 'DELETED' GROUP BY content ORDER BY content;
----
DATA	1

statement ok
DROP TABLE IF EXISTS my_datalake.default.rewrite_v3_upgraded;
