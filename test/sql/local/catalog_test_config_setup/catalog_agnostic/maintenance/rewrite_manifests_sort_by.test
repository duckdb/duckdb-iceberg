# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/maintenance/rewrite_manifests_sort_by.test
# description: iceberg_rewrite_manifests clusters entries by the partition fields named in sort_by.
# group: [maintenance]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

statement ok
DROP TABLE IF EXISTS my_datalake.default.rewrite_manifests_sort_by;

statement ok
CREATE TABLE my_datalake.default.rewrite_manifests_sort_by (id INTEGER, region VARCHAR, kind VARCHAR)
PARTITIONED BY (region, kind)
WITH ('format-version' = 2, 'commit.manifest-merge.enabled' = false);

# Every append writes the four (region, kind) combinations.
loop i 0 2

statement ok
INSERT INTO my_datalake.default.rewrite_manifests_sort_by VALUES
    ({i}, 'east', 'x'), ({i}, 'west', 'x'), ({i}, 'east', 'y'), ({i}, 'west', 'y');

endloop

statement error
CALL iceberg_rewrite_manifests('my_datalake.default.rewrite_manifests_sort_by', sort_by => ['id']);
----
'id' is not a partition field of partition spec 0

statement ok
SET VARIABLE target_size = (
    SELECT sum(length) // 2 + 1 FROM iceberg_manifests(my_datalake.default.rewrite_manifests_sort_by)
);

# Clustering by kind alone puts each kind in its own manifest, with both regions in each.
query II
CALL iceberg_rewrite_manifests('my_datalake.default.rewrite_manifests_sort_by',
    sort_by => ['kind'], target_manifest_size_bytes => getvariable('target_size'));
----
2	2

query III
SELECT kind, count(DISTINCT manifest_path), count(DISTINCT region)
FROM iceberg_metadata(my_datalake.default.rewrite_manifests_sort_by) m
JOIN (SELECT DISTINCT filename, region, kind FROM my_datalake.default.rewrite_manifests_sort_by) t
ON m.file_path = t.filename
GROUP BY kind ORDER BY kind;
----
x	1	2
y	1	2

query I
SELECT count(*) FROM my_datalake.default.rewrite_manifests_sort_by;
----
8

statement ok
DROP TABLE my_datalake.default.rewrite_manifests_sort_by;
