# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/maintenance/rewrite_manifests_basic.test
# description: iceberg_rewrite_manifests repacks a spec's data manifests into partition-clustered ones.
# group: [maintenance]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

require json

statement ok
DROP TABLE IF EXISTS my_datalake.default.rewrite_manifests_basic;

statement ok
CREATE TABLE my_datalake.default.rewrite_manifests_basic (id INTEGER, category VARCHAR)
PARTITIONED BY (category)
WITH ('format-version' = 2, 'commit.manifest-merge.enabled' = false);

# Six appends that each touch two partitions: six manifests, none clustered by partition.
loop i 0 6

statement ok
INSERT INTO my_datalake.default.rewrite_manifests_basic VALUES ({i} * 2, 'a'), ({i} * 2 + 1, 'b');

endloop

query III
SELECT count(*), sum(added_data_files_count), sum(existing_data_files_count)
FROM iceberg_manifests(my_datalake.default.rewrite_manifests_basic);
----
6	12	0

statement ok
SET VARIABLE entries_before = (
    SELECT list((file_path, data_sequence_number, file_sequence_number) ORDER BY file_path)
    FROM iceberg_metadata(my_datalake.default.rewrite_manifests_basic)
);

query II
CALL iceberg_rewrite_manifests('my_datalake.default.rewrite_manifests_basic');
----
6	1

query IIII
SELECT count(*), sum(added_data_files_count), sum(existing_data_files_count), sum(deleted_data_files_count)
FROM iceberg_manifests(my_datalake.default.rewrite_manifests_basic);
----
1	0	12	0

# Every file keeps its sequence numbers and is now an EXISTING entry.
query I
SELECT list((file_path, data_sequence_number, file_sequence_number) ORDER BY file_path) = getvariable('entries_before')
FROM iceberg_metadata(my_datalake.default.rewrite_manifests_basic);
----
true

query I
SELECT DISTINCT status FROM iceberg_metadata(my_datalake.default.rewrite_manifests_basic);
----
EXISTING

query IIIIIII
SELECT
    json_extract_string(snap, '$.summary.operation'),
    json_extract_string(snap, '$.summary."manifests-created"'),
    json_extract_string(snap, '$.summary."manifests-replaced"'),
    json_extract_string(snap, '$.summary."manifests-kept"'),
    json_extract_string(snap, '$.summary."total-data-files"'),
    json_extract_string(snap, '$.summary."total-records"'),
    json_extract_string(snap, '$.summary."added-data-files"')
FROM (
    SELECT unnest(json_extract(metadata::JSON, '$.snapshots[*]')) AS snap
    FROM iceberg_load_table_response(my_datalake.default.rewrite_manifests_basic)
)
ORDER BY json_extract_string(snap, '$."sequence-number"')::BIGINT DESC
LIMIT 1;
----
replace	1	6	0	12	12	NULL

query II
SELECT category, list(id ORDER BY id) FROM my_datalake.default.rewrite_manifests_basic GROUP BY category ORDER BY category;
----
a	[0, 2, 4, 6, 8, 10]
b	[1, 3, 5, 7, 9, 11]

# One manifest that would be rewritten into one manifest is left alone, as in Spark.
query II
CALL iceberg_rewrite_manifests('my_datalake.default.rewrite_manifests_basic');
----
0	0

query I
SELECT count(*) FROM iceberg_snapshots(my_datalake.default.rewrite_manifests_basic);
----
7

# Appends after the rewrite still build on the rewritten manifest.
statement ok
INSERT INTO my_datalake.default.rewrite_manifests_basic VALUES (12, 'a');

query I
SELECT count(*) FROM my_datalake.default.rewrite_manifests_basic;
----
13

statement ok
DROP TABLE my_datalake.default.rewrite_manifests_basic;
