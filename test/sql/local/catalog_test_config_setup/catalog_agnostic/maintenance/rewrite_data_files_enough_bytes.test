# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/maintenance/rewrite_data_files_enough_bytes.test
# description: rewrite when fewer than min_input_files but total bytes meet the target
# group: [maintenance]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

require core_functions

statement ok
drop table if exists my_datalake.default.rewrite_enough_bytes;

statement ok
create table my_datalake.default.rewrite_enough_bytes (id INTEGER, payload VARCHAR);

# Three single-row files: each under the rewrite target, but combined size exceeds it.
# Each payload exceeds the row-group byte target. Keep the row count small so the
# rewrite tests eligibility by input bytes without also triggering file rotation.
statement ok
insert into my_datalake.default.rewrite_enough_bytes
select i, repeat('x', 5000)
from range(1) t(i);

statement ok
insert into my_datalake.default.rewrite_enough_bytes
select i, repeat('y', 5000)
from range(1, 2) t(i);

statement ok
insert into my_datalake.default.rewrite_enough_bytes
select i, repeat('z', 5000)
from range(2, 3) t(i);

query I
select count(*)
from iceberg_metadata('my_datalake.default.rewrite_enough_bytes')
where content = 'DATA' and status <> 'DELETED';
----
3

statement ok
begin

# Verify the input-byte precondition independently of Parquet encoding details.
statement ok
set variable input_file_paths = (
	select list(file_path)
	from iceberg_metadata('my_datalake.default.rewrite_enough_bytes')
	where content = 'DATA' and status <> 'DELETED'
);

statement ok
set variable largest_input_bytes = (
	select max(size)::BIGINT from read_blob(getvariable('input_file_paths'))
);

statement ok
set variable input_bytes = (
	select sum(size)::BIGINT from read_blob(getvariable('input_file_paths'))
);

# Spark requires target > min. Keep every file below min, and the target one byte
# above that min, so the files stay eligible while their combined size still clears
# the byte gate. max stays above the target.
statement ok
set variable min_bytes = getvariable('largest_input_bytes') + 1;

statement ok
set variable target_bytes = getvariable('min_bytes') + 1;

query II
select bool_and(size::BIGINT < getvariable('min_bytes')),
       getvariable('input_bytes') > getvariable('target_bytes')
from read_blob(getvariable('input_file_paths'));
----
true	true

statement ok
commit

# Three files is below min_input_files=5, but combined size is above the target.
query III
call iceberg_rewrite_data_files(
	'my_datalake.default.rewrite_enough_bytes',
	target_file_size_bytes => getvariable('target_bytes'),
	min_file_size_bytes => getvariable('min_bytes'),
	max_file_size_bytes => 1000000000,
	min_input_files => 5
);
----
3	1	<REGEX>:[1-9][0-9]*

query I
select count(*) from my_datalake.default.rewrite_enough_bytes;
----
3

query I
select count(*)
from iceberg_metadata('my_datalake.default.rewrite_enough_bytes')
where content = 'DATA' and status <> 'DELETED';
----
1

# The rewrite commit writes a new manifest; do not hard-code sequence 3 (last insert).
statement ok
begin

statement ok
set variable latest_manifest_sequence = (
	select max(manifest_sequence_number)
	from iceberg_metadata('my_datalake.default.rewrite_enough_bytes')
);

statement ok
set variable file_path = (
	select file_path
	from iceberg_metadata('my_datalake.default.rewrite_enough_bytes')
	where manifest_sequence_number = $latest_manifest_sequence
	and manifest_content = 'DATA'
	and status = 'ADDED'
	limit 1
);

# One row group stays in a single file. That file is at least the target, which sits
# just above the largest input.
query I
select size::BIGINT >= getvariable('target_bytes') and size::BIGINT < 20000
from read_blob($file_path);
----
true

statement ok
commit

statement ok
drop table if exists my_datalake.default.rewrite_enough_bytes;
