# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/partitioning/test_partitioning_pushdown_bucket.test
# description: Test bucket partition pushdown for multiple types (INTEGER, BIGINT, STRING, DATE, DECIMAL, BINARY, TIMESTAMP)
# group: [partitioning]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

require core_functions

require icu

# Reset this small fixture for each test.

statement ok
DROP TABLE IF EXISTS my_datalake.default.bucket_partitioned_integer;

statement ok
CREATE TABLE my_datalake.default.bucket_partitioned_integer (
    id INTEGER,
    value INTEGER,
    name VARCHAR
)
PARTITIONED BY (bucket(4, value)) WITH ('format-version' = '2');

statement ok
INSERT INTO my_datalake.default.bucket_partitioned_integer
VALUES
    (1, 10, 'row_1'),
    (2, 20, 'row_2'),
