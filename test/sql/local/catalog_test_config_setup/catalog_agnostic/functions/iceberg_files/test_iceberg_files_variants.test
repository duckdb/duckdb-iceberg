# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/functions/iceberg_files/test_iceberg_files_variants.test
# description: iceberg_files returns an empty readable_metrics struct when the table has no primitive columns
# group: [iceberg_files]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

require-env VARIANT_SUPPORT

include test/sql/init_requires

statement ok
drop table if exists my_datalake.default.files_variant_only;

statement ok
create table my_datalake.default.files_variant_only WITH ('format-version'='3') as from values
({'age': 20}::VARIANT),
({'age': 30}::VARIANT) t(variant_col);

# A variant column is not primitive, so readable_metrics has no fields
query II
SELECT typeof(readable_metrics), readable_metrics FROM iceberg_files(my_datalake.default.files_variant_only);
----
STRUCT	{}

statement ok
drop table my_datalake.default.files_variant_only;
