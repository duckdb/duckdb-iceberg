# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/test_column_doc_comment.test
# description: Iceberg schema field 'doc' is surfaced as a DuckDB column comment
# group: [catalog_agnostic]

require-env CATALOG_TEST_CONFIG_SETUP

require-env DUCKDB_ICEBERG_HAVE_GENERATED_DATA

require avro

require parquet

require iceberg

require httpfs


statement ok
CALL enable_logging(['HTTP', 'Iceberg']);

statement ok
CALL truncate_duckdb_logs();

# The Iceberg field 'doc' is mapped to the DuckDB column comment. Fields without
# a 'doc' (e.g. 'name') have a NULL comment. Reading the catalog's column list
# lazily loads the table metadata instead of exposing a placeholder column.
query II
select column_name, comment from duckdb_columns()
where database_name = 'my_datalake' and table_name = 'column_doc_comment'
order by column_index;
----
id	Primary identifier
population	Resident count, 2024 census
name	NULL

query I
select count(*) from duckdb_logs()
where type = 'Iceberg'
  and message = 'Lazily loading columns for Iceberg table ''default.column_doc_comment''';
----
1

query I
select count(*) from duckdb_logs_parsed('HTTP')
where request.type = 'GET'
  and request.url like '%/namespaces/default/tables/column_doc_comment';
----
1
