# name: test/sql/local/catalog_test_config_setup/catalog_interop/test_basic_variant.test
# description: test variant reading capabilities
# group: [catalog_interop]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

require-env VARIANT_SUPPORT

include test/sql/init_requires

require core_functions


statement ok
use my_datalake.default;

query I
select count(*) from my_datalake.default.variant_column ;
----
103

query I rowsort expected_res
select * from range(100) UNION ALL VALUES (-123), (123), (256)

query I rowsort expected_res
select * from my_datalake.default.variant_column;
----

query I
select count(*) from my_datalake.default.variant_column where col > 100
----
2

query I
select variant_typeof(col) from my_datalake.default.variant_column limit 1
----
INT8

statement ok
insert into my_datalake.default.variant_column VALUES
	('test'),
	({'d': [1, 2, 3]}),
	(['testing'::VARIANT, 21, true, {'hello': 'world'}])
;

