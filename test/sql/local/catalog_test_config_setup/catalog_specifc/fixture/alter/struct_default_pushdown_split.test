# name: test/sql/local/catalog_test_config_setup/catalog_specifc/fixture/alter/struct_default_pushdown_split.test
# group: [alter]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FIXTURE_SERVER_AVAILABLE

include test/sql/init_requires

statement ok
CREATE SCHEMA IF NOT EXISTS my_datalake.default;

statement ok
SET GLOBAL __iceberg_unsafe_struct_null_default_interp = '{}';

statement ok
DROP TABLE IF EXISTS my_datalake.default.sdp_partitioned_only;

statement ok
CREATE TABLE my_datalake.default.sdp_partitioned_only (id INTEGER, category VARCHAR, payload STRUCT(a VARCHAR)) WITH ('format-version' = 3);

statement ok
ALTER TABLE my_datalake.default.sdp_partitioned_only SET PARTITIONED BY (category);

statement ok
INSERT INTO my_datalake.default.sdp_partitioned_only VALUES (1, 'a', {'a': 'one'});

statement ok
ALTER TABLE my_datalake.default.sdp_partitioned_only ADD COLUMN payload.extra STRUCT(flag BOOLEAN, w INTEGER) DEFAULT {'flag': true, 'w': 7};

query I
SELECT payload.extra.w FROM my_datalake.default.sdp_partitioned_only;
----
7

statement ok
DROP TABLE my_datalake.default.sdp_partitioned_only;

statement ok
DROP TABLE IF EXISTS my_datalake.default.sdp_unpartitioned_only;

statement ok
CREATE TABLE my_datalake.default.sdp_unpartitioned_only (id INTEGER, category VARCHAR, payload STRUCT(a VARCHAR)) WITH ('format-version' = 3);

statement ok
INSERT INTO my_datalake.default.sdp_unpartitioned_only VALUES (1, 'a', {'a': 'one'});

statement ok
ALTER TABLE my_datalake.default.sdp_unpartitioned_only ADD COLUMN payload.extra STRUCT(flag BOOLEAN, w INTEGER) DEFAULT {'flag': true, 'w': 7};

query I
SELECT payload.extra.w FROM my_datalake.default.sdp_unpartitioned_only;
----
7

statement ok
DROP TABLE my_datalake.default.sdp_unpartitioned_only;
