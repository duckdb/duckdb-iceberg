# name: test/sql/local/catalog_test_config_setup/catalog_specifc/polaris/test_delete_consolidation_cleanup_failure.test
# description: Failed file cleanup is logged without preventing transaction rollback
# group: [polaris]

require-env CATALOG_TEST_CONFIG_SETUP polaris

require avro

require parquet

require iceberg

require httpfs

require core_functions


statement ok
set enable_logging=true

statement ok
set logging_level='debug'

statement ok
drop table if exists my_datalake.default.polaris_delete_consolidation_cleanup_failure;

statement ok
create table my_datalake.default.polaris_delete_consolidation_cleanup_failure (
	id INTEGER,
	data VARCHAR
) WITH (
	'format-version' = 3
);

statement ok
insert into my_datalake.default.polaris_delete_consolidation_cleanup_failure values
	(1, 'a'),
	(2, 'b'),
	(3, 'c'),
	(4, 'd'),
	(5, 'e');

query IIII
select _last_updated_sequence_number, _row_id, id, data from my_datalake.default.polaris_delete_consolidation_cleanup_failure order by _row_id;
----
1	0	1	a
1	1	2	b
1	2	3	c
1	3	4	d
1	4	5	e

# Create the first delete on the table
statement ok
UPDATE my_datalake.default.polaris_delete_consolidation_cleanup_failure
SET data = data || '_u1'
WHERE id IN (2, 4);

query IIII
select _last_updated_sequence_number, _row_id, id, data from my_datalake.default.polaris_delete_consolidation_cleanup_failure order by _row_id;
----
1	0	1	a
2	1	2	b_u1
1	2	3	c
2	3	4	d_u1
1	4	5	e

statement ok
begin transaction;

# Create a new delete that needs to invalidate the existing delete and include its contents
statement ok
DELETE FROM my_datalake.default.polaris_delete_consolidation_cleanup_failure
WHERE id IN (3, 5);

query IIII
select _last_updated_sequence_number, _row_id, id, data from my_datalake.default.polaris_delete_consolidation_cleanup_failure order by _row_id;
----
1	0	1	a
2	1	2	b_u1
2	3	4	d_u1

# Create yet another delete in the same transaction
statement ok
DELETE FROM my_datalake.default.polaris_delete_consolidation_cleanup_failure
WHERE id = 2;

# The first transaction's delete should now be skipped, and only the last delete should be used
query IIII
select _last_updated_sequence_number, _row_id, id, data from my_datalake.default.polaris_delete_consolidation_cleanup_failure order by _row_id;
----
1	0	1	a
2	3	4	d_u1

statement ok
abort

# Polaris denies removal of the uncommitted files. Cleanup must report the failure.
query I
select count(*) from duckdb_logs()
where type = 'Iceberg'
and message like 'Iceberg Transaction Cleanup, failed to delete one or more of 2 data_file(s):%'
and regexp_matches(message, 'AccessDenied|403 Forbidden');
----
1

# The aborted deletes must not change the committed contents.
query II
select id, data from my_datalake.default.polaris_delete_consolidation_cleanup_failure order by id;
----
1	a
2	b_u1
3	c
4	d_u1
5	e

statement ok
drop table my_datalake.default.polaris_delete_consolidation_cleanup_failure;
