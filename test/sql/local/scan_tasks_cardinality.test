# name: test/sql/local/scan_tasks_cardinality.test
# description: iceberg_scan_tasks estimates its tasks' record counts, so a default-session join probes it
# group: [local]

include test/sql/init_requires

require json

# Disable caches so the data-column reads below are actual reads.
statement ok
set enable_external_file_cache=false;

statement ok
set parquet_metadata_cache=false;

# Two files of 100,000 rows. The trailing column keeps footer prefetch away from the id column's byte range.
foreach partition 1999 2000

statement ok
copy (select i::integer id, i * 10::bigint payload, i::integer tail from range(100000) t(i))
to '{TEST_DIR}/cardinality_task_{partition}.parquet'
(format parquet, compression uncompressed, row_group_size 100000, dictionary_size_limit 1,
 field_ids {id:1, payload:2, tail:4});

endloop

statement ok
create temp table cardinality_tasks as select
    '{TEST_DIR}/cardinality_task_' || p::varchar || '.parquet' as file_path,
    'PARQUET'::varchar file_format,
    (case p when 1999 then (select size from read_blob('{TEST_DIR}/cardinality_task_1999.parquet'))
     else (select size from read_blob('{TEST_DIR}/cardinality_task_2000.parquet')) end)::bigint file_size_in_bytes,
    100000::bigint record_count, NULL::bigint sequence_number, NULL::bigint first_row_id,
    0::integer partition_spec_id, {'3':p::integer} partition_constants,
    []::struct(file_path varchar, file_format varchar, content integer, file_size_in_bytes bigint,
              record_count bigint, equality_ids integer[], referenced_data_file varchar,
              content_offset bigint, content_size_in_bytes bigint)[] delete_files,
    NULL::bigint snapshot_id, 0::integer schema_id,
    '{"format-version": 3, "table-uuid": "00000000-0000-0000-0000-000000000003", "location": "{TEST_DIR}", "last-updated-ms": 0, "last-column-id": 4, "last-sequence-number": 0, "current-schema-id": 0, "schemas": [{"schema-id": 0, "type": "struct", "fields": [{"id": 1, "name": "id", "required": false, "type": "int"}, {"id": 2, "name": "payload", "required": false, "type": "long"}, {"id": 3, "name": "part", "required": false, "type": "int", "initial-default": 2001}, {"id": 4, "name": "tail", "required": false, "type": "int"}]}], "partition-specs": [{"spec-id": 0, "fields": [{"name": "part", "transform": "identity", "source-id": 3, "field-id": 1000}]}], "default-spec-id": 0, "sort-orders": [{"order-id": 0, "fields": []}], "default-sort-order-id": 0}'::json::variant metadata,
    NULL::struct(id integer, payload bigint, part integer, tail integer) schema
from (values (1999), (2000)) t(p);

statement ok
set variable cardinality_task_list = (select list(t order by file_path) from cardinality_tasks t);

# ---- the estimate ----

# The sum of the tasks' record counts.
query II
explain (format json) select * from iceberg_scan_tasks(getvariable('cardinality_task_list'));
----
physical_plan	<REGEX>:[\s\S]*"name": "ICEBERG_SCAN_TASKS"[\s\S]*"Estimated Cardinality": "200000"[\s\S]*

# One task: its own count.
statement ok
set variable one_task = (select list(t) from cardinality_tasks t where ends_with(file_path, '_1999.parquet'));

query II
explain (format json) select * from iceberg_scan_tasks(getvariable('one_task'));
----
physical_plan	<REGEX>:[\s\S]*"name": "ICEBERG_SCAN_TASKS"[\s\S]*"Estimated Cardinality": "100000"[\s\S]*

# The estimate does not cap the rows: tasks whose counts are too low still return every row of their files.
statement ok
set variable low_count_tasks = (select list(t order by file_path)
                                from (select * replace (10::bigint as record_count) from cardinality_tasks) t);

query II
explain (format json) select * from iceberg_scan_tasks(getvariable('low_count_tasks'));
----
physical_plan	<REGEX>:[\s\S]*"name": "ICEBERG_SCAN_TASKS"[\s\S]*"Estimated Cardinality": "20"[\s\S]*

query II
select count(*), sum(id) from iceberg_scan_tasks(getvariable('low_count_tasks'));
----
200000	9999900000

# A maximum below 21 would let the optimizer remove this LIMIT.
query I
select count(id) from (select id from iceberg_scan_tasks(getvariable('low_count_tasks')) limit 21);
----
21

# Counts whose sum passes the largest BIGINT saturate there. Two of 2^63-1 and one of 2 sum to exactly 2^64, which
# would wrap to 0 (planning only: the files do not hold these rows).
statement ok
set variable huge_count_tasks = (select list(t)
    from (select c.* replace (case when r.range < 2 then 9223372036854775807 else 2 end::bigint as record_count)
          from cardinality_tasks c, range(3) r where ends_with(c.file_path, '_1999.parquet')) t);

query II
explain (format json) select * from iceberg_scan_tasks(getvariable('huge_count_tasks'));
----
physical_plan	<REGEX>:[\s\S]*"name": "ICEBERG_SCAN_TASKS"[\s\S]*"Estimated Cardinality": "9223372036854775807"[\s\S]*

# NULL and a typed empty list both estimate and return zero rows.
statement ok
set variable null_tasks = (select list(t) from cardinality_tasks t where false);

statement ok
set variable empty_tasks = list_slice(getvariable('one_task'), 1, 0);

foreach empty null_tasks empty_tasks

query II
explain (format json) select * from iceberg_scan_tasks(getvariable('{empty}'));
----
physical_plan	<REGEX>:[\s\S]*"name": "ICEBERG_SCAN_TASKS"[\s\S]*"Estimated Cardinality": "0"[\s\S]*

query I
select count(*) from iceberg_scan_tasks(getvariable('{empty}'));
----
0

endloop

# Incomplete descriptors contribute only their usable counts during planning.
statement ok
set variable incomplete_tasks = (select [NULL, struct_update(t, record_count := NULL::bigint),
    struct_update(t, record_count := -1::bigint), struct_update(t, file_path := NULL::varchar),
    struct_update(t, delete_files := cast_to_type(NULL, t.delete_files)), t]
    from cardinality_tasks t where ends_with(file_path, '_1999.parquet'));

query II
explain (format json) select * from iceberg_scan_tasks(getvariable('incomplete_tasks'));
----
physical_plan	<REGEX>:[\s\S]*"name": "ICEBERG_SCAN_TASKS"[\s\S]*"Estimated Cardinality": "300000"[\s\S]*

statement error
select id from iceberg_scan_tasks(getvariable('incomplete_tasks'));
----
non-NULL task structs

# Deletes that name the task's file alone (a deletion vector, or a position delete file referencing one data file)
# are taken off its count; a position delete file without a referenced data file and an equality delete file are
# not, as they say nothing about how many of this file's rows they remove. Deletes past the count clamp at 0.
# Planning only: these delete files do not exist.
statement ok
set variable deleted_tasks = (select list(t order by file_path) from (select * replace (
    case when ends_with(file_path, '_1999.parquet') then [
        {'file_path': '{TEST_DIR}/dv.puffin', 'file_format': 'PUFFIN', 'content': 1, 'file_size_in_bytes': 100,
         'record_count': 30000, 'equality_ids': NULL, 'referenced_data_file': file_path, 'content_offset': 4,
         'content_size_in_bytes': 40},
        {'file_path': '{TEST_DIR}/shared_pos.parquet', 'file_format': 'PARQUET', 'content': 1,
         'file_size_in_bytes': 100, 'record_count': 50000, 'equality_ids': NULL, 'referenced_data_file': NULL,
         'content_offset': NULL, 'content_size_in_bytes': NULL},
        {'file_path': '{TEST_DIR}/eq.parquet', 'file_format': 'PARQUET', 'content': 2, 'file_size_in_bytes': 100,
         'record_count': 50000, 'equality_ids': [1], 'referenced_data_file': NULL, 'content_offset': NULL,
         'content_size_in_bytes': NULL}]
    else [
        {'file_path': '{TEST_DIR}/pos.parquet', 'file_format': 'PARQUET', 'content': 1, 'file_size_in_bytes': 100,
         'record_count': 250000, 'equality_ids': NULL, 'referenced_data_file': file_path, 'content_offset': NULL,
         'content_size_in_bytes': NULL}]
    end::struct(file_path varchar, file_format varchar, content integer, file_size_in_bytes bigint,
                record_count bigint, equality_ids integer[], referenced_data_file varchar,
                content_offset bigint, content_size_in_bytes bigint)[] as delete_files)
  from cardinality_tasks) t);

query II
explain (format json) select * from iceberg_scan_tasks(getvariable('deleted_tasks'));
----
physical_plan	<REGEX>:[\s\S]*"name": "ICEBERG_SCAN_TASKS"[\s\S]*"Estimated Cardinality": "70000"[\s\S]*

# Only the last descriptor has a usable count for a position delete scoped to this data file.
# In particular, a vector for a different file cannot supersede this file's deletes.
statement ok
set variable partial_deletes = (
    with input as (select getvariable('deleted_tasks')[2] as t),
         pos as (select t, t.delete_files[1] as d from input)
    select [struct_update(t, delete_files := [
        NULL, struct_update(d, file_path := NULL::varchar), struct_update(d, file_format := NULL::varchar),
        struct_update(d, content := NULL::integer), struct_update(d, record_count := NULL::bigint),
        struct_update(d, record_count := -1::bigint), struct_update(d, referenced_data_file := NULL::varchar),
        struct_update(d, content := 2, equality_ids := [1]),
        struct_update(d, file_format := 'PUFFIN', referenced_data_file := t.file_path || '.other'),
        struct_update(d, record_count := 7::bigint)
    ])] from pos);

query II
explain (format json) select * from iceberg_scan_tasks(getvariable('partial_deletes'));
----
physical_plan	<REGEX>:[\s\S]*"name": "ICEBERG_SCAN_TASKS"[\s\S]*"Estimated Cardinality": "99993"[\s\S]*

# A prepared statement binds the list it is executed with.
statement ok
prepare scan_tasks_with as select * from iceberg_scan_tasks($1);

query II
explain (format json) execute scan_tasks_with(getvariable('one_task'));
----
physical_plan	<REGEX>:[\s\S]*"name": "ICEBERG_SCAN_TASKS"[\s\S]*"Estimated Cardinality": "100000"[\s\S]*

query II
explain (format json) execute scan_tasks_with(getvariable('cardinality_task_list'));
----
physical_plan	<REGEX>:[\s\S]*"name": "ICEBERG_SCAN_TASKS"[\s\S]*"Estimated Cardinality": "200000"[\s\S]*

statement ok
prepare count_tasks_with as select count(*) from iceberg_scan_tasks($1);

query I
execute count_tasks_with(getvariable('cardinality_task_list'));
----
200000

# ---- a join in a default session ----

# A chosen flag on a small table produces a join filter at execution time. With the estimate the task scan is the
# larger side, so it is probed and receives the filter: the rejected file's partition constant skips its data read.
# No optimizer is disabled. The table has 1,000 rows, so that even after its filter it is estimated at more than the
# one row the task scan was taken for without an estimate, which put the task scan on the build side.
statement ok
create temp table chosen_parts as
select (case when i = 0 then 2000 else -i end)::integer part, i = 0 chosen from range(1000) t(i);

statement ok
create temp table chunk_ranges as
select file_name, coalesce(dictionary_page_offset, data_page_offset) as start_offset,
       coalesce(dictionary_page_offset, data_page_offset) + total_compressed_size as end_offset
from parquet_metadata(['{TEST_DIR}/cardinality_task_1999.parquet', '{TEST_DIR}/cardinality_task_2000.parquet'])
where path_in_schema='id';

statement ok
create temp macro chunk_reads() as table
select r.file_name, count(l.pos) as reads
from chunk_ranges r left join duckdb_logs_parsed('FileSystem') l
on l.op='READ' and l.path=r.file_name
   and l.pos < r.end_offset and l.pos + l.bytes > r.start_offset
group by r.file_name;

foreach multi_file true false

statement ok
set iceberg_enable_multi_file_scan_tasks={multi_file};

foreach threads 1 4

statement ok
set threads={threads};

# The plan probes the task scan: the hash join's first (probe) child is the task scan, its build side the small
# table.
query II
explain (format json) select count(*), sum(s.id)
from iceberg_scan_tasks(getvariable('cardinality_task_list')) s
join chosen_parts d on s.part=d.part
where d.chosen;
----
physical_plan	<REGEX>:[\s\S]*"name": "HASH_JOIN",\s*"children": \[\s*\{\s*"name": "ICEBERG_SCAN_TASKS"[\s\S]*

statement ok
call enable_logging('FileSystem');

statement ok
call truncate_duckdb_logs();

query II
select count(*), sum(s.id)
from iceberg_scan_tasks(getvariable('cardinality_task_list')) s
join chosen_parts d on s.part=d.part
where d.chosen;
----
100000	4999950000

query II
select count(*) filter (where file_name='{TEST_DIR}/cardinality_task_1999.parquet' and reads=0),
       count(*) filter (where file_name='{TEST_DIR}/cardinality_task_2000.parquet' and reads>0)
from chunk_reads();
----
1	1

statement ok
call disable_logging();

# The task list on the other side of the join: the optimizer still probes it, and skips the same data.
query II
explain (format json) select count(*), sum(s.id)
from chosen_parts d
join iceberg_scan_tasks(getvariable('cardinality_task_list')) s on s.part=d.part
where d.chosen;
----
physical_plan	<REGEX>:[\s\S]*"name": "HASH_JOIN",\s*"children": \[\s*\{\s*"name": "ICEBERG_SCAN_TASKS"[\s\S]*

statement ok
call enable_logging('FileSystem');

statement ok
call truncate_duckdb_logs();

query II
select count(*), sum(s.id)
from chosen_parts d
join iceberg_scan_tasks(getvariable('cardinality_task_list')) s on s.part=d.part
where d.chosen;
----
100000	4999950000

query II
select count(*) filter (where file_name='{TEST_DIR}/cardinality_task_1999.parquet' and reads=0),
       count(*) filter (where file_name='{TEST_DIR}/cardinality_task_2000.parquet' and reads>0)
from chunk_reads();
----
1	1

statement ok
call disable_logging();

endloop

endloop

# Negative control: without join filter pushdown the same join reads both files' data, so the skipping above is the
# join filter's.
statement ok
set disabled_optimizers='join_filter_pushdown';

statement ok
call enable_logging('FileSystem');

statement ok
call truncate_duckdb_logs();

query II
select count(*), sum(s.id)
from iceberg_scan_tasks(getvariable('cardinality_task_list')) s
join chosen_parts d on s.part=d.part
where d.chosen;
----
100000	4999950000

query I
select count(*) filter (where reads>0) from chunk_reads();
----
2

statement ok
call disable_logging();

statement ok
reset disabled_optimizers;

# A regression guard: a task list smaller than the other side is built on, as any small scan is: the probe child is the table.
statement ok
create temp table many_parts as select (1999 + (i % 2))::integer part, i % 2 = 1 chosen from range(1000000) t(i);

query II
explain (format json) select count(*)
from iceberg_scan_tasks(getvariable('low_count_tasks')) s
join many_parts d on s.part=d.part;
----
physical_plan	<REGEX>:[\s\S]*"name": "HASH_JOIN",\s*"children": \[\s*\{\s*"name": "SEQ_SCAN"[\s\S]*"name": "ICEBERG_SCAN_TASKS"[\s\S]*
