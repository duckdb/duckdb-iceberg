# name: test/sql/local/partitioning/identity/identity_source_missing_cast.test
# description: Cast partition-backed fields with the scan type and session time zone, including missing ancestors
# group: [identity]

include test/sql/init_requires

require json

require icu

statement ok
SET TimeZone = 'Europe/Amsterdam';

statement ok
CREATE TEMP TABLE cast_partition_rows AS
SELECT * FROM (VALUES
	(1, 42, TIMESTAMPTZ '2020-01-01 23:30:00+00'),
	(2, 1000, TIMESTAMPTZ '2020-06-01 23:30:00+00'),
	(3, NULL, NULL),
	(4, NULL, NULL),
	(5, 9, TIMESTAMPTZ '2020-06-01 23:30:00+00')
) t(id, code, ts);

# Files 1 and 3 have the parent struct but omit its partition source fields.
foreach id 1 3

statement ok
COPY (
	SELECT id, CASE WHEN id = 3 THEN NULL ELSE {'x': id} END AS s
	FROM cast_partition_rows WHERE id = {id}
) TO '{TEST_DIR}/cast_{id}.parquet' (
	FORMAT PARQUET, FIELD_IDS {id: 1, s: {__duckdb_field_id: 2, x: 3}}
);

endloop

# Files 2 and 4 omit the entire struct.
foreach id 2 4

statement ok
COPY (SELECT id FROM cast_partition_rows WHERE id = {id})
TO '{TEST_DIR}/cast_{id}.parquet' (FORMAT PARQUET, FIELD_IDS {id: 1});

endloop

# A file containing the fields must agree with the partition-derived values.
statement ok
COPY (
	SELECT id, {'x': id, 'code': code, 'ts': ts} AS s FROM cast_partition_rows WHERE id = 5
) TO '{TEST_DIR}/cast_5.parquet' (
	FORMAT PARQUET, FIELD_IDS {id: 1, s: {__duckdb_field_id: 2, x: 3, code: 4, ts: 5}}
);

foreach shape field struct mixed

statement ok
COPY (
	SELECT
		1::INTEGER AS status,
		1::BIGINT AS snapshot_id,
		1::BIGINT AS sequence_number,
		1::BIGINT AS file_sequence_number,
		{
			content: 0::INTEGER,
			file_path: filename,
			file_format: 'PARQUET',
			partition: {code: code, ts: ts},
			record_count: 1::BIGINT,
			file_size_in_bytes: size::BIGINT
		} AS data_file
	FROM cast_partition_rows
	JOIN read_blob('{TEST_DIR}/cast_*.parquet') ON regexp_extract(filename, 'cast_([0-9]+)[.]parquet$', 1)::INTEGER = id
	WHERE '{shape}' = 'mixed'
	   OR ('{shape}' = 'field' AND id IN (1, 3))
	   OR ('{shape}' = 'struct' AND id IN (2, 4))
) TO '{TEST_DIR}/cast_{shape}_manifest.avro' (
	FORMAT AVRO,
	METADATA {'schema-id': '0', 'partition-spec-id': '0', 'format-version': '2', 'content': 'data'},
	FIELD_IDS {
		status: 0, snapshot_id: 1, sequence_number: 3, file_sequence_number: 4,
		data_file: {
			__duckdb_field_id: 2, content: 134, file_path: 100, file_format: 101,
			partition: {__duckdb_field_id: 102, code: 1000, ts: 1001},
			record_count: 103, file_size_in_bytes: 104
		}
	}
);

statement ok
COPY (
	SELECT
		'{TEST_DIR}/cast_{shape}_manifest.avro' AS manifest_path,
		(SELECT size FROM read_blob('{TEST_DIR}/cast_{shape}_manifest.avro'))::BIGINT AS manifest_length,
		0::INTEGER AS partition_spec_id,
		0::INTEGER AS content,
		1::BIGINT AS sequence_number,
		1::BIGINT AS min_sequence_number,
		1::BIGINT AS added_snapshot_id
) TO '{TEST_DIR}/cast_{shape}_list.avro' (
	FORMAT AVRO,
	FIELD_IDS {
		manifest_path: 500, manifest_length: 501, partition_spec_id: 502,
		content: 517, sequence_number: 515, min_sequence_number: 516, added_snapshot_id: 503
	}
);

statement ok
COPY (
	SELECT to_json({
		'format-version': 2,
		'table-uuid': 'bb588b10-22c8-4976-b3d9-25410fa402c5',
		'location': '{TEST_DIR}',
		'last-sequence-number': 1,
		'last-updated-ms': 1700000000000,
		'last-column-id': 5,
		'current-schema-id': 0,
		'schemas': [{
			'type': 'struct', 'schema-id': 0,
			'fields': [
				{'id': 1, 'name': 'id', 'required': false, 'type': '"int"'::JSON},
				{'id': 2, 'name': 's', 'required': false, 'type': to_json({
					'type': 'struct', 'fields': [
						{'id': 3, 'name': 'x', 'required': false, 'type': 'int'},
						{'id': 4, 'name': 'code', 'required': false, 'type': 'int'},
						{'id': 5, 'name': 'ts', 'required': false, 'type': 'timestamptz'}
					]
				})}
			]
		}],
		'default-spec-id': 0,
		'partition-specs': [{
			'spec-id': 0, 'fields': [
				{'source-id': 4, 'field-id': 1000, 'name': 'code', 'transform': 'identity'},
				{'source-id': 5, 'field-id': 1001, 'name': 'ts', 'transform': 'identity'}
			]
		}],
		'last-partition-id': 1001,
		'default-sort-order-id': 0,
		'sort-orders': [{'order-id': 0, 'fields': []}],
		'current-snapshot-id': 1,
		'snapshots': [{
			'snapshot-id': 1, 'sequence-number': 1, 'timestamp-ms': 1700000000000,
			'manifest-list': '{TEST_DIR}/cast_{shape}_list.avro',
			'schema-id': 0, 'summary': {'operation': 'append'}
		}]
	})
) TO '{TEST_DIR}/cast_{shape}.metadata.json' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '');

endloop

# The partition values themselves decode with the declared schema types.
query IIT
SELECT id, s.code, s.ts FROM iceberg_scan('{TEST_DIR}/cast_struct.metadata.json') ORDER BY id;
----
2	1000	2020-06-02 01:30:00+02
4	NULL	NULL

# Projecting through an absent struct must use the session's cast functions.
query ITTT
SELECT id, s.code::VARCHAR, s.ts::VARCHAR, s.ts::DATE
FROM iceberg_scan('{TEST_DIR}/cast_struct.metadata.json') ORDER BY id;
----
2	1000	2020-06-02 01:30:00+02	2020-06-02
4	NULL	NULL	NULL

# A missing leaf and a NULL parent need the same result types.
query ITTT
SELECT id, s.code::VARCHAR, s.ts::VARCHAR, s.ts::DATE
FROM iceberg_scan('{TEST_DIR}/cast_field.metadata.json') ORDER BY id;
----
1	42	2020-01-02 00:30:00+01	2020-01-02
3	NULL	NULL	NULL

statement ok
CREATE MACRO cast_direct_scan() AS TABLE FROM iceberg_scan('{TEST_DIR}/cast_mixed.metadata.json');

statement ok
SET VARIABLE cast_tasks = (SELECT list(t) FROM iceberg_scan_plan('{TEST_DIR}/cast_mixed.metadata.json') t);

statement ok
CREATE MACRO cast_task_scan() AS TABLE FROM iceberg_scan_tasks(getvariable('cast_tasks'));

foreach scan cast_direct_scan cast_task_scan

# Multiple projections of one field must retain their independent types.
query IITTTI
SELECT id, s.code, s.code::VARCHAR, s.ts::VARCHAR, s.ts::DATE, s.x FROM {scan}() ORDER BY id;
----
1	42	42	2020-01-02 00:30:00+01	2020-01-02	1
2	1000	1000	2020-06-02 01:30:00+02	2020-06-02	NULL
3	NULL	NULL	NULL	NULL	NULL
4	NULL	NULL	NULL	NULL	NULL
5	9	9	2020-06-02 01:30:00+02	2020-06-02	5

query I
SELECT id FROM {scan}() WHERE s.code::VARCHAR = '1000';
----
2

query I
SELECT id FROM {scan}() WHERE s.ts::DATE = DATE '2020-06-02' ORDER BY id;
----
2
5

query III
SELECT count(*), count(s.code::VARCHAR), count(s.ts::VARCHAR) FROM {scan}();
----
5	3	3

query II
SELECT id, TRY_CAST(s.code AS TINYINT) FROM {scan}() ORDER BY id;
----
1	42
2	NULL
3	NULL
4	NULL
5	9

statement error
SELECT s.code::TINYINT FROM {scan}();
----
out of range

endloop

statement ok
RESET TimeZone;
