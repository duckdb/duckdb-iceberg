# name: test/sql/local/equality_deletes.test
# description: Test equaltiy deletes in an iceberg scan
# group: [local]

require avro

require parquet

require iceberg

require httpfs

# for unpartitioned table:
# create table by spark sql: create table mytable_partitioned(id int,name string,bir date );

# First snapshot:
# insert into mytable values(1,'a',date '2025-01-01'),(2,'b',date '2025-01-02'),(3,'c',date '2025-01-03'),(4,'d',date '2025-01-04');
# Result: [(id=1, name=a, bir=2025-01-01), (id=2, name=b, bir=2025-01-02), (id=3, name=c, bir=2025-01-03), (id=4, name=d, bir=2025-01-04)]

# Second snapshot:
# delete where name=b
# Result: [(id=1, name=a, bir=2025-01-01), (id=3, name=c, bir=2025-01-03), (id=4, name=d, bir=2025-01-04)]

# Third snapshot:
# delete where id = 1
# Result: [ (id=3, name=c, bir=2025-01-03), (id=4, name=d, bir=2025-01-04)]

# Fourth snapshot:
# delete where id = 3 and name = c
# Result: [(id=4, name=d, bir=2025-01-04)]

# Fifth snapshot:
#  insert into mytable values(5,'e',date '2025-01-05'),(6,'f',date '2025-01-06');
# Result:[(id=4, name=d, bir=2025-01-04),(5,'e',date '2025-01-05'),(6,'f',date '2025-01-06')]

# Sixth snapshot:
# delete where  name = f
# Result:[(id=4, name=d, bir=2025-01-04),(5,'e',date '2025-01-05')]


# all
query III
SELECT * FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/equality_deletes/warehouse/mydb/mytable') order by all;
----
4	d	2025-01-04
5	e	2025-01-05

# only equality delete fields
query II
SELECT id,name FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/equality_deletes/warehouse/mydb/mytable') order by all;
----
4	d
5	e

# no equality delete fields
query I
SELECT bir FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/equality_deletes/warehouse/mydb/mytable') order by all;
----
2025-01-04
2025-01-05

# partial equality delete field
query I
SELECT name FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/equality_deletes/warehouse/mydb/mytable') order by all;
----
d
e

# partial equality delete field and other
query II
SELECT name,bir FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/equality_deletes/warehouse/mydb/mytable') order by all;
----
d	2025-01-04
e	2025-01-05

# contain metadata
query II
SELECT filename[17:32], name FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/equality_deletes/warehouse/mydb/mytable') order by all;
----
equality_deletes	d
equality_deletes	e

query I
SELECT count(*) FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/equality_deletes/warehouse/mydb/mytable');
----
2

# Live equality deletes disable late materialization.
statement ok
SET late_materialization_max_rows = 1;

statement ok
SET explain_output = 'optimized_only';

query II
EXPLAIN (FORMAT JSON) SELECT *
FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/equality_deletes/warehouse/mydb/mytable')
ORDER BY id
LIMIT 1;
----
logical_opt	<!REGEX>:(?s).*COMPARISON_JOIN.*

statement ok
RESET explain_output;

statement ok
RESET late_materialization_max_rows;

# Equality deletes are a scan correctness requirement and must not depend on an optimizer extension.
statement ok
PRAGMA disable_optimizer;

query I
SELECT bir FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/equality_deletes/warehouse/mydb/mytable') ORDER BY ALL;
----
2025-01-04
2025-01-05

query I
SELECT count(*) FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/equality_deletes/warehouse/mydb/mytable');
----
2

query I
SELECT count(*)
FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/equality_deletes/warehouse/mydb/mytable')
WHERE bir >= DATE '2025-01-01';
----
2

# `id` is used only by the pushed filter and is not part of the output projection.
query I
SELECT bir
FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/equality_deletes/warehouse/mydb/mytable')
WHERE id = 4;
----
2025-01-04

statement ok
PRAGMA enable_optimizer;

# Equality-delete key discovery must remain correct after complex and dynamic filter pushdown.
# The static and runtime predicates deliberately target the same column.
statement ok
SET disabled_optimizers = 'join_order,build_side_probe_side';

query II
SELECT scan.id, scan.name
FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/equality_deletes/warehouse/mydb/mytable') scan
JOIN (VALUES (1), (4), (5), (6)) filter_ids(id) USING (id)
WHERE scan.id >= 4
ORDER BY ALL;
----
4	d
5	e

statement ok
SET disabled_optimizers = '';

# for partitioned table:
# create table  :  mytable_partitioned(id int,name string,bir date ) partitioned by (name);

# First snapshot:
# insert into mytable_partitioned values(1,'a',date '2025-01-01'),(2,'b',date '2025-01-02'),(3,'c',date '2025-01-03'),(4,'d',date '2025-01-04');
# Result: [(id=1, name=a, bir=2025-01-01), (id=2, name=b, bir=2025-01-02), (id=3, name=c, bir=2025-01-03), (id=4, name=d, bir=2025-01-04)]

# Second snapshot:
# delete where name=b
# Result: [(id=1, name=a, bir=2025-01-01), (id=3, name=c, bir=2025-01-03), (id=4, name=d, bir=2025-01-04)]

# Third snapshot:
# delete where id = 3 and name = c
# Result: [(id=1, name=a, bir=2025-01-01), (id=4, name=d, bir=2025-01-04)]

# Fourth snapshot:
#  insert into mytable_partitioned values(5,'e',date '2025-01-05'),(6,'f',date '2025-01-06');
# Result:[(id=1, name=a, bir=2025-01-01), (id=4, name=d, bir=2025-01-04), (5,'e',date '2025-01-05'),(6,'f',date '2025-01-06')]

# Fifth snapshot:
# delete where  name = f
# Result:[(id=1, name=a, bir=2025-01-01), (id=4, name=d, bir=2025-01-04), (5,'e',date '2025-01-05')]

# only equality delete fields
query I
SELECT name FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/equality_deletes/warehouse/mydb/mytable_partitioned') order by all;
----
a
d
e

# no equality delete field
query I
SELECT id FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/equality_deletes/warehouse/mydb/mytable_partitioned') order by all;
----
1
4
5

# partial equality delete field and other
query II
SELECT name,bir FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/equality_deletes/warehouse/mydb/mytable_partitioned') order by all;
----
a	2025-01-01
d	2025-01-04
e	2025-01-05


# contain metadata
query II
SELECT filename[17:32], name FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/equality_deletes/warehouse/mydb/mytable_partitioned') order by all;
----
equality_deletes	a
equality_deletes	d
equality_deletes	e

query I
SELECT count(*) FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/equality_deletes/warehouse/mydb/mytable_partitioned');
----
3

# all
query III
SELECT * FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/equality_deletes/warehouse/mydb/mytable_partitioned') order by all;
----
1	a	2025-01-01
4	d	2025-01-04
5	e	2025-01-05

query III
SELECT filename[17:32], name, id FROM ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/equality_deletes/warehouse/mydb/mytable') order by all;
----
equality_deletes	d	4
equality_deletes	e	5
